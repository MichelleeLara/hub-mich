# ID del sitio en Umami Cloud (Settings → Websites → Edit → Website ID).
# En Vercel: Project → Settings → Environment Variables (Production).
PUBLIC_UMAMI_WEBSITE_ID=

# Modo "Escríbeme" del teclado: copia este archivo como .env para que también envíe en `npm run dev`.
# En producción estas mismas variables van en Vercel. Con claves reales, cada prueba local manda un mensaje de verdad.
# Telegram (bot de @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp con CallMeBot (cuando haya lugares)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

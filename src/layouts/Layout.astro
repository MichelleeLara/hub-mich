---
import AnimatedTabs from '../components/Navbar';
import Header from '../components/Header';
import ParticlesBackground from '../components/ParticlesBackground.astro';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/rock-salt/400.css';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '../styles/product.css';
const { title, description, image, url, noindex = false, navigation = true } = Astro.props;
// og:image debe ser absoluta; algunas páginas pasan rutas relativas (/author.png)
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
// Analítica (Umami Cloud): solo si hay ID configurado y en páginas públicas (no previews con noindex)
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;


// Definir las propiedades que el layout aceptará
export interface Props {
  title: string;
  description: string;
  image: string;
  url: string;
  noindex?: boolean;
  navigation?: boolean;
}

---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={url} />

    <!-- Meta Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="itsmich — Mich, Product Engineer" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Meta para Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Tema antes de pintar: sin esto el <html class="dark"> del markup
         gana hasta que React hidrata y quien eligió claro ve un flash oscuro
         en cada carga. Preferencia guardada > preferencia del sistema. -->
    <!-- "light dark" = sigue al sistema; "light"/"dark" = override guardado.
         product.css mapea este <meta> a la propiedad color-scheme de :root. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add('has-js');
      let saved = null, motion = null;
      try { saved = localStorage.getItem('theme'); motion = localStorage.getItem('motion'); } catch {}
      if (saved !== 'light' && saved !== 'dark') saved = null;
      document.querySelector('meta[name="color-scheme"]').content = saved ?? 'light dark';
      // Tailwind sigue usando la clase .dark (darkMode: 'class').
      document.documentElement.classList.toggle('dark', saved ? saved === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches);
      // Animaciones pausadas por defecto; solo corren si la persona las activó con el botón.
      document.documentElement.classList.toggle('motion-paused', motion !== 'on');
    </script>
    <!-- Transición entre páginas: no animar hacia una página a medio parsear. -->
    <link rel="expect" href="#main-content" blocking="render" />
    <script is:inline>
      // Llegada desde otra página del sitio (no recarga): la barra flotante ya estaba
      // en pantalla, así que no repite su animación de entrada (ver .site-dock abajo).
      (() => {
        const a = window.navigation?.activation;
        const type = performance.getEntriesByType('navigation')[0]?.type;
        const arrived = a ? !!a.from && a.navigationType !== 'reload'
          : type !== 'reload' && document.referrer.startsWith(location.origin + '/');
        if (arrived) document.documentElement.classList.add('vt-arrival');
      })();
    </script>
    <!-- Sin cookies; data-domains evita contar visitas de localhost y previews de Vercel -->
    {umamiId && !noindex && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} data-domains="itsmich.com.mx"></script>
    )}
  </head>
  <body class="flex flex-col min-h-screen">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <!-- Fondo de partículas (detrás de todo el contenido) -->
    <ParticlesBackground />
    <!-- Navegación superior (islas desktop + barra mínima mobile) -->
    <!-- Desenfoque progresivo bajo la navegación fija: el contenido se aleja en lugar de chocar con las islas. -->
    {navigation && <div class="top-scrim" aria-hidden="true"></div>}
    {navigation && <Header client:load />}
    <div id="main-content" class="flex-grow" tabindex="-1">

      <slot />
    </div>
    <!-- Navegación móvil + asistente contextual de escritorio -->
    {navigation && <AnimatedTabs client:load />}
    
  </body>
</html>

<style is:global>
  @font-face { font-family: 'ClashDisplay'; src: url('../fonts/ClashDisplay-Semibold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: 'Inter Tight Variable', sans-serif;
  }

  /* Scroll suave solo para quien no pidió menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* El color de fondo vive SOLO en html: el canvas de partículas usa
     z-index -1 y debe quedar entre el fondo y el contenido. Un fondo
     opaco en body lo taparía. */
  html {
    background: var(--bg);
    transition: background-color var(--dur-base);
  }

  body {
    background: transparent;
  }



  /* Bajo el header fijo: solo desenfoque (sin tinte), así funciona igual sobre papel,
     tarjetas carbón y el footer invertido. La máscara lo desvanece hacia abajo. */
  .top-scrim {
    position: fixed; inset: 0 0 auto; height: 112px; z-index: 99; pointer-events: none;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000 35%, transparent);
  }
  @media (max-width: 767px) { .top-scrim { height: 84px; } }

  /* Transiciones entre páginas (mejora progresiva: Firefox navega normal). */
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: reduce) {
    @view-transition { navigation: none; }
  }

  /* Header y barra flotante no se desvanecen con la página: se quedan quietos encima. */
  .site-header { view-transition-name: site-header; }
  .site-header-mobile { view-transition-name: site-header-mobile; }
  .site-dock { view-transition-name: site-dock; }
  /* Al llegar desde otra página, la barra aparece ya en su lugar (gana a los estilos en línea de framer). */
  html.vt-arrival .site-dock { opacity: 1 !important; transform: none !important; }

  /* Fade-through: la página anterior sale primero y la nueva entra después.
     Sin superposición no hay "doble exposición" de dos páginas a la vez. */
  ::view-transition-old(root) { animation: 140ms ease-in both vt-out; }
  ::view-transition-new(root) { animation: 280ms var(--ease-out) 140ms both vt-in; }
  @keyframes vt-out { to { opacity: 0; } }
  @keyframes vt-in { from { opacity: 0; translate: 0 12px; } }
</style>

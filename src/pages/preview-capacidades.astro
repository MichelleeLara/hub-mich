---
import Layout from '../layouts/Layout.astro';
import SkillsStack from '../components/SkillsStack.astro';
import SectionHeading from '../components/SectionHeading.astro';
const areas=[
 {name:'Experiencia',tools:['Figma','React','Next.js','Angular'],description:'Interfaces y recorridos que hacen más sencillo usar el producto.'},
 {name:'Sistemas',tools:['TypeScript','Supabase','WebSockets'],description:'Datos, servicios y actualizaciones en tiempo real conectados a la experiencia.'},
 {name:'IA aplicada',tools:['Claude','Agentes','Automatización'],description:'Herramientas que ayudan a explorar, construir y automatizar tareas.'},
 {name:'Mundo físico',tools:['C','STM32','FreeRTOS'],description:'Software que lleva la lógica del producto a dispositivos reales.'},
];
const choices=[{id:'actual',label:'01 · Actual'},{id:'editorial',label:'02 · Capacidades'},{id:'connected',label:'03 · Sistema conectado'}];
---
<Layout title="Capacidades · Opciones de diseño" description="Propuestas para la sección posterior a proyectos." image="/author.png" url={Astro.url.href} noindex>
 <main>
  <div class="preview-controls">
   <p>Después de proyectos · Elige una dirección</p>
   <div class="choices" aria-label="Opciones de presentación">{choices.map(choice=><button type="button" data-choice={choice.id} aria-pressed={choice.id==='editorial'}>{choice.label}</button>)}</div>
   <p class="preview-note">Una propuesta para mostrar con qué construyo, después de ver los proyectos.</p>
  </div>
  <div data-variant="actual" hidden><SkillsStack /></div>
  {['editorial','connected'].map(mode=><section class={`section-shell capabilities ${mode}`} data-variant={mode} hidden={mode!=='editorial'}>
   <header class="capabilities-heading"><SectionHeading label="Con qué construyo" title="La tecnología al servicio del producto." /><p>De la interfaz a los datos, la IA y los dispositivos. Conecto las herramientas que necesita cada proyecto.</p></header>
   {mode==='connected'&&<p class="connection-hint">Cuatro áreas que trabajan como un mismo sistema.</p>}
   <div class="areas">
    {mode==='connected'&&<div class="system-core" aria-hidden="true"><span>Una misma dirección</span><strong>Producto</strong><svg viewBox="0 0 100 100" fill="none"><path d="M50 5v90M5 50h90" stroke="currentColor" stroke-width=".5" /></svg></div>}
    {areas.map((area,index)=><article class="area">
     <span class="area-number" aria-hidden="true">0{index+1}</span>
     {mode==='editorial'&&<svg class="area-graphic" viewBox="0 0 160 120" fill="none" aria-hidden="true">
      {index===0&&<><rect x="25" y="18" width="88" height="64" rx="8"/><path d="M25 34h88M39 26h1m7 0h1M42 49h36M42 60h22"/><rect x="68" y="62" width="67" height="40" rx="6"/><path d="M80 75h35M80 86h20"/></>}
      {index===1&&<><path d="M40 30h38v30h42M40 90h38V60M78 60V22"/><circle cx="30" cy="30" r="10"/><circle cx="30" cy="90" r="10"/><circle cx="130" cy="60" r="10"/><circle cx="78" cy="60" r="6"/><circle cx="78" cy="16" r="6"/></>}
      {index===2&&<><path d="M80 16c0 32 12 44 44 44-32 0-44 12-44 44 0-32-12-44-44-44 32 0 44-12 44-44Z"/><path d="M126 12v20m-10-10h20M28 90v16m-8-8h16"/><circle cx="80" cy="60" r="14"/></>}
      {index===3&&<><rect x="48" y="28" width="64" height="64" rx="8"/><rect x="63" y="43" width="34" height="34" rx="3"/><path d="M60 16v12m20-12v12m20-12v12M60 92v12m20-12v12m20-12v12M36 40h12M36 60h12M36 80h12M112 40h12M112 60h12M112 80h12"/></>}
     </svg>}
     <div class="area-copy"><h3>{area.name}</h3><p>{area.description}</p></div>
     <ul aria-label={`Herramientas de ${area.name}`}>{area.tools.map(tool=><li>{tool}</li>)}</ul>
    </article>)}
   </div>
  </section>)}
  <div class="preview-end"><a href="/#Stack">Volver a la sección actual</a></div>
 </main>
</Layout>
<style>
 .preview-controls { width:min(100%,var(--container)); padding:0 var(--gutter); margin:120px auto 0; color:var(--ink); }
 .preview-controls>p:first-child { color:var(--accent); font:var(--fs-small) var(--font-mono); }
 .choices { display:flex; flex-wrap:wrap; gap:var(--space-2); margin:var(--space-4) 0; }
 .choices button { min-height:44px; padding:10px 18px; border:1px solid var(--line); border-radius:var(--radius-full); background:var(--surface); color:var(--ink); cursor:pointer; }
 .choices button[aria-pressed=true] { background:var(--ink); color:var(--bg); }
 .preview-note,.connection-hint { color:var(--muted); font-size:var(--fs-small); line-height:1.6; }
 .capabilities { padding-top:var(--space-6); }
 .capabilities-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:var(--space-7); margin-bottom:var(--space-8); }
 .capabilities-heading>p { max-width:300px; color:var(--muted); font-size:var(--fs-body); line-height:1.7; }
 .area h3 { font:600 32px/1.15 var(--font-display); letter-spacing:-.02em; }
 .area-copy>p { color:var(--muted); font-size:var(--fs-body); line-height:1.65; max-width:420px; margin-top:var(--space-3); }
 .area-number { font:500 42px/1 var(--font-display); color:var(--accent); letter-spacing:-.04em; }
 .area ul { list-style:none; display:flex; gap:var(--space-2); flex-wrap:wrap; align-items:center; }
 .area li { border:1px solid var(--line); padding:8px 12px; border-radius:var(--radius-full); font-size:var(--fs-small); color:var(--ink); background:var(--bg); }
 .editorial .capabilities-heading { align-items:flex-start; }
 .editorial :global(.section-heading) { max-width:600px; }
 .editorial .areas { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--line); }
 .editorial .area { position:relative; padding:32px 40px 32px 0; border-bottom:1px solid var(--line); min-height:300px; }
 .editorial .area:nth-child(even) { padding-left:40px; border-left:1px solid var(--line); }
 .editorial .area-number { display:block; font:var(--fs-small) var(--font-mono); margin-bottom:60px; }
 .editorial .area h3 { font-size:36px; }
 .editorial .area-copy>p { max-width:350px; }
 .editorial .area ul { margin-top:24px; gap:12px; }
 .editorial .area li { padding:0; border:0; border-radius:0; background:transparent; color:var(--muted); }
 .editorial .area li+li::before { content:'·'; padding-right:12px; color:var(--accent); }
 .area-graphic { position:absolute; top:16px; right:32px; width:130px; height:98px; stroke:var(--accent); stroke-width:1.25; stroke-linecap:round; stroke-linejoin:round; }
 .editorial.particle-capabilities .area-graphic { opacity:0; }
 :global(html.motion-paused) .editorial.particle-capabilities .area-graphic { opacity:1; stroke-dasharray:.1 3; stroke-width:2; }
 @media(prefers-reduced-motion:reduce) { .editorial.particle-capabilities .area-graphic { opacity:1; stroke-dasharray:.1 3; stroke-width:2; } }
 .connected .areas { position:relative; display:grid; grid-template-columns:1fr 1fr; gap:120px var(--space-9); padding:var(--space-6) 0; }
 .connected .area { position:relative; z-index:1; background:var(--bg); border:1px solid var(--line); border-radius:var(--radius-md); padding:var(--space-5); transition:border-color var(--dur-base),box-shadow var(--dur-base); }
 .connected .area:hover { border-color:var(--accent); box-shadow:var(--shadow-float); }
 .connected .area-number { font-size:var(--fs-small); font-family:var(--font-mono); display:block; margin-bottom:var(--space-4); }
 .connected .area ul { margin-top:var(--space-5); }
 .system-core { position:absolute; inset:0; display:flex; justify-content:center; align-items:center; flex-direction:column; gap:var(--space-2); color:var(--accent); }
 .system-core span { font:var(--fs-micro) var(--font-mono); background:var(--bg); z-index:1; }
 .system-core strong { font:600 32px/1.1 var(--font-display); background:var(--bg); padding:4px 16px; z-index:1; }
 .system-core svg { position:absolute; inset:0; width:100%; height:100%; opacity:.35; }
 .connection-hint { margin-bottom:var(--space-4); }
 .preview-end { padding:var(--space-8) var(--gutter) 120px; text-align:center; color:var(--muted); }
 [data-variant][hidden] { display:none; }
 @media(max-width:767px) {
  .preview-controls { margin-top:100px; }
  .capabilities-heading { display:block; margin-bottom:var(--space-6); }
  .capabilities-heading>p { max-width:440px; margin-top:var(--space-5); }
  .editorial .areas { grid-template-columns:minmax(0,1fr); }
  .editorial .area,.editorial .area:nth-child(even) { padding:24px 0; border-left:0; min-height:290px; }
  .editorial .area h3 { font-size:32px; }
  .area-graphic { right:0; top:12px; }
  .area-number { font-size:32px; }
  .area h3 { font-size:28px; }
  .connected .areas { grid-template-columns:minmax(0,1fr); gap:var(--space-5); padding-top:80px; }
  .system-core { inset:0 0 auto; height:70px; }
  .system-core svg { display:none; }
 }
 @media(prefers-reduced-motion:reduce) { .connected .area { transition:none; } }
 :global(html.motion-paused) .connected .area { transition:none; }
</style>
<script>
 import { ENFOQUE_PARTICLE_EVENT, type EnfoqueGrain } from '../lib/enfoqueParticles';
 const field=document.querySelector<HTMLElement>('.editorial');
 const graphics=Array.from(field?.querySelectorAll<SVGSVGElement>('.area-graphic')??[]);
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const pointer={x:-1000,y:-1000};
 let frame=0,visible=false;
 const release=()=>document.dispatchEvent(new CustomEvent(ENFOQUE_PARTICLE_EVENT,{detail:{points:[],strength:0}}));
 const samples=graphics.map(svg=>Array.from(svg.querySelectorAll<SVGGeometryElement>('path,rect,circle')).flatMap(shape=>{
  const length=shape.getTotalLength();
  return Array.from({length:Math.ceil(length/2.4)},(_,i)=>shape.getPointAtLength(i*2.4));
 }));
 const enabled=()=>visible&&!field?.hidden&&!reduced.matches&&!document.documentElement.classList.contains('motion-paused')&&!document.hidden;
 const draw=(time:number)=>{
  frame=0;
  if(!enabled()){release();return;}
  const points:EnfoqueGrain[]=[];
  graphics.forEach((svg,g)=>{
   const matrix=svg.getScreenCTM();if(!matrix)return;
   samples[g].forEach((point,i)=>{
    const screen=new DOMPoint(point.x,point.y).matrixTransform(matrix);
    const phase=i*.73+g*2;
    let x=screen.x+Math.sin(time*.0008+phase)*.65;
    let y=screen.y+Math.cos(time*.0006+phase)*.65;
    const dx=x-pointer.x,dy=y-pointer.y,distance=Math.hypot(dx,dy);
    const push=Math.max(0,1-distance/65)*9;
    x+=dx/Math.max(1,distance)*push;y+=dy/Math.max(1,distance)*push;
    points.push({x,y,alpha:.65+(i%4)*.08,radius:.85+(i%3)*.12,tint:1});
   });
  });
  document.dispatchEvent(new CustomEvent(ENFOQUE_PARTICLE_EVENT,{detail:{points,strength:1}}));
  frame=requestAnimationFrame(draw);
 };
 const schedule=()=>{if(!frame&&enabled())frame=requestAnimationFrame(draw);};
 if(field&&document.getElementById('particles-bg')){
  field.classList.add('particle-capabilities');
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;schedule();if(!visible)release();}).observe(field);
  new MutationObserver(()=>{schedule();if(!enabled())release();}).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  reduced.addEventListener('change',schedule);
  document.addEventListener('visibilitychange',schedule);
  field.addEventListener('pointermove',event=>{pointer.x=event.clientX;pointer.y=event.clientY;});
  field.addEventListener('pointerleave',()=>{pointer.x=pointer.y=-1000;});
 }
 const controls=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choice]'));
 controls.forEach(button=>button.addEventListener('click',()=>{
  controls.forEach(control=>control.setAttribute('aria-pressed',String(control===button)));
  document.querySelectorAll<HTMLElement>('[data-variant]').forEach(variant=>variant.hidden=variant.dataset.variant!==button.dataset.choice);
  schedule();if(!enabled())release();
 }));
</script>

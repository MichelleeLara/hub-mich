---
import Layout from '../layouts/Layout.astro';

// Proyección isométrica para la opción C (misma gramática que "Mi enfoque").
const C = Math.cos(Math.PI / 6), S = 0.5;
const iso = (x: number, y: number, z = 0) => [240 + (x - y) * C, 150 + (x + y) * S - z];
const pts = (list: number[][]) => list.map(p => p.map(n => n.toFixed(1)).join(',')).join(' ');
const plane = (x: number, y: number, w: number, h: number, z = 0) => pts([iso(x, y, z), iso(x + w, y, z), iso(x + w, y + h, z), iso(x, y + h, z)]);
const box = (x: number, y: number, w: number, h: number, z: number, d: number) => ({
  top: plane(x, y, w, h, z + d),
  left: pts([iso(x, y + h, z), iso(x + w, y + h, z), iso(x + w, y + h, z + d), iso(x, y + h, z + d)]),
  right: pts([iso(x + w, y, z), iso(x + w, y + h, z), iso(x + w, y + h, z + d), iso(x + w, y, z + d)]),
});
const line = (a: number[], b: number[]) => { const [x1, y1] = a, [x2, y2] = b; return { x1, y1, x2, y2 }; };
const gridLines = Array.from({ length: 7 }, (_, i) => i * 30);
const devBrowser = box(-20, -10, 150, 110, 0, 10);
const devPhone = box(150, 40, 46, 80, 0, 10);
const nodes = [[-60, -40], [20, -40], [20, 60], [120, 60]].map(([x, y]) => box(x, y, 40, 40, 0, 26));
const nodeCenters = [[-40, -20], [40, -20], [40, 80], [140, 80]].map(([x, y]) => iso(x, y, 0));
const nodeLabels = [['disparador', -40, -20], ['IA', 40, -20], ['CRM', 40, 80], ['correo', 140, 80]].map(([t, x, y]) => { const [lx, ly] = iso(Number(x), Number(y), 26); return { t, x: lx, y: ly - 30 }; });
const flowMid = iso(0, -20, 0);

const services = [
  { n: '01', name: 'Diseño UX/UI', idea: 'Del boceto al sistema visual' },
  { n: '02', name: 'Desarrollo', idea: 'Web y móvil desde el mismo diseño' },
  { n: '03', name: 'Automatización', idea: 'Herramientas conectadas que trabajan solas' },
];
---
<Layout title="Preview · Gráficos de servicios" description="Tres direcciones para los gráficos de Diseño, Desarrollo y Automatización." image="/author.png" url={Astro.url.href} noindex>
  <main class="shell">
    <header class="intro">
      <p class="note-label">Preview de servicios</p>
      <h1>Tres direcciones para los gráficos</h1>
      <p>Cada dirección usa la misma gramática en los tres servicios. Todas usan los tokens del sitio, así que cambian con el tema.</p>
    </header>

    <!-- A · Un mismo lienzo que evoluciona -->
    <section class="option" aria-labelledby="opt-a">
      <div class="option-head">
        <h2 id="opt-a"><span>A</span> Un mismo lienzo que evoluciona</h2>
        <p>La misma pantalla pasa por los tres servicios: boceto con retícula, producto real en web y iPhone, y luego conectada a otras herramientas. Cuenta que el servicio es un proceso continuo.</p>
      </div>
      <div class="frames">
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame" x="70" y="40" width="340" height="270" rx="16"/>
            {[0,1,2,3,4,5].map(i => <rect class="col" x={92 + i * 51} y="58" width="40" height="234" rx="3"/>)}
            <rect class="wire" x="92" y="62" width="296" height="22" rx="6"/>
            <rect class="wire" x="92" y="100" width="194" height="74" rx="8"/>
            <rect class="wire" x="92" y="190" width="91" height="96" rx="8"/><rect class="wire" x="194" y="190" width="91" height="96" rx="8"/><rect class="wire" x="297" y="190" width="91" height="96" rx="8"/>
            <rect class="accent-fill" x="92" y="150" width="70" height="18" rx="9"/>
            <path class="redline" d="M286 108h18M295 108v58M286 166h18"/><text class="mono small" x="310" y="141">24</text>
            <g class="chip" transform="translate(296 92)"><rect width="128" height="24" rx="12"/><text class="mono" x="12" y="16">Botón / primario</text></g>
            <path class="pen" d="M176 168l26 30-8 2-5 9-13-41z"/>
          </svg>
          <figcaption><b>01 · Diseño</b> Retícula, componentes y medidas: se ve que hay sistema.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame solid" x="40" y="40" width="300" height="240" rx="14"/>
            <path class="bar" d="M40 70h300"/><circle class="dot" cx="58" cy="55" r="3"/><circle class="dot" cx="69" cy="55" r="3"/><circle class="dot" cx="80" cy="55" r="3"/>
            <rect class="soft" x="58" y="86" width="170" height="62" rx="8"/><rect class="accent-fill" x="58" y="130" width="62" height="14" rx="7"/>
            <rect class="soft" x="58" y="162" width="80" height="100" rx="8"/><rect class="soft" x="148" y="162" width="80" height="100" rx="8"/><rect class="soft" x="238" y="162" width="84" height="100" rx="8"/>
            <rect class="frame solid" x="330" y="96" width="112" height="226" rx="22"/>
            <rect class="notch" x="368" y="104" width="36" height="8" rx="4"/>
            <rect class="soft" x="344" y="124" width="84" height="54" rx="8"/><rect class="accent-fill" x="344" y="164" width="44" height="10" rx="5"/>
            <rect class="soft" x="344" y="188" width="84" height="56" rx="8"/><rect class="soft" x="344" y="252" width="84" height="56" rx="8"/>
            <g class="chip" transform="translate(58 292)"><rect width="150" height="26" rx="13"/><text class="mono" x="14" y="17">&lt;/&gt; en producción</text></g>
          </svg>
          <figcaption><b>02 · Desarrollo</b> El mismo diseño, funcionando en web y en iPhone.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame solid faded" x="40" y="60" width="220" height="200" rx="14"/>
            <rect class="soft faded" x="56" y="80" width="130" height="44" rx="8"/>
            <rect class="soft" x="56" y="140" width="60" height="100" rx="8"/><rect class="soft" x="124" y="140" width="60" height="100" rx="8"/><rect class="soft" x="192" y="140" width="52" height="100" rx="8"/>
            <path class="link" d="M116 190C220 190 230 96 330 96"/><path class="link" d="M184 200C260 200 260 180 330 180"/><path class="link" d="M244 210C290 210 290 264 330 264"/>
            {[['CRM', 96], ['IA', 180], ['Correo', 264]].map(([label, y]) => <g class="tool" transform={`translate(330 ${Number(y) - 18})`}><rect width="110" height="36" rx="10"/><circle cx="18" cy="18" r="5"/><text x="32" y="23">{label}</text></g>)}
            <circle class="pulse" cx="116" cy="190" r="5"/>
            <g class="chip ok" transform="translate(56 284)"><rect width="124" height="26" rx="13"/><text class="mono" x="14" y="17">● flujo activo</text></g>
          </svg>
          <figcaption><b>03 · Automatización</b> El producto se conecta con CRM, IA y correo.</figcaption>
        </figure>
      </div>
    </section>

    <!-- B · El banco de trabajo de cada servicio -->
    <section class="option" aria-labelledby="opt-b">
      <div class="option-head">
        <h2 id="opt-b"><span>B</span> El banco de trabajo de cada servicio</h2>
        <p>Cada gráfico muestra la herramienta real del oficio dentro del mismo marco: el lienzo de diseño, el editor con la vista en vivo y el editor de flujos. Es la más literal y fácil de leer.</p>
      </div>
      <div class="frames">
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame solid" x="30" y="40" width="420" height="280" rx="14"/>
            <path class="bar" d="M30 70h420M118 70v250M362 70v250"/>
            {[0,1,2,3,4].map(i => <rect class="soft" x="44" y={88 + i * 22} width={i % 2 ? 46 : 60} height="8" rx="4"/>)}
            <rect class="accent-soft" x="40" y="128" width="72" height="16" rx="5"/>
            <rect class="artboard" x="138" y="92" width="204" height="210" rx="8"/>
            <rect class="soft" x="154" y="110" width="172" height="58" rx="8"/><rect class="accent-fill" x="154" y="180" width="74" height="18" rx="9"/>
            <rect class="soft" x="154" y="212" width="80" height="72" rx="8"/><rect class="soft" x="246" y="212" width="80" height="72" rx="8"/>
            <rect class="select" x="150" y="176" width="82" height="26" rx="11"/>
            <text class="type" x="378" y="110">Aa</text>
            <circle class="sw-ink" cx="384" cy="140" r="9"/><circle class="sw-accent" cx="408" cy="140" r="9"/><circle class="sw-line" cx="432" cy="140" r="9"/>
            {[0,1,2].map(i => <rect class="soft" x="376" y={166 + i * 18} width={58 - i * 10} height="7" rx="4"/>)}
          </svg>
          <figcaption><b>01 · Diseño</b> Capas, lienzo y estilos: el taller de diseño.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame solid" x="30" y="40" width="270" height="280" rx="14"/>
            <path class="bar" d="M30 70h270"/>
            {[[48,90,120,'k'],[64,110,150,''],[64,130,96,'a'],[80,150,130,''],[80,170,70,'k'],[64,190,110,''],[48,210,40,'k'],[48,240,140,'a'],[64,260,90,'']].map(([x,y,w,t]) => <rect class={`code ${t}`} x={x} y={y} width={w} height="8" rx="4"/>)}
            {[0,1,2,3,4,5,6,7,8].map(i => <text class="mono ln" x="38" y={97 + i * 20 + (i > 6 ? 10 : 0)}>{i + 1}</text>)}
            <path class="link" d="M300 180h40"/><path class="arrow" d="M334 174l8 6-8 6"/>
            <rect class="frame solid" x="352" y="70" width="104" height="220" rx="22"/><rect class="notch" x="386" y="78" width="36" height="8" rx="4"/>
            <rect class="soft" x="364" y="98" width="80" height="52" rx="8"/><rect class="accent-fill" x="364" y="138" width="40" height="10" rx="5"/>
            <rect class="soft" x="364" y="162" width="80" height="48" rx="8"/><rect class="soft" x="364" y="218" width="80" height="48" rx="8"/>
            <g class="chip ok" transform="translate(48 286)"><rect width="112" height="24" rx="12"/><text class="mono" x="12" y="16">● build listo</text></g>
          </svg>
          <figcaption><b>02 · Desarrollo</b> Código a la izquierda, producto vivo a la derecha.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <rect class="frame solid" x="30" y="40" width="420" height="280" rx="14"/>
            <path class="bar" d="M30 70h420"/>
            <path class="link" d="M144 140h44M292 140h44M388 162v34M336 218h-44M188 218h-44"/>
            {[[40,'Disparador'],[188,'IA clasifica'],[336,'Actualiza CRM']].map(([x,label]) => <g class="tool" transform={`translate(${x} 118)`}><rect width="104" height="44" rx="10"/><circle cx="16" cy="22" r="5"/><text x="28" y="26">{label}</text></g>)}
            {[[336,'Envía correo'],[188,'Registra'],[40,'Reporte']].map(([x,label]) => <g class="tool" transform={`translate(${x} 196)`}><rect width="104" height="44" rx="10"/><circle cx="16" cy="22" r="5"/><text x="28" y="26">{label}</text></g>)}
            <circle class="pulse" cx="188" cy="140" r="5"/>
            <g class="log"><text class="mono" x="48" y="276">09:41  ✓  42 solicitudes procesadas</text><text class="mono muted" x="48" y="296">09:40  ✓  CRM actualizado</text></g>
          </svg>
          <figcaption><b>03 · Automatización</b> Un flujo que corre solo y deja registro.</figcaption>
        </figure>
      </div>
    </section>

    <!-- C · Isométrico de puntos (rima con "Mi enfoque") -->
    <section class="option" aria-labelledby="opt-c">
      <div class="option-head">
        <h2 id="opt-c"><span>C</span> Isométrico de puntos</h2>
        <p>Usa el mismo trazo punteado e isométrico de «Mi enfoque»: capas de diseño separadas, el producto armado en web y móvil, y bloques conectados. Es la más coherente con la identidad del sitio y la más abstracta.</p>
      </div>
      <div class="frames iso-frames">
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <polygon class="iso-plane" points={plane(-10, -10, 200, 200, 0)}/>
            {gridLines.map(g => <line class="iso-grid" {...line(iso(-10 + g, -10, 0), iso(-10 + g, 190, 0))}/>)}
            <polygon class="iso-plane" points={plane(-10, -10, 200, 200, 52)}/>
            <polygon class="iso-block" points={plane(10, 10, 160, 30, 52)}/><polygon class="iso-block" points={plane(10, 60, 70, 110, 52)}/><polygon class="iso-block" points={plane(100, 60, 70, 110, 52)}/>
            <polygon class="iso-plane top" points={plane(-10, -10, 200, 200, 104)}/>
            <polygon class="iso-accent" points={plane(20, 20, 70, 24, 104)}/>
            <line class="iso-drop" {...line(iso(55, 32, 104), iso(55, 32, 52))}/>
            <text class="mono iso-tag" x="400" y="96">componentes</text><text class="mono iso-tag" x="400" y="150">estructura</text><text class="mono iso-tag" x="400" y="206">retícula</text>
          </svg>
          <figcaption><b>01 · Diseño</b> Retícula, estructura y componentes, separados en capas.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <polygon class="iso-plane" points={plane(-50, -40, 270, 200, 0)}/>
            <polygon class="iso-side" points={devBrowser.left}/><polygon class="iso-side" points={devBrowser.right}/><polygon class="iso-face" points={devBrowser.top}/>
            <polygon class="iso-block" points={plane(-10, 0, 130, 26, 10)}/><polygon class="iso-accent" points={plane(-10, 34, 50, 14, 10)}/><polygon class="iso-block" points={plane(-10, 56, 60, 40, 10)}/><polygon class="iso-block" points={plane(60, 56, 60, 40, 10)}/>
            <polygon class="iso-side" points={devPhone.left}/><polygon class="iso-side" points={devPhone.right}/><polygon class="iso-face" points={devPhone.top}/>
            <polygon class="iso-block" points={plane(156, 48, 34, 22, 10)}/><polygon class="iso-accent" points={plane(156, 76, 20, 8, 10)}/><polygon class="iso-block" points={plane(156, 90, 34, 22, 10)}/>
            <text class="mono iso-tag" x={iso(55, 100, 0)[0] - 70} y={iso(55, 100, 0)[1] + 18}>web</text><text class="mono iso-tag" x={iso(173, 120, 0)[0] - 10} y={iso(173, 120, 0)[1] + 22}>iOS</text>
          </svg>
          <figcaption><b>02 · Desarrollo</b> El diseño armado como producto en web y móvil.</figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 480 360" aria-hidden="true">
            <polygon class="iso-plane" points={plane(-90, -70, 280, 200, 0)}/>
            <polyline class="iso-link" points={pts(nodeCenters)}/>
            {nodes.map((b, i) => <g><polygon class="iso-side" points={b.left}/><polygon class="iso-side" points={b.right}/><polygon class={i === 1 ? 'iso-accent' : 'iso-face'} points={b.top}/></g>)}
            <circle class="pulse" cx={flowMid[0]} cy={flowMid[1]} r="5"/>
            {nodeLabels.map(l => <text class="mono iso-tag" x={l.x} y={l.y} text-anchor="middle">{l.t}</text>)}
          </svg>
          <figcaption><b>03 · Automatización</b> Bloques conectados por un flujo que se recorre solo.</figcaption>
        </figure>
      </div>
    </section>

    <section class="notes" aria-label="Qué se mantiene en cualquier opción">
      <h2>En cualquier opción</h2>
      <ul>
        <li>El gráfico deja libre la zona del título «Resultado» (hoy el estado 02 se encima con él).</li>
        <li>Un solo color de acento, y solo en lo que el servicio entrega.</li>
        <li>La transición entre servicios conserva piezas comunes para que se lea como una sola pieza.</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .shell { width: min(100%, var(--container)); margin: 0 auto; padding: 120px var(--gutter) var(--space-9); display: grid; gap: var(--space-9); color: var(--ink); }
  .intro { display: grid; gap: var(--space-4); max-width: 720px; }
  .intro .note-label { color: var(--muted); font: 400 14px/1.5 var(--font-note); }
  .intro h1 { font: 600 var(--fs-h2)/1.1 var(--font-display); letter-spacing: -.012em; }
  .intro p:last-child { color: var(--muted); line-height: 1.6; }
  .option { display: grid; gap: var(--space-6); }
  .option-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-6); align-items: end; }
  .option-head h2 { display: flex; align-items: center; gap: 12px; font: 600 26px/1.15 var(--font-display); }
  .option-head h2 span { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--accent); color: var(--bg); font: 600 14px/1 var(--font-mono); }
  .option-head p { color: var(--muted); line-height: 1.6; }
  .frames { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  figure { margin: 0; display: grid; gap: var(--space-3); }
  figure svg { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 20px; background: linear-gradient(150deg, color-mix(in srgb, var(--accent) 4%, var(--bg)), var(--bg) 60%); }
  figcaption { color: var(--muted); font-size: var(--fs-small); line-height: 1.5; }
  figcaption b { display: block; color: var(--ink); font-weight: 600; }
  .notes { padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .notes h2 { font: 600 20px/1.2 var(--font-display); margin-bottom: var(--space-3); }
  .notes ul { display: grid; gap: 8px; padding-left: 18px; color: var(--muted); list-style: disc; }

  /* Gramática común de los gráficos (tokens del sitio) */
  svg :is(.frame) { fill: none; stroke: var(--line); stroke-width: 1.2; }
  svg .frame.solid { fill: color-mix(in srgb, var(--bg) 94%, transparent); }
  svg .bar { stroke: var(--line); fill: none; }
  svg .dot { fill: none; stroke: var(--line); }
  svg .col { fill: color-mix(in srgb, var(--accent) 6%, transparent); }
  svg .wire { fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 4; opacity: .7; }
  svg .soft { fill: color-mix(in srgb, var(--ink) 7%, transparent); }
  svg .faded { opacity: .55; }
  svg .accent-fill { fill: var(--accent); }
  svg .accent-soft { fill: color-mix(in srgb, var(--accent) 18%, transparent); }
  svg .redline { stroke: var(--accent); fill: none; stroke-width: 1.2; }
  svg .pen { fill: var(--ink); stroke: var(--bg); stroke-width: 1.5; }
  svg .chip rect { fill: var(--bg); stroke: var(--line); }
  svg .chip text { fill: var(--ink); }
  svg .chip.ok text { fill: var(--success); }
  svg .notch { fill: color-mix(in srgb, var(--ink) 12%, transparent); }
  svg .link { fill: none; stroke: color-mix(in srgb, var(--accent) 55%, var(--line)); stroke-width: 1.4; stroke-dasharray: 6 6; }
  svg .arrow { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  svg .tool rect { fill: var(--bg); stroke: var(--line); }
  svg .tool circle { fill: var(--accent); }
  svg .tool text { fill: var(--ink); font: 500 12px/1 var(--font-sans); }
  svg .pulse { fill: var(--accent); }
  svg .artboard { fill: var(--bg); stroke: var(--line); }
  svg .select { fill: none; stroke: var(--accent); stroke-width: 1.4; }
  svg .type { fill: var(--ink); font: 600 22px/1 var(--font-display); }
  svg .sw-ink { fill: var(--ink); } svg .sw-accent { fill: var(--accent); } svg .sw-line { fill: var(--line); }
  svg .code { fill: color-mix(in srgb, var(--ink) 16%, transparent); }
  svg .code.k { fill: color-mix(in srgb, var(--accent) 60%, transparent); }
  svg .code.a { fill: color-mix(in srgb, var(--success) 55%, transparent); }
  svg .mono { fill: var(--muted); font: 500 11px/1 var(--font-mono); }
  svg .mono.small { font-size: 10px; fill: var(--accent); }
  svg .ln { fill: var(--subtle); font-size: 9px; }
  svg .log .mono { fill: var(--ink); } svg .log .muted { fill: var(--muted); }

  /* Isométrico punteado: misma textura de grano que "Mi enfoque" */
  svg .iso-plane { fill: color-mix(in srgb, var(--accent) 4%, transparent); stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: .1 5; stroke-linecap: round; }
  svg .iso-plane.top { fill: color-mix(in srgb, var(--accent) 7%, transparent); }
  svg .iso-grid { stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: .1 7; stroke-linecap: round; opacity: .55; }
  svg .iso-block { fill: color-mix(in srgb, var(--ink) 7%, transparent); stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: .1 4; stroke-linecap: round; }
  svg .iso-accent { fill: color-mix(in srgb, var(--accent) 28%, transparent); stroke: var(--accent); stroke-width: 1.4; }
  svg .iso-face { fill: color-mix(in srgb, var(--bg) 90%, var(--accent)); stroke: var(--accent); stroke-width: 1.2; }
  svg .iso-side { fill: color-mix(in srgb, var(--accent) 10%, var(--bg)); stroke: color-mix(in srgb, var(--accent) 50%, var(--line)); stroke-width: 1; }
  svg .iso-drop, svg .iso-link { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: .1 6; stroke-linecap: round; }
  svg .iso-tag { fill: var(--muted); }

  @media (max-width: 700px) {
    .option-head { grid-template-columns: 1fr; }
    .frames { grid-template-columns: 1fr; max-width: 520px; }
  }
</style>

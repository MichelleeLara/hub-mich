---
import Layout from '../../layouts/Layout.astro';
import MegaFooter from '../../components/MegaFooter.astro';
import CaseHero from '../../components/CaseHero.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import { projectPresentation } from '../../data/projectPresentation';
import { projects, getProject } from '../../data/projectsData.js';

export function getStaticPaths() {
	return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const p = project ?? getProject(Astro.params.slug);

// Ficha técnica del brief: reutiliza el patrón "INTRO + pills agrupados".
// HERRAMIENTAS se recicla del stack para no duplicar datos.
const facts = p.brief
	? [
			{ label: 'Rol', tags: p.brief.rol },
			{ label: 'Estado', tags: p.brief.estado },
			{ label: 'Tipo', tags: p.brief.tipo },
			{ label: 'Herramientas', tags: p.stack.map((t) => t.label) },
		]
	: [];

// Siguiente proyecto (cicla al primero al llegar al final) para el banner-portal.
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length];

// Pills resumidas del siguiente caso: rol · tipo · año (desde su brief).
const nextTags = next.brief
	? [
			next.brief.rol?.[0],
			next.brief.tipo?.[0],
			next.brief.estado?.[next.brief.estado.length - 1],
		].filter(Boolean)
	: [];
---

<Layout
	title={`${p.title} · Caso de estudio — Mich`}
	description={p.intro.left}
	image="/OpenGraphl.png"
	url={`https://itsmich.com.mx/proyectos/${p.slug}/`}
>
	<!-- Fondo transparente: el color claro/oscuro lo maneja <html> (toggle del
	     header) y las partículas del Layout se ven a través de toda la página. -->
	<main><article class="font-InterT text-gray-900 dark:text-secondary">
		<CaseHero project={p} />

		<!-- ============================================================= -->
		<!-- 2b · BRIEF — Narrativa editorial + ficha en pills             -->
		<!-- ============================================================= -->
		{p.brief && (
			<section id="decisiones" class="relative scroll-mt-28 px-6 pb-20">
				<div class="mx-auto max-w-5xl">
					<div class="relative overflow-hidden rounded-3xl border border-black/10 bg-[#f4f4f5] p-8 dark:border-white/10 dark:bg-[#1d1d1d] md:p-12">
						<div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
							<!-- Narrativa -->
							<div>
								<p class="mb-6 text-xs font-semibold uppercase tracking-[0.2em] text-orange-700 dark:text-orange-400">Intro</p>
								<div class="space-y-5 text-[15px] leading-relaxed text-gray-600 dark:text-zinc-300 md:text-base [&_em]:italic [&_em]:text-gray-600 dark:[&_em]:text-zinc-400 [&_strong]:font-semibold [&_strong]:text-gray-900 dark:[&_strong]:text-zinc-100">
									{p.brief.intro.map((para) => (
										<p set:html={para} />
									))}
								</div>
								{p.brief.note && (
									<div class="mt-8 inline-flex items-center gap-2.5 rounded-xl border border-black/10 bg-black/5 px-4 py-3 text-xs italic text-gray-600 dark:border-white/10 dark:bg-white/5 dark:text-zinc-400">
										<svg class="h-4 w-4 flex-shrink-0 text-gray-600 dark:text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
										{p.brief.note}
									</div>
								)}
							</div>

							<!-- Ficha · pills agrupados (Herramientas reutiliza el stack) -->
							<div class="space-y-7 lg:border-l lg:border-black/10 lg:pl-14 dark:lg:border-white/10">
								{facts.map((group) => (
									<div>
										<p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-orange-700 dark:text-orange-400">{group.label}</p>
										<div class="flex flex-wrap gap-2">
											{group.tags.map((tag) => (
												<span class="rounded-full border border-black/10 bg-black/5 px-3.5 py-1.5 text-[13px] font-medium text-gray-700 dark:border-white/10 dark:bg-white/10 dark:text-gray-300">
													{tag}
												</span>
											))}
										</div>
									</div>
								))}
							</div>
						</div>
					</div>
				</div>
			</section>
		)}

		<!-- ============================================================= -->
		<!-- 3 · LA AUTOPSIA — Staggered Cards + SVG connector             -->
		<!-- ============================================================= -->
		<section class="relative py-28 md:py-40">
			<div class="mx-auto max-w-3xl px-6 text-center">
				<span class="text-xs font-semibold uppercase tracking-[0.25em] text-orange-700 dark:text-orange-400">Detrás del producto</span>
				<h2 class="mt-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-secondary md:text-5xl">Problema · Solución · Resultado</h2>
				<p class="mt-4 text-base text-gray-600 dark:text-terteary">Qué necesitaba cambiar, qué decidí y qué resultado tuvo.</p>
			</div>

			<div class="relative mx-auto mt-20 max-w-6xl px-6">
				<!-- Conectores punteados (solo desktop). Dos SVGs pequeños con
				     viewBox = tamaño de caja → escala uniforme, puntos siempre
				     redondos y curva sin deformar. Uno por gap entre tarjetas. -->
				<!-- Gap 1 → 2 (tarjeta 2 va más arriba: la curva sube a la derecha).
				     Los cp comparten la Y de cada extremo → salida/entrada horizontal
				     y un swoosh ease-in-out suave, como la referencia. -->
				<svg
					class="pointer-events-none absolute left-[33.5%] top-[205px] z-0 hidden h-[170px] w-[110px] -translate-x-1/2 lg:block"
					viewBox="0 0 110 170"
					fill="none"
					aria-hidden="true"
				>
					<path d="M 12 126 C 46 126, 60 50, 98 50" stroke="#f97316" stroke-width="2.5" stroke-dasharray="5 7" stroke-linecap="round" />
					<circle cx="12" cy="126" r="4" fill="#f97316" />
					<circle cx="98" cy="50" r="4" fill="#f97316" />
				</svg>
				<!-- Gap 2 → 3 (tarjeta 3 va más abajo: la curva baja a la derecha) -->
				<svg
					class="pointer-events-none absolute left-[66.5%] top-[205px] z-0 hidden h-[170px] w-[110px] -translate-x-1/2 lg:block"
					viewBox="0 0 110 170"
					fill="none"
					aria-hidden="true"
				>
					<path d="M 12 50 C 46 50, 60 126, 98 126" stroke="#f97316" stroke-width="2.5" stroke-dasharray="5 7" stroke-linecap="round" />
					<circle cx="12" cy="50" r="4" fill="#f97316" />
					<circle cx="98" cy="126" r="4" fill="#f97316" />
				</svg>

				<!-- Tarjetas: layout asimétrico en desktop, apiladas en móvil -->
				<div class="relative z-10 grid grid-cols-1 gap-8 lg:grid-cols-3 lg:items-start lg:gap-6">
					<!-- 1 · PROBLEMA (viñetas) -->
					<div class="rounded-2xl bg-[#f4f4f5] p-8 shadow-xl shadow-zinc-900/5 ring-1 ring-black/5 dark:bg-[#1d1d1d] dark:ring-white/10 lg:mt-8 lg:-rotate-1">
						<div class="mb-5 flex items-center gap-3">
							<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-red-500 dark:bg-red-500/10 dark:text-red-400">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
							</div>
							<div>
								<p class="text-[11px] font-semibold uppercase tracking-widest text-gray-600 dark:text-zinc-400">01 · El contexto</p>
								<h3 class="text-xl font-bold tracking-tight text-gray-900 dark:text-secondary">Problema</h3>
							</div>
						</div>
						<ul class="space-y-3.5 text-sm leading-relaxed text-gray-600 dark:text-zinc-300">
							{p.problema.map((item) => (
								<li class="flex gap-3">
									<span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-red-400"></span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>

					<!-- 2 · SOLUCIÓN (párrafos) — centro, elevada y rotada -->
					<div class="rounded-2xl bg-[#f4f4f5] p-8 shadow-2xl shadow-zinc-900/10 ring-1 ring-black/5 dark:bg-[#1d1d1d] dark:ring-white/10 lg:-mt-4 lg:rotate-2">
						<div class="mb-5 flex items-center gap-3">
							<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-50 text-orange-700 dark:text-orange-400 dark:bg-orange-500/10 dark:text-orange-400">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
							</div>
							<div>
								<p class="text-[11px] font-semibold uppercase tracking-widest text-gray-600 dark:text-zinc-400">02 · La decisión</p>
								<h3 class="text-xl font-bold tracking-tight text-gray-900 dark:text-secondary">Solución</h3>
							</div>
						</div>
						<div class="space-y-4 text-sm leading-relaxed text-gray-600 dark:text-zinc-300">
							{p.solucion.map((para) => (<p>{para}</p>))}
						</div>
					</div>

					<!-- 3 · RESULTADO (métricas grandes en acento) -->
					<div class="rounded-2xl bg-[#f4f4f5] p-8 shadow-xl shadow-zinc-900/5 ring-1 ring-black/5 dark:bg-[#1d1d1d] dark:ring-white/10 lg:mt-12 lg:rotate-1">
						<div class="mb-5 flex items-center gap-3">
							<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
							</div>
							<div>
								<p class="text-[11px] font-semibold uppercase tracking-widest text-gray-600 dark:text-zinc-400">03 · El impacto</p>
								<h3 class="text-xl font-bold tracking-tight text-gray-900 dark:text-secondary">Resultado</h3>
							</div>
						</div>
						<div class="space-y-6">
							{p.resultado.map((metric) => (
								<div>
									<p class="text-4xl font-bold tracking-tighter text-[var(--accent)]">
										{metric.value}
									</p>
									<p class="mt-1 text-sm leading-snug text-gray-600 dark:text-zinc-400">{metric.label}</p>
								</div>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- ===================================================== -->
			<!-- 4 · GRID DE IMPACTO — Bento Box                       -->
			<!-- ===================================================== -->
			{p.impact && (
				<div class="mx-auto mt-24 max-w-5xl px-6">
					<span class="text-sm uppercase tracking-widest text-gray-600 dark:text-zinc-400">Lo que cambió</span>

					<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3 md:grid-rows-2">
						<!-- Tarjeta 1 · Destacada: métrica de negocio (siempre oscura, acento) -->
						<div class="relative flex flex-col justify-between overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-950 p-8 text-white md:col-span-2 md:row-span-2 md:p-10">
							<!-- glow ámbar de acento -->
							<div
								class="pointer-events-none absolute -left-20 -top-24 h-72 w-72 rounded-full opacity-70 blur-[90px]"
								style="background: radial-gradient(circle, rgba(251,191,36,0.30), transparent 70%);"
							>
							</div>
							<div class="relative">
								<p class="text-4xl font-bold tracking-tighter sm:text-6xl md:text-7xl">{p.impact.featured.metric}</p>
								<p class="mt-4 text-sm font-semibold uppercase tracking-widest text-orange-400">{p.impact.featured.label}</p>
							</div>
							<p class="relative mt-10 max-w-xl text-base leading-relaxed text-zinc-400">{p.impact.featured.desc}</p>
						</div>

						<!-- Tarjetas 2 y 3 · Hardware / arquitectura (con icono técnico) -->
						{p.impact.items.map((item) => (
							<div class="flex flex-col justify-between rounded-3xl border border-zinc-200 bg-zinc-100 p-8 text-zinc-900 dark:border-white/10 dark:bg-[#1d1d1d] dark:text-secondary md:col-span-1">
								<div>
									{item.icon && (
										<span class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-zinc-200 bg-white text-zinc-600 dark:border-white/10 dark:bg-white/5 dark:text-zinc-400">
											{item.icon === 'cpu' && (
												<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
											)}
											{item.icon === 'server' && (
												<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
											)}
										</span>
									)}
									<p class="text-2xl font-bold tracking-tight md:text-3xl">{item.metric}</p>
									<p class="mt-2 text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">{item.label}</p>
								</div>
								<p class="mt-6 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">{item.desc}</p>
							</div>
						))}
					</div>
				</div>
			)}

		</section>

		<!-- ===================================================== -->
		<!-- 4b · NEXT CASE — Cierre + card del siguiente proyecto   -->
		<!-- ===================================================== -->
		<!-- Marcador de cierre -->
		<div class="border-t border-black/10 py-8 text-center dark:border-white/10">
			<span class="font-mono text-xs uppercase tracking-[0.3em] text-gray-600 dark:text-zinc-400">
				· Fin del caso de estudio ·
			</span>
		</div>

		<!-- Card del siguiente caso (todo el bloque es cliqueable) -->
		<section class="px-6 pb-24 pt-6">
			<a
				href={`/proyectos/${next.slug}`}
				data-magnetic-card
				class="group mx-auto block max-w-6xl rounded-3xl border border-black/10 bg-[#f4f4f5] p-8 transition-colors duration-300 hover:border-black/20 dark:border-white/10 dark:bg-[#1d1d1d] dark:hover:border-white/20 md:p-12"
			>
				<div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-center lg:gap-16">
					<!-- Izquierda · texto -->
					<div>
						<span class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-700 dark:text-orange-400">Siguiente Caso</span>
						<h2 class="mt-4 font-ClashDisplay text-3xl font-bold uppercase leading-[1.05] tracking-tight break-words sm:text-5xl text-gray-900 dark:text-secondary md:text-6xl">
							{next.title}
						</h2>
						<p class="mt-5 max-w-md text-sm leading-relaxed text-gray-600 dark:text-zinc-400 md:text-base">
							{next.intro.left}
						</p>

						{nextTags.length > 0 && (
							<div class="mt-6 flex flex-wrap gap-2">
								{nextTags.map((tag) => (
									<span class="rounded-full border border-black/10 bg-black/5 px-3.5 py-1.5 text-xs font-medium text-gray-700 dark:border-white/10 dark:bg-white/10 dark:text-gray-300">
										{tag}
									</span>
								))}
							</div>
						)}

						<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-secondary">
							Ver caso completo
							<svg class="h-4 w-4 text-orange-700 dark:text-orange-400 transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</span>
					</div>

                    <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-zinc-950">
                      <ProjectImage name={projectPresentation[next.slug].image} alt={projectPresentation[next.slug].alt} />
                    </div>
				</div>
			</a>
		</section>

		<!-- ===================================================== -->
		<!-- 5 · MEGA FOOTER (componente reutilizable)              -->
		<!-- ===================================================== -->
	</article></main>
	<MegaFooter />
</Layout>

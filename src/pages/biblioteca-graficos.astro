---
import Layout from '../layouts/Layout.astro';
import GraphicSample from '../components/graphics/GraphicSample.astro';
import GraphicResource from '../components/graphics/GraphicResource.astro';
import {graphicLibrary,graphicCategories,graphicReferences} from '../data/graphicLibrary';
const archived=[{id:'interfaces',label:'Mini interfaces'},{id:'orbitas',label:'Órbitas'},{id:'capas',label:'Capas concéntricas'}] as const;
---
<Layout title="Mich · Biblioteca de gráficos" description="Biblioteca interna de recursos visuales reutilizables." url={Astro.url.href} image="/author.png" noindex>
 <main class="library">
  <header><p class="library-label">Nuestro lenguaje gráfico</p><h1>Una base. Muchas formas.</h1><p>Capas de interfaz, vidrio suave y conexiones. Los gráficos de servicios son la base; los nuevos recursos comparten sus colores, profundidad e interacción.</p><a href="/preview-completo#servicios">Ver en servicios ↗</a></header>
  <section class="catalog" aria-labelledby="catalog-title"><div class="catalog-heading"><h2 id="catalog-title">Recursos reutilizables</h2><span data-resource-count>{graphicLibrary.length} recursos</span></div><div class="filters" aria-label="Filtrar recursos">{graphicCategories.map((category,i)=><button type="button" data-library-filter={category.id} aria-pressed={i===0}>{category.label}</button>)}</div><div class="resources">{graphicLibrary.map(entry=><article data-library-entry data-category={entry.category}><div class="samples"><GraphicSample entry={entry} tone="light"/><GraphicSample entry={entry} tone="dark"/></div><div class="resource-info"><h3>{entry.title}</h3><span>{entry.id}</span><a href={`/media/graphic-library/${entry.reference}`} target="_blank">Ver referencia ↗</a></div></article>)}</div></section>
  <details class="archive"><summary>Ensayos anteriores · conservar para reutilizar</summary>{archived.map(family=><div><h3>{family.label}</h3><div class="archive-grid">{[0,1,2].map(profile=><div class="archived-sample"><GraphicResource variant={family.id} profile={profile as 0|1|2}/></div>)}</div></div>)}</details>
  <details class="references"><summary>Referencias originales · {graphicReferences.length} capturas</summary><p class="reference-note">Las formas se adaptan a los colores del repo. Las referencias de composición y tipografía también se conservan aquí.</p><div class="references-grid">{graphicReferences.map(([label,file])=><figure><a href={`/media/graphic-library/${file}`} target="_blank"><img src={`/media/graphic-library/${file}`} alt={label} loading="lazy" width="640" height="320"/></a><figcaption>{label}</figcaption></figure>)}</div></details>
 </main>
</Layout>
<style>
 .library { max-width:1200px; margin:130px auto 60px; padding:0 24px; }header { margin-bottom:48px; max-width:820px; }.library-label { font:400 clamp(11px,.9vw,13px)/1.55 var(--font-note); color:var(--muted); }h1 { font:550 clamp(36px,5vw,60px)/1.1 var(--font-sans); letter-spacing:-.04em; margin:18px 0; }header>p:not(.library-label),.reference-note { color:var(--muted); font-size:16px; line-height:1.6; }header>a { display:inline-flex; align-items:center; min-height:44px; margin-top:16px; color:var(--accent); }h2 { font-size:28px; letter-spacing:-.03em; }.catalog-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:20px; }.catalog-heading>span { font:12px/1.3 var(--font-mono); color:var(--muted); }.filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px; }.filters button { min-height:44px; padding:10px 15px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:13px; }.filters button[aria-pressed=true] { color:var(--ink); background:var(--surface); border-color:color-mix(in srgb,var(--accent) 30%,var(--line)); }.resources { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }article { border:1px solid var(--line); border-radius:24px; overflow:hidden; }article[hidden] { display:none; }.samples { display:grid; grid-template-columns:1fr 1fr; }.resource-info { padding:18px 20px; display:grid; gap:8px; border-top:1px solid var(--line); }h3 { font-size:17px; font-weight:550; }.resource-info>span { color:var(--muted); font:10px/1.3 var(--font-mono); }.resource-info>a { min-height:32px; display:flex; align-items:center; color:var(--accent); font-size:12px; }.archive,.references { border-top:1px solid var(--line); padding-top:24px; margin-top:48px; }summary { cursor:pointer; font-size:20px; letter-spacing:-.02em; margin-bottom:24px; }.archive h3 { margin:24px 0 16px; }.archive-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }.archived-sample { border:1px solid var(--line); border-radius:20px; padding:20px; overflow:hidden; }.references-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:24px; }figure { border:1px solid var(--line); border-radius:18px; overflow:hidden; }img { width:100%; height:280px; object-fit:contain; background:var(--surface); }figcaption { padding:16px; font-size:14px; }
 @media(max-width:900px) { .resources { grid-template-columns:1fr; } }@media(max-width:600px) { .library { padding:0 16px; }.samples { grid-template-columns:1fr; }.archive-grid,.references-grid { grid-template-columns:1fr; }.catalog-heading { align-items:flex-start; }.catalog-heading>span { flex-shrink:0; padding-top:8px; }h2 { font-size:23px; } }
</style>
<script>
 const filters=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-library-filter]'));
 const entries=Array.from(document.querySelectorAll<HTMLElement>('[data-library-entry]'));
 const count=document.querySelector('[data-resource-count]');
 filters.forEach(button=>button.addEventListener('click',()=>{const category=button.dataset.libraryFilter;filters.forEach(choice=>choice.setAttribute('aria-pressed',String(choice===button)));let visible=0;entries.forEach(entry=>{const show=category==='all'||entry.dataset.category===category;entry.hidden=!show;if(show)visible++;});if(count)count.textContent=`${visible} recursos`; }));
</script>

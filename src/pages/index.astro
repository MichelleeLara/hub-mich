---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AboutStats from "../components/AboutStats.astro";
import ProjectsBento from "../components/ProjectsBento.astro";
import Trayectoria from "../components/Trayectoria.astro";
import SkillsStack from "../components/SkillsStack.astro";
import MegaFooter from "../components/MegaFooter.astro";
import ProjectBrief from "../components/ProjectBrief.astro";
import { Spotlight } from "../components/ui/Spotlight";

const meta = {
  title: 'Mich · Software Engineer — Diseño, ingeniería e IA para productos de impacto',
  description: 'Soy Mich. Combino diseño, ingeniería e IA para construir productos de impacto, bien pensados y fáciles de usar. Software Engineer con base en frontend (React, Next.js, Angular, TypeScript) y experiencia en backend, sistemas en tiempo real y firmware embebido. Construyo productos de punta a punta y lidero los equipos que los entregan.',
  image: 'https://itsmich.com.mx/OpenGraphl.png',
  url: 'https://itsmich.com.mx/',
};

---

<Layout {...meta}>

  <main
    class="home-content text-black dark:text-gray-300 transition-colors duration-300 pb-14 "
  >

    <div class="w-full rounded-md flex md:items-center md:justify-center bg-black-[#161616] antialiased bg-grid-white/[0.02] relative overflow-hidden">
      <Spotlight
        className=""
        fill="white"
      />
      <!-- Hero Section -->
       <Hero />

    </div>

    <!-- Sobre mí: stats + rostro de partículas -->
    <AboutStats />

    <!-- Proyectos: bento grid con glow magnético de partículas -->
    <ProjectsBento />

    <!-- Habilidades y Stack Técnico: tipografía gigante + marquee + bento -->
    <SkillsStack />

    <!-- Trayectoria: experiencia laboral (fondo claro, contrasta con el grid) -->
    <Trayectoria />

    <ProjectBrief />

  </main>

  <!-- Mega Footer (mismo que las páginas de detalle) -->
  <MegaFooter />
</Layout>


---
import ThemeToggle from "../components/Themetoggle";
import Layout from "../layouts/Layout.astro";
import { AnimateFragments } from "../components/Hero";
import Jobs from "../components/Jobs";
import Technologies from "../components/Technologies";
import { IconArrowRight,IconIdea, IconGroup, IconArrowRightUp, IconEyes, IconDownload, ConversationIcon, GeminiIcon, OpenAIIcon, FramerIcon, Figma, NextJS, TailwindIcon, ReactIcon, IconWhatsappT, IconTech, IconCloud, TypeScriptIcon, CloudFareIcons, GoogleIcon, GitIcon, GitHubIcon} from '../icons/Icons'
import TechFront from '../sections/TechFront'
import TechColaborate from '../sections/TechColaborate'
import TechCloud from '../sections/TechCloud'
import Particles from '../components/ui/Particles'
import React from "react";
import { IconWhatsapp } from "../icons/Icons";
import { IconLinkedin } from "../icons/Icons";
import Hero from "../components/Hero.astro";
import AboutStats from "../components/AboutStats.astro";
import ProjectsBento from "../components/ProjectsBento.astro";
import Trayectoria from "../components/Trayectoria.astro";
import SkillsStack from "../components/SkillsStack.astro";
import MegaFooter from "../components/MegaFooter.astro";
import { Spotlight } from "../components/ui/Spotlight";

const meta = {
  title: 'Mich · Frontend Engineer — Productos que resuelven, detalles que se notan',
  description: 'Soy Mich, Frontend Engineer. Diseño y construyo productos digitales que resuelven problemas de negocio y se sienten simples de usar.',
  image: 'https://hub-mich.vercel.app/OpenGraphl.png',
  url: 'https://hub-mich.vercel.app/',
};

---

<Layout {...meta}>

  <main
    class="min-h-screen text-black dark:text-gray-300 transition-colors duration-300 pb-14 "
  >

    <div class="w-full rounded-md flex md:items-center md:justify-center bg-black-[#161616] antialiased bg-grid-white/[0.02] relative overflow-hidden">
      <Spotlight
        className=""
        fill="white"
      />
      <!-- Hero Section -->
       <Hero />

    </div>

    <!-- Sobre mí: stats + rostro de partículas -->
    <AboutStats />

    <!-- Proyectos: bento grid con glow magnético de partículas -->
    <ProjectsBento />

    <!-- Habilidades y Stack Técnico: tipografía gigante + marquee + bento -->
    <SkillsStack />

    <!-- Trayectoria: experiencia laboral (fondo claro, contrasta con el grid) -->
    <Trayectoria />

  </main>

  <!-- Mega Footer (mismo que las páginas de detalle) -->
  <MegaFooter />
</Layout>

<style>
  .scroll_hide {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* Internet Explorer 10+ */
}

.scroll_hide::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Edge */
}


---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AboutStats from "../components/AboutStats.astro";
import ProjectsGallery from "../components/ProjectsGallery.astro";
import Trayectoria from "../components/Trayectoria.astro";
import Services from "../components/Services.astro";
import DifferenceOptions from "../components/DifferenceOptions.astro";
import SiteClosing from "../components/SiteClosing.astro";
import IosPointer from "../components/IosPointer.astro";
import { Spotlight } from "../components/ui/Spotlight";

const meta = {
  title: 'Mich · Product Engineer — Diseño, ingeniería e IA para productos de impacto',
  description: 'Soy Mich. Combino diseño, ingeniería e IA para construir productos de impacto, bien pensados y fáciles de usar. Product Engineer con base en frontend (React, Next.js, Angular, TypeScript) y experiencia en backend, sistemas en tiempo real y firmware embebido. Construyo productos de punta a punta y lidero los equipos que los entregan.',
  image: 'https://itsmich.com.mx/OpenGraphl.png',
  url: 'https://itsmich.com.mx/',
};

---

<Layout {...meta}>
  <IosPointer />
  <main class="home-content text-ink">

    <div class="w-full rounded-md flex md:items-center md:justify-center antialiased bg-grid-white/[0.02] relative overflow-hidden">
      <Spotlight
        className=""
        fill="white"
      />
      <!-- Hero Section -->
       <Hero />

    </div>

    <ProjectsGallery />
    <Services />
    <AboutStats />

    <DifferenceOptions variant="editorial" integrated id="por-que-conmigo" />

    <!-- Trayectoria: experiencia laboral (fondo claro, contrasta con el grid) -->
    <Trayectoria />

  </main>

  <SiteClosing />
</Layout>


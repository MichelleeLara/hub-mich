---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import AboutStats from "../components/AboutStats.astro";
import ProjectsWobble from "../components/ProjectsWobble.astro";
import Trayectoria from "../components/Trayectoria.astro";
import ServicesCompact from "../components/ServicesCompact.astro";
import DifferenceOptions from "../components/DifferenceOptions.astro";
import SiteClosing from "../components/SiteClosing.astro";
import RelaxSection from "../components/RelaxSection.astro";
import IosPointer from "../components/IosPointer.astro";
import { Spotlight } from "../components/ui/Spotlight";
import ModoHeader from "../components/negocio/ModoHeader.astro";
import NegocioHero from "../components/negocio/NegocioHero.astro";
import NegocioProblema from "../components/negocio/NegocioProblema.astro";
import NegocioIncluye from "../components/negocio/NegocioIncluye.astro";
import NegocioPasos from "../components/negocio/NegocioPasos.astro";
import NegocioOferta from "../components/negocio/NegocioOferta.astro";
import NegocioCierre from "../components/negocio/NegocioCierre.astro";
import "../styles/modo-negocio.css";

const meta = {
  title: 'Mich · Product Engineer — Diseño, ingeniería e IA para productos de impacto',
  description: 'Soy Mich. Combino diseño, ingeniería e IA para construir productos de impacto, bien pensados y fáciles de usar. Product Engineer con base en frontend (React, Next.js, Angular, TypeScript) y experiencia en backend, sistemas en tiempo real y firmware embebido. Construyo productos de punta a punta y lidero los equipos que los entregan.',
  image: 'https://itsmich.com.mx/OpenGraphl.png',
  url: 'https://itsmich.com.mx/',
};

---

<Layout {...meta}>
  <!-- Modo: ?modo= en la URL > localStorage('mich-modo') > negocio. Corre antes de pintar el contenido. -->
  <script is:inline>
    (function () {
      var m = null, q = null;
      try { q = new URLSearchParams(location.search).get('modo'); } catch (e) {}
      if (q === 'reclutador' || q === 'negocio') {
        m = q;
        try { localStorage.setItem('mich-modo', q); } catch (e) {}
      } else {
        try { m = localStorage.getItem('mich-modo'); } catch (e) {}
      }
      document.documentElement.dataset.modo = (m === 'reclutador') ? 'reclutador' : 'negocio';
    })();
  </script>
  <ModoHeader />
  <main class="home-content text-ink solo-negocio">
    <NegocioHero />
    <NegocioProblema />
    <NegocioIncluye />
    <NegocioPasos />
    <NegocioOferta />
    <NegocioCierre />
  </main>
  <div class="solo-reclutador">
  <IosPointer />
  <main class="home-content text-ink">

    <div class="w-full rounded-md flex md:items-center md:justify-center antialiased bg-grid-white/[0.02] relative overflow-hidden">
      <Spotlight
        className=""
        fill="white"
      />
      <!-- Hero Section -->
       <Hero />

    </div>

    <ProjectsWobble />
    <ServicesCompact />
    <AboutStats />

    <DifferenceOptions variant="editorial" integrated id="por-que-conmigo" />

    <!-- Trayectoria: experiencia laboral (fondo claro, contrasta con el grid) -->
    <Trayectoria />

    <!-- Un respiro: teclado mecánico interactivo antes del footer -->
    <RelaxSection />

  </main>

  <SiteClosing />
  </div>
</Layout>


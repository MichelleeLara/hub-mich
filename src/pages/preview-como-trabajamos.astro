---
import Layout from '../layouts/Layout.astro';
import WorkProcess from '../components/WorkProcess.astro';
import DifferenceArtwork from '../components/graphics/DifferenceArtwork.astro';
const steps = [
 { title: 'Aterrizamos tu idea.', text: 'Me cuentas qué quieres resolver. Definimos prioridades, alcance y una propuesta de trabajo.', result: 'Un plan claro para empezar.', short: 'Conversamos', artifact: 'Objetivo + alcance', variant: 'context' },
 { title: 'Le damos forma juntos.', text: 'Diseño y construyo por etapas. Revisamos avances para ajustar con tu feedback y tomar decisiones a tiempo.', result: 'Avances que puedes ver y probar.', short: 'Construimos', artifact: 'Diseño + desarrollo', variant: 'build' },
 { title: 'Lo ponemos en marcha.', text: 'Probamos los detalles y preparamos la entrega. Te acompaño en la puesta en marcha y definimos los siguientes pasos.', result: 'Tu producto listo para usarse.', short: 'Lanzamos', artifact: 'Pruebas + entrega', variant: 'build' },
] as const;
---
<Layout title="Mich · Cómo trabajaríamos · Propuestas" description="Propuestas de diseño para la sección Cómo trabajaríamos." image="/author.png" url={Astro.url.href} noindex navigation={false}>
 <main class="process-preview">
  <div class="preview-bar"><a href="/#por-que-conmigo">← Volver al inicio</a><span>Exploración de diseño · 4 propuestas</span></div>
  <h1>Así podría verse<br/>cómo trabajaríamos.</h1>
  <p class="page-intro">Cuatro formas de contar el mismo recorrido: de la primera conversación a un producto en marcha.</p>
  <nav aria-label="Ver propuestas"><a href="#propuesta-1">01 · Ruta clara</a><a href="#propuesta-2">02 · Acompañamiento</a><a href="#propuesta-3">03 · Del plan al producto</a><a href="#propuesta-4">04 · Un camino juntos</a></nav>

  <div class="proposal-label" id="propuesta-1"><span>PROPUESTA 01</span><p>Ruta clara · Tres pasos visibles de un vistazo.</p></div>
  <section class="route" aria-labelledby="route-title">
   <header><p class="note-label">Cómo trabajaríamos</p><h2 id="route-title">Tu idea, paso a paso.</h2><p>Un proceso claro, con espacio para conversar y construir juntos.</p></header>
   <ol class="route-grid">{steps.map((step,i)=><li><div class="step-line"><span>0{i+1}</span><i aria-hidden="true"></i></div><div class="art"><DifferenceArtwork variant={step.variant} id={`route-${i}`} /></div><h3>{step.title}</h3><p>{step.text}</p><div class="result"><span>Al cerrar esta etapa</span><strong>{step.result}</strong></div></li>)}</ol>
   <footer><p>Todo empieza con una conversación.</p><span class="cta">Cuéntame tu idea <b aria-hidden="true">↗</b></span></footer>
  </section>

  <div class="proposal-label" id="propuesta-2"><span>PROPUESTA 02</span><p>Acompañamiento · Más personal, con lectura editorial.</p></div>
  <section class="editorial" aria-labelledby="editorial-title">
   <header><p class="note-label">Cómo trabajaríamos</p><h2 id="editorial-title">Tú conoces tu negocio.<br/>Yo te ayudo<br/>a darle forma.</h2><p>Trabajamos de cerca, con avances visibles y decisiones compartidas.</p><div class="signature">De la primera idea<br/>a la puesta en marcha. <span aria-hidden="true">↘</span></div></header>
   <ol>{steps.map((step,i)=><li><span class="number">0{i+1}</span><div><h3>{step.title}</h3><p>{step.text}</p><strong class="inline-result">↳ {step.result}</strong></div></li>)}</ol>
   <footer><p>Me cuentas dónde estás. Definimos cómo avanzar.</p><span class="cta">Hablemos de tu proyecto <b aria-hidden="true">↗</b></span></footer>
  </section>

  <div class="proposal-label" id="propuesta-3"><span>PROPUESTA 03</span><p>Del plan al producto · El proceso contado a través de sus entregables.</p></div>
  <section class="workspace" aria-labelledby="workspace-title">
   <header><p class="note-label">Cómo trabajaríamos</p><h2 id="workspace-title">Siempre sabrás<br/>qué sigue.</h2><p>Una dirección compartida. Un resultado concreto en cada etapa.</p></header>
   <ol class="workspace-grid">{steps.map((step,i)=><li><div class="card-top"><span>0{i+1} / {step.short}</span><span aria-hidden="true">↗</span></div><div class:list={['artifact',`artifact-${i}`]} aria-hidden="true">{i===0?<div class="plan"><small>EL PUNTO DE PARTIDA</small><b>Una idea.<br/>Un objetivo claro.</b><span>✓ Prioridades</span><span>✓ Alcance acordado</span><span>✓ Propuesta de trabajo</span></div>:i===1?<div class="interface"><div class="window-bar"><i></i><i></i><i></i></div><div class="mini-ui"><div></div><div></div><div></div></div><span>Tu feedback → siguiente versión</span></div>:<div class="launch"><span class="check">✓</span><b>Listo para salir.</b><small>Probado · Entregado · En marcha</small></div>}</div><h3>{step.title}</h3><p>{step.text}</p><div class="deliverable"><span>Nos llevamos</span><strong>{step.artifact}</strong></div></li>)}</ol>
   <footer><p>¿Le damos forma a lo que tienes en mente?</p><span class="cta">Empecemos por tu idea <b aria-hidden="true">↗</b></span></footer>
  </section>

  <div class="proposal-label" id="propuesta-4"><span>PROPUESTA 04</span><p>Un camino juntos · Tres momentos conectados por una línea punteada.</p></div>
  <WorkProcess />
  <p class="preview-end">Vista de propuestas · Los botones de contacto son muestras visuales.</p>
 </main>
</Layout>
<style>
 .process-preview{max-width:1200px;margin:auto;padding:32px 32px 80px;color:var(--ink)}
 .preview-bar{display:flex;justify-content:space-between;gap:16px;font-size:13px;color:var(--muted)}.preview-bar a{min-height:44px;display:flex;align-items:center}.preview-bar span{align-self:center}
 h1{font-family:var(--font-display);font-size:clamp(36px,5vw,64px);line-height:1.04;letter-spacing:-.03em;margin:48px 0 20px}.page-intro{max-width:560px;color:var(--muted);font-size:18px;line-height:1.6}
 nav{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}nav a{padding:12px 20px;min-height:44px;border:1px solid var(--line);border-radius:99px;font-size:14px;background:var(--surface-glass)}a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}nav a:hover{color:var(--accent);border-color:var(--accent)}
 .proposal-label{scroll-margin-top:24px;margin:88px 0 48px;border-top:1px solid var(--line);padding-top:20px;display:flex;justify-content:space-between;gap:20px;align-items:center}.proposal-label>span{font:12px var(--font-mono);color:var(--accent);letter-spacing:.08em}.proposal-label p{font-size:13px;color:var(--muted)}
 section{padding:20px 0 0}header>p:not(.note-label){max-width:460px;color:var(--muted);font-size:17px;line-height:1.6;margin-top:20px}.note-label{font-size:12px;margin-bottom:24px}h2{font:600 clamp(32px,3.6vw,46px)/1.08 var(--font-display);letter-spacing:-.025em}h3{font:600 24px/1.15 var(--font-display);letter-spacing:-.02em;margin:0 0 16px}ol{list-style:none;padding:0;margin:0}li>p,li>div>p{font-size:16px;line-height:1.65;color:var(--muted)}
 .route-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:48px}.step-line{display:flex;align-items:center;gap:16px}.step-line span{font:13px var(--font-mono);color:var(--accent)}.step-line i{height:1px;flex:1;background:var(--line)}.art{height:180px;margin:8px 0 24px}.art :global(.difference-artwork){height:180px}.result{border-top:1px solid var(--line);margin-top:24px;padding-top:18px}.result span,.deliverable span{display:block;font-size:12px;color:var(--muted);margin-bottom:7px}.result strong{font-size:14px;font-weight:500}
 footer{display:flex;justify-content:space-between;align-items:center;gap:24px;border-top:1px solid var(--line);padding-top:24px;margin-top:44px}footer p{font-size:14px;color:var(--muted)}.cta{display:inline-flex;justify-content:center;align-items:center;gap:32px;background:var(--ink);color:var(--bg);padding:15px 24px;border-radius:99px;font-size:14px;font-weight:600}.cta b{font-size:20px;font-weight:400}
 .editorial{display:grid;grid-template-columns:1fr 1.15fr;gap:32px 80px}.editorial header>p{max-width:340px}.signature{font:12px/2 var(--font-note);color:var(--accent);margin-top:48px}.signature span{font:40px var(--font-sans);margin-left:16px}.editorial ol{border-top:1px solid var(--line)}.editorial li{display:grid;grid-template-columns:32px 1fr;gap:24px;padding:28px 0;border-bottom:1px solid var(--line)}.number{font:12px var(--font-mono);color:var(--accent);padding-top:5px}.inline-result{display:block;font-size:14px;color:var(--accent);font-weight:500;margin-top:16px}.editorial footer{grid-column:1/-1;margin-top:8px}
 .workspace header{display:grid;grid-template-columns:1fr 1fr;gap:0 40px}.workspace .note-label{grid-column:1/-1}.workspace header>p:not(.note-label){align-self:end;max-width:330px;justify-self:end}.workspace-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}.workspace-grid li{border:1px solid var(--line);border-radius:24px;padding:24px;background:var(--surface-glass);overflow:hidden}.card-top{display:flex;justify-content:space-between;gap:10px;font:12px var(--font-mono);color:var(--muted)}.artifact{height:210px;display:flex;align-items:center;justify-content:center;margin:18px -10px 28px;background:radial-gradient(ellipse at center,color-mix(in srgb,var(--accent) 9%,transparent),transparent 70%)}.plan{width:210px;display:grid;gap:8px;padding:20px;border:1px solid var(--line);background:var(--bg);border-radius:12px;transform:rotate(-5deg);box-shadow:var(--shadow-float)}.plan small{font:9px var(--font-mono);color:var(--muted)}.plan b{font:600 22px/1.1 var(--font-display);margin:4px 0 8px}.plan>span{font-size:12px;color:var(--muted)}.interface{width:235px;padding:14px;background:var(--bg);border:1px solid var(--line);border-radius:14px;transform:rotate(4deg);box-shadow:var(--shadow-float)}.window-bar{display:flex;gap:4px;padding-bottom:12px;border-bottom:1px solid var(--line)}.window-bar i{width:5px;height:5px;border-radius:50%;background:var(--line)}.mini-ui{display:grid;grid-template-columns:1fr 1.5fr;gap:8px;margin:12px 0}.mini-ui>div{height:40px;border-radius:6px;background:var(--accent-soft)}.mini-ui>div:first-child{grid-row:span 2;height:auto}.interface>span{font-size:11px;color:var(--accent)}.launch{display:grid;text-align:center;gap:14px;justify-items:center}.check{display:grid;place-items:center;width:68px;height:68px;border-radius:50%;background:var(--accent-soft);color:var(--accent);font-size:30px;border:1px solid var(--line)}.launch b{font:600 23px var(--font-display)}.launch small{font-size:11px;color:var(--muted)}.deliverable{margin-top:24px;padding-top:18px;border-top:1px solid var(--line)}.deliverable strong{font-size:14px;font-weight:500}.preview-end{margin:72px 0 0;text-align:center;color:var(--muted);font-size:13px}

 @media(max-width:767px){.process-preview{padding:20px 22px 56px}.preview-bar{flex-wrap:wrap;gap:0}h1{margin-top:32px}.proposal-label{margin:64px 0 32px;display:block}.proposal-label p{margin-top:12px}.route-grid,.workspace-grid{grid-template-columns:1fr;gap:32px}.route-grid{margin-top:32px}.art{height:160px}.art :global(.difference-artwork){height:160px}.editorial{grid-template-columns:1fr;gap:32px}.signature{display:none}.editorial footer{grid-column:auto}.workspace header{display:block}.workspace header>p:not(.note-label){max-width:100%}.workspace-grid li{padding:24px}.workspace-grid{gap:16px}.artifact{height:190px}footer{align-items:flex-start;flex-direction:column;gap:18px}.cta{width:100%}.editorial li{gap:16px}nav a{flex:1;text-align:center;white-space:nowrap}}
</style>

---
import Layout from '../../layouts/Layout.astro';
import MegaFooter from '../../components/MegaFooter.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArgymHeroMock from '../../components/audits/ArgymHeroMock.astro';
import BeforeAfter from '../../components/audits/BeforeAfter.astro';
import { audits } from '../../data/audits.js';

export function getStaticPaths() {
	return audits.map((a) => ({ params: { slug: a.slug }, props: { audit: a } }));
}

const { audit: a } = Astro.props;
// Cada auditoría puede traer su propuesta visual; la clave vive en audits.js.
const mocks = { argym: ArgymHeroMock };
const Mock = mocks[a.heroMock];
const waText = encodeURIComponent(`Hola Mich, vi la auditoría de ${a.negocio} y me gustaría platicarla.`);
---

<Layout
	title={`Auditoría de ${a.sitio} · Mich`}
	description={`Revisión de ${a.sitio}: qué funciona, qué frena las ventas y cómo resolverlo.`}
	image="/OpenGraphl.png"
	url={`https://itsmich.com.mx/auditorias/${a.slug}/`}
	noindex
>
	<main class="audit text-ink">
		<!-- Portada -->
		<header class="section-shell audit-hero">
			<p class="section-label note-label font-note">Auditoría para {a.negocio}</p>
			<h1>{a.titulo}</h1>
			<p class="audit-lead">{a.intro}</p>
			<p class="audit-meta">{a.sitio} · {a.fecha}</p>

			<dl class="audit-figures">
				{a.cifras.map((c) => (
					<div class="grain">
						<dt>{c.valor}</dt>
						<dd>{c.texto}</dd>
					</div>
				))}
			</dl>
		</header>

		<!-- Lo que ya funciona -->
		<section class="section-shell">
			<SectionHeading label="Lo que ya hacen bien" title="La base es sólida." />
			<ul class="audit-good">
				{a.bien.map((b) => (
					<li>
						<span class="audit-check" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
						</span>
						<h3>{b.titulo}</h3>
						<p>{b.texto}</p>
					</li>
				))}
			</ul>
		</section>

		<!-- Hallazgos -->
		<section class="section-shell">
			<SectionHeading label="Lo que encontré" title="Ocho detalles, ordenados por lo que más pesa en una venta." />
			<ol class="audit-findings">
				{a.hallazgos.map((h, i) => (
					<li class="audit-finding">
						<div class="audit-finding-head">
							<span class="audit-num">{String(i + 1).padStart(2, '0')}</span>
							<span class:list={['audit-priority', `is-${h.prioridad.toLowerCase()}`]}>Prioridad {h.prioridad.toLowerCase()}</span>
						</div>
						<h3>{h.titulo}</h3>
						<dl>
							<div><dt>Lo que se ve</dt><dd>{h.ve}</dd></div>
							<div><dt>Por qué importa</dt><dd>{h.importa}</dd></div>
							<div><dt>Cómo se arregla</dt><dd>{h.arreglo}</dd></div>
						</dl>
					</li>
				))}
			</ol>
		</section>

		<!-- Propuesta visual -->
		{Mock && (
			<section class="section-shell" id="propuesta">
				<SectionHeading label="Una idea para su portada" title="Misma marca, mejor primera impresión." />
				<p class="audit-section-lead">Sus colores, su tipografía y sus fotos. Solo cambia el orden: lo primero que se ve es qué venden, por qué comprarles y dónde hacer clic.</p>

				<div class="audit-compare">
					<BeforeAfter url={a.sitio} antes={a.antes} alt={a.antesAlt} label={`Comparar la portada actual de ${a.sitio} con la propuesta`}>
						<Mock />
					</BeforeAfter>
				</div>
			</section>
		)}

		<!-- Plan -->
		<section class="section-shell">
			<SectionHeading label="Cómo lo resolvería" title="En tres pasos, empezando por lo que más se nota." />
			<ol class="audit-plan">
				{a.plan.map((p) => (
					<li class="grain">
						<span class="audit-num">{p.paso}</span>
						<h3>{p.titulo}</h3>
						<p>{p.texto}</p>
					</li>
				))}
			</ol>
			<div class="audit-cta">
				<a class="btn btn-primary" href={`https://wa.me/525578934420?text=${waText}`}>
					Platiquemos por WhatsApp <span class="btn-arrow" aria-hidden="true">→</span>
				</a>
				<a class="btn btn-secondary" href={`mailto:mich.ia@hotmail.com?subject=${encodeURIComponent(`Auditoría ${a.negocio}`)}`}>Escribir por correo</a>
			</div>
			<p class="audit-method">{a.metodo}</p>
		</section>
	</main>
	<MegaFooter />
</Layout>

<style>
	.audit-hero { padding-top: calc(var(--section-y) + 40px); padding-bottom: var(--space-8); }
	.audit h1 { max-width: 16ch; margin: var(--space-4) 0 0; font: 600 var(--fs-h1)/1.02 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
	.audit-lead { max-width: 60ch; margin: var(--space-5) 0 0; color: var(--muted); font-size: var(--fs-lead); line-height: 1.6; }
	.audit-meta { margin: var(--space-4) 0 0; color: var(--subtle); font: 12px/1.4 var(--font-mono); letter-spacing: .04em; }
	.section-label { color: var(--muted); font-size: clamp(11px, .9vw, 13px); }

	.audit-figures { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin: var(--space-7) 0 0; }
	.audit-figures > div { padding: var(--space-5); border-radius: var(--radius-md); background: var(--surface); }
	.audit-figures dt { font: 600 clamp(32px, 3.4vw, 44px)/1 var(--font-display); letter-spacing: -.02em; }
	.audit-figures dd { margin: var(--space-3) 0 0; color: var(--muted); font-size: var(--fs-small); line-height: 1.5; }

	.audit-section-lead { max-width: 60ch; margin: var(--space-4) 0 0; color: var(--muted); line-height: 1.6; }

	.audit-good { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); margin: var(--space-7) 0 0; padding: 0; list-style: none; }
	.audit-good li { display: grid; grid-template-columns: 40px 1fr; column-gap: var(--space-4); }
	.audit-check { grid-row: span 2; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--accent-soft); color: var(--accent); }
	.audit-check svg { width: 20px; height: 20px; }
	.audit h3 { margin: 0; font: 600 var(--fs-h3)/1.2 var(--font-display); letter-spacing: -.02em; }
	.audit-good h3 { font-size: 20px; }
	.audit-good p { margin: var(--space-2) 0 0; color: var(--muted); line-height: 1.6; }

	.audit-findings { display: grid; gap: var(--space-4); margin: var(--space-7) 0 0; padding: 0; list-style: none; }
	.audit-finding { padding: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-lg); }
	.audit-finding-head { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
	.audit-num { color: var(--subtle); font: 12px/1 var(--font-mono); letter-spacing: .06em; }
	.audit-priority { padding: 5px 10px; border-radius: var(--radius-full); border: 1px solid var(--line); color: var(--muted); font-size: var(--fs-micro); font-weight: 600; letter-spacing: .04em; }
	.audit-priority.is-alta { border-color: transparent; background: var(--ink); color: var(--bg); }
	.audit-finding dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin: var(--space-5) 0 0; }
	.audit-finding dt { color: var(--subtle); font-size: var(--fs-caption); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
	.audit-finding dd { margin: var(--space-2) 0 0; color: var(--muted); font-size: 15px; line-height: 1.6; }

	.audit-compare { max-width: 960px; margin: var(--space-7) 0 0; }

	.audit-plan { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin: var(--space-7) 0 0; padding: 0; list-style: none; }
	.audit-plan li { padding: var(--space-6); border-radius: var(--radius-lg); background: var(--surface); }
	.audit-plan h3 { margin-top: var(--space-4); }
	.audit-plan p { margin: var(--space-2) 0 0; color: var(--muted); line-height: 1.6; }
	.audit-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-7) 0 0; }
	.audit-method { max-width: 60ch; margin: var(--space-5) 0 0; color: var(--subtle); font-size: var(--fs-small); line-height: 1.6; }

	@media (max-width: 900px) {
		.audit-figures { grid-template-columns: repeat(2, 1fr); }
		.audit-finding dl, .audit-plan, .audit-good { grid-template-columns: 1fr; }
	}
	@media (max-width: 767px) {
		.audit-hero { padding-top: calc(var(--section-y) + 24px); }
		.audit h1 { font-size: clamp(34px, 9vw, 44px); }
		.audit-figures { gap: var(--space-3); }
		.audit-figures > div { padding: var(--space-4); }
		.audit-figures dt { font-size: 30px; }
		.audit-finding { padding: var(--space-5); }
		.audit-cta .btn { width: 100%; }
	}
</style>

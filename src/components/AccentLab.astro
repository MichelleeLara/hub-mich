---
// Herramienta de desarrollo: prueba de acento en vivo. Claro siempre clay; en oscuro clay o azul A/B/C.
// Solo se monta en `npm run dev` (ver Layout.astro). No llega a producción.
const options = [
  { id: 'clay', label: 'Clay', swatch: '#efaa85' },
  { id: 'a', label: 'A', swatch: '#148cfa' },
  { id: 'b', label: 'B', swatch: '#4f8ff7' },
  { id: 'c', label: 'C', swatch: '#8ab4ff' },
];
---
<div class="accent-lab" role="group" aria-label="Probar color de acento (solo desarrollo)">
  <span class="accent-lab-title">Acento dark</span>
  {options.map(o => (
    <button type="button" data-accent-option={o.id} aria-pressed="false" title={`Acento ${o.label}`}>
      <span class="accent-lab-dot" style={`background:${o.swatch}`}></span>{o.label}
    </button>
  ))}
</div>

<script is:inline>
  (() => {
    const KEY = 'accent-lab';
    const root = document.documentElement;
    const apply = (id) => {
      if (id === 'clay') root.removeAttribute('data-accent'); else root.setAttribute('data-accent', id);
      document.querySelectorAll('[data-accent-option]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.accentOption === id)));
      try { localStorage.setItem(KEY, id); } catch {}
    };
    let saved = 'clay';
    try { saved = localStorage.getItem(KEY) || 'clay'; } catch {}
    apply(saved);
    document.querySelectorAll('[data-accent-option]').forEach(b => b.addEventListener('click', () => apply(b.dataset.accentOption)));
  })();
</script>

<style is:global>
  /* Propuesta: clay en claro, azul en oscuro. Una sola voz por modo:
     los paneles invertidos/oscuros usan el acento del modo de la página. */
  html.dark[data-accent="a"] { --accent: #148cfa; --accent-soft: #13263d; --accent-strong: #4aa3fb; --accent-deep: #cfe6ff; }
  html.dark[data-accent="b"] { --accent: #4f8ff7; --accent-soft: #1a2638; --accent-strong: #7aa9f9; --accent-deep: #d8e6ff; }
  html.dark[data-accent="c"] { --accent: #8ab4ff; --accent-soft: #1e2636; --accent-strong: #a9c8ff; --accent-deep: #e3edff; }
  html.dark[data-accent="a"] .theme-dark { --accent: #148cfa; --accent-soft: #13263d; }
  html.dark[data-accent="b"] .theme-dark { --accent: #4f8ff7; --accent-soft: #1a2638; }
  html.dark[data-accent="c"] .theme-dark { --accent: #8ab4ff; --accent-soft: #1e2636; }
  /* Footer en modo oscuro es claro: azul que pasa AA sobre blanco */
  html.dark[data-accent] .theme-inverse { --accent: #1d5fc4; --accent-soft: #e6eefb; }

  .accent-lab { position: fixed; left: 16px; bottom: 16px; z-index: 300; display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: var(--radius-full); background: var(--surface-glass); border: 1px solid var(--line); backdrop-filter: blur(12px); font: 500 var(--fs-caption)/1 var(--font-sans); color: var(--ink); }
  .accent-lab-title { padding: 0 8px 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .accent-lab button { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border-radius: var(--radius-full); color: var(--ink); }
  .accent-lab button[aria-pressed="true"] { background: var(--line); }
  .accent-lab-dot { width: 10px; height: 10px; border-radius: 50%; }
  @media (max-width: 767px) { .accent-lab { bottom: calc(env(safe-area-inset-bottom) + 88px); } }
</style>

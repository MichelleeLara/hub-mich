---
import MegaFooter from './MegaFooter.astro';
interface Props { option: '1' | '2' | '3'; id?: string; }
const { option, id = `contacto-${Astro.props.option}` } = Astro.props;
const paths = {
'1': 'M100 70C-100 360 140 690 390 520C640 350 380 180 420 400C460 680 970 710 1080 390C1190 70 880 40 880 300C880 560 1210 590 1360 250',
'2': 'M-140 180C120-30 470 80 500 330C530 570 240 570 350 410C470 220 840 360 920 590C1000 820 1260 860 1450 570',
'3': 'M-80 120C240-140 420 150 210 290C-20 440 0 680 280 710C640 750 730 530 1020 610C1300 690 1610 490 1280 330C980 180 1170-120 1480 40',
};
---
<div class:list={['footer-option','theme-inverse','grain',`option-${option}`]} id={id} data-contact-assistant data-context-title="Contacto">
<svg class="shared-ribbon" viewBox="0 0 1400 1000" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true"><path d={paths[option]} /></svg>
<section class="closing-message" aria-labelledby={`closing-title-${option}`}>
<div class="closing-copy">
<p class="closing-eyebrow note-label">El siguiente paso empieza con una conversación</p>
<h2 id={`closing-title-${option}`}>Démosle forma<br />a lo que sigue.</h2>
</div>
<div class="closing-action">
<a class="closing-button" data-umami-event="cuentame-tu-idea" data-umami-event-ubicacion="contacto" href="mailto:mich.ia@hotmail.com?subject=Una%20idea%20de%20producto">Cuéntame tu idea <span aria-hidden="true">↗</span></a>
<span class="closing-email">mich.ia@hotmail.com</span>
</div>
</section>
<MegaFooter compact seamless id={`footer-${option}`} />
</div>
<style>
.footer-option { position:relative; isolation:isolate; overflow:hidden; background:var(--bg); color:var(--ink); scroll-margin-top:100px; }
.shared-ribbon { position:absolute; inset:0; width:100%; height:100%; z-index:-1; pointer-events:none; stroke:var(--accent); stroke-width:62; stroke-linecap:round; opacity:.15; }
.closing-message { width:min(100%,var(--container)); margin:auto; padding:112px var(--gutter) 80px; text-align:center; }
.closing-eyebrow { width:fit-content; color:var(--muted); font:400 clamp(11px,.9vw,13px)/1.55 var(--font-note); letter-spacing:0; margin-bottom:14px; }
h2 { font:600 clamp(36px,4.8vw,64px)/1.06 var(--font-display); letter-spacing:-.012em; text-wrap:balance; }
.closing-action { margin-top:36px; }
.closing-button { display:inline-flex; align-items:center; justify-content:space-between; gap:48px; min-height:56px; padding:16px 24px; background:var(--ink); color:var(--bg); border-radius:var(--radius-full); font-size:var(--fs-body); }
.closing-button span { font-size:24px; }
.closing-email { display:block; margin-top:20px; font-size:var(--fs-small); color:var(--muted); }
.footer-option :global(.footer-seamless) { background:transparent; }
.footer-option.footer-option :global(.footer-seamless .footer-inner) { border-top:0; padding-top:32px; }
.footer-option :global(.mich-fill) { opacity:.5; }
.option-2 .closing-message { text-align:left; padding-top:104px; padding-bottom:104px; }
.option-2 h2 { max-width:840px; font-size:clamp(44px,6.5vw,88px); }
.option-2 .shared-ribbon { stroke-width:82; opacity:.12; }
.option-3 .closing-message { display:grid; grid-template-columns:1.4fr 1fr; align-items:end; gap:48px; padding-top:100px; padding-bottom:100px; text-align:left; }
.option-3 h2 { font-size:clamp(42px,5vw,68px); }
@media(min-width:1025px) { .option-3 h2 { font-size:clamp(44px,3.4vw,52px); } }
@media(max-width:767px) { .option-3 h2 { font-size:clamp(30px,8.5vw,36px); } }
.option-3 .closing-action { margin:0 0 6px; justify-self:end; }
.option-3 .shared-ribbon { stroke-width:46; opacity:.17; }
@media(max-width:767px) {
.closing-message,.option-2 .closing-message,.option-3 .closing-message { padding:72px var(--gutter) 48px; }
.closing-eyebrow { font-size:11px; max-width:300px; margin:0 auto var(--space-3); }
.option-2 .closing-eyebrow,.option-3 .closing-eyebrow { margin-left:0; }
.option-3 .closing-message { grid-template-columns:1fr; gap:28px; }
.option-3 .closing-action { justify-self:start; }
.closing-button { gap:36px; }
.shared-ribbon { width:160%; left:-30%; }
.footer-option.footer-option :global(.footer-seamless .footer-inner) { padding-top:24px; }
}
</style>

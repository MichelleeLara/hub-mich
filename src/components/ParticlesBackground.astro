---
// Fondo de "polvo estelar": miles de partículas diminutas agrupadas en una
// corriente orgánica (estilo nebulosa) que el cursor dispersa a su paso.
// En "Mi enfoque" (AboutStats) las mismas partículas se reclutan hacia los
// destinos que esa sección calcula por cuadro y forman la estructura.
//
// WebGL sin dependencias: cada partícula es un vértice con atributos fijos y
// todo el movimiento (deriva, destello, parallax, cursor, imán, formación) se
// resuelve en el vertex shader. La CPU solo actualiza unos uniforms por cuadro,
// así el fondo corre a la tasa del display sin competir con el scroll.
//
// ⚠️ El interruptor vive en src/config.ts (PARTICLES_ENABLED). Sin WebGL, con
// reduced-motion o si algo falla, el fondo no se pinta y "Mi enfoque" dibuja su
// propia figura (clase `particles-gl` en <html> = este motor está activo).
import { PARTICLES_ENABLED } from '../config';
---

{PARTICLES_ENABLED && <canvas id="particles-bg" aria-hidden="true"></canvas>}

<style>
  #particles-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<!-- El script vive fuera del condicional: dentro de una expresión JSX Astro
     no lo procesa (llegaría TypeScript crudo al navegador). Si el canvas no
     se renderizó, no hace nada. -->
<script>
  import { ENFOQUE_PARTICLE_EVENT, type EnfoqueParticleFrame } from '../lib/enfoqueParticles';
  const el = document.getElementById('particles-bg') as HTMLCanvasElement | null;
  if (el) {
    const initialize = () => start(el);
    if ('requestIdleCallback' in window) window.requestIdleCallback(initialize, { timeout: 1200 });
    else requestAnimationFrame(() => setTimeout(initialize, 0));
  }

  const VERTEX = `
    precision highp float;
    attribute vec2 aHome;    // hogar en px (viewport con scroll 0)
    attribute vec4 aSeed;    // fase, velocidad de deriva, amplitud, profundidad
    attribute vec3 aLook;    // tamaño, alpha, tipo (0 corriente, 1 ambiente)
    attribute vec4 aTarget;  // destino de "Mi enfoque": x, y, alpha, radio (z < 0 = sin destino)
    attribute float aTint;
    uniform vec2 uRes;
    uniform float uTime, uScroll, uScrollVel, uDpr, uDim, uBlend;
    uniform vec3 uMouse;     // x, y, fuerza (0 = sin cursor)
    uniform vec4 uMagnet;    // rect de la tarjeta magnética (x0, y0, x1, y1)
    uniform float uMagnetOn;
    varying float vAlpha, vTint;

    void main() {
      float phase = aSeed.x, speed = aSeed.y, amp = aSeed.z, depth = aSeed.w;
      float t = uTime * 0.0002 * speed + phase;
      // Deriva continua: el punto orbita lentamente alrededor de su hogar.
      vec2 p = aHome + vec2(sin(t), cos(t * 0.77 + phase * 1.7) * 0.8) * amp;
      // Parallax + estela: con scroll rápido el polvo se queda un poco atrás según su profundidad.
      p.y -= uScroll * 0.14 * depth - uScrollVel * depth;
      // El ambiente envuelve el viewport; la corriente se queda en el hero.
      if (aLook.z > 0.5) p.y = mod(p.y + 40.0, uRes.y + 80.0) - 40.0;

      float glow = 0.0;
      vec2 d = p - uMouse.xy;
      float dist = length(d);
      if (uMagnetOn > 0.5) {
        // Imán de borde: el polvo cercano al cursor se acumula fuera de la tarjeta.
        if (dist < 260.0) {
          float infl = 1.0 - dist / 260.0;
          vec2 b = clamp(p, uMagnet.xy, uMagnet.zw);
          if (b == p) {
            vec4 e = vec4(p.x - uMagnet.x, uMagnet.z - p.x, p.y - uMagnet.y, uMagnet.w - p.y);
            float m = min(min(e.x, e.y), min(e.z, e.w));
            if (m == e.x) b.x = uMagnet.x; else if (m == e.y) b.x = uMagnet.z; else if (m == e.z) b.y = uMagnet.y; else b.y = uMagnet.w;
          }
          b += sign(b - (uMagnet.xy + uMagnet.zw) * 0.5) * vec2(b.x == uMagnet.x || b.x == uMagnet.z ? 4.0 : 0.0, b.y == uMagnet.y || b.y == uMagnet.w ? 4.0 : 0.0);
          p = mix(p, b, infl * 0.75);
          glow = infl;
        }
      } else if (uMouse.z > 0.0 && dist < 130.0 && dist > 0.01) {
        // Dispersión con remolino tangencial: el cursor abre un claro que se cierra solo.
        float q = (130.0 - dist) / 130.0;
        vec2 n = d / dist;
        p += (n + vec2(-n.y, n.x) * 0.45) * q * q * 54.0 * uMouse.z;
      }

      float twinkle = 0.75 + 0.25 * sin(uTime * 0.001 * speed + phase);
      float a = aLook.y * uDim * twinkle;
      a = max(a * (1.0 + 2.4 * glow), 0.5 * glow);
      float size = aLook.x;
      float tint = 0.0;
      if (aTarget.z >= 0.0) {
        // Formación: la partícula viaja a su destino; sin muelles, sin rebote.
        // Llegadas escalonadas: cada grano entra con su propio retraso.
        float delay = fract(phase * 0.159) * 0.35;
        float k = smoothstep(delay, delay + 0.65, uBlend);
        p = mix(p, aTarget.xy, k);
        a = mix(a, aTarget.z, k);
        size = mix(size, aTarget.w * 2.0, k);
        tint = aTint * k;
      } else {
        a *= 1.0 - uBlend;
      }
      vAlpha = min(a, 1.0);
      vTint = tint;
      gl_Position = vec4(p / uRes * vec2(2.0, -2.0) + vec2(-1.0, 1.0), 0.0, 1.0);
      gl_PointSize = (size + 1.0) * uDpr;
    }
  `;

  const FRAGMENT = `
    precision mediump float;
    uniform vec3 uColor, uAccent;
    varying float vAlpha, vTint;
    void main() {
      // Grano redondo con borde suave (el +1 del tamaño es el antialias).
      float r = length(gl_PointCoord - 0.5) * 2.0;
      float a = vAlpha * (1.0 - smoothstep(0.55, 1.0, r));
      if (a < 0.004) discard;
      gl_FragColor = vec4(mix(uColor, uAccent, vTint) * a, a);
    }
  `;

  function start(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true, powerPreference: 'low-power' });
    if (!gl) { canvas.remove(); return; }

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader) || 'shader');
      return shader;
    };
    let program: WebGLProgram;
    try {
      program = gl.createProgram()!;
      gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));
      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program) || 'link');
    } catch (error) {
      console.warn('[particles] WebGL no disponible:', error);
      canvas.remove();
      return;
    }
    gl.useProgram(program);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    gl.clearColor(0, 0, 0, 0);

    const u = (name: string) => gl.getUniformLocation(program, name);
    const uni = {
      res: u('uRes'), time: u('uTime'), scroll: u('uScroll'), scrollVel: u('uScrollVel'), dpr: u('uDpr'), dim: u('uDim'), blend: u('uBlend'),
      mouse: u('uMouse'), magnet: u('uMagnet'), magnetOn: u('uMagnetOn'), color: u('uColor'), accent: u('uAccent'),
    };

    // --- Presupuesto por dispositivo -------------------------------------------
    // En GPU el coste por partícula es mínimo; el nivel solo ajusta densidad y DPR.
    const cores = navigator.hardwareConcurrency || 4;
    const memGB = (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 4;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const coarsePointer = matchMedia('(pointer: coarse)').matches;
    const smallScreen = innerWidth < 768;
    const tier: 'low' | 'mid' | 'high' =
      saveData || cores <= 4 || memGB <= 4 || (coarsePointer && smallScreen) ? 'low' : cores <= 8 || memGB <= 8 ? 'mid' : 'high';
    const TIER = { low: { scale: 0.5, dpr: 1.5 }, mid: { scale: 0.8, dpr: 2 }, high: { scale: 1, dpr: 2 } }[tier];
    // En táctiles, sin interacción la deriva baja a 30 fps (batería); nunca a menos.
    const idleThrottle = coarsePointer || smallScreen || Boolean(saveData);

    const AREA_PER_PARTICLE = 170;
    const MIN_COUNT = 900;
    const MAX_COUNT = 6000;
    const AMBIENT_RATIO = 0.14;
    const BASE_DIM = 0.35;
    const FIGURE_MIN = 1600;

    // --- Buffers -----------------------------------------------------------------
    const attrib = (name: string, size: number, buffer: WebGLBuffer) => {
      const loc = gl.getAttribLocation(program, name);
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, size, gl.FLOAT, false, 0, 0);
    };
    const homeBuf = gl.createBuffer()!, seedBuf = gl.createBuffer()!, lookBuf = gl.createBuffer()!;
    const targetBuf = gl.createBuffer()!, tintBuf = gl.createBuffer()!;
    let count = 0;
    let targets = new Float32Array(0);
    let tints = new Float32Array(0);

    const gauss = () => {
      let a = 0, b = 0;
      while (!a) a = Math.random();
      while (!b) b = Math.random();
      return Math.sqrt(-2 * Math.log(a)) * Math.cos(2 * Math.PI * b);
    };

    let w = 0, h = 0, dpr = 1;
    const rebuild = () => {
      // Nunca menos partículas que destinos de "Mi enfoque" (~1536): la figura conserva su detalle en móvil.
      count = Math.max(FIGURE_MIN, Math.round(Math.min(MAX_COUNT, Math.max(MIN_COUNT, (w * h) / AREA_PER_PARTICLE)) * TIER.scale));
      const home = new Float32Array(count * 2), seed = new Float32Array(count * 4), look = new Float32Array(count * 3);
      for (let i = 0; i < count; i++) {
        const ambient = Math.random() < AMBIENT_RATIO;
        let x: number, y: number, al: number;
        if (ambient) {
          x = Math.random() * w; y = Math.random() * h; al = 0.05 + Math.random() * 0.15;
        } else {
          // Corriente: bézier que entra arriba a la derecha y baja en diagonal, ensanchándose.
          const t = Math.random(), a = (1 - t) ** 2, b = 2 * (1 - t) * t, c = t * t;
          const cx = a * 0.68 * w + b * 0.74 * w + c * 0.42 * w;
          const cy = a * -0.08 * h + b * 0.55 * h + c * 1.15 * h;
          const spread = w * 0.05 * (0.55 + t * 1.4);
          x = cx + gauss() * spread; y = cy + gauss() * spread * 0.6;
          al = 0.12 + Math.random() ** 1.5 * 0.7;
        }
        const star = !ambient && Math.random() < 0.02;
        home[i * 2] = x; home[i * 2 + 1] = y;
        seed[i * 4] = Math.random() * Math.PI * 2;
        seed[i * 4 + 1] = 1 + Math.random() * 1.5;
        seed[i * 4 + 2] = 200 + Math.random() * 28;
        seed[i * 4 + 3] = 0.2 + Math.random() * 0.8;
        look[i * 3] = star ? 1.8 + Math.random() * 0.8 : 0.5 + Math.random() * 1.3;
        look[i * 3 + 1] = star ? 0.5 + Math.random() * 0.3 : al;
        look[i * 3 + 2] = ambient ? 1 : 0;
      }
      gl.bindBuffer(gl.ARRAY_BUFFER, homeBuf); gl.bufferData(gl.ARRAY_BUFFER, home, gl.STATIC_DRAW);
      gl.bindBuffer(gl.ARRAY_BUFFER, seedBuf); gl.bufferData(gl.ARRAY_BUFFER, seed, gl.STATIC_DRAW);
      gl.bindBuffer(gl.ARRAY_BUFFER, lookBuf); gl.bufferData(gl.ARRAY_BUFFER, look, gl.STATIC_DRAW);
      // Sin destino = z negativa. Los primeros slots se reasignan por cuadro.
      targets = new Float32Array(count * 4);
      for (let i = 0; i < count; i++) targets[i * 4 + 2] = -1;
      tints = new Float32Array(count);
      gl.bindBuffer(gl.ARRAY_BUFFER, targetBuf); gl.bufferData(gl.ARRAY_BUFFER, targets, gl.DYNAMIC_DRAW);
      gl.bindBuffer(gl.ARRAY_BUFFER, tintBuf); gl.bufferData(gl.ARRAY_BUFFER, tints, gl.DYNAMIC_DRAW);
      attrib('aHome', 2, homeBuf); attrib('aSeed', 4, seedBuf); attrib('aLook', 3, lookBuf);
      attrib('aTarget', 4, targetBuf); attrib('aTint', 1, tintBuf);
      slotsInUse = 0;
    };

    let lastW = -1, lastH = -1;
    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, TIER.dpr);
      const nw = innerWidth, nh = innerHeight;
      canvas.width = Math.round(nw * dpr);
      canvas.height = Math.round(nh * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      // La barra de direcciones móvil solo cambia la altura: no regenerar por eso.
      const onlyHeight = nw === lastW && Math.abs(nh - lastH) < lastH * 0.25;
      w = nw; h = nh;
      if (!onlyHeight) rebuild();
      lastW = nw; lastH = nh;
    };

    // --- Tema ---------------------------------------------------------------------
    const hex = (value: string) => {
      const c = value.trim().replace('#', '');
      return [0, 2, 4].map(o => parseInt(c.slice(o, o + 2), 16) / 255);
    };
    const syncTheme = () => {
      const dark = document.documentElement.classList.contains('dark');
      gl.uniform3fv(uni.color, dark ? [235 / 255, 235 / 255, 240 / 255] : [25 / 255, 25 / 255, 30 / 255]);
      gl.uniform3fv(uni.accent, hex(getComputedStyle(document.documentElement).getPropertyValue('--accent-strong')));
    };

    // --- "Mi enfoque": destinos por cuadro -----------------------------------------
    let enfoque: EnfoqueParticleFrame = { points: [], strength: 0 };
    let enfoqueBlend = 0;
    let slotsInUse = 0;
    let targetsDirty = false;
    document.addEventListener(ENFOQUE_PARTICLE_EVENT, event => {
      const next = (event as CustomEvent<EnfoqueParticleFrame>).detail;
      enfoque = next.points.length ? next : { points: enfoque.points, strength: 0 };
      targetsDirty = true;
      wake();
    });
    const uploadTargets = () => {
      if (!targetsDirty) return;
      targetsDirty = false;
      // Si hay menos partículas que destinos, se reparten parejo por toda la figura.
      const total = enfoque.points.length, n = Math.min(total, count);
      for (let i = 0; i < n; i++) {
        const p = enfoque.points[Math.floor(i * total / n)];
        targets[i * 4] = p.x; targets[i * 4 + 1] = p.y; targets[i * 4 + 2] = p.alpha; targets[i * 4 + 3] = p.radius;
        tints[i] = p.tint;
      }
      // Los slots que dejaron de usarse vuelven al campo libre.
      for (let i = n; i < slotsInUse; i++) { targets[i * 4 + 2] = -1; tints[i] = 0; }
      const used = Math.max(n, slotsInUse);
      slotsInUse = n;
      if (!used) return;
      gl.bindBuffer(gl.ARRAY_BUFFER, targetBuf); gl.bufferSubData(gl.ARRAY_BUFFER, 0, targets.subarray(0, used * 4));
      gl.bindBuffer(gl.ARRAY_BUFFER, tintBuf); gl.bufferSubData(gl.ARRAY_BUFFER, 0, tints.subarray(0, used));
    };

    // --- Cursor e imán --------------------------------------------------------------
    // El cursor se sigue casi en directo (respuesta ~40 ms): el polvo reacciona a la mano.
    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999, speed: 0, active: false, force: 0 };
    const hoverCapable = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let magnetCard: Element | null = null;

    // --- Bucle ------------------------------------------------------------------------
    const motionMedia = matchMedia('(prefers-reduced-motion: reduce)');
    const blocked = () => motionMedia.matches || document.hidden
      || document.documentElement.classList.contains('motion-paused')
      || document.documentElement.classList.contains('project-preview-open');
    let rafId = 0, lastTime = 0, lastFrame = 0, lastInteraction = performance.now(), frames = 0;
    let lastScroll = scrollY, scrollVel = 0;

    const render = (time: number, dt: number) => {
      const ease = 1 - Math.exp(-dt / 40);
      const prevX = mouse.x, prevY = mouse.y;
      mouse.x += (mouse.tx - mouse.x) * ease;
      mouse.y += (mouse.ty - mouse.y) * ease;
      const speed = mouse.active ? Math.hypot(mouse.x - prevX, mouse.y - prevY) / (dt / 16.67) : 0;
      mouse.speed += (speed - mouse.speed) * (1 - Math.exp(-dt / 80));
      // Moverlo abre el polvo; quieto, el claro se cierra poco a poco.
      const forceTarget = mouse.active ? 0.3 + 0.7 * Math.min(1, mouse.speed / 18) : 0;
      mouse.force += (forceTarget - mouse.force) * (1 - Math.exp(-dt / (forceTarget > mouse.force ? 60 : 420)));

      // Velocidad de scroll suavizada (~120 ms): alimenta la estela, que se asienta sola al parar.
      const scrollNow = scrollY;
      const vel = Math.max(-1, Math.min(1, (scrollNow - lastScroll) / dt * 16.67 / 60)) * 28;
      lastScroll = scrollNow;
      scrollVel += (vel - scrollVel) * (1 - Math.exp(-dt / 120));

      enfoqueBlend += (enfoque.strength - enfoqueBlend) * (1 - Math.exp(-dt / 140));
      if (enfoqueBlend < 0.001) enfoqueBlend = 0;
      uploadTargets();

      let magnetOn = 0;
      if (hoverCapable && magnetCard && mouse.active && enfoqueBlend < 0.3) {
        const r = magnetCard.getBoundingClientRect();
        gl.uniform4f(uni.magnet, r.left, r.top, r.right, r.bottom);
        magnetOn = 1;
      }

      gl.uniform2f(uni.res, w, h);
      gl.uniform1f(uni.time, time);
      gl.uniform1f(uni.scroll, scrollNow);
      gl.uniform1f(uni.scrollVel, scrollVel);
      gl.uniform1f(uni.dpr, dpr);
      gl.uniform1f(uni.dim, BASE_DIM);
      gl.uniform1f(uni.blend, enfoqueBlend);
      gl.uniform3f(uni.mouse, mouse.x, mouse.y, mouse.force);
      gl.uniform1f(uni.magnetOn, magnetOn);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.POINTS, 0, count);
      frames++;
    };

    const step = (time: number) => {
      if (blocked()) { rafId = 0; return; }
      rafId = requestAnimationFrame(step);
      const interacting = time - lastInteraction < 1200 || enfoqueBlend > 0 || enfoque.strength > 0 || mouse.force > 0.01 || Math.abs(scrollVel) > 0.05;
      if (idleThrottle && !interacting && time - lastFrame < 1000 / 30 - 2) return;
      const dt = Math.min(time - lastTime, 50) || 16.67;
      lastTime = lastFrame = time;
      render(time, dt);
    };

    function wake() {
      lastInteraction = performance.now();
      if (!rafId && !blocked()) {
        lastTime = lastFrame = performance.now();
        rafId = requestAnimationFrame(step);
      }
    }

    const resumeMotion = () => {
      const off = blocked();
      canvas.style.display = off ? 'none' : '';
      if (canvas.isConnected) document.documentElement.classList.toggle('particles-gl', !motionMedia.matches);
      if (off) { cancelAnimationFrame(rafId); rafId = 0; }
      else wake();
    };

    // Estado de depuración (consola: __particlesState)
    Object.defineProperty(window, '__particlesState', {
      get: () => ({ renderer: 'webgl', tier, count, slots: slotsInUse, blend: +enfoqueBlend.toFixed(3), running: Boolean(rafId), frames }),
      configurable: true,
    });

    // --- Listeners ----------------------------------------------------------------------
    syncTheme();
    resize();

    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => { resize(); wake(); }, 150);
    });
    addEventListener('scroll', wake, { passive: true });
    new MutationObserver(() => { syncTheme(); resumeMotion(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('motionchange', resumeMotion);
    document.addEventListener('visibilitychange', resumeMotion);
    motionMedia.addEventListener('change', resumeMotion);

    const release = () => { mouse.active = false; mouse.tx = mouse.ty = mouse.x = mouse.y = -9999; };
    addEventListener('pointermove', e => {
      if (e.pointerType !== 'mouse') return;
      mouse.tx = e.clientX; mouse.ty = e.clientY;
      if (!mouse.active) { mouse.x = e.clientX; mouse.y = e.clientY; mouse.active = true; }
      wake();
    }, { passive: true });
    // window no emite pointerleave: el cursor sale cuando un mouseout no tiene destino.
    document.addEventListener('mouseout', e => { if (!e.relatedTarget) release(); });
    const releaseTouch = (e: PointerEvent) => { if (e.pointerType !== 'mouse') release(); };
    addEventListener('pointerup', releaseTouch, { passive: true });
    addEventListener('pointercancel', releaseTouch, { passive: true });
    if (hoverCapable) {
      document.addEventListener('pointerover', e => {
        magnetCard = (e.target as Element | null)?.closest?.('[data-magnetic-card]') ?? null;
      }, { passive: true });
    }

    // Si la GPU pierde el contexto, el fondo se retira y "Mi enfoque" vuelve a su figura propia.
    canvas.addEventListener('webglcontextlost', () => {
      cancelAnimationFrame(rafId); rafId = 0;
      canvas.remove();
      document.documentElement.classList.remove('particles-gl');
    });

    resumeMotion();
  }
</script>

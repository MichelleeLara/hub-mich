---
// Fondo de "polvo estelar": miles de partículas diminutas agrupadas en una
// corriente orgánica (estilo nebulosa) que el cursor dispersa a su paso.
// Fase 2: al llegar a la sección #face-anchor (Sobre mí), las partículas se
// reclutan en cascada hacia puntos muestreados del ilustración y forman el
// composición; el scroll dirige la formación (scrubbing) y al salir se dispersan.
// Canvas 2D vanilla, sin dependencias.
//
// ⚠️ El interruptor vive en src/config.ts (PARTICLES_ENABLED). AboutStats
// siempre pinta la figura estática; este script la oculta (clase
// `particles-live` en <html>) solo cuando el composición de partículas está listo.
// Sin JS, con reduced-motion o si algo falla, la figura queda visible.
import { PARTICLES_ENABLED } from '../config';
---

{PARTICLES_ENABLED && <canvas id="particles-bg" aria-hidden="true"></canvas>}

<style>
  #particles-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<!-- El script vive fuera del condicional: dentro de una expresión JSX Astro
     no lo procesa (llegaría TypeScript crudo al navegador). Si el canvas no
     se renderizó, no hace nada. -->
<script>
  import { ideaPoints, ideaAspect, ideaFlowPoint } from '../data/ideasGeometry';
  const el = document.getElementById('particles-bg') as HTMLCanvasElement | null;
  if (el) start(el);

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;

    const motionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Presupuesto de rendimiento ------------------------------------------
    // El fondo es decorativo: nunca debe competir con el contenido. Se adapta al
    // dispositivo en tres niveles y, si el coste real por frame se pasa del
    // presupuesto, recorta partículas en caliente sin reconstruir nada.
    const cores = navigator.hardwareConcurrency || 4;
    // deviceMemory (GB) solo existe en Chromium; se asume 4 donde no esté.
    const memGB = (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 4;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
    const smallScreen = window.innerWidth < 768;

    const tier: 'low' | 'mid' | 'high' =
      saveData || cores <= 4 || memGB <= 4 || (coarsePointer && smallScreen)
        ? 'low'
        : cores <= 8 || memGB <= 8
          ? 'mid'
          : 'high';

    // Escala del conteo, FPS máximos y DPR por nivel. En 120Hz se limita a 60:
    // un fondo de polvo no gana nada a más cuadros y cuesta el doble.
    const TIER = {
      low: { scale: 0.35, fps: 30, dpr: 1.5 },
      mid: { scale: 0.65, fps: 60, dpr: 2 },
      high: { scale: 1, fps: 60, dpr: 2 },
    }[tier];

    // --- Configuración -------------------------------------------------------
    const AREA_PER_PARTICLE = 170; // px² por partícula (menor = más denso)
    const MIN_COUNT = 900;
    const MAX_COUNT = 6000;
    const AMBIENT_RATIO = 0.14; // fracción de polvo suelto por todo el viewport
    const SPRING = 0.012; // fuerza de regreso al hogar
    const DAMPING = 0.9;
    const MOUSE_RADIUS = 130; // radio de dispersión del cursor
    const MOUSE_FORCE = 2.4;
    // Fracción tangencial del empuje: el cursor deja una estela en remolino en
    // vez de un simple agujero.
    const MOUSE_SWIRL = 0.45;
    // El empuje crece con la velocidad del cursor: moverlo abre el polvo y,
    // quieto, el hueco se vuelve a llenar poco a poco.
    const MOUSE_REST = 0.3;
    const MOUSE_SPEED_FULL = 18; // px/frame para empuje completo
    const SCROLL_PARALLAX = 0.14;
    // Atenuación global fuera de la sección del composición: el polvo queda como
    // textura casi imperceptible y recupera opacidad plena al formarse el composición.
    const BASE_DIM = 0.35;
    // Partículas de reserva: invisibles y sin física fuera del composición; se
    // materializan durante la formación para duplicar la resolución del ilustración.
    const RESERVE_AREA = 220; // px² por partícula de reserva
    const RESERVE_MAX = 6000;
    // Formación en cascada: cada partícula arranca con un retraso propio dentro
    // de este rango del progreso global, así el composición "se teje" y no salta.
    const FACE_STAGGER = 0.45;
    // Margen fuera de pantalla en el que la corriente sigue simulándose
    const CULL_MARGIN = 420;
    // Cuantización del alpha para pintar por lotes (menos cambios de estado)
    const ALPHA_BUCKETS = 24;

    // --- Tarjetas magnéticas (sección Proyectos) -------------------------------
    // Al hacer hover sobre un elemento [data-magnetic-card], el polvo cercano
    // al cursor es atraído hacia el borde de esa tarjeta y se acumula ahí
    // (glow de borde). Solo con cursor real: en táctiles queda desactivado.
    const MAGNET_RADIUS = 260;
    const MAGNET_PULL = 0.05;
    const MAGNET_GLOW = 2.4;
    const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let magnetCard: Element | null = null;
    const magnetRect = { x: 0, y: 0, w: 0, h: 0, active: false };

    // --- Estado (structure-of-arrays) -----------------------------------------
    // Miles de partículas como objetos generan basura y fallos de caché; en
    // arrays tipados el bucle caliente recorre memoria contigua.
    const KIND_STREAM = 0;
    const KIND_AMBIENT = 1;
    const KIND_RESERVE = 2;

    let cap = 0; // capacidad total (principal + reservas)
    let mainCount = 0; // [0, mainCount) = corriente + ambiente, mezclados
    let reserveCount = 0; // [mainCount, mainCount + reserveCount) = reservas
    let activeMain = 0; // recortables en caliente por la degradación
    let activeReserve = 0;

    let hx = new Float32Array(0);
    let hy = new Float32Array(0);
    let px = new Float32Array(0);
    let py = new Float32Array(0);
    let vx = new Float32Array(0);
    let vy = new Float32Array(0);
    let size = new Float32Array(0);
    let alpha = new Float32Array(0);
    let depth = new Float32Array(0);
    let phase = new Float32Array(0);
    let tw = new Float32Array(0);
    let amp = new Float32Array(0);
    let mg = new Float32Array(0); // 0..1 — influencia magnética (glow de borde)
    let fx = new Float32Array(0); // punto del composición normalizado (-1 = sin asignar)
    let fy = new Float32Array(0);
    let fa = new Float32Array(0); // alpha objetivo dentro del composición
    let delay = new Float32Array(0); // retraso de formación (cascada)
    let kind = new Uint8Array(0);
    // Buffers de pintado por frame
    let sy = new Float32Array(0); // y en pantalla
    let drawA = new Float32Array(0);
    let formWeight = new Float32Array(0);
    let bucketOf = new Uint8Array(0);
    let order = new Uint32Array(0);
    const bucketCount = new Uint32Array(ALPHA_BUCKETS + 1);
    const bucketStart = new Uint32Array(ALPHA_BUCKETS + 1);

    let w = 0;
    let h = 0;
    let rafId = 0;
    let lastTime = 0;

    // Progreso de formación del composición (0 = polvo libre, 1 = composición formado).
    const leased = new Set<number>();
    let particleEpoch = 0;
    let faceEase = 0;
    let structureFlow = 0, structureFlowTarget = 0;
    let facePointsReady = false;
    let faceAspect = 1;
    let pickFacePoint: (() => { x: number; y: number; a: number; birth: number }) | null = null;

    const mouse = { x: -9999, y: -9999, tx: -9999, ty: -9999, speed: 0, active: false };

    // --- Tema ----------------------------------------------------------------
    let rgb = '235, 235, 240';
    const syncTheme = () => {
      rgb = document.documentElement.classList.contains('dark') ? '235, 235, 240' : '25, 25, 30';
      if (reduceMotion) draw(0);
    };
    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    // --- Muestreo de la corriente --------------------------------------------
    const gauss = () => {
      let u = 0;
      let v = 0;
      while (!u) u = Math.random();
      while (!v) v = Math.random();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    };

    // Curva bézier cuadrática que define el eje de la corriente de polvo:
    // entra por arriba a la derecha y fluye en diagonal hacia abajo al centro.
    const streamPoint = (t: number) => {
      const p0x = 0.68 * w, p0y = -0.08 * h;
      const p1x = 0.74 * w, p1y = 0.55 * h;
      const p2x = 0.42 * w, p2y = 1.15 * h;
      const a = (1 - t) * (1 - t);
      const b = 2 * (1 - t) * t;
      const c = t * t;
      return { x: a * p0x + b * p1x + c * p2x, y: a * p0y + b * p1y + c * p2y };
    };

    const spawn = (i: number, k: number) => {
      let x: number;
      let y: number;
      let al: number;
      if (k === KIND_STREAM) {
        const t = Math.random();
        const p = streamPoint(t);
        // La corriente se ensancha conforme baja, como polvo que se abre
        const width = w * 0.05 * (0.55 + t * 1.4);
        x = p.x + gauss() * width;
        y = p.y + gauss() * width * 0.6;
        // Sesgada: muchas tenues, pocas brillantes
        al = 0.12 + Math.random() ** 1.5 * 0.7;
      } else {
        x = Math.random() * w;
        y = Math.random() * h;
        al = 0.05 + Math.random() * 0.15;
      }
      const star = k === KIND_STREAM && Math.random() < 0.02; // destellos ocasionales
      hx[i] = px[i] = x;
      hy[i] = py[i] = y;
      vx[i] = vy[i] = 0;
      size[i] = star ? 1.8 + Math.random() * 0.8 : 0.5 + Math.random() * 1.3;
      alpha[i] = star ? 0.5 + Math.random() * 0.3 : al;
      depth[i] = 0.2 + Math.random() * 0.8;
      phase[i] = Math.random() * Math.PI * 2;
      tw[i] = 1 + Math.random() * 1.5;
      amp[i] = 200 + Math.random() * 28;
      mg[i] = 0;
      fx[i] = fy[i] = -1;
      fa[i] = 0;
      delay[i] = Math.random() * FACE_STAGGER;
      kind[i] = k;
    };

    let baseFY = new Float32Array(0);
    const assignFaceTargets = () => {
      if (!pickFacePoint) return;
      const count = Math.min(960, cap);
      let next = 0;
      for (let i = 0; i < cap; i++) {
        if (i !== Math.floor(next * cap / count) || next >= count) { fx[i] = fy[i] = -1; fa[i] = 0; continue; }
        const point = ideaPoints[Math.floor(next * ideaPoints.length / count)];
        fx[i] = point.x; fy[i] = point.y; baseFY[i] = point.baseY;
        fa[i] = point.outer ? .76 : .44;
        delay[i] = point.birth;
        next++;
      }
    };

    // Native geometry shares its static fallback; no portrait or image sampling.
    const sampleFace = () => {
      faceAspect = ideaAspect;
      pickFacePoint = () => {
        const point = ideaPoints[Math.floor(Math.random() * ideaPoints.length)];
        return { x: point.x, y: point.y, a: point.outer ? .70 + Math.random() * .12 : .20 + Math.random() * .12, birth: point.birth };
      };
      assignFaceTargets(); facePointsReady = true;
      document.documentElement.classList.add('particles-build-ready');
    };

    const alloc = (n: number) => {
      cap = n;
      hx = new Float32Array(n); hy = new Float32Array(n);
      px = new Float32Array(n); py = new Float32Array(n);
      vx = new Float32Array(n); vy = new Float32Array(n);
      size = new Float32Array(n); alpha = new Float32Array(n);
      depth = new Float32Array(n); phase = new Float32Array(n);
      tw = new Float32Array(n); amp = new Float32Array(n);
      mg = new Float32Array(n);
      fx = new Float32Array(n); fy = new Float32Array(n); fa = new Float32Array(n);
      delay = new Float32Array(n);
      baseFY = new Float32Array(n);
      kind = new Uint8Array(n);
      sy = new Float32Array(n); drawA = new Float32Array(n); formWeight = new Float32Array(n);
      bucketOf = new Uint8Array(n); order = new Uint32Array(n);
    };

    const rebuild = () => {
      leased.clear(); particleEpoch++;
      const budget = TIER.scale;
      mainCount = Math.round(
        Math.min(MAX_COUNT * budget, Math.max(MIN_COUNT * budget, ((w * h) / AREA_PER_PARTICLE) * budget)),
      );
      reserveCount = Math.round(Math.min(RESERVE_MAX * budget, ((w * h) / RESERVE_AREA) * budget));
      alloc(mainCount + reserveCount);
      // Corriente y ambiente mezclados al azar: recortar el final del rango
      // (degradación) conserva la proporción entre ambos.
      for (let i = 0; i < mainCount; i++) spawn(i, Math.random() < AMBIENT_RATIO ? KIND_AMBIENT : KIND_STREAM);
      for (let i = mainCount; i < cap; i++) spawn(i, KIND_RESERVE);
      activeMain = Math.round(mainCount * perfScale);
      activeReserve = Math.round(reserveCount * perfScale);
      assignFaceTargets();
    };

    let lastW = -1;
    let lastH = -1;
    const resize = () => {
      // Cap de DPR: en pantallas 3x se pintarían 9 píxeles por píxel CSS.
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const nw = window.innerWidth;
      const nh = window.innerHeight;
      canvas.width = Math.round(nw * dpr);
      canvas.height = Math.round(nh * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // En móviles la barra de direcciones cambia solo la altura: no vale la
      // pena regenerar miles de partículas (y verlas "saltar") por eso.
      const onlyHeight = nw === lastW && Math.abs(nh - lastH) < lastH * 0.25;
      w = nw;
      h = nh;
      if (!onlyHeight) rebuild();
      lastW = nw;
      lastH = nh;
    };

    // --- Progreso y caja del composición (por frame) --------------------------------
    let anchorEl: HTMLElement | null = null;

    const smooth = (e0: number, e1: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
      return t * t * (3 - 2 * t);
    };

    // Caja destino del composición en coordenadas de pantalla, ajustada al anchor
    const faceBox = { x: 0, y: 0, w: 0, h: 0 };
    let faceDX = 0, faceDY = 0, previousScroll = window.scrollY;
    const quintic = (t: number) => t*t*t*(t*(t*6-15)+10);

    let buildStage = -1, buildPercent = -1;
    const updateBuildState = (progress: number) => {
      const percent = Math.round(progress * 100);
      document.querySelector<HTMLElement>('[data-build-progress]')?.style.setProperty('--build-progress', String(progress));
      if (percent !== buildPercent) {
        buildPercent = percent;
        const label = document.querySelector('[data-build-percent]');
        if (label) label.textContent = `${percent}%`;
      }
      const next = progress < .30 ? 0 : progress < .72 ? 1 : 2;
      if (next === buildStage) return;
      buildStage = next;
      document.querySelectorAll('[data-build-stage]').forEach((node,i) => {
        if (i === next) node.setAttribute('aria-current','step'); else node.removeAttribute('aria-current');
      });
    };
    const updateFace = (dt: number) => {
      if (!anchorEl || !anchorEl.isConnected) anchorEl = document.getElementById('face-anchor');
      let target = 0;
      if (anchorEl && facePointsReady) {
        const r = anchorEl.getBoundingClientRect();
        const runway = document.getElementById('about-build-scroll');
        const grid = runway?.querySelector<HTMLElement>('.about-grid');
        const figure = runway?.querySelector<HTMLElement>('.portrait-study');
        const copy = runway?.querySelector<HTMLElement>('.about-copy');
        if (runway && grid && figure && copy) {
          const mobile = window.matchMedia('(max-width: 767px)').matches;
          const pinned = mobile ? figure : grid;
          const pinTop = parseFloat(getComputedStyle(pinned).top) || 0;
          const startOffset = mobile ? copy.getBoundingClientRect().height + 48 : 0;
          const box = runway.getBoundingClientRect();
          const travel = box.height - startOffset - pinned.getBoundingClientRect().height;
          // Last quarter of native scroll runs a complete signal through the built structure.
          const sectionProgress = Math.max(0, Math.min(1, (pinTop-box.top-startOffset)/Math.max(1,travel)));
          target = Math.min(1, sectionProgress/.75);
          structureFlowTarget = Math.max(0, (sectionProgress-.75)/.25);
          if (r.bottom <= 0 || r.top >= h) target = 0;
        }

        // Encaje "contain" del ilustración dentro del anchor
        let fw = r.width;
        let fh = fw * faceAspect;
        if (fh > r.height) {
          fh = r.height;
          fw = fh / faceAspect;
        }
        const nextX = r.left + (r.width - fw) / 2;
        const nextY = r.top + (r.height - fh) / 2;
        faceDX = faceBox.w ? nextX - faceBox.x : 0;
        faceDY = faceBox.h ? nextY - faceBox.y : 0;
        faceBox.x = nextX;
        faceBox.y = nextY;
        faceBox.w = fw;
        faceBox.h = fh;
      }
      document.documentElement.classList.toggle('particles-portrait', facePointsReady && !reduceMotion);
      faceEase += (target - faceEase) * (1 - Math.exp(-dt * 16.67 / 55));
      structureFlow += (structureFlowTarget-structureFlow) * (1-Math.exp(-dt*16.67/55));
      if (faceEase < 0.001) faceEase = 0;
      updateBuildState(faceEase);
    };

    // --- Simulación ------------------------------------------------------------
    const simulate = (time: number, dt: number) => {
      const scrollY = window.scrollY;
      const scrollDelta = scrollY - previousScroll;
      previousScroll = scrollY;
      const ef = faceEase;
      const faceOn = ef > 0 && facePointsReady;
      const r2 = MOUSE_RADIUS * MOUSE_RADIUS;
      const mr2 = MAGNET_RADIUS * MAGNET_RADIUS;
      const damp = Math.pow(DAMPING, dt);
      const dim = BASE_DIM;
      const tSec = time * 0.001;
      const flowStrength = smooth(.97,1,ef) * (1-smooth(.72,.92,structureFlow));
      const sealProgress = smooth(.78,.98,structureFlow);
      const sealPulse = Math.sin(Math.PI*sealProgress);
      const flowHeads = [0,1/3,2/3].map(offset=>ideaFlowPoint(structureFlow + offset));
      const tDrift = time * 0.0002;
      const wrapSpan = h + 80;
      const mouseOn = mouse.active;
      const mForce = MOUSE_FORCE * (MOUSE_REST + (1 - MOUSE_REST) * Math.min(1, mouse.speed / MOUSE_SPEED_FULL));

      // Tarjeta magnética activa (solo con cursor real y sin composición formado)
      magnetRect.active = false;
      if (hoverCapable && magnetCard && mouseOn && ef < 0.3) {
        const r = magnetCard.getBoundingClientRect();
        magnetRect.x = r.left;
        magnetRect.y = r.top;
        magnetRect.w = r.width;
        magnetRect.h = r.height;
        magnetRect.active = true;
      }
      const magOn = magnetRect.active;
      const mx0 = magnetRect.x, my0 = magnetRect.y;
      const mx1 = mx0 + magnetRect.w, my1 = my0 + magnetRect.h;

      const end = mainCount + activeReserve;
      for (let i = 0; i < end; i++) {
        if (i === activeMain && i < mainCount) i = mainCount; // saltar recortadas
        const k = kind[i];
        const par = scrollY * SCROLL_PARALLAX * depth[i];
        const e = faceOn && fx[i] >= 0 ? quintic(Math.max(0, Math.min(1, (ef-delay[i])/.24))) : 0;
        formWeight[i] = e;
        // Move formed particles with their anchor directly: no spring drag on scroll.
        px[i] += faceDX * e;
        py[i] += (faceDY + scrollDelta * SCROLL_PARALLAX * depth[i]) * e;
        let s = py[i] - par; // y en pantalla

        // Las reservas duermen sin composición ni imán: cero física, cero pintado
        if (k === KIND_RESERVE && !faceOn && !magOn && mg[i] < 0.001) {
          bucketOf[i] = 255;
          continue;
        }

        // Polvo ambiental: envuelve el viewport moviendo su hogar en el mundo
        // (no con un módulo al pintar), así nunca salta al formarse el composición.
        if (k === KIND_AMBIENT && !faceOn) {
          if (s < -40) {
            hy[i] += wrapSpan; py[i] += wrapSpan; s += wrapSpan;
          } else if (s > h + 40) {
            hy[i] -= wrapSpan; py[i] -= wrapSpan; s -= wrapSpan;
          }
        }

        // La corriente fuera de pantalla no se simula: su hogar está en el hero
        if (k === KIND_STREAM && !faceOn && mg[i] < 0.001 && (s < -CULL_MARGIN || s > h + CULL_MARGIN)) {
          bucketOf[i] = 255;
          continue;
        }

        if (mg[i] > 0.001) mg[i] *= 1 - Math.min(1, 0.1 * dt);

        const x = px[i];
        if (magOn) {
          // Gravedad magnética: el polvo cercano al cursor es atraído hacia el
          // punto más cercano del borde de la tarjeta y se acumula ahí.
          const dxm = x - mouse.x;
          const dym = s - mouse.y;
          const dm2 = dxm * dxm + dym * dym;
          if (dm2 < mr2) {
            const infl = 1 - Math.sqrt(dm2) / MAGNET_RADIUS;
            let bx = x < mx0 ? mx0 : x > mx1 ? mx1 : x;
            let by = s < my0 ? my0 : s > my1 ? my1 : s;
            if (bx === x && by === s) {
              // Dentro de la tarjeta: empujar a la arista más próxima
              const dL = x - mx0, dR = mx1 - x, dT = s - my0, dB = my1 - s;
              const m = Math.min(dL, dR, dT, dB);
              if (m === dL) bx = mx0;
              else if (m === dR) bx = mx1;
              else if (m === dT) by = my0;
              else by = my1;
            }
            // Acumular unos px FUERA del borde: la tarjeta es opaca
            if (bx === mx0) bx -= 4;
            else if (bx === mx1) bx += 4;
            if (by === my0) by -= 4;
            else if (by === my1) by += 4;
            const kk = MAGNET_PULL * infl * dt;
            vx[i] += (bx - x) * kk;
            vy[i] += (by - s) * kk;
            if (infl > mg[i]) mg[i] = infl;
          }
        } else if (mouseOn) {
          // Dispersión por cursor con remolino tangencial
          const dx = x - mouse.x;
          const dy = s - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < r2 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const q = (MOUSE_RADIUS - d) / MOUSE_RADIUS;
            const f = (q * q * mForce * dt * (1 - .94 * e)) / d;
            vx[i] += (dx - dy * MOUSE_SWIRL) * f;
            vy[i] += (dy + dx * MOUSE_SWIRL) * f;
          }
        }


        // Deriva continua: el punto que la partícula persigue orbita lentamente
        // alrededor del hogar. Conforme el composición se forma la deriva se aquieta.
        const t1 = tDrift * tw[i] + phase[i];
        const drift = amp[i] * (1 - e);
        let tx = hx[i] + Math.sin(t1) * drift;
        let ty = hy[i] + Math.cos(t1 * 0.77 + phase[i] * 1.7) * drift * 0.8;

        if (e > 0) {
          const fxs = faceBox.x + fx[i] * faceBox.w;
          const lift = quintic(Math.max(0, Math.min(1, (ef-.18)/.72)));
          const assembledY = baseFY[i] + (fy[i]-baseFY[i]) * lift;
          const fys = faceBox.y + assembledY * faceBox.h + par;
          tx += (fxs - tx) * e;
          ty += (fys - ty) * e;
        }

        if (e > 0) {
          // Same 55ms response as the process: no oscillating spring on the shape.
          const follow = 1 - Math.exp(-dt * 16.67 / 55);
          vx[i] = (tx-x) * follow; vy[i] = (ty-py[i]) * follow;
          px[i] = x + vx[i]; py[i] += vy[i];
        } else {
          const ks = SPRING * dt;
          vx[i] = (vx[i] + (tx-x)*ks) * damp;
          vy[i] = (vy[i] + (ty-py[i])*ks) * damp;
          px[i] = x + vx[i]*dt; py[i] += vy[i]*dt;
        }
        s = py[i] - par;
        sy[i] = s;

        // --- alpha para el pintado ---
        if (s < -4 || s > h + 4 || px[i] < -4 || px[i] > w + 4) {
          bucketOf[i] = 255;
          continue;
        }
        const twinkle = 0.75 + 0.25 * Math.sin(tSec * tw[i] + phase[i]);
        let a: number;
        if (k === KIND_RESERVE) {
          // Se materializan con la formación del composición o con el imán de borde
          a = e > 0 ? fa[i] * e : 0.55 * mg[i];
        } else {
          const base = alpha[i] * dim;
          a = base + (fa[i] - base) * e;
        }
        if (mg[i] > 0.01) a = Math.min(0.9, Math.max(a * (1 + MAGNET_GLOW * mg[i]), 0.5 * mg[i]));
        // Formed grain stays still: illumination and the final seal follow scroll only.
        a *= twinkle * (1-e) + .98 * e;
        if (e > .99 && fa[i] > .7) a=Math.min(1,a+sealPulse*.3+sealProgress*.08);
        if (e > .99 && flowStrength > 0) {
          let energy=0;
          for (const head of flowHeads) energy=Math.max(energy, Math.max(0,1-Math.hypot((fx[i]-head.x)*faceBox.w,(fy[i]-head.y)*faceBox.h)/18));
          a=Math.min(1,a+energy*.5*flowStrength);
        }
        if (a < 0.008) {
          bucketOf[i] = 255;
          continue;
        }
        drawA[i] = a;
        bucketOf[i] = Math.min(ALPHA_BUCKETS - 1, (a * ALPHA_BUCKETS) | 0);
      }
    };

    // Temporarily hand real background particles to the process illustration.
    document.addEventListener('process-particle-request', event => {
      const detail = (event as CustomEvent<{
        amount: number; rect: { left: number; top: number; right: number; bottom: number };
        receive: (seeds: { x: number; y: number; alpha: number; radius: number; color: string }[], release: () => void) => void;
      }>).detail;
      if (!detail || reduceMotion || faceEase > .15 || document.documentElement.classList.contains('motion-paused')) return;
      const rect = detail.rect;
      const candidates: { id: number; x: number; y: number; distance: number }[] = [];
      for (let i = 0; i < activeMain; i++) {
        const x = px[i], y = py[i] - window.scrollY * SCROLL_PARALLAX * depth[i];
        if (leased.has(i) || x < 0 || x > w || y < 0 || y > h) continue;
        if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) continue;
        const dx = Math.max(rect.left - x, 0, x - rect.right);
        const dy = Math.max(rect.top - y, 0, y - rect.bottom);
        candidates.push({ id: i, x, y, distance: Math.hypot(dx, dy) });
      }
      candidates.sort((a,b) => a.distance - b.distance);
      const selected = candidates.slice(0, Math.min(detail.amount, 540));
      if (!selected.length) return;
      const epoch = particleEpoch;
      selected.forEach(p => leased.add(p.id));
      detail.receive(selected.map(p => ({ x: p.x, y: p.y, alpha: drawA[p.id] || alpha[p.id] * BASE_DIM, radius: size[p.id] / 2, color: `rgb(${rgb})` })), () => {
        if (epoch === particleEpoch) selected.forEach(p => leased.delete(p.id));
      });
    });

    // --- Render por lotes ------------------------------------------------------
    // Cambiar globalAlpha miles de veces por frame es lo que más cuesta en
    // Canvas 2D. Se agrupan las partículas por nivel de alpha (counting sort) y
    // cada grupo se pinta con un solo cambio de estado.
    const draw = (time: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = `rgb(${rgb})`;
      if (reduceMotion) {
        // Un solo frame estático de la corriente atenuada
        ctx.globalAlpha = 1;
        for (let i = 0; i < mainCount; i++) {
          ctx.globalAlpha = alpha[i] * BASE_DIM;
          ctx.fillRect(px[i], py[i], size[i], size[i]);
        }
        ctx.globalAlpha = 1;
        return;
      }
      void time;
      const end = mainCount + activeReserve;
      bucketCount.fill(0);
      for (let i = 0; i < end; i++) {
        if (i === activeMain && i < mainCount) i = mainCount;
        const b = leased.has(i) ? 255 : bucketOf[i];
        if (b !== 255) bucketCount[b]++;
      }
      let acc = 0;
      for (let b = 0; b < ALPHA_BUCKETS; b++) {
        bucketStart[b] = acc;
        acc += bucketCount[b];
      }
      bucketCount.fill(0);
      for (let i = 0; i < end; i++) {
        if (i === activeMain && i < mainCount) i = mainCount;
        const b = leased.has(i) ? 255 : bucketOf[i];
        if (b !== 255) order[bucketStart[b] + bucketCount[b]++] = i;
      }
      const shapeColor = getComputedStyle(document.documentElement).getPropertyValue('--accent-strong').trim();
      // Separate passes preserve batched paint while the illustration turns orange.
      for (let pass = 0; pass < 2; pass++) {
        ctx.fillStyle = pass === 0 ? `rgb(${rgb})` : shapeColor;
        for (let b = 0; b < ALPHA_BUCKETS; b++) {
          const n = bucketCount[b];
          if (!n) continue;
          ctx.globalAlpha = (b + .5) / ALPHA_BUCKETS;
          const start = bucketStart[b];
          for (let j = start; j < start+n; j++) {
            const i = order[j];
            if (Number(formWeight[i] > .3) !== pass) continue;
            if (pass === 1) {
              ctx.beginPath(); ctx.arc(px[i], sy[i], i % 11 === 0 ? 1.7 : 1.1, 0, Math.PI*2); ctx.fill();
            } else ctx.fillRect(px[i], sy[i], size[i], size[i]);
          }
        }
      }
      // Granular packets follow the edges rather than washing over the volume.
      const strength=smooth(.97,1,faceEase)*(1-smooth(.72,.92,structureFlow));
      if (strength > 0) {
        ctx.fillStyle=shapeColor;
        for (let packet=0;packet<3;packet++) {
          for (let grain=0;grain<7;grain++) {
            const point=ideaFlowPoint(structureFlow+packet/3-grain*.0035);
            ctx.globalAlpha=strength*(1-grain/7)*.8;
            ctx.beginPath(); ctx.arc(faceBox.x+point.x*faceBox.w,faceBox.y+point.y*faceBox.h,grain===0?1.35:1.0,0,Math.PI*2);ctx.fill();
          }
        }
      }
      ctx.globalAlpha = 1;
      drawn = acc;
    };

    // --- Bucle con límite de FPS y auto-degradación por coste ------------------
    // Se mide el tiempo real de simulación + pintado (no los FPS: con el límite
    // de cuadros activo los FPS medidos mienten). Si el promedio excede el
    // presupuesto, se recorta el rango activo; si sobra holgura, se recupera.
    const frameBudget = 1000 / TIER.fps;
    const COST_BUDGET = 6; // ms por frame que el fondo puede gastar
    // Piso: por debajo de esto el ilustración pierde legibilidad; preferible
    // bajar FPS a tener un composición ralo.
    const MIN_PERF_SCALE = 0.5;
    let perfScale = 1;
    let lastFrame = 0;
    let costEMA = 0;
    let lastPerfCheck = 0;
    let drawn = 0;

    const adapt = (time: number) => {
      if (time - lastPerfCheck < 1500) return;
      lastPerfCheck = time;
      let next = perfScale;
      if (costEMA > COST_BUDGET) next = Math.max(MIN_PERF_SCALE, perfScale * 0.8);
      else if (costEMA < COST_BUDGET * 0.4 && perfScale < 1) next = Math.min(1, perfScale * 1.15);
      if (next === perfScale) return;
      perfScale = next;
      activeMain = Math.round(mainCount * perfScale);
      activeReserve = Math.round(reserveCount * perfScale);
    };

    const step = (time: number) => {
      if (reduceMotion || document.hidden || document.documentElement.classList.contains('motion-paused')) { rafId = 0; document.documentElement.classList.remove('particles-portrait'); return; }
      rafId = requestAnimationFrame(step);
      // Límite de FPS (con tolerancia para no perder cuadros por jitter)
      if (time - lastFrame < (faceEase > 0 ? 1000/60 : frameBudget) - 2) return;
      lastFrame = time;

      const dt = Math.min((time - lastTime) / 16.67, 3);
      lastTime = time;

      const prevX = mouse.x;
      const prevY = mouse.y;
      const ease = Math.min(1, 0.25 * dt);
      mouse.x += (mouse.tx - mouse.x) * ease;
      mouse.y += (mouse.ty - mouse.y) * ease;
      const sp = Math.hypot(mouse.x - prevX, mouse.y - prevY) / dt;
      mouse.speed += ((mouse.active ? sp : 0) - mouse.speed) * 0.2;

      const t0 = performance.now();
      updateFace(dt);
      simulate(time, dt);
      draw(time);
      costEMA += (performance.now() - t0 - costEMA) * 0.1;
      adapt(time);
    };

    // Estado de depuración (consola: __particlesState)
    Object.defineProperty(window, '__particlesState', {
      get: () => ({
        tier,
        perfScale,
        costMs: +costEMA.toFixed(2),
        main: `${activeMain}/${mainCount}`,
        reserve: `${activeReserve}/${reserveCount}`,
        drawn,
        faceEase: +faceEase.toFixed(3),
      }),
      configurable: true,
    });

    // --- Listeners -----------------------------------------------------------
    syncTheme();
    resize();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion) draw(0);
      }, 200);
    });

    const resumeMotion = () => {
      reduceMotion = motionMedia.matches;
      const paused = reduceMotion || document.documentElement.classList.contains('motion-paused');
      canvas.style.display = paused ? 'none' : '';
      if (paused) { updateBuildState(1); cancelAnimationFrame(rafId); rafId = 0; document.documentElement.classList.remove('particles-portrait'); }
      else if (!document.hidden && !rafId) { if (!facePointsReady) sampleFace(); lastTime = lastFrame = performance.now(); rafId = requestAnimationFrame(step); }
    };
    document.addEventListener('motionchange', resumeMotion);
    motionMedia.addEventListener('change', resumeMotion);
    if (reduceMotion) {
      // Sin animación: corriente estática y la figura estática queda visible
      draw(0);
    }
    {
      if (!reduceMotion) sampleFace();

      const release = () => {
        mouse.active = false;
        mouse.tx = mouse.ty = mouse.x = mouse.y = -9999;
      };
      window.addEventListener('pointermove', (e) => {
        if (reduceMotion || document.documentElement.classList.contains('motion-paused')) return;
        mouse.tx = e.clientX;
        mouse.ty = e.clientY;
        if (!mouse.active) {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
          mouse.active = true;
        }
      }, { passive: true });
      // window no emite pointerleave: el cursor sale de la ventana cuando un
      // mouseout no tiene destino.
      document.addEventListener('mouseout', (e) => {
        if (!e.relatedTarget) release();
      });
      // En táctil, al levantar el dedo no queda un "cursor fantasma" empujando
      const releaseTouch = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse') release();
      };
      window.addEventListener('pointerup', releaseTouch, { passive: true });
      window.addEventListener('pointercancel', releaseTouch, { passive: true });

      if (hoverCapable) {
        document.addEventListener('pointerover', (e) => {
          magnetCard = (e.target as Element | null)?.closest?.('[data-magnetic-card]') ?? null;
        }, { passive: true });
      }

      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(rafId);
        rafId = 0;
        resumeMotion();
      });

    }
    resumeMotion();
  }
</script>

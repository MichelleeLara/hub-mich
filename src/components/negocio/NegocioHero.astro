---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { WA_URL, DEMO_URL } from './data.js';

const days = [
  { day: 'Hoy', items: [
    { icon: 'chat', title: 'Nuevo mensaje de WhatsApp', meta: 'Cita para Toby · 10:30', when: 'ahora' },
    { icon: 'pin', title: 'Llamada desde Google Maps', meta: 'Contestada · 2 min', when: '1 h' },
    { icon: 'chat', title: '¿Cuánto cuesta la afinación?', meta: 'WhatsApp', when: '3 h' },
  ]},
  { day: 'Ayer', items: [
    { icon: 'chat', title: '¿Abren los sábados?', meta: 'WhatsApp', when: '18:40' },
    { icon: 'cal', title: 'Cita confirmada', meta: 'Revisión · 17:00', when: '16:05' },
  ]},
  { day: 'Lunes', items: [
    { icon: 'pin', title: 'Llamada desde Google Maps', meta: 'Contestada · 1 min', when: '12:15' },
    { icon: 'chat', title: '¿Dónde están ubicados?', meta: 'WhatsApp', when: '09:20' },
  ]},
];
const icons = {
  chat: 'M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4 3.5V17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z',
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11zM12 12.2a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8z',
  cal: 'M5 5.5h14a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 19 19.5H5A1.5 1.5 0 0 1 3.5 18V7A1.5 1.5 0 0 1 5 5.5zM3.5 10h17M8 3.5v3M16 3.5v3',
};
---
<section class="mn-hero" id="negocio-inicio" aria-labelledby="mn-hero-title">
  <div class="mn-wrap mn-hero-grid">
    <div class="mn-hero-copy">
      <p class="mn-avail"><span class="mn-dot" aria-hidden="true"></span>3 lugares para negocios pioneros · noviembre</p>
      <h1 id="mn-hero-title" class="mn-h1">
        <span class="mn-h1-line">Que te encuentren
          <svg class="mn-h1-ico" viewBox="0 0 48 32" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 26l12-11 8 7L43 5"/><path d="M31 5h12v12"/></svg>
        </span>
        <span class="mn-h1-line">y te escriban directo</span>
      </h1>
      <p class="mn-lead">Soy Michelle, ingeniero en sistemas. Ayudo a negocios de la colonia a que quien los busca en Google encuentre lo que necesita y les escriba directo.</p>
      <div class="mn-actions">
        <a class="mn-btn mn-btn-primary" href={WA_URL} target="_blank" rel="noopener noreferrer" data-umami-event="whatsapp" data-umami-event-ubicacion="hero-negocio">
          <WhatsAppIcon />Escríbeme por WhatsApp
        </a>
        <a class="mn-btn mn-btn-secondary" href={DEMO_URL} data-umami-event="ver-ejemplo">Ver ejemplo <span aria-hidden="true">↗</span></a>
      </div>
      <p class="mn-proof">Ingeniero en sistemas · CDMX</p>
    </div>

    <div class="mn-feed" role="group" aria-label="Ejemplo ilustrativo de mensajes y llamadas que recibe un negocio">
      <p class="mn-feed-tag">Ejemplo ilustrativo</p>
      <div class="mn-feed-view" aria-hidden="true">
        <div class="mn-feed-track">
          {[0, 1].map(() => (
            <div class="mn-feed-set">
              {days.map((d) => (
                <div class="mn-day">
                  <p class="mn-day-label">{d.day}</p>
                  {d.items.map((it) => (
                    <div class="mn-note">
                      <span class="mn-note-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[it.icon]} /></svg></span>
                      <span class="mn-note-body"><b>{it.title}</b><small>{it.meta}</small></span>
                      <span class="mn-note-when">{it.when}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
      <p class="mn-sr">Ejemplo ilustrativo: un mensaje de WhatsApp para agendar una cita, una llamada desde Google Maps y una pregunta de precio.</p>
    </div>
  </div>
</section>

---
const icon = {
  chat: 'M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4 3.5V17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z',
  phone: 'M6.6 3.5h2.7l1.4 4-1.8 1.2a11 11 0 0 0 5.4 5.4l1.2-1.8 4 1.4v2.7a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z',
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11zM12 12.2a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8z',
  cal: 'M5 5.5h14a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 19 19.5H5A1.5 1.5 0 0 1 3.5 18V7A1.5 1.5 0 0 1 5 5.5zM3.5 10h17M8 3.5v3M16 3.5v3',
};
---
<section class="mn-section mn-problema" aria-labelledby="mn-problema-title">
  <div class="mn-wrap">
    <div class="mn-chaos" data-reveal>
      <svg class="mn-chaos-lines" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <path pathLength="1" d="M14 14C30 -2 70 -2 86 14" />
        <path pathLength="1" d="M12 18C2 40 2 62 12 78" />
        <path pathLength="1" d="M88 18C98 40 98 62 88 78" />
        <path pathLength="1" d="M16 84C32 98 68 98 84 84" />
      </svg>

      <div class="mn-ico mn-ico-a" aria-hidden="true" style="--x:12%;--y:14%;--d:0s">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.chat} /></svg>
        <span class="mn-badge">99+</span>
      </div>
      <div class="mn-bubble" aria-hidden="true" style="--x:86%;--y:13%;--d:-1.5s">¿cuánto cuesta?</div>
      <div class="mn-ico mn-ico-b" aria-hidden="true" style="--x:11%;--y:84%;--d:-3s">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.phone} /><path d="M15 4l5 5M20 4l-5 5" /></svg>
        <span class="mn-badge">1</span>
        <span class="mn-ico-cap">llamada perdida</span>
      </div>
      <div class="mn-ico mn-ico-c" aria-hidden="true" style="--x:50%;--y:94%;--d:-4.5s">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.pin} /></svg>
      </div>
      <div class="mn-ico mn-ico-d" aria-hidden="true" style="--x:89%;--y:84%;--d:-2s">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.cal} /></svg>
        <span class="mn-badge">3</span>
      </div>

      <div class="mn-chaos-center">
        <p class="mn-label note-label">El problema</p>
        <h2 id="mn-problema-title" class="mn-h2 mn-h2-center">Hoy tus clientes te buscan por todos lados.</h2>
      </div>
    </div>
    <ul class="mn-mono-list">
      <li>Las mismas preguntas por WhatsApp todo el día.</li>
      <li>Quien te encuentra en Maps tiene que llamar para preguntar.</li>
      <li>El enlace de tu ficha no lleva a ningún lado.</li>
    </ul>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('.mn-chaos');
  if (el) {
    if (!('IntersectionObserver' in window)) el.classList.add('is-in');
    else new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); o.disconnect(); } }), { threshold: 0.25 }).observe(el);
  }
</script>

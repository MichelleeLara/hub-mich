---
---

<section
  class="pt-40 pb-16 mx-6 flex items-center justify-center text-center"
>
  <div
    class="flex flex-col items-center gap-8 relative z-30 w-full max-w-screen-xl"
  >
    <!-- Kicker: rol + estado de disponibilidad -->
    <div
      class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest"
    >
      <span class="text-gray-800 dark:text-secondary">Frontend Engineer</span>
      <span class="text-gray-300 dark:text-[#3a3a3a]" aria-hidden="true">|</span>
      <span class="flex items-center gap-2 text-green-500">
        <span class="relative flex w-2 h-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-60"
          ></span>
          <span class="relative inline-flex rounded-full w-2 h-2 bg-green-500"
          ></span>
        </span>
        Disponible
      </span>
    </div>

    <!-- Nombre gigante con la foto integrada al centro -->
    <div class="relative w-full flex items-center justify-center">
      <h1
        class="font-ClashDisplay font-semibold uppercase tracking-tight leading-[0.98] sm:leading-[0.9] md:leading-[0.85] text-gray-800 dark:text-secondary text-center text-5xl xs:text-6xl sm:text-7xl md:text-8xl lg:text-[9rem] select-none"
      >
        <span class="block">Michelle</span>
        <span class="block">Rodriguez</span>
      </h1>

      <!-- Avatar encimado, centrado entre las dos líneas.
           Las dos fotos están apiladas y se hace crossfade según el tema. -->
      <div
        id="hero-avatar"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 will-change-transform w-20 h-28 sm:w-28 sm:h-36 md:w-36 md:h-48"
      >
        <!-- Modo claro: versión con suéter negro -->
        <img
          src="/hero_mich_black.png"
          alt="Foto de Michelle Rodriguez Lara"
          class="hero-float absolute inset-0 w-full h-full object-cover object-top rounded-[42%] bg-[#e0e0e0] border border-[#8f8f8f30] shadow-2xl opacity-100 dark:opacity-0"
        />
        <!-- Modo oscuro: versión original -->
        <img
          src="/hero_mich.png"
          alt="Foto de Michelle Rodriguez Lara"
          class="hero-float absolute inset-0 w-full h-full object-cover object-top rounded-[42%] dark:bg-[#1c1c1c] border border-transparent dark:border-[#272626] shadow-2xl opacity-0 dark:opacity-100"
        />
      </div>
    </div>

    <!-- Subtítulo: copy sintetizado -->
    <p
      class="text-sm md:text-base text-gray-800 dark:text-terteary text-pretty max-w-[620px]"
    >
      Convierto problemas de negocio en <span
        class="font-semibold dark:text-secondary">productos simples de usar</span
      >. Interfaces donde los detalles técnicos y visuales se notan.
    </p>

    <!-- CTAs: primario (sólido) + secundario (borde) para marcar jerarquía -->
    <div class="flex gap-3 items-center justify-center flex-wrap mt-2">
      <!-- Primario: Ver proyectos -->
      <a
        href="#proyectos"
        class="group flex items-center gap-2.5 text-sm font-medium rounded-lg py-3.5 px-7 bg-gray-900 text-white dark:bg-secondary dark:text-gray-900 transition-colors"
      >
        Ver proyectos
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.0001 11.9998L4.00012 11.9998"></path>
          <path
            d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0002 10.6824 15.0002 7 15.0002 7"
          ></path>
        </svg>
      </a>
      <!-- Secundario: Leer mi CV -->
      <a
        href="/pdf/CV_michelle_lara.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 text-sm font-medium rounded-lg py-3.5 px-7 border border-[#d9d9d9] dark:border-[#2b2b2b8e] text-gray-800 dark:text-secondary transition-colors"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
          <path
            d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"
          ></path>
          <path d="M9 13h6"></path>
          <path d="M9 17h4"></path>
        </svg>
        Leer mi CV
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* Transición de blur al cambiar de tema: la foto se desenfoca,
     se hace el swap de imagen y vuelve a enfocarse. */
  #hero-avatar img {
    transition: opacity 0.4s ease, filter 0.25s ease;
  }

  /* Blur muy leve solo durante el cruce, para que la disolución
     se sienta suave y no un cambio brusco de imagen. */
  html.theme-swapping #hero-avatar img {
    filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #hero-avatar img {
      transition: none;
    }
  }
</style>

<style>
  /* Levitación en reposo (sutil) */
  .hero-float {
    animation: hero-float 5.5s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-6px) rotate(1deg);
    }
  }

  /* Detalle con propósito: sin movimiento para quien lo pide */
  @media (prefers-reduced-motion: reduce) {
    .hero-float {
      animation: none;
    }
  }
</style>

<script>
  // Parallax sutil: el avatar acompaña al mouse con inercia.
  const avatar = document.getElementById("hero-avatar");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (avatar && !reduceMotion && window.matchMedia("(pointer: fine)").matches) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    const RANGE_X = 10;
    const RANGE_Y = 8;
    const DAMP = 0.06;

    window.addEventListener(
      "mousemove",
      (e) => {
        targetX = (e.clientX / window.innerWidth - 0.5) * 2 * RANGE_X;
        targetY = (e.clientY / window.innerHeight - 0.5) * 2 * RANGE_Y;
      },
      { passive: true }
    );

    const loop = () => {
      x += (targetX - x) * DAMP;
      y += (targetY - y) * DAMP;
      avatar.style.transform = `translate(-50%, -50%) translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      requestAnimationFrame(loop);
    };
    loop();
  }
</script>

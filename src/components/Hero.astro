---
import Particles from "../components/ui/Particles";
---

<section
  class="pt-36 pb-16 mx-6 flex items-center justify-center text-center"
>
  <div
    class="flex flex-col items-center gap-8 relative z-30 w-full max-w-screen-xl"
  >
    <!-- Kicker: solo el badge de disponibilidad -->
    <a
      href="#footer"
      class="flex items-center gap-2 rounded-full border border-[#eff3f4] bg-[#eff3f43c] dark:bg-[#1c1c1c] dark:border-[#2b2b2b8e] py-1.5 px-4 text-xs"
    >
      <span class="relative flex w-2.5 h-2.5">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-60"
        ></span>
        <span class="relative inline-flex rounded-full w-2.5 h-2.5 bg-green-400"
        ></span>
      </span>
      Disponible para nuevos proyectos
    </a>

    <!-- Nombre gigante con la foto integrada al centro -->
    <div class="relative w-full flex items-center justify-center">
      <h1
        class="font-ClashDisplay font-semibold uppercase tracking-tight leading-[0.85] text-gray-800 dark:text-secondary text-center text-5xl xs:text-6xl sm:text-7xl md:text-8xl lg:text-[9rem] select-none"
      >
        <span class="block">Michelle</span>
        <span class="block">Rodriguez</span>
      </h1>

      <!-- Avatar encimado, centrado entre las dos líneas -->
      <div
        id="hero-avatar"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 will-change-transform"
      >
        <img
          src="/hero_mich.png"
          alt="Foto de Michelle Rodriguez Lara"
          class="hero-float w-24 h-32 sm:w-28 sm:h-36 md:w-36 md:h-48 object-cover object-top rounded-[42%] bg-[#e0e0e0] dark:bg-[#1c1c1c] border border-[#8f8f8f30] dark:border-[#272626] shadow-2xl"
        />
      </div>
    </div>

    <!-- Subtítulo: copy sintetizado -->
    <p
      class="text-sm md:text-base text-gray-800 dark:text-terteary text-pretty max-w-[620px]"
    >
      Convierto problemas de negocio en <span
        class="font-semibold dark:text-secondary">productos simples de usar</span
      >. Frontend Engineer. Diseño y construyo interfaces donde los detalles
      técnicos y visuales se notan. Sin fricción y listas para escalar.
    </p>

    <!-- CTAs -->
    <div class="flex gap-3 items-center justify-center flex-wrap mt-1 relative">
      <a
        href="#proyectos"
        class="text-xs font-semibold text-white bg-primary rounded-lg py-2.5 px-5"
        >Ver proyectos</a
      >
      <a
        href="/pdf/CV_michelle_lara.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="border flex items-center gap-2 rounded-lg border-[#eff3f4] dark:border-[#2b2b2b8e] text-xs py-2.5 px-5"
        >Leer mi CV</a
      >
      <div class="absolute -right-10 -top-10 opacity-70 -z-40 h-24 w-24">
        <Particles client:load />
      </div>
    </div>

    <!-- Acento estrella (guiño a la referencia) -->
    <svg
      class="mt-4 text-primary/80"
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M12 0c.6 6 5.4 10.8 12 12-6.6 1.2-11.4 6-12 12-.6-6-5.4-10.8-12-12C6.6 10.8 11.4 6 12 0z"
      ></path>
    </svg>
  </div>
</section>

<style>
  /* Levitación en reposo (sutil) */
  .hero-float {
    animation: hero-float 5.5s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0) rotate(-1deg);
    }
    50% {
      transform: translateY(-6px) rotate(1deg);
    }
  }

  /* Detalle con propósito: sin movimiento para quien lo pide */
  @media (prefers-reduced-motion: reduce) {
    .hero-float {
      animation: none;
    }
  }
</style>

<script>
  // Parallax sutil: el avatar acompaña al mouse con inercia.
  const avatar = document.getElementById("hero-avatar");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (avatar && !reduceMotion && window.matchMedia("(pointer: fine)").matches) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    const RANGE_X = 10;
    const RANGE_Y = 8;
    const DAMP = 0.06;

    window.addEventListener(
      "mousemove",
      (e) => {
        targetX = (e.clientX / window.innerWidth - 0.5) * 2 * RANGE_X;
        targetY = (e.clientY / window.innerHeight - 0.5) * 2 * RANGE_Y;
      },
      { passive: true }
    );

    const loop = () => {
      x += (targetX - x) * DAMP;
      y += (targetY - y) * DAMP;
      avatar.style.transform = `translate(-50%, -50%) translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      requestAnimationFrame(loop);
    };
    loop();
  }
</script>

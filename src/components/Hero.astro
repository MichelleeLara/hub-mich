---
---

<section
  id="inicio"
  class="pt-40 pb-16 mx-6 flex items-center justify-center text-center"
>
  <div
    class="flex flex-col items-center gap-8 relative z-30 w-full max-w-screen-xl"
  >
    <!-- Kicker: rol + estado de disponibilidad -->
    <div
      class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest"
    >
      <span class="text-gray-800 dark:text-secondary">Software Engineer</span>
      <span class="text-gray-300 dark:text-[#3a3a3a]" aria-hidden="true">|</span>
      <span class="flex items-center gap-2 text-green-700 dark:text-green-500">
        <span class="relative flex w-2 h-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-60"
          ></span>
          <span class="relative inline-flex rounded-full w-2 h-2 bg-green-500"
          ></span>
        </span>
        Disponible
      </span>
    </div>

    <!-- Nombre gigante con la foto integrada al centro -->
    <div class="relative w-full flex items-center justify-center">
      <h1
        class="font-ClashDisplay font-semibold uppercase tracking-tight leading-[1.08] sm:leading-[1.02] md:leading-[0.98] text-gray-800 dark:text-secondary text-center text-5xl xs:text-6xl sm:text-7xl md:text-8xl lg:text-[9rem] select-none origin-center [transform:scaleY(1.14)]"
      >
        <span class="block">Michelle</span>
        <span class="block">Rodriguez</span>
      </h1>

      <!-- Avatar encimado, centrado entre las dos líneas. -->
      <div
        id="hero-avatar"
        class="absolute top-[51%] left-[52%] sm:left-[53%] -translate-x-1/2 -translate-y-1/2 z-20 will-change-transform w-20 h-32 xs:w-24 xs:h-36 sm:w-32 sm:h-48 md:w-40 md:h-56 lg:w-44 lg:h-60"
      >
        <img
          src="/media/hero-profile-480.webp"
          srcset="/media/hero-profile-240.webp 240w, /media/hero-profile-480.webp 480w"
          sizes="(min-width: 1024px) 176px, (min-width: 768px) 160px, 96px"
          width="480" height="768" fetchpriority="high" decoding="async"
          alt="Mich Rodriguez, Software Engineer"
          class="hero-float w-full h-full object-cover object-[47%_28%] rounded-full bg-[#e0e0e0] dark:bg-[#1c1c1c] border border-[#8f8f8f30] dark:border-[#272626] shadow-2xl"
        />
      </div>
    </div>

    <!-- Subtítulo: copy sintetizado -->
    <p
      class="text-base leading-[1.7] text-gray-800 dark:text-terteary text-pretty max-w-[620px]"
    >
      Convierto problemas de negocio en <span
        class="font-semibold dark:text-secondary">productos simples de usar</span
      >. Diseño, ingeniería e IA, con atención a los detalles.
    </p>

    <!-- CTAs: primario (sólido) + secundario (borde) para marcar jerarquía -->
    <div class="flex gap-3 items-center justify-center flex-wrap mt-2">
      <!-- Primario: Ver proyectos -->
      <a
        href="/#proyectos"
        class="group flex items-center gap-2.5 text-sm font-medium rounded-lg py-3.5 px-7 bg-gray-900 text-white dark:bg-secondary dark:text-gray-900 transition-colors"
      >
        Ver proyectos
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.0001 11.9998L4.00012 11.9998"></path>
          <path
            d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0002 10.6824 15.0002 7 15.0002 7"
          ></path>
        </svg>
      </a>
      <!-- Secundario: Leer mi CV -->
      <a
        href="/pdf/CV_michelle_lara.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 text-sm font-medium rounded-lg py-3.5 px-7 border border-[#d9d9d9] dark:border-[#2b2b2b8e] text-gray-800 dark:text-secondary transition-colors"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
          <path
            d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"
          ></path>
          <path d="M9 13h6"></path>
          <path d="M9 17h4"></path>
        </svg>
        Leer mi CV
      </a>
    </div>
  </div>
</section>

<style>
  /* Levitación en reposo (sutil) */
  .hero-float {
    animation: hero-float 5.5s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* Detalle con propósito: sin movimiento para quien lo pide */
  @media (prefers-reduced-motion: reduce) {
    .hero-float {
      animation: none;
    }
  }
</style>

<script>
  // Parallax con trabajo solo durante la interacción visible.
  const avatar = document.getElementById('hero-avatar');
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(pointer: fine)');
  if (avatar) {
    let targetX = 0, targetY = 0, x = 0, y = 0, raf = 0, visible = false;
    const canAnimate = () => visible && !document.hidden && !motionPreference.matches && finePointer.matches && !document.documentElement.classList.contains('motion-paused');
    const loop = () => {
      raf = 0;
      if (!canAnimate()) return;
      x += (targetX - x) * .16; y += (targetY - y) * .16;
      avatar.style.transform = `translate(-50%, -50%) translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      if (Math.abs(targetX - x) + Math.abs(targetY - y) > .02) raf = requestAnimationFrame(loop);
    };
    const sync = () => {
      if (!canAnimate()) { cancelAnimationFrame(raf); raf = 0; }
      if (motionPreference.matches || !finePointer.matches) {
        targetX = targetY = x = y = 0;
        avatar.style.transform = 'translate(-50%, -50%)';
      }
      if (canAnimate() && !raf) raf = requestAnimationFrame(loop);
    };
    window.addEventListener('mousemove', e => {
      if (!canAnimate()) return;
      targetX = (e.clientX / innerWidth - .5) * 60;
      targetY = (e.clientY / innerHeight - .5) * 48;
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }).observe(avatar);
    motionPreference.addEventListener('change', sync);
    finePointer.addEventListener('change', sync);
    document.addEventListener('motionchange', sync);
    document.addEventListener('visibilitychange', sync);
  }
</script>

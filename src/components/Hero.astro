---
---

<section
  id="inicio"
  class="hero-section"
>
  <div
    class="hero-layout"
  >
    <div class="hero-copy">
    <!-- Rol y disponibilidad -->
    <div
      class="hero-role"
    >
      <span class="text-ink">Product Engineer</span>
      <span class="text-line" aria-hidden="true">|</span>
      <span class="flex items-center gap-2 text-success">
        <span class="relative flex w-2 h-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-60"
          ></span>
          <span class="relative inline-flex rounded-full w-2 h-2 bg-success"
          ></span>
        </span>
        Disponible
      </span>
    </div>

    <!-- Nombre completo, separado del retrato -->
      <h1
        class="hero-name"
      >
        <span class="block">Michelle</span>
        <span class="block">Rodriguez</span>
      </h1>

    <!-- Subtítulo: copy sintetizado -->
    <p
      class="hero-description"
    >
      Convierto problemas de negocio en <span
        class="font-semibold text-ink">productos simples de usar</span
      >. Diseño, ingeniería e IA, con atención a los detalles.
    </p>

    <!-- CTAs: primario (sólido) + secundario (borde) para marcar jerarquía -->
    <div class="hero-actions">
      <!-- Primario: Ver proyectos -->
      <a
        href="/#proyectos"
        class="btn btn-primary"
      >
        Ver proyectos
        <svg
          aria-hidden="true"
          class="btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20.0001 11.9998L4.00012 11.9998"></path>
          <path
            d="M15.0003 17C15.0003 17 20.0002 13.3176 20.0002 12C20.0002 10.6824 15.0002 7 15.0002 7"
          ></path>
        </svg>
      </a>
      <!-- Secundario: Leer mi CV -->
      <a
        href="/pdf/CV_michelle_lara.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
      >
        <svg
          aria-hidden="true"
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 3v4a1 1 0 0 0 1 1h4"></path>
          <path
            d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"
          ></path>
          <path d="M9 13h6"></path>
          <path d="M9 17h4"></path>
        </svg>
        Leer mi CV
      </a>
    </div>
    </div>
    <!-- Retrato lateral; encima del texto en móvil. -->
      <div
        id="hero-avatar"
        class="hero-portrait"
      >
        <img
          src="/media/hero-profile-480.webp"
          srcset="/media/hero-profile-240.webp 240w, /media/hero-profile-480.webp 480w"
          sizes="(min-width: 768px) 240px, 112px"
          width="480" height="768" fetchpriority="high" decoding="async"
          alt="Mich Rodriguez, Product Engineer"
          class="hero-float w-full h-full object-cover object-[47%_28%] rounded-full bg-surface border border-line shadow-lift"
        />
      </div>
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    padding: 144px var(--gutter) var(--space-8);
    color: var(--ink);
    scroll-margin-top: 100px;
  }
  .hero-layout {
    position: relative;
    z-index: 30;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    align-items: center;
    gap: var(--space-7);
    width: min(100%, 920px);
    min-height: 500px;
    margin: auto;
  }
  .hero-copy { min-width: 0; }
  .hero-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    color: var(--muted);
    font-size: var(--fs-caption);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .hero-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(42px, 6.6vw, 68px);
    line-height: 1.06;
    letter-spacing: -.045em;
    text-transform: uppercase;
  }
  .hero-description {
    max-width: 490px;
    margin: var(--space-6) 0 var(--space-5);
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .hero-portrait { width: 240px; height: 344px; justify-self: end; }
  @media (max-width: 767px) {
    .hero-section { padding-top: var(--space-9); }
    .hero-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); min-height: 0; }
    .hero-portrait { grid-row: 1; width: 112px; height: 152px; }
    .hero-role { font-size: var(--fs-micro); letter-spacing: .06em; gap: var(--space-2); margin-bottom: var(--space-4); }
    .hero-name { font-size: clamp(38px, 10vw, 60px); }
    .hero-description { margin-top: var(--space-5); }
  }

  /* Levitación en reposo (sutil) */
  .hero-float {
    animation: hero-float 5.5s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* Detalle con propósito: sin movimiento para quien lo pide */
  @media (prefers-reduced-motion: reduce) {
    .hero-float {
      animation: none;
    }
  }
</style>

<script>
  // Parallax con trabajo solo durante la interacción visible.
  const avatar = document.getElementById('hero-avatar');
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(pointer: fine)');
  if (avatar) {
    let targetX = 0, targetY = 0, x = 0, y = 0, raf = 0, visible = false;
    const canAnimate = () => visible && !document.hidden && !motionPreference.matches && finePointer.matches && !document.documentElement.classList.contains('motion-paused');
    const loop = () => {
      raf = 0;
      if (!canAnimate()) return;
      x += (targetX - x) * .16; y += (targetY - y) * .16;
      avatar.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
      if (Math.abs(targetX - x) + Math.abs(targetY - y) > .02) raf = requestAnimationFrame(loop);
    };
    const sync = () => {
      if (!canAnimate()) { cancelAnimationFrame(raf); raf = 0; }
      if (motionPreference.matches || !finePointer.matches) {
        targetX = targetY = x = y = 0;
        avatar.style.transform = 'translate3d(0, 0, 0)';
      }
      if (canAnimate() && !raf) raf = requestAnimationFrame(loop);
    };
    window.addEventListener('mousemove', e => {
      if (!canAnimate()) return;
      targetX = (e.clientX / innerWidth - .5) * 12;
      targetY = (e.clientY / innerHeight - .5) * 12;
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }).observe(avatar);
    motionPreference.addEventListener('change', sync);
    finePointer.addEventListener('change', sync);
    document.addEventListener('motionchange', sync);
    document.addEventListener('visibilitychange', sync);
  }
</script>

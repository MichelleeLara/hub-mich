---
const steps = [
  { name: 'Entender', title: 'Primero, la pregunta correcta.', text: 'Identifico la fricción, el contexto y lo que necesita la persona. La IA me ayuda a explorar alternativas; el objetivo lo define el problema.', output: 'Un problema concreto y una decisión que se puede explicar.' },
  { name: 'Diseñar', title: 'Darle orden a la complejidad.', text: 'Convierto las piezas en un flujo: qué se ve, qué se hace y qué pasa después. Prototipo, pruebo estados y cuido los detalles que hacen clara la experiencia.', output: 'Una experiencia que se entiende antes de construirla.' },
  { name: 'Construir', title: 'Llevar la idea hasta el uso.', text: 'Conecto la interfaz, los datos y la automatización. Uso IA para acelerar la implementación y reviso el resultado con pruebas y uso real.', output: 'Un producto funcional, con una base que se puede mantener.' },
];
const tools = [
  { label: 'Experiencia', items: 'Figma · React · Next.js · Angular' },
  { label: 'Sistemas', items: 'TypeScript · Supabase · WebSockets' },
  { label: 'IA aplicada', items: 'Claude · Agentes · Automatización' },
  { label: 'Mundo físico', items: 'C · STM32 · FreeRTOS' },
];
---
<section id="Stack" class="section-shell method-section">
  <div class="method-layout">
    <div class="method-intro">
      <p class="section-kicker">03 / Del problema al producto</p>
      <h2 class="section-title">La IA acelera.<br /><span class="quiet">El criterio<br />da dirección.</span></h2>
      <p>Un buen producto nace de conectar las piezas correctas. Así paso de una idea a algo útil, claro y bien construido.</p>
      <div class="method-tools">{tools.map(tool => <div><span>{tool.label}</span><p>{tool.items}</p></div>)}</div>
    </div>
    <div class="method-lab" id="particle-lab">
      <div class="lab-heading"><span>De las piezas al sistema</span><span class="lab-tag">Explora el proceso</span></div>
      <div class="lab-stage"><canvas id="process-particles" aria-hidden="true"></canvas><span class="lab-stage-label" aria-hidden="true">01 / Entender</span><span class="lab-axis axis-x" aria-hidden="true">+</span><span class="lab-axis axis-y" aria-hidden="true">+</span></div>
      <div class="process-buttons requires-js" role="group" aria-label="Etapas de mi proceso">
        {steps.map((step, i) => <button type="button" data-process-stage={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="process-description"><span>0{i + 1}</span>{step.name}</button>)}
      </div>
      <div id="process-description" class="process-description" aria-live="polite" aria-atomic="true">
        {steps.map((step, i) => <div data-process-panel={i} hidden={i !== 0}><h3>{step.title}</h3><p>{step.text}</p><div class="process-output"><span>Resultado</span><p>{step.output}</p></div></div>)}
      </div>
      <p class="lab-footnote">Visualización interactiva de mi proceso de trabajo.</p>
    </div>
  </div>
</section>
<style>
  .method-layout { display: grid; grid-template-columns: 1fr 1.1fr; gap: 72px; align-items: start; }
  h2 { margin: 28px 0; }
  .method-intro > p:not(.section-kicker) { max-width: 380px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .method-tools { margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .method-tools > div { border-top: 1px solid var(--line); padding-top: 14px; }
  .method-tools span { font-size: 12px; font-weight: 600; }
  .method-tools p { margin-top: 8px; font-size: 13px; color: var(--muted); line-height: 1.65; }
  .method-lab { overflow: hidden; border-radius: 24px; background: var(--surface); border: 1px solid transparent; box-shadow: 0 0 0 1px var(--line); }
  .lab-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 28px 0; font-size: 12px; color: var(--muted); }
  .lab-tag { color: var(--accent); }
  .lab-stage { position: relative; height: 264px; margin: 12px 24px 20px; }
  canvas { display: block; width: 100%; height: 100%; }
  .lab-stage-label { position: absolute; bottom: 12px; left: 12px; font-family: monospace; font-size: 11px; color: var(--muted); }
  .lab-axis { position: absolute; top: 12px; color: var(--muted); font-family: monospace; }.axis-x { left: 12px; }.axis-y { right: 12px; }
  .process-buttons { display: flex; gap: 6px; padding: 0 24px; }
  .process-buttons button { display: flex; justify-content: center; gap: 8px; align-items: center; flex: 1; min-height: 48px; border-radius: 10px; color: var(--muted); font-size: 13px; transition: background-color 150ms, color 150ms; }
  .process-buttons button span { font-size: 11px; opacity: 1; }
  .process-buttons button[aria-pressed="true"] { background: var(--ink); color: var(--surface); }
  .process-description { min-height: 236px; padding: 28px; }
  .process-description h3 { font-size: 22px; font-weight: 500; line-height: 1.2; }
  .process-description > div > p { margin-top: 12px; font-size: 14px; line-height: 1.7; color: var(--muted); }
  .process-output { display: flex; align-items: baseline; gap: 16px; padding-top: 18px; margin-top: 20px; border-top: 1px solid var(--line); }
  .process-output > span { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--accent); }
  .process-output p { font-size: 12px; line-height: 1.6; }
  .lab-footnote { padding: 0 28px 24px; font-size: 11px; color: var(--muted); }
  @media (max-width: 767px) { .method-layout { grid-template-columns: 1fr; gap: 40px; } .method-tools { gap: 20px; } .lab-heading { padding: 22px 20px 0; } .lab-stage { margin: 12px 12px 16px; height: 220px; } .process-buttons { padding: 0 14px; } .process-description { padding: 24px 20px; min-height: 270px; } .process-buttons button { font-size: 12px; gap: 6px; } .lab-footnote { padding: 0 20px 22px; } }
</style>
<script>
  const lab = document.getElementById('particle-lab');
  const canvas = document.getElementById('process-particles') as HTMLCanvasElement | null;
  if (lab && canvas) {
    const ctx = canvas.getContext('2d')!;
    const media = matchMedia('(prefers-reduced-motion: reduce)');
    let stage = 0, width = 0, height = 0, raf = 0, visible = false, last = 0;
    const points = Array.from({ length: 540 }, (_, i) => ({ x: Math.random(), y: Math.random(), seed: i * 2.39996, tx: 0, ty: 0 }));
    const paused = () => media.matches || document.documentElement.classList.contains('motion-paused');
    const target = (i: number) => {
      const p = points[i];
      if (stage === 0) { const angle = p.seed; const r = .07 + ((i * 37 % 541) / 541) * .36; return { x: .5 + Math.cos(angle) * r, y: .46 + Math.sin(angle) * r * .86 }; }
      if (stage === 1) { const cluster = i % 3; const n = Math.floor(i / 3); const angle = n * 2.39996; const r = Math.sqrt(n / 180) * .135; return { x: .23 + cluster * .27 + Math.cos(angle) * r, y: .46 + Math.sin(angle) * r }; }
      const n = i % 540; const col = n % 30; const row = Math.floor(n / 30);
      const gap = col > 6 ? .06 : 0;
      return { x: .15 + col / 30 * .64 + gap, y: .14 + row / 18 * .61 };
    };
    const setTargets = () => points.forEach((p, i) => { const t = target(i); p.tx = t.x; p.ty = t.y; if (paused()) { p.x = p.tx; p.y = p.ty; } });
    const render = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      const dark = document.documentElement.classList.contains('dark');
      ctx.fillStyle = dark ? '#edb191' : '#95421d';
      for (let i = 0; i < points.length; i++) {
        const p = points[i];
        const drift = paused() ? 0 : Math.sin(time * .0006 + p.seed) * .006;
        ctx.globalAlpha = .4 + (i % 5) * .12;
        ctx.beginPath(); ctx.arc((p.x + drift) * width, (p.y + drift * .7) * height, i % 11 === 0 ? 1.7 : 1.1, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };
    const tick = (time: number) => {
      if (!visible || document.hidden || paused()) { raf = 0; render(time); return; }
      if (time - last > 32) { const ease = Math.min(.22, (time - last) / 300); points.forEach(p => { p.x += (p.tx - p.x) * ease; p.y += (p.ty - p.y) * ease; }); last = time; render(time); }
      raf = requestAnimationFrame(tick);
    };
    const resume = () => { if (!raf && visible && !document.hidden && !paused()) { last = performance.now(); raf = requestAnimationFrame(tick); } else if (paused()) { setTargets(); render(0); } };
    new ResizeObserver(() => { const box = canvas.getBoundingClientRect(); width = box.width; height = box.height; const dpr = Math.min(devicePixelRatio, 2); canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr); ctx.setTransform(dpr,0,0,dpr,0,0); render(0); }).observe(canvas);
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; resume(); }).observe(canvas);
    new MutationObserver(resume).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    media.addEventListener('change', resume);
    document.addEventListener('visibilitychange', resume);
    lab.querySelectorAll<HTMLButtonElement>('[data-process-stage]').forEach(button => button.addEventListener('click', () => {
      stage = Number(button.dataset.processStage);
      lab.querySelectorAll('[data-process-stage]').forEach((node, i) => node.setAttribute('aria-pressed', String(i === stage)));
      lab.querySelectorAll<HTMLElement>('[data-process-panel]').forEach((node, i) => { node.hidden = i !== stage; });
      lab.querySelector('.lab-stage-label')!.textContent = ['01 / Entender', '02 / Diseñar', '03 / Construir'][stage];
      setTargets(); render(performance.now()); resume();
    }));
    setTargets(); resume();
  }
</script>

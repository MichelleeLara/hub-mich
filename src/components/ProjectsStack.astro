---
import SectionHeading from './SectionHeading.astro';
import ProjectImage from './ProjectImage.astro';
import { projects } from '../data/projectsData.js';
import { projectPresentation } from '../data/projectPresentation';
const { id = 'proyectos' } = Astro.props;
const selected = ['luzia-agentes-ia','anamseals-firmware','inteligencia-logistica','monitoreo-white-label','tracking-aduanal'].map(slug => projects.find(p => p.slug === slug)!);
---
<section id={id} class="section-shell proposal editorial" data-projects-stack>
 <header class="proposal-heading">
  <SectionHeading label="Trabajo seleccionado" title="Ideas que toman forma y generan impacto." />
  <p>De agentes de IA a sistemas que operan en el mundo real. Cada caso cuenta el problema, las decisiones y lo que cambió.</p>
 </header>
 <div class="cases"><div class="case-deck">{selected.map((project,index)=>{
  const visual=projectPresentation[project.slug];
  return <a class="case" href={`/proyectos/${project.slug}`} style={`--case-index:${index}`}>
   <div class="case-tail" aria-hidden="true"><span>0{index+1}</span><span>{project.title}</span><span>↗</span></div>
   <div class="case-image"><ProjectImage name={visual.image} alt={visual.alt} sizes="(min-width:768px) 620px, calc(100vw - 80px)" /></div>
   <div class="case-copy">
    <div class="case-meta"><span class="case-number">0{index+1}</span><span>{visual.category}</span></div>
    <h3>{project.title}</h3>
    <p class="case-story">{visual.summary}</p>
    {project.slug==='luzia-agentes-ia'?<p class="case-status">Proyecto propio · MVP en prevalidación</p>:<div class="case-result"><strong>{visual.result}</strong><span>{visual.resultLabel}</span></div>}
    <span class="case-link">Explorar el caso <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg></span>
   </div>
  </a>;
 })}</div></div>
</section>
<style>

 .proposal-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:var(--space-7); margin-bottom:var(--space-8); }
 .proposal-heading>p { max-width:290px; font-size:var(--fs-body); color:var(--muted); line-height:1.7; }
 .case { color:var(--ink); display:grid; min-width:0; }
 .case-image { overflow:hidden; border-radius:var(--radius-lg); aspect-ratio:1.4; background:var(--surface); }
 .case-image :global(img) { width:100%; height:100%; object-fit:cover; transition:transform .6s cubic-bezier(.2,.7,.2,1); }
 .case:hover .case-image :global(img) { transform:scale(1.025); }
 .case-meta { display:flex; gap:var(--space-4); align-items:center; color:var(--muted); font-size:var(--fs-small); }
 .case-number { color:var(--accent); font-family:var(--font-mono); }
 h3 { font-family:var(--font-display); font-weight:600; font-size:clamp(28px,3vw,42px); letter-spacing:-.03em; line-height:1.1; margin:var(--space-5) 0 var(--space-4); }
 .case-story { color:var(--muted); font-size:var(--fs-body); line-height:1.65; max-width:460px; }
 .case-result { border-top:1px solid var(--line); margin-top:var(--space-6); padding-top:var(--space-5); display:flex; flex-direction:column; gap:var(--space-2); }
 .case-result strong { font-family:var(--font-display); font-size:32px; line-height:1.1; font-weight:500; }
 .case-result span,.case-status { font-size:var(--fs-small); color:var(--muted); }
 .case-status { margin-top:var(--space-6); padding-top:var(--space-5); border-top:1px solid var(--line); line-height:1.6; }
 .case-link { display:inline-flex; gap:var(--space-4); align-items:center; min-height:44px; margin-top:var(--space-5); font-size:var(--fs-small); }
 .case-link svg { width:20px; height:20px; transition:transform .25s; }
 .case:hover .case-link svg { transform:translate(3px,-3px); }
 .editorial .cases { position:relative; isolation:isolate; }
 .editorial .case-deck { display:flex; flex-direction:column; gap:var(--space-5); }
 .editorial .case { position:relative; z-index:calc(var(--case-index) + 1); grid-template-columns:minmax(0,1.45fr) minmax(0,1fr); column-gap:var(--space-6); row-gap:var(--space-4); align-items:center; padding:var(--space-3) var(--space-5) var(--space-5); border:1px solid var(--line); border-radius:var(--radius-lg); background:var(--bg); box-shadow:var(--shadow-float); margin-bottom:0; scroll-margin-top:112px; }
 .editorial .case:last-child { margin-bottom:0; }
 .editorial .case:focus-visible { z-index:10; }
 .case-tail { grid-column:1/-1; display:flex; align-items:center; gap:var(--space-3); color:var(--muted); font-size:var(--fs-small); line-height:20px; }
 .case-tail span:first-child { color:var(--accent); font-family:var(--font-mono); }
 .case-tail span:last-child { margin-left:auto; }
 .editorial .case-image { aspect-ratio:1.85; border-radius:var(--radius-md); }
 .editorial h3 { font-size:clamp(28px,2.8vw,38px); margin-top:var(--space-4); }
 .editorial .case-result,.editorial .case-status { margin-top:var(--space-4); padding-top:var(--space-4); }
 .editorial .case-link { margin-top:var(--space-3); }
 .editorial .case:nth-child(even) .case-image { order:2; }
 .editorial .case:nth-child(even) { grid-template-columns:minmax(0,1fr) minmax(0,1.45fr); }
 @media(max-width:767px) {
  .editorial .case,.editorial .case:nth-child(even) { grid-template-columns:minmax(0,1fr); }
  .proposal-heading { display:block; margin-bottom:var(--space-6); }
  .proposal-heading>p { max-width:450px; margin-top:var(--space-5); }
  .editorial .case { gap:var(--space-4); padding:var(--space-2) var(--space-4) var(--space-4); margin-bottom:0; }
  .editorial .case-image { aspect-ratio:auto; height:clamp(120px,19svh,160px); }
  .editorial .case-meta { font-size:12px; gap:var(--space-2); }
  .editorial .case-story { font-size:var(--fs-small); }
  .editorial h3 { font-size:28px; margin:var(--space-3) 0; }
  .editorial .case-result strong { font-size:28px; }
  .case-tail { font-size:12px; }
  .editorial .case:nth-child(even) .case-image { order:0; }
  .editorial .cases { gap:0; }
  .case-result,.case-status { margin-top:var(--space-5); }
 }
 @media(prefers-reduced-motion:reduce) { .case-image :global(img),.case-link svg { transition:none; } }
 :global(html.motion-paused) .case-image :global(img),:global(html.motion-paused) .case-link svg { transition:none; }
 .cases.stack-ready { height:var(--stack-runway); }
 .stack-ready .case-deck { position:sticky; top:var(--stack-top); height:var(--stack-height); display:block; }
 .stack-ready .case { position:absolute; top:calc(var(--case-index)*var(--stack-tail)); left:0; right:0; transform:translate3d(0,var(--stack-entry,0px),0); visibility:var(--stack-visibility,visible); }
 .stack-ready .case:focus-visible { transform:none; visibility:visible; }

</style>
<script>
 const reduced=matchMedia('(prefers-reduced-motion:reduce)');
 document.querySelectorAll<HTMLElement>('[data-projects-stack]').forEach(section=>{
  const stack=section.querySelector<HTMLElement>('.cases')!;
  const deck=stack.querySelector<HTMLElement>('.case-deck')!;
  const cards=Array.from(deck.querySelectorAll<HTMLElement>('.case'));
  let unit=300,cardHeight=0,stackTop=100,tail=44,frame=0,phase=0,target=0,velocity=0,last=0,visible=false;
  const paused=()=>document.documentElement.classList.contains('motion-paused');
  function paint(){
   cards.forEach((card,index)=>{
    const entry=index===0?1:Math.max(0,Math.min(1,(phase-index+.65)/.65));
    // Zero velocity and acceleration at both ends soften the landing.
    const eased=entry*entry*entry*(entry*(entry*6-15)+10);
    card.style.setProperty('--stack-entry',`${(1-eased)*(cardHeight+tail*cards.length+40)}px`);
    card.style.setProperty('--stack-visibility',entry===0?'hidden':'visible');
   });
  }
  function tick(time:number){
   frame=0;
   if(!stack.classList.contains('stack-ready')||document.hidden)return;
   const dt=Math.min(50,time-last||16)/1000;last=time;
   // A critically damped spring absorbs wheel/trackpad steps without bounce.
   // Integrating analytically keeps the same feel at different frame rates.
   const omega=9.5,delta=phase-target,decay=Math.exp(-omega*dt);
   const travel=(velocity+omega*delta)*dt;
   phase=target+(delta+travel)*decay;
   velocity=(velocity-omega*travel)*decay;
   if(Math.abs(target-phase)<.0002&&Math.abs(velocity)<.002){phase=target;velocity=0;}
   paint();
   if(phase!==target)frame=requestAnimationFrame(tick);
  }
  function update(){
   if(!stack.classList.contains('stack-ready'))return;
   target=Math.max(0,(stackTop-stack.getBoundingClientRect().top)/unit);
   if(visible&&!frame&&!document.hidden)frame=requestAnimationFrame(tick);
  }
  function measure(){
   cancelAnimationFrame(frame);frame=0;stack.classList.remove('stack-ready');
   if(section.closest<HTMLElement>('[data-proposal]')?.hidden||reduced.matches||paused())return;
   const mobile=innerWidth<768;
   stackTop=mobile?80:100;tail=mobile?28:44;
   cardHeight=Math.max(...cards.map(card=>card.getBoundingClientRect().height));
   const height=cardHeight+(cards.length-1)*tail;
   if(height>innerHeight-stackTop-(mobile?84:24))return;
   // A longer scroll interval controls actual travel speed, not just easing.
   unit=Math.max(360,Math.min(440,innerHeight*.52));
   stack.style.setProperty('--stack-top',`${stackTop}px`);
   stack.style.setProperty('--stack-tail',`${tail}px`);
   stack.style.setProperty('--stack-height',`${height}px`);
   stack.style.setProperty('--stack-runway',`${height+unit*cards.length}px`);
   stack.classList.add('stack-ready');
   phase=target=Math.max(0,(stackTop-stack.getBoundingClientRect().top)/unit);velocity=0;last=0;
   paint();
  }
  new IntersectionObserver(entries=>{
   visible=entries[0].isIntersecting;
   if(visible){last=0;update();}else {cancelAnimationFrame(frame);frame=0;}
  },{rootMargin:'120px'}).observe(stack);
  addEventListener('scroll',update,{passive:true});
  addEventListener('resize',measure,{passive:true});
  document.addEventListener('project-stack-refresh',measure);
  document.addEventListener('visibilitychange',()=>{if(!document.hidden){last=0;update();}});
  reduced.addEventListener('change',measure);
  let wasPaused=paused();
  new MutationObserver(()=>{const now=paused();if(now!==wasPaused){wasPaused=now;measure();}}).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  document.fonts.ready.then(measure);
 });
</script>

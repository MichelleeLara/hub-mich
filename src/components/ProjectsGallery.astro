---
import SectionHeading from './SectionHeading.astro';
import ProjectImage from './ProjectImage.astro';
import { projects } from '../data/projectsData.js';
import { projectPresentation } from '../data/projectPresentation';
import { projectGalleryCovers } from '../data/projectGalleryCovers';
const selected = ['luzia-agentes-ia','anamseals-firmware','inteligencia-logistica','monitoreo-white-label','tracking-aduanal'].map(slug => projects.find(p => p.slug === slug)!);
const tags: Record<string,string[]> = {
 'luzia-agentes-ia':['IA','Producto','UX'],
 'anamseals-firmware':['IoT','Firmware','Hardware'],
 'inteligencia-logistica':['Mapas','Frontend','Datos'],
 'monitoreo-white-label':['Arquitectura','Liderazgo'],
 'tracking-aduanal':['Tiempo real','Logística'],
};
---
<section id="proyectos" class="section-shell project-gallery">
 <header class="gallery-heading">
  <SectionHeading label="Trabajo seleccionado" title="Ideas que toman forma y generan impacto." />
  <p>De agentes de IA a sistemas que operan en el mundo real. Explora cada proyecto y conoce lo que cambió.</p>
 </header>
 <div class="gallery-grid">
  {selected.map(project=>{
   const visual=projectPresentation[project.slug];
   return <button class="gallery-card" type="button" data-project-open={project.slug} aria-haspopup="dialog" aria-controls={`preview-${project.slug}`} aria-label={`Ver preview de ${project.title}`}>
    <div class="project-cover">
     <ProjectImage name={projectGalleryCovers[project.slug]} desktopName={project.slug === 'luzia-agentes-ia' ? 'luzia-studio-wide-v2' : undefined} alt={visual.alt} sizes={project.slug === 'luzia-agentes-ia' ? '(min-width:768px) 1200px, calc(100vw - 48px)' : '(min-width:768px) 600px, calc(100vw - 48px)'} />
     <span class="cover-shade" aria-hidden="true"></span>
     <span class="project-tags" aria-hidden="true">{tags[project.slug].map(tag=><span>{tag}</span>)}</span>
     <div class="cover-title"><h3>{project.title}</h3><p>{project.meta}</p></div>
     <span class="cover-open" aria-hidden="true">↗</span>
    </div>
   </button>;
  })}
 </div>
 {selected.map(project=>{
  const visual=projectPresentation[project.slug];
  return <dialog class="project-preview" id={`preview-${project.slug}`} aria-labelledby={`preview-title-${project.slug}`}>
   <article>
    <div class="project-cover preview-cover">
     <ProjectImage name={projectGalleryCovers[project.slug]} desktopName={project.slug === 'luzia-agentes-ia' ? 'luzia-studio-wide-v2' : undefined} alt={visual.alt} sizes="(min-width:768px) 900px, 100vw" />
     <span class="cover-shade" aria-hidden="true"></span>
     <span class="project-tags" aria-hidden="true">{tags[project.slug].map(tag=><span>{tag}</span>)}</span>
     <div class="cover-title"><h3 id={`preview-title-${project.slug}`}>{project.title}</h3><p>{project.meta}</p></div>
    </div>
    <button type="button" class="preview-close" aria-label="Cerrar preview" autofocus><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    <div class="preview-content">
     <p class="preview-headline">{visual.headline}</p>
     <p class="preview-summary">{visual.summary}</p>
     <div class="preview-bottom">
      {project.slug==='luzia-agentes-ia'?<p class="preview-status">Proyecto propio<br/><span>MVP en prevalidación</span></p>:<div class="preview-result"><strong>{visual.result}</strong><span>{visual.resultLabel}</span></div>}
      <a class="preview-more" href={`/proyectos/${project.slug}`}>Ver más <span aria-hidden="true">↗</span></a>
     </div>
    </div>
   </article>
  </dialog>;
 })}
</section>
<div class="project-gallery-backdrop" aria-hidden="true"></div>
<style>
 .gallery-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:40px; margin-bottom:40px; }
 .gallery-heading>p { max-width:290px; font-size:var(--fs-body); line-height:1.7; color:var(--muted); }
 .gallery-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
 .gallery-card { display:block; width:100%; min-width:0; padding:0; border:0; background:transparent; text-align:left; border-radius:28px; }
 .gallery-card:first-child { grid-column:1/-1; }
 .project-cover { position:relative; height:380px; overflow:hidden; border-radius:28px; background:#d9d6d3; color:#fff; isolation:isolate; }
 .gallery-card:first-child .project-cover { height:460px; }
 .project-cover :global(img) { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
 .cover-shade { position:absolute; inset:0; background:linear-gradient(180deg,transparent 38%,rgb(0 0 0 / .2) 60%,rgb(0 0 0 / .8)); }
 .project-tags { position:absolute; top:24px; right:24px; display:flex; flex-wrap:wrap; justify-content:flex-end; gap:8px; max-width:calc(100% - 48px); }
 .project-tags>span { padding:8px 13px; border:1px solid rgb(255 255 255 / .18); border-radius:999px; background:rgb(24 24 24 / .65); backdrop-filter:blur(12px); font-size:12px; font-weight:500; }
 .cover-title { position:absolute; bottom:32px; left:32px; right:52px; }
 .cover-title h3 { font-family:var(--font-display); font-weight:600; font-size:clamp(28px,3vw,42px); line-height:1.1; letter-spacing:-.035em; }
 .cover-title p { margin-top:10px; font-size:var(--fs-small); color:rgb(255 255 255 / .8); }
 .cover-open { position:absolute; bottom:34px; right:28px; font-size:24px; }
 .project-preview { position:fixed; inset:0; margin:auto; padding:0; width:min(860px,calc(100% - 48px)); max-width:none; max-height:calc(100svh - 64px); border:0; outline:0; border-radius:28px; background:var(--bg); color:var(--ink); overflow:auto; overscroll-behavior:contain; box-shadow:0 24px 100px rgb(0 0 0 / .3); }
 .project-preview::backdrop { background:transparent; }
 .project-gallery-backdrop { position:fixed; inset:0; z-index:10000; pointer-events:none; background:rgb(0 0 0 / .55); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); opacity:0; visibility:hidden; will-change:opacity; }
 .project-preview article { position:relative; }
 .preview-cover { height:clamp(240px,44svh,370px); border-radius:0; }
 .preview-cover :global(img) { object-position:center 20%; }
 .preview-cover .project-tags { right:76px; }
 .preview-close { position:absolute; top:18px; right:18px; width:40px; height:40px; border:1px solid rgb(255 255 255 / .2); border-radius:50%; background:rgb(24 24 24 / .7); color:#fff; display:grid; place-items:center; backdrop-filter:blur(10px); }
 .preview-close svg { width:20px; height:20px; }
 .preview-content { padding:28px 32px 32px; }
 .preview-headline { font-family:var(--font-display); font-size:clamp(24px,2.5vw,30px); line-height:1.2; font-weight:600; letter-spacing:-.025em; }
 .preview-summary { margin-top:12px; max-width:640px; font-size:var(--fs-body); line-height:1.65; color:var(--muted); }
 .preview-bottom { margin-top:24px; padding-top:20px; border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; gap:24px; }
 .preview-result { display:flex; align-items:center; gap:16px; }
 .preview-result strong { color:var(--accent); font:600 28px/1.1 var(--font-display); white-space:nowrap; }
 .preview-result span,.preview-status span { font-size:var(--fs-small); color:var(--muted); }
 .preview-status { font-size:var(--fs-small); line-height:1.6; }
 .preview-more { flex-shrink:0; display:inline-flex; justify-content:center; align-items:center; gap:24px; padding:12px 22px; min-height:48px; border-radius:999px; background:var(--accent); color:var(--bg); font-size:var(--fs-small); font-weight:600; }
 @media(max-width:767px) {
  .gallery-heading { display:block; margin-bottom:28px; }
  .gallery-heading>p { max-width:450px; margin-top:20px; }
  .gallery-grid { grid-template-columns:1fr; gap:20px; }
  .project-cover,.gallery-card:first-child .project-cover { height:340px; border-radius:22px; }
  .cover-title { left:24px; bottom:24px; }
  .project-tags { top:20px; right:20px; }
  .project-tags>span { font-size:11px; padding:6px 10px; }
  .project-preview { width:calc(100% - 24px); max-height:calc(100svh - 24px); border-radius:22px; }
  .preview-cover { height:280px; border-radius:0; }
  .preview-content { padding:24px; }
  .preview-result { align-items:flex-start; flex-direction:column; gap:6px; }
 }
</style>
<style is:global>
 html.project-gallery-ready { scrollbar-gutter:stable; }
 html.project-preview-open { overflow:hidden; }
</style>
<script>
 const gallery=document.querySelector<HTMLElement>('.project-gallery');
 if(gallery){
  let busy=false,pendingClose=false,trigger:HTMLButtonElement|null=null,active:HTMLDialogElement|null=null;
  const pointer=document.querySelector<HTMLElement>('.ios-pointer'),pointerParent=pointer?.parentElement;
  const backdrop=document.querySelector<HTMLElement>('.project-gallery-backdrop')!;
  document.body.append(backdrop);
  document.documentElement.classList.add('project-gallery-ready');
  const reduced=()=>matchMedia('(prefers-reduced-motion:reduce)').matches||document.documentElement.classList.contains('motion-paused');
  const transition=async(update:()=>void,dialog:HTMLDialogElement,source:HTMLElement,closing=false)=>{
   if(reduced()){
    backdrop.style.visibility=closing?'hidden':'visible';
    backdrop.style.opacity=closing?'0':'1';
    update();return;
   }
   const card=source.getBoundingClientRect();
   if(!closing){backdrop.style.visibility='visible';update();}
   const expanded=dialog.getBoundingClientRect();
   const hero=dialog.querySelector<HTMLElement>('.preview-cover')!;
   const heroHeight=hero.getBoundingClientRect().height;
   const originalStyle=dialog.getAttribute('style');
   const tags=dialog.querySelector<HTMLElement>('.project-tags')!;
   const cardTags=getComputedStyle(source.querySelector('.project-tags')!);
   const previewTags=getComputedStyle(tags);
   const collapsedTags={right:cardTags.right,top:cardTags.top};
   const expandedTags={right:previewTags.right,top:previewTags.top};
   const expandedShadow=getComputedStyle(dialog).boxShadow;
   const duration=closing?500:600;
   const easing=closing?'cubic-bezier(.4,0,.2,1)':'cubic-bezier(.22,1,.36,1)';
   const geometry=(rect:DOMRect)=>({left:`${rect.left}px`,top:`${rect.top}px`,width:`${rect.width}px`,height:`${rect.height}px`});
   // Animate real layout dimensions: object-fit recomputes the crop without stretching the photo.
   Object.assign(dialog.style,{inset:'auto',margin:'0',left:`${expanded.left}px`,top:`${expanded.top}px`,width:`${expanded.width}px`,height:`${expanded.height}px`,overflow:'hidden',maxHeight:'none'});
   dialog.dataset.phase=closing?'closing':'opening';
   const background=backdrop.animate(closing?[{opacity:1},{opacity:0}]:[{opacity:0},{opacity:1}],{duration,easing,fill:'both'});
   // Keep the underlying card in place throughout so the blurred background never changes suddenly.
   const collapsedBox={...geometry(card),boxShadow:'0 0 0 0 rgb(0 0 0 / 0)'};
   const expandedBox={...geometry(expanded),boxShadow:expandedShadow};
   const box=dialog.animate(closing?[expandedBox,collapsedBox]:[collapsedBox,expandedBox],{duration,easing,fill:'both'});
   const chips=tags.animate(closing?[expandedTags,collapsedTags]:[collapsedTags,expandedTags],{duration,easing,fill:'both'});
   const image=hero.animate(closing?[{height:`${heroHeight}px`},{height:`${card.height}px`}]:[{height:`${card.height}px`},{height:`${heroHeight}px`}],{duration,easing,fill:'both'});
   const content=dialog.querySelector<HTMLElement>('.preview-content')!;
   const contentAnimation=content.animate(closing?[{opacity:1},{opacity:0}]:[{opacity:0},{opacity:1}],{duration:closing?140:260,delay:closing?0:220,fill:'both'});
   const closeAnimation=dialog.querySelector('.preview-close')!.animate(closing?[{opacity:1},{opacity:0}]:[{opacity:0},{opacity:1}],{duration:140,delay:closing?0:360,fill:'both'});
   try{await Promise.all([box.finished,background.finished]);}catch{}
   backdrop.style.opacity=closing?'0':'1';
   background.cancel();
   if(closing)backdrop.style.visibility='hidden';
   if(closing)update();
   box.cancel();image.cancel();chips.cancel();contentAnimation.cancel();closeAnimation.cancel();
   if(originalStyle===null)dialog.removeAttribute('style');else dialog.setAttribute('style',originalStyle);
   delete dialog.dataset.phase;
  };
  const close=async()=>{
   if(!active||!trigger)return;
   if(busy){pendingClose=true;return;}busy=true;pendingClose=false;
   const dialog=active,button=trigger;
   const source=button;
   await transition(()=>{
    dialog.close();
    if(pointer&&pointerParent)pointerParent.append(pointer);

    document.documentElement.classList.remove('project-preview-open');
   },dialog,source,true);
   active=null;trigger=null;busy=false;button.focus({preventScroll:true});
  };
  gallery.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach(button=>{
   button.addEventListener('click',async()=>{
    if(busy||active)return;busy=true;trigger=button;
    const dialog=document.getElementById(`preview-${button.dataset.projectOpen}`) as HTMLDialogElement;
    const source=button;
    // Decode the expanded asset before the first animated frame; hidden lazy images otherwise flash blank.
    await Promise.all(Array.from(dialog.querySelectorAll('img')).map(image=>{
     image.loading='eager';return image.decode().catch(()=>{});
    }));

    await transition(()=>{

     document.documentElement.classList.add('project-preview-open');dialog.showModal();dialog.scrollTop=0;active=dialog;
     if(pointer)dialog.append(pointer);
    },dialog,source);busy=false;
    if(pendingClose)close();
   });
  });
  gallery.querySelectorAll<HTMLDialogElement>('.project-preview').forEach(dialog=>{
   dialog.querySelector('.preview-close')!.addEventListener('click',close);
   dialog.addEventListener('cancel',event=>{event.preventDefault();close();});
   dialog.addEventListener('click',event=>{
    if(event.target!==dialog)return;
    const box=dialog.getBoundingClientRect();
    if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)close();
   });
  });
 }
</script>

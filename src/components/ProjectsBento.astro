---
// Sección "Proyectos" — Bento Grid asimétrico (60/40 · 40/60).
// Cada tarjeta lleva `data-magnetic-card`: el sistema de partículas global
// (ParticlesBackground) detecta el hover y atrae el polvo hacia el borde de
// la tarjeta activa (glow magnético). Aquí NO hay canvas propio.

// TODO(mich): ajustar oraciones de impacto y tags reales de cada proyecto
const projects = [
  {
    title: 'Rand Abogados',
    impact: 'Lideré el desarrollo end-to-end y recorté los tiempos de entrega un 25%.',
    tags: ['Next.js', 'Tailwind', 'Figma'],
    img: '/thumbnail_rand.webp',
    alt: 'Vista del sitio web de Rand Abogados',
    url: 'https://1-rand.vercel.app/',
    wide: true,
  },
  {
    title: 'Nomad Technologies',
    impact: 'Convertí datos técnicos de energía en decisiones simples de leer.',
    tags: ['React', 'Data viz'],
    img: '/thumbnail_nomad.webp',
    alt: 'Vista de la plataforma Nomad Technologies',
    url: 'https://app-energy.vercel.app/',
    wide: false,
  },
  {
    title: 'Medibiologica',
    impact: 'Rediseñé el flujo de agenda para reservar estudios en menos de un minuto.',
    tags: ['Astro', 'UX'],
    img: '/thumbnail_medibiologic.webp',
    alt: 'Vista del sitio de Medibiologica',
    url: 'https://medi-biologic.vercel.app/',
    wide: false,
  },
  {
    title: 'Tigrillas',
    impact: 'Una marca deportiva con presencia digital tan viva como su equipo.',
    tags: ['Next.js', 'Branding'],
    img: '/thumbnail_tigrillas.webp',
    alt: 'Vista del sitio de Tigrillas',
    url: 'https://www.tigrillas.com.mx/',
    wide: true,
  },
];
---

<section id="proyectos-destacados" class="relative mx-auto max-w-6xl px-6 pt-[max(12vh,100px)] pb-24">
  <!-- Eyebrow: mismo lenguaje que Hero y Sobre mí -->
  <h2
    class="flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.1em]"
  >
    <span class="text-gray-800 dark:text-secondary">Proyectos</span>
    <span class="text-gray-300 dark:text-[#3a3a3a]" aria-hidden="true">|</span>
    <span class="text-terteary">Trabajo seleccionado</span>
  </h2>

  <!-- Titular editorial a dos tonos, estilo referencia -->
  <p
    class="mx-auto mt-8 max-w-3xl text-center font-ClashDisplay text-4xl font-semibold leading-tight tracking-wide md:text-5xl"
  >
    <span class="text-gray-900 dark:text-secondary">Lo que he construido.</span>
    <span class="text-gray-400 dark:text-[#5a5a5a]"> Proyectos que hablan por mí.</span>
  </p>

  <!-- Bento Grid: fila 1 → 60/40, fila 2 → 40/60; móvil apila -->
  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-5">
    {
      projects.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic-card
          class={`group relative flex min-h-[380px] flex-col overflow-hidden rounded-3xl border border-black/10 bg-[#f2f2f0] p-6 transition-colors duration-300 hover:border-black/20 dark:border-white/10 dark:bg-[#1d1d1d] dark:hover:border-white/20 ${
            p.wide ? 'md:col-span-3' : 'md:col-span-2'
          }`}
        >
          <div class="flex flex-wrap justify-end gap-2">
            {p.tags.map((t) => (
              <span class="rounded-full border border-black/10 bg-black/5 px-3.5 py-1.5 text-xs font-semibold text-gray-700 backdrop-blur-sm dark:border-white/10 dark:bg-white/10 dark:text-gray-300">
                {t}
              </span>
            ))}
          </div>

          <div class="flex flex-1 items-center justify-center overflow-hidden py-6">
            <img
              src={p.img}
              alt={p.alt}
              loading="lazy"
              class="max-h-[240px] w-auto rounded-xl shadow-lg transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>

          <div>
            <h3 class="font-ClashDisplay text-2xl font-semibold tracking-wide text-gray-900 dark:text-secondary">
              {p.title}
            </h3>
            <p class="mt-1 text-sm text-terteary">{p.impact}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

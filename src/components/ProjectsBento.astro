---
// Sección "Proyectos" — Bento Grid asimétrico que enlaza a los casos de estudio.
// Fuente de datos: src/data/projectsData.js (misma que las páginas de detalle
// /proyectos/[slug]). Cada tarjeta lleva `data-magnetic-card`: el sistema de
// partículas global (ParticlesBackground) detecta el hover y atrae el polvo
// hacia el borde de la tarjeta activa (glow magnético). Aquí NO hay canvas propio.

import { projects } from '../data/projectsData.js';

// Layout: grid de 2 columnas con cards grandes (referencia midu.design).
// Fila 1 → AnamSeals a todo el ancho · Filas 2-3 → los otros cuatro en pares.
// Con 5 proyectos esto llena la retícula sin huecos. Móvil apila.
// `aspect` manda la altura (no `min-h`): en móvil todas van 4/3, y en desktop la
// destacada se abre a 16/9 mientras las de par van verticales como en la ref.
// `cover` → la foto va de fondo, a sangre, llenando la card.
// `pos` = background-position del recorte: 'center top' cuando el sujeto está
// arriba y centrar lo decapitaría.
const PAIR = 'aspect-[4/3] md:aspect-[5/4]';
const layout = [
  { slug: 'anamseals-firmware', span: 'md:col-span-2', aspect: 'aspect-[4/3] md:aspect-[2/1]', featured: true, cover: true, pos: 'center top' },
  { slug: 'monitoreo-white-label', span: '', aspect: PAIR, featured: false, cover: true, pos: 'center center' },
  { slug: 'inteligencia-logistica', span: '', aspect: PAIR, featured: false, cover: true, pos: 'center center' },
  { slug: 'tracking-aduanal', span: '', aspect: PAIR, featured: false, cover: true, pos: 'center top' },
  { slug: 'luzia-agentes-ia', span: '', aspect: PAIR, featured: false, cover: true, pos: 'center center' },
];

// El velo que asienta el título va como PRIMERA capa de background, con la foto
// como segunda, sobre el mismo elemento que lleva el `rounded-3xl`.
// Motivo (medido): con la foto en un `<img>` y el velo en un div aparte, Chrome
// rasteriza el recorte redondeado de cada capa con cobertura distinta, y la foto
// se filtra como una hairline de 1px sobre el arco (brillo 103 contra 33 del
// interior). Probé viñeta, sangrado del velo, `isolation`, `translateZ` y una capa
// interna: todas siguen en +67. Un solo elemento con dos backgrounds da +0.
const VEIL =
  'linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.74) 16%, rgba(0,0,0,0.38) 36%, transparent 58%)';

const cards = layout
  .map((l) => ({ ...l, ...projects.find((p) => p.slug === l.slug) }))
  .filter((c) => c.title);
---

<section id="proyectos-destacados" class="relative mx-auto max-w-6xl px-6 pt-[max(12vh,100px)] pb-24">
  <!-- Eyebrow: mismo lenguaje que Hero y Sobre mí -->
  <h2
    class="flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.1em]"
  >
    <span class="text-gray-800 dark:text-secondary">Proyectos</span>
    <span class="text-gray-300 dark:text-[#3a3a3a]" aria-hidden="true">|</span>
    <span class="text-terteary">Casos de estudio</span>
  </h2>

  <!-- Titular editorial a dos tonos, estilo referencia -->
  <p
    class="mx-auto mt-8 max-w-3xl text-center font-ClashDisplay text-4xl font-semibold leading-tight tracking-wide md:text-5xl"
  >
    <span class="text-gray-900 dark:text-secondary">Lo que he construido.</span>
    <span class="text-gray-400 dark:text-[#5a5a5a]"> Del problema al impacto medible.</span>
  </p>

  <!-- Grid de 2 columnas con cards grandes; móvil apila -->
  <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
    {
      cards.map((p) => (
        <a
          href={`/proyectos/${p.slug}`}
          data-magnetic-card
          class={`group relative flex flex-col justify-end overflow-hidden rounded-3xl bg-zinc-950 transition-transform duration-500 ease-out hover:scale-[1.015] ${p.aspect} ${p.span}`}
          style={`background-image: ${VEIL}, url('${p.thumbnail}'); background-size: auto, cover; background-position: center; background-repeat: no-repeat;`}
        >
          <!-- Tags flotantes arriba-derecha -->
          {p.brief?.tipo && (
            <div class="absolute right-6 top-6 z-10 flex max-w-[80%] flex-wrap justify-end gap-2 md:right-7 md:top-7">
              {p.brief.tipo.map((tag) => (
                <span class="rounded-full border border-white/15 bg-black/60 px-4 py-2 text-xs font-medium text-white backdrop-blur-md md:text-sm">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <!-- Título + categoría overlaid abajo-izquierda -->
          <div class="relative z-10 px-7 pb-8 pt-16 md:px-9 md:pb-9">
            <h3 class="font-ClashDisplay text-3xl font-semibold tracking-wide text-white md:text-[2.5rem] md:leading-[1.1]">
              {p.title}
            </h3>
            <p class="mt-2 text-sm text-zinc-300 md:text-base">{p.meta}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

---
import { projects } from '../data/projectsData.js';
import ProjectImage from './ProjectImage.astro';
import { projectPresentation } from '../data/projectPresentation';
const featured = projects.find(p => p.slug === 'luzia-agentes-ia');
const others = ['anamseals-firmware', 'inteligencia-logistica', 'monitoreo-white-label', 'tracking-aduanal'].map(slug => projects.find(p => p.slug === slug));
---
<section id="proyectos" class="section-shell projects-section">
  <div class="projects-heading">
    <div><p class="section-kicker">02 / Trabajo seleccionado</p><h2 class="section-title">La idea toma forma.<br /><span class="quiet">El impacto la sostiene.</span></h2></div>
    <p>De agentes de IA a sistemas que operan en el mundo real. Cada caso cuenta el problema, las decisiones y lo que cambió.</p>
  </div>
  <a href={`/proyectos/${featured.slug}`} class="featured-project pressable" data-magnetic-card>
    <div class="featured-copy">
      <div class="project-category">IA aplicada <span>MVP · Pre-validación</span></div>
      <h3>Luz.ia</h3>
      <p>Hacer simple la operación detrás de un ecosistema de agentes de IA para el bienestar.</p>
      <div class="featured-metric"><strong>&lt; 2 min</strong><span>De un formulario a un reporte con IA</span></div>
      <span class="text-link">Explorar el caso <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
    </div>
    <div class="featured-visual"><ProjectImage name="luzia" sizes="(min-width: 1152px) 660px, (min-width: 768px) calc((100vw - 48px) * 0.6), calc(100vw - 48px)" alt="Visual de Luz.ia: panel de conversaciones, pacientes y agenda" /></div>
  </a>
  <div class="project-grid">
    {others.map(p => {
      const visual = projectPresentation[p.slug];
      return <a href={`/proyectos/${p.slug}`} class="project-card" data-magnetic-card>
        <div class="project-card-image"><ProjectImage name={visual.image} alt={visual.alt} /></div>
        <div class="project-card-tags">{p.brief.tipo.map(tag => <span>{tag}</span>)}</div>
        <div class="project-card-info"><h3>{p.title}</h3><p>{p.meta}</p></div>
      </a>;
    })}
  </div>
</section>
<style>
  .projects-section { padding-top: 64px; }
  .projects-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; margin-bottom: 48px; }
  h2 { margin-top: 24px; }
  .projects-heading > p { max-width: 290px; color: var(--muted); line-height: 1.7; font-size: 15px; }
  .featured-project { display: grid; grid-template-columns: .8fr 1.2fr; overflow: hidden; border-radius: 24px; border: 1px solid transparent; background: var(--surface); box-shadow: 0 0 0 1px var(--line); }
  .featured-copy { padding: 40px; }
  .project-category { display: flex; gap: 16px; align-items: center; color: var(--accent); font-size: 12px; font-weight: 600; }
  .project-category > span { font-weight: 400; color: var(--muted); }
  .featured-copy h3 { font-family: ClashDisplay, sans-serif; font-size: 56px; margin: 28px 0 16px; line-height: 1; }
  .featured-copy > p { font-size: 17px; line-height: 1.6; max-width: 320px; }
  .featured-metric { display: flex; flex-direction: column; gap: 6px; margin: 32px 0 20px; padding-top: 24px; border-top: 1px solid var(--line); }
  .featured-metric strong { font-size: 28px; font-weight: 500; }
  .featured-metric span { color: var(--muted); font-size: 12px; }
  .featured-visual { min-width: 0; height: 100%; }
  .featured-visual :global(img) { object-position: center; }
  .project-grid { margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .project-card { position: relative; display: flex; align-items: flex-end; min-width: 0; aspect-ratio: 1.25; overflow: hidden; border-radius: 24px; background: #171717; box-shadow: 0 0 0 1px var(--line); color: #fff; }
  .project-card-image { position: absolute; inset: 0; }
  .project-card-image :global(img) { transition: transform 400ms var(--ease-out); }
  .project-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 30%, rgb(0 0 0 / .12) 45%, rgb(0 0 0 / .78) 74%, #111 100%); pointer-events: none; }
  .project-card-tags { position: absolute; z-index: 1; top: 24px; right: 24px; left: 24px; display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8px; }
  .project-card-tags span { padding: 9px 14px; border: 1px solid rgb(255 255 255 / .25); border-radius: 999px; background: rgb(36 36 36 / .78); color: #fff; font-size: 12px; font-weight: 500; line-height: 1.2; }
  .project-card-info { position: relative; z-index: 1; width: 100%; padding: 32px; }
  .project-card-info h3 { font-family: ClashDisplay, sans-serif; font-size: clamp(30px, 3.2vw, 44px); font-weight: 600; line-height: 1.1; text-wrap: balance; }
  .project-card-info > p { margin-top: 16px; color: #e0e0e0; font-size: 16px; line-height: 1.5; }
  @media (hover: hover) { .project-card:hover { box-shadow: 0 0 0 1px var(--accent); } }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .project-card:hover :global(img) { transform: scale(1.025); } }
  @media (max-width: 767px) { .projects-heading { display: block; } .projects-heading > p { max-width: 450px; margin-top: 24px; } .featured-project { grid-template-columns: 1fr; } .featured-copy { padding: 28px; } .featured-visual { aspect-ratio: 1.5; } .project-grid { grid-template-columns: 1fr; gap: 28px; } .project-card-info { padding: 24px; } .project-card-info h3 { font-size: 30px; } .project-card-info > p { font-size: 14px; margin-top: 12px; } .project-card-tags { top: 16px; right: 16px; left: 16px; gap: 6px; } .project-card-tags span { font-size: 11px; padding: 7px 10px; } }
</style>

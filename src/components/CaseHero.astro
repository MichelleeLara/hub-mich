---
import ProjectImage from './ProjectImage.astro';
import { projectPresentation } from '../data/projectPresentation';
const { project: p } = Astro.props;
const visual = projectPresentation[p.slug];
---
<section class="case-hero section-shell">
  <a href="/#proyectos" class="case-back text-link"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5m6-6-6 6 6 6"/></svg>Trabajo seleccionado</a>
  <div class="case-intro">
    <div><p class="section-kicker">{visual.category}</p><h1>{p.title}</h1><p class="case-headline">{visual.headline}</p></div>
    <div class="case-lead"><p>{visual.summary}</p><div class="case-key-result"><strong>{visual.result}</strong><span>{visual.resultLabel}</span></div><a href="#decisiones" class="text-link">Leer las decisiones <span aria-hidden="true">↓</span></a></div>
  </div>
  <figure class="case-visual"><ProjectImage name={visual.image} alt={visual.alt} eager sizes="(min-width: 1152px) 1104px, calc(100vw - 48px)" /><figcaption>Visual del proyecto <span>{p.meta}</span></figcaption></figure>
  <dl class="case-facts">
    <div><dt>Mi rol</dt><dd>{p.brief?.rol.join(' · ')}</dd></div>
    <div><dt>Estado</dt><dd>{p.brief?.estado.join(' · ')}</dd></div>
    <div><dt>Herramientas</dt><dd>{p.stack.map(t => t.label).join(' · ')}</dd></div>
  </dl>
</section>
<style>
  .case-hero { padding-top: 128px; padding-bottom: 64px; }
  .case-back { color: var(--muted); font-size: 13px; margin-bottom: 56px; }
  .case-intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: 72px; align-items: end; margin-bottom: 48px; }
  h1 { font-family: ClashDisplay,'Inter Tight Variable',sans-serif; font-weight: 600; font-size: clamp(48px,6vw,80px); letter-spacing: -.03em; line-height: 1.05; margin: 24px 0; text-wrap: balance; overflow-wrap: break-word; }
  .case-headline { color: var(--muted); font-size: 22px; line-height: 1.4; max-width: 520px; text-wrap: balance; }
  .case-lead > p { font-size: 16px; line-height: 1.65; color: var(--muted); }
  .case-key-result { display: flex; gap: 20px; align-items: center; margin: 24px 0 14px; padding-top: 24px; border-top: 1px solid var(--line); }
  .case-key-result strong { font-size: 30px; font-weight: 500; white-space: nowrap; }
  .case-key-result span { font-size: 12px; color: var(--muted); max-width: 150px; }
  .case-visual { border-radius: 24px; overflow: hidden; background: var(--surface); }
  .case-visual :global(img) { aspect-ratio: 1.7; height: auto; object-fit: cover; }
  figcaption { padding: 16px 24px; display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); }
  .case-facts { display: grid; grid-template-columns: 1fr 1fr 1.7fr; gap: 32px; padding-top: 32px; margin-top: 8px; }
  dt { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 10px; }
  dd { font-size: 13px; line-height: 1.65; }
  @media (max-width: 767px) { .case-hero { padding-top: 96px; } .case-back { margin-bottom: 32px; } .case-intro { grid-template-columns: 1fr; gap: 28px; } .case-headline { font-size: 20px; } .case-facts { grid-template-columns: 1fr 1fr; gap: 24px; } .case-facts > div:last-child { grid-column: 1/-1; } figcaption { flex-direction: column; padding: 14px 18px; } .case-visual :global(img) { aspect-ratio: 1.3; } }
</style>

---
interface Props { seamless?: boolean; }
const { seamless = false } = Astro.props;
---
<section class:list={['ribbon-cta', { seamless }]} aria-labelledby="ribbon-title">
 <svg class="ribbon" viewBox="0 0 1400 620" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true"><path d="M180 130C-40 440 290 640 495 475C700 310 420 190 430 390C445 650 920 575 1010 290C1105 -15 785 65 860 260C940 465 1195 385 1270 90" /></svg>
 <div class="ribbon-content"><p>El siguiente paso empieza con una conversación</p><h2 id="ribbon-title">Démosle forma<br />a lo que sigue.</h2><a class="ribbon-button" href="mailto:mich.ia@hotmail.com?subject=Una%20idea%20de%20producto">Cuéntame tu idea <span aria-hidden="true">↗</span></a><span class="ribbon-email">mich.ia@hotmail.com</span></div>
</section>
<style>
 .ribbon-cta { position:relative; overflow:hidden; isolation:isolate; background:var(--accent-soft); color:var(--ink); padding:112px var(--gutter); text-align:center; }
 .ribbon { position:absolute; inset:0; width:100%; height:100%; z-index:-1; stroke:var(--accent); stroke-width:60; stroke-linecap:round; opacity:.14; }
 .ribbon-content { max-width:1000px; margin:auto; }
 .ribbon-cta.seamless { background:linear-gradient(180deg,var(--accent-soft),var(--bg)); padding-bottom:64px; }
 .seamless .ribbon { mask-image:linear-gradient(to bottom,black 55%,transparent 100%); }
 .ribbon-content>p { font:var(--fs-caption)/1.6 var(--font-mono); color:var(--muted); margin-bottom:var(--space-6); }
 h2 { font:650 clamp(48px,7.5vw,104px)/1.02 var(--font-sans); letter-spacing:-.05em; }
 .ribbon-button { display:inline-flex; align-items:center; justify-content:space-between; gap:48px; min-height:56px; margin-top:var(--space-7); padding:16px 24px; background:var(--ink); color:var(--bg); border-radius:var(--radius-full); font-size:var(--fs-body); }
 .ribbon-button span { font-size:24px; transition:transform var(--dur-fast); }
 @media(hover:hover) and (prefers-reduced-motion:no-preference) { .ribbon-button:hover span { transform:translate(2px,-2px); } }
 .ribbon-email { display:block; margin-top:var(--space-5); font-size:var(--fs-small); color:var(--muted); }
 @media(max-width:767px) { .ribbon-cta { padding:80px var(--gutter); }.ribbon-cta.seamless { padding-bottom:40px; }.ribbon { width:180%; left:-40%; opacity:.12; } }
 @media(prefers-reduced-motion:reduce) { .ribbon-button span { transition:none; } }
 :global(html.motion-paused) .ribbon-button span { transition:none; transform:none; }
</style>

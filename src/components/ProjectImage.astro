---
import imageManifest from '../data/imageManifest.json';
interface Props { name: keyof typeof imageManifest; desktopName?: keyof typeof imageManifest; alt: string; eager?: boolean; sizes?: string; }
const { name, desktopName, alt, eager = false, sizes = '(min-width: 1152px) 552px, (min-width: 768px) calc((100vw - 80px) / 2), calc(100vw - 48px)' } = Astro.props;
const variants = imageManifest[name];
const largest = variants[variants.length - 1];
const desktopVariants = desktopName ? imageManifest[desktopName] : null;
const imageProps = { class: 'project-picture', src: largest.src, srcset: variants.map(image => `${image.src} ${image.width}w`).join(', '), sizes, alt, width: largest.width, height: largest.height, loading: eager ? 'eager' : 'lazy', fetchpriority: eager ? 'high' : 'auto', decoding: 'async' };
---
{desktopVariants ? <picture>
  <source media="(min-width: 768px)" srcset={desktopVariants.map(image => `${image.src} ${image.width}w`).join(', ')} sizes={sizes} />
  <img {...imageProps} />
</picture> : <img {...imageProps} />}

---
// Comparador antes/después (idea: Aceternity "Compare"). A la izquierda la propuesta
// en vivo (slot), donde va su titular; a la derecha la captura de hoy. La propuesta se dibuja a tamaño
// real (laptop 1024 × 768 o celular 375 × 812) y se escala a lo ancho de la caja.
// El mouse mueve la línea al pasar; en touch se arrastra; con teclado, el range.
interface Props {
	url: string;
	antes: { escritorio: string; movil: string };
	alt: string;
	label: string;
}
const { url, antes, alt, label } = Astro.props;
---

<figure class="cmp">
	<div class="cmp-bar" aria-hidden="true"><span></span><span></span><span></span><p>{url}</p></div>
	<div class="cmp-stage" style="--pos: 60%">
		<picture class="cmp-before">
			<source media="(max-width: 760px)" srcset={antes.movil} />
			<img src={antes.escritorio} alt={alt} loading="lazy" decoding="async" />
		</picture>
		<div class="cmp-after" aria-hidden="true">
			<div class="cmp-scale"><slot /></div>
		</div>
		<span class="cmp-tag cmp-tag-after">Propuesta</span>
		<span class="cmp-tag cmp-tag-before">Hoy</span>
		<div class="cmp-handle" aria-hidden="true">
			<span>
				<svg viewBox="0 0 24 24"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg>
			</span>
		</div>
		<input class="cmp-range" type="range" min="0" max="100" value="60" aria-label={label} />
	</div>
	<figcaption>Mueve la línea para comparar. {alt}</figcaption>
</figure>

<script>
	for (const stage of document.querySelectorAll<HTMLElement>('.cmp-stage')) {
		const scale = stage.querySelector<HTMLElement>('.cmp-scale')!;
		const range = stage.querySelector<HTMLInputElement>('.cmp-range')!;
		const set = (pct: number) => {
			const v = Math.min(100, Math.max(0, pct));
			stage.style.setProperty('--pos', `${v}%`);
			range.value = String(Math.round(v));
		};
		const fromEvent = (e: PointerEvent) => {
			const r = stage.getBoundingClientRect();
			set(((e.clientX - r.left) / r.width) * 100);
		};

		// Escala: el ancho "real" sale de --w (cambia entre laptop y celular por CSS).
		new ResizeObserver(() => {
			const w = parseFloat(getComputedStyle(stage).getPropertyValue('--w'));
			stage.style.setProperty('--s', String(stage.clientWidth / w));
		}).observe(stage);

		let dragging = false;
		stage.addEventListener('pointermove', (e) => {
			if (e.pointerType === 'mouse' || dragging) fromEvent(e);
		});
		stage.addEventListener('pointerdown', (e) => {
			dragging = true;
			stage.setPointerCapture(e.pointerId);
			fromEvent(e);
		});
		const stop = () => { dragging = false; };
		stage.addEventListener('pointerup', stop);
		stage.addEventListener('pointercancel', stop);
		range.addEventListener('input', () => set(Number(range.value)));
	}
</script>

<style>
	.cmp { margin: 0; }
	.cmp-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: #ece8e1; }
	.cmp-bar span { width: 10px; height: 10px; border-radius: 50%; background: rgba(43, 43, 43, .18); }
	.cmp-bar p { flex: 1; margin: 0 40px 0 12px; padding: 4px 12px; border-radius: var(--radius-full); background: #faf8f5; color: #5f5a52; font-size: var(--fs-caption); text-align: center; }

	.cmp-stage {
		--w: 1024; --h: 768; --s: 1;
		position: relative; overflow: hidden; aspect-ratio: var(--w) / var(--h);
		border-radius: 0 0 var(--radius-lg) var(--radius-lg); background: #faf8f5;
		box-shadow: var(--shadow-lift); cursor: ew-resize; touch-action: pan-y; user-select: none;
	}
	.cmp-after { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
	.cmp-scale { width: calc(var(--w) * 1px); height: calc(var(--h) * 1px); transform: scale(var(--s)); transform-origin: 0 0; }
	.cmp-before { position: absolute; inset: 0; }
	.cmp-before img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

	.cmp-tag { position: absolute; top: 14px; z-index: 2; padding: 6px 12px; border-radius: var(--radius-full); background: rgba(22, 22, 22, .78); color: #f6f6f6; font-size: var(--fs-micro); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; pointer-events: none; backdrop-filter: blur(6px); }
	.cmp-tag-after { left: 14px; }
	.cmp-tag-before { right: 14px; }

	/* Línea con brillo en acento, como el original, y una perilla para arrastrar */
	.cmp-handle { position: absolute; inset: 0 auto 0 var(--pos); z-index: 3; width: 2px; translate: -1px 0; background: linear-gradient(to bottom, transparent, var(--accent) 12%, var(--accent) 88%, transparent); box-shadow: 0 0 16px 2px color-mix(in srgb, var(--accent) 55%, transparent); pointer-events: none; }
	.cmp-handle span { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 40px; height: 40px; translate: -50% -50%; border-radius: 50%; background: #fff; color: #202124; box-shadow: var(--shadow-float); }
	.cmp-handle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

	/* El range es invisible pero da teclado y lector de pantalla; su foco se ve en la perilla */
	.cmp-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
	.cmp-stage:has(.cmp-range:focus-visible) .cmp-handle span { outline: 2px solid var(--accent); outline-offset: 4px; }

	.cmp figcaption { margin: var(--space-3) 0 0; color: var(--muted); font-size: var(--fs-small); }

	@media (max-width: 760px) {
		.cmp-stage { --w: 375; --h: 812; }
	}
</style>

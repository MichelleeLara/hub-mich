---
import { worldMapDots, projectWorldLocation, worldMapRoute, WORLD_MAP_WIDTH, WORLD_MAP_HEIGHT } from '../data/worldMapGeometry';
import { worldCases as cases } from '../data/worldCases';
---
<section id="mundo" class="section-shell world-section" aria-labelledby="world-title">
 <div class="world-copy">
  <p class="world-label">Casos de éxito</p>
  <h2 id="world-title">Las buenas ideas <span>no tienen fronteras.</span></h2>
  <p class="world-description">Productos que conectan personas, datos y operaciones. Resultados que viajan de México a China.</p>
 </div>
 <div class="world-visual">
  <figure class="particle-world" aria-label="Mapa mundial de puntos con los proyectos en México y China">
   <svg class="world-fallback" viewBox={`0 0 ${WORLD_MAP_WIDTH} ${WORLD_MAP_HEIGHT}`} aria-hidden="true">{worldMapDots.map(p=><circle cx={p.x} cy={p.y} r="3.1" fill="currentColor" />)}</svg>
   <svg class="world-route" viewBox={`0 0 ${WORLD_MAP_WIDTH} ${WORLD_MAP_HEIGHT}`} aria-hidden="true"><path data-world-route d={worldMapRoute(cases[0].locations)} pathLength="1" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" /></svg>
   {cases[0].locations.map((location,i)=>{const point=projectWorldLocation(location);return <button type="button" class="world-pin" data-world-pin={i} aria-label={`Destacar ${location.name}`} aria-pressed={false} style={`left:${point.x/WORLD_MAP_WIDTH*100}%;top:${point.y/WORLD_MAP_HEIGHT*100}%`}><span class="pin-dot"></span><span class="pin-label">{location.name}</span></button>;})}
  </figure>
  <p class="world-map-caption" data-world-caption aria-live="polite" aria-atomic="true">AnamSeals · México ↔ China</p>
 </div>
 <div class="world-bento" aria-label="Casos de éxito y sus resultados">
  {cases.map((item,i)=><article class={`world-card world-card-${i}`} data-world-card={i}>
   <button type="button" class="case-select" data-world-select={i} aria-pressed={i===0} aria-label={`Destacar ${item.title} en el mapa`}><span class="case-number">{String(i+1).padStart(2,'0')}</span><span>{item.title}</span></button>
   <div class="case-art" aria-hidden="true">
    {i===0&&<svg class="seal-art" viewBox="0 0 240 150" fill="none"><circle cx="120" cy="76" r="65"/><circle cx="120" cy="76" r="48"/><path class="art-accent" d="M102 66V51a18 18 0 0 1 36 0v15"/><rect class="art-solid" x="92" y="66" width="56" height="48" rx="12"/><path class="art-accent" d="M120 86v10"/><path d="M18 76h39m126 0h39M120 5v12m0 120v12"/><circle class="art-accent" cx="32" cy="76" r="5"/><circle class="art-accent" cx="208" cy="76" r="5"/></svg>}
    {i===1&&<svg class="performance-art" viewBox="0 0 240 150" fill="none"><path d="M20 30h200M20 65h200M20 100h200M20 135h200"/><path class="chart-fill" d="M20 122L58 106L95 114L131 77L168 83L213 28V135H20Z"/><path class="art-accent" d="M20 122L58 106L95 114L131 77L168 83L213 28"/><circle class="art-solid" cx="213" cy="28" r="8"/><circle class="art-accent" cx="213" cy="28" r="3"/></svg>}
    {i===2&&<svg class="team-art" viewBox="0 0 240 150" fill="none"><path d="M45 50L120 30L195 50L195 108L120 128L45 108ZM45 50L120 128M195 50L45 108M120 30L195 108"/>{[[45,50],[120,30],[195,50],[45,108],[120,128],[195,108]].map(([x,y])=><g><circle class="art-solid" cx={x} cy={y} r="19"/><circle class="art-accent" cx={x} cy={y-4} r="4"/><path class="art-accent" d={`M${x-7} ${y+8}a7 7 0 0 1 14 0`}/></g>)}</svg>}
    {i===3&&<svg class="tracking-art" viewBox="0 0 240 150" fill="none"><path d="M20 40h200M20 75h200M20 110h200M55 15v120M100 15v120M145 15v120M190 15v120"/><path class="art-accent route-trace" d="M42 110H95Q120 110 120 85V62Q120 40 145 40H194"/><circle class="art-solid" cx="42" cy="110" r="10"/><circle class="art-accent" cx="42" cy="110" r="4"/><circle class="art-solid" cx="194" cy="40" r="15"/><circle class="art-accent" cx="194" cy="40" r="6"/></svg>}
   </div>
   <div class="case-outcome"><p class="case-value">{i===2?<><span>6</span><span class="case-unit">ingenieros</span></>:item.result}</p><p class="case-detail">{item.label}</p></div>
   <a class="case-link" href={`/proyectos/${item.slug}`} aria-label={`Ver caso de ${item.title}`}><span>Ver caso</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18L18 6M6 6h12v12"/></svg></a>
  </article>)}
 </div>
</section>
<style>
 .world-section { position:relative; display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); align-items:start; column-gap:var(--space-6); row-gap:var(--space-5); padding-block:var(--space-8) var(--space-9); border-top:1px solid var(--line); scroll-margin-top:var(--space-9); }
 .world-copy { position:relative; z-index:1; padding-top:var(--space-4); }
 .world-label { font-family:var(--font-accent); font-size:30px; color:var(--accent); margin-bottom:var(--space-6); }
 h2 { font:450 var(--fs-h2)/1.15 var(--font-sans); letter-spacing:-.04em; max-width:520px; text-wrap:balance; }
 h2 span { font-weight:650; }
 .world-description { font-size:var(--fs-body); line-height:1.7; color:var(--muted); max-width:360px; margin-top:var(--space-5); }
 .world-visual { min-width:0; position:relative; padding-top:var(--space-3); }
 .particle-world { width:100%; margin:0; aspect-ratio:1000 / 580; position:relative; }
 .world-fallback { width:100%; height:100%; color:var(--muted); opacity:.24; mask-image:linear-gradient(90deg,transparent 0%,black 14%,black 86%,transparent 100%); }
 .world-section.world-live .world-fallback { opacity:0; }
 :global(html.motion-paused) .world-section.world-live .world-fallback { opacity:.24; }
 .world-route { position:absolute; inset:0; width:100%; height:100%; overflow:visible; color:var(--muted); opacity:.38; pointer-events:none; }
 .world-pin { position:absolute; width:44px; height:44px; transform:translate(-50%,-50%); border-radius:var(--radius-full); border:0; display:grid; place-items:center; cursor:pointer; background:transparent; }
 .world-pin[hidden] { display:none; }
 .pin-dot { width:8px; height:8px; border-radius:var(--radius-full); background:var(--bg); border:2px solid color-mix(in srgb,var(--muted) 65%,var(--bg)); box-shadow:0 0 0 4px color-mix(in srgb,var(--muted) 8%,transparent); transition:box-shadow .2s ease; }
 .world-pin:first-of-type .pin-dot { width:10px; height:10px; border-color:var(--accent); box-shadow:0 0 0 5px var(--bg),0 0 0 10px color-mix(in srgb,var(--muted) 10%,transparent); }
 .world-pin:hover .pin-dot,.world-pin[aria-pressed=true] .pin-dot { border-color:var(--accent); box-shadow:0 0 0 5px var(--bg),0 0 0 12px color-mix(in srgb,var(--muted) 12%,transparent); }
 .pin-label { position:absolute; top:38px; left:50%; transform:translateX(-50%); white-space:nowrap; font:var(--fs-caption) var(--font-mono); color:var(--ink); background:var(--surface-glass); border:1px solid var(--line-subtle); border-radius:var(--radius-sm); padding:6px 10px; pointer-events:none; }
 .world-map-caption { color:var(--muted); font:var(--fs-caption)/1.5 var(--font-mono); text-align:right; padding-right:var(--space-5); min-height:var(--space-5); margin-top:var(--space-3); }
 .world-bento { grid-column:1 / -1; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-items:start; gap:var(--space-4); position:relative; z-index:1; }
 .world-card { min-width:0; position:relative; padding:var(--space-5); border:1px solid var(--line); border-radius:var(--radius-lg); background:var(--surface); overflow:hidden; transition:border-color .2s ease,box-shadow .2s ease; }
 .world-card[data-active] { border-color:var(--accent); box-shadow:var(--shadow-float); }
 .world-card-0 { margin-top:0; }
 .world-card-1 { margin-top:var(--space-7); }
 .world-card-2 { margin-top:var(--space-9); }
 .world-card-3 { margin-top:var(--space-6); }
 .case-select { display:flex; align-items:center; gap:var(--space-2); text-align:left; font:500 var(--fs-small)/1.25 var(--font-sans); color:var(--ink); min-height:44px; width:100%; cursor:pointer; }
 .case-select>span:last-child { background:var(--bg); border:1px solid var(--line); padding:8px 10px; border-radius:var(--radius-sm); }
 .case-number { align-self:flex-start; flex-shrink:0; display:grid; place-items:center; width:28px; height:28px; border-radius:var(--radius-sm); background:var(--bg); border:1px solid var(--line); font:var(--fs-caption) var(--font-mono); color:var(--muted); margin-top:2px; }
 .case-select[aria-pressed=true] .case-number { background:var(--accent-soft); color:var(--accent); border-color:var(--accent); }
 .case-art { margin-block:var(--space-4); height:132px; display:grid; place-items:center; color:var(--line); }
 .case-art svg { width:100%; max-width:240px; height:100%; stroke:currentColor; stroke-width:1; }
 .case-art .art-accent { stroke:var(--accent); stroke-width:1.8; }
 .case-art .art-solid { fill:var(--bg); stroke:var(--line); }
 .case-art .chart-fill { fill:var(--accent-soft); stroke:none; }
 .case-art .route-trace { stroke-dasharray:4 5; }
 .world-card-0 .case-art { height:100px; }
 .world-card-2 .case-art { height:100px; }
 .case-value { color:var(--ink); font:600 clamp(25px,2.8vw,38px)/1.05 var(--font-display); letter-spacing:-.025em; }
 .world-card-0 .case-value { color:var(--accent); }
 .world-card-2 .case-value { display:flex; align-items:baseline; gap:var(--space-2); }
 .case-unit { font:500 var(--fs-lead)/1.2 var(--font-sans); letter-spacing:-.02em; }
 .case-detail { font:var(--fs-small)/1.5 var(--font-sans); color:var(--muted); margin-top:var(--space-2); min-height:42px; }
 .case-link { display:flex; justify-content:space-between; align-items:center; min-height:44px; border-top:1px solid var(--line); margin-top:var(--space-4); padding-top:var(--space-3); font:500 var(--fs-caption)/1.3 var(--font-sans); color:var(--muted); }
 .case-link svg { width:18px; height:18px; }
 .case-link:hover { color:var(--accent); }
 .world-pin:focus-visible,.case-select:focus-visible,.case-link:focus-visible { outline:2px solid var(--accent); outline-offset:4px; border-radius:var(--radius-sm); }
 @media(max-width:1023px) {
  .world-section { grid-template-columns:minmax(0,1fr) minmax(0,1fr); }
  .world-bento { grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-5); }
  .world-card-1 { margin-top:var(--space-6); }
  .world-card-2 { margin-top:calc(-1 * var(--space-6)); }
  .world-card-3 { margin-top:0; }
  .case-art,.world-card-0 .case-art,.world-card-2 .case-art { height:120px; }
 }
 @media(max-width:767px) {
  .world-section { grid-template-columns:minmax(0,1fr); row-gap:var(--space-6); padding-block:var(--space-7) var(--space-8); }
  .world-copy { padding-top:0; }
  .world-label { margin-bottom:var(--space-5); }
  .world-description { max-width:440px; }
  .world-visual { padding:0; }
  .pin-label { padding:6px 8px; font-size:var(--fs-micro); }
  .world-map-caption { text-align:center; padding:0; margin-top:var(--space-5); }
  .world-bento { gap:var(--space-4); }
  .world-card { padding:var(--space-4); }
  .world-card-1,.world-card-2,.world-card-3 { margin-top:0; }
  .case-select { gap:var(--space-1); font-size:var(--fs-caption); }
  .case-select>span:last-child { padding:6px; }
  .case-number { width:24px; height:24px; }
  .case-value { font-size:26px; }
  .case-art,.world-card-0 .case-art,.world-card-2 .case-art { height:96px; }
 }
 @media(max-width:479px) {
  .world-bento { grid-template-columns:1fr; }
  .world-card { padding:var(--space-5); }
  .case-art,.world-card-0 .case-art,.world-card-2 .case-art { height:112px; }
  .case-select { font-size:var(--fs-small); }
  .case-detail { min-height:0; }
 }
 @media(prefers-reduced-motion:reduce) {
  .world-section.world-live .world-fallback { opacity:.24; }
  .world-card,.pin-dot { transition:none; }
 }
</style>
<script>
 import { worldMapDots, projectWorldLocation, worldMapRoute, WORLD_MAP_WIDTH, WORLD_MAP_HEIGHT } from '../data/worldMapGeometry';
 import { worldCases } from '../data/worldCases';
 import { ENFOQUE_PARTICLE_EVENT, type EnfoqueGrain } from '../lib/enfoqueParticles';
 const section=document.querySelector<HTMLElement>('.world-section');
 const figure=section?.querySelector<HTMLElement>('.particle-world');
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 if(section&&figure){
  let frame=0,visible=false,selected=0,selectedLocation=-1;
  let formationStarted:number|null=null,connectionStarted:number|null=null;
  const pins=Array.from(section.querySelectorAll<HTMLButtonElement>('[data-world-pin]'));
  const caseButtons=Array.from(section.querySelectorAll<HTMLButtonElement>('[data-world-select]'));
  const cards=Array.from(section.querySelectorAll<HTMLElement>('[data-world-card]'));
  cards[0]?.setAttribute('data-active','');
  const route=section.querySelector<SVGPathElement>('[data-world-route]');
  const disabled=()=>reduced.matches||document.documentElement.classList.contains('motion-paused');
  const release=()=>document.dispatchEvent(new CustomEvent(ENFOQUE_PARTICLE_EVENT,{detail:{points:[],strength:0}}));
  const render=(time:number)=>{
   frame=0;
   if(!visible||document.hidden){release();return;}
   if(formationStarted===null)formationStarted=time;
   if(connectionStarted===null)connectionStarted=formationStarted+1200;
   const anchorProgress=disabled()?1:Math.max(0,Math.min(1,(time-connectionStarted)/350));
   const routeProgress=disabled()?1:Math.max(0,Math.min(1,(time-connectionStarted-180)/900));
   const routeReveal=routeProgress*routeProgress*(3-2*routeProgress);
   const box=figure.getBoundingClientRect();
   const destinations=worldCases[selected].locations;
   if(route){
    route.setAttribute('d',worldMapRoute(destinations));
    route.style.opacity=String(routeProgress>0?1:0);
    route.style.strokeDasharray='1';
    route.style.strokeDashoffset=String(1-routeReveal);
   }
   pins.forEach((pin,i)=>{
    const location=destinations[i];
    if(!location){pin.hidden=true;return;}
    const point=projectWorldLocation(location);
    pin.hidden=anchorProgress===0;
    pin.style.opacity=String(anchorProgress);
    pin.style.left=`${point.x/WORLD_MAP_WIDTH*100}%`;
    pin.style.top=`${point.y/WORLD_MAP_HEIGHT*100}%`;
    pin.setAttribute('aria-pressed',String(i===selectedLocation));
   });
   if(disabled()){release();return;}
   const points:EnfoqueGrain[]=worldMapDots.map(point=>({
    x:box.left+point.x/WORLD_MAP_WIDTH*box.width,
    y:box.top+point.y/WORLD_MAP_HEIGHT*box.height,
    alpha:.22*Math.min(1,point.x/140,(WORLD_MAP_WIDTH-point.x)/140),
    radius:Math.max(.8,3.1*box.width/WORLD_MAP_WIDTH),
    tint:0,
   }));
   document.dispatchEvent(new CustomEvent(ENFOQUE_PARTICLE_EVENT,{detail:{points,strength:1}}));
   frame=requestAnimationFrame(render);
  };
  const schedule=()=>{if(!frame&&visible)frame=requestAnimationFrame(render);};
  if(document.getElementById('particles-bg'))section.classList.add('world-live');
  new IntersectionObserver(entries=>{
   const entering=entries[0].isIntersecting&&!visible;
   visible=entries[0].isIntersecting;
   if(entering){formationStarted=null;connectionStarted=null;}
   schedule();if(!visible)release();
  },{threshold:.25}).observe(figure);
  new MutationObserver(()=>{schedule();if(disabled())release();}).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  new ResizeObserver(schedule).observe(figure);
  reduced.addEventListener('change',schedule);
  document.addEventListener('visibilitychange',schedule);
  const focusLocation=(index:number)=>{
   selectedLocation=index;
   connectionStarted=performance.now()-2000;

   schedule();
  };
  const selectCase=(index:number)=>{
   selected=(index+worldCases.length)%worldCases.length;
   selectedLocation=-1;
   connectionStarted=performance.now()+100;
   caseButtons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===selected)));
   cards.forEach((card,i)=>card.toggleAttribute('data-active',i===selected));
   section.querySelector('[data-world-caption]')!.textContent=`${worldCases[selected].title} · ${worldCases[selected].locations.length===2?'México ↔ China':'Ciudad de México'}`;
   pins.forEach((pin,i)=>{
    const location=worldCases[selected].locations[i];
    pin.hidden=!location;
    if(location){
     pin.setAttribute('aria-label',`Destacar ${location.name}`);
     pin.querySelector('.pin-label')!.textContent=location.name;
    }
   });
   schedule();
  };
  caseButtons.forEach((button,i)=>button.addEventListener('click',()=>selectCase(i)));
  pins.forEach((pin,i)=>pin.addEventListener('click',()=>focusLocation(i)));
 }
</script>

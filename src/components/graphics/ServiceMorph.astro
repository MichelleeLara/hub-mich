 .service-morph[data-state="1"] .morph-cursor { left:61%; top:57%; transform:rotate(-12deg); }.service-morph[data-state="1"] .morph-caption { left:72%; bottom:7%; }

 /* Estado 2: esos paneles se convierten en pasos conectados de un flujo. */
 .service-morph[data-state="2"] .morph-browser { inset:12% 4% 10%; border-radius:28px; transform:scale(.96); }.service-morph[data-state="2"] .browser-body { grid-template-columns:80px 1fr; }
 .service-morph[data-state="2"] .morph-card { top:38%; width:23%; height:39%; transform:none; border-radius:20px; }.service-morph[data-state="2"] .card-a { left:7%; }.service-morph[data-state="2"] .card-b { left:38.5%; }.service-morph[data-state="2"] .card-c { left:70%; }
 .service-morph[data-state="2"] .morph-card .card-visual { min-height:35px; border-radius:50%; transform:scale(.55); }.service-morph[data-state="2"] .morph-node { opacity:1; }.service-morph[data-state="2"] .morph-connections .connection-a,.service-morph[data-state="2"] .morph-connections circle { opacity:1; }
 .service-morph[data-state="2"] .morph-orbits { width:460px; height:95px; top:49%; opacity:.22; }.service-morph[data-state="2"] .morph-orbits i { border-radius:999px; }
 .service-morph[data-state="2"] .morph-core { top:24%; width:104px; height:64px; margin:-32px -52px; border-radius:999px; }.service-morph[data-state="2"] .core-spark { opacity:0; }.service-morph[data-state="2"] .core-flow { opacity:1; }.service-morph[data-state="2"] .label-ai { opacity:0; }.service-morph[data-state="2"] .label-flow { opacity:1; bottom:8px; }.service-morph[data-state="2"] .morph-core svg { top:7px; width:20px; }
 .service-morph[data-state="2"] .morph-cursor { left:82%; top:69%; transform:rotate(12deg); }.service-morph[data-state="2"] .morph-caption { left:5%; bottom:7%; }

 @media(max-width:767px) { .morph-browser { inset:12% 3% 8%; }.browser-body { grid-template-columns:64px 1fr; }.morph-nav { padding:16px 10px; }.morph-core { transform:scale(.78); }.morph-orbits { transform:translate(-50%,-50%) scale(.75); }.morph-caption { transform:scale(.78); transform-origin:left bottom; }.service-morph[data-state="1"] .browser-body,.service-morph[data-state="2"] .browser-body { grid-template-columns:58px 1fr; } }
 @media(prefers-reduced-motion:reduce) { .service-morph * { transition:none!important; } }
 :global(html.motion-paused) .service-morph * { transition:none!important; }
</style>

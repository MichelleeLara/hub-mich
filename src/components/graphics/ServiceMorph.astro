<style>
 .service-morph { position:absolute; inset:0; overflow:hidden; color:var(--ink); perspective:1100px; }
 .morph-browser { position:absolute; inset:11% 8% 8%; overflow:hidden; border:1px solid var(--line); border-radius:20px; background:color-mix(in srgb,var(--bg) 94%,transparent); box-shadow:0 24px 55px rgb(0 0 0 / .06); transform-origin:center; }
 .browser-bar { display:flex; align-items:center; height:48px; padding:0 16px; border-bottom:1px solid var(--line); }
 .browser-dots,.browser-actions { display:flex; gap:5px; }.browser-dots i { width:6px; height:6px; border-radius:50%; border:1px solid var(--line); }.browser-bar>b { width:34%; height:7px; margin:auto; border-radius:9px; background:var(--line-subtle); }.browser-actions i { width:18px; height:5px; border-radius:5px; background:var(--line-subtle); }
 .browser-body { display:grid; grid-template-columns:120px 1fr; height:calc(100% - 48px); }
 .morph-nav { display:flex; flex-direction:column; gap:18px; padding:22px 18px; border-right:1px solid var(--line); }.morph-nav .avatar { width:28px; height:28px; margin-bottom:20px; border-radius:9px; background:color-mix(in srgb,var(--accent) 18%,var(--surface)); box-shadow:inset 0 0 0 1px var(--line); }.morph-nav i { width:100%; height:7px; border-radius:8px; background:var(--line-subtle); }.morph-nav i:last-child { width:68%; }
 .morph-workspace { position:relative; min-width:0; overflow:hidden; }
 .morph-card { position:absolute; display:flex; flex-direction:column; gap:8px; padding:14px; border:1px solid var(--line); border-radius:15px; background:var(--bg); box-shadow:0 12px 24px rgb(0 0 0 / .045); }
 .morph-card .card-tag { width:42%; height:6px; border-radius:8px; background:color-mix(in srgb,var(--accent) 25%,var(--line)); }.morph-card .card-visual { display:block; flex:1; min-height:48px; border-radius:10px; background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 9%,var(--surface)),var(--surface)); }.morph-card b { width:80%; height:5px; border-radius:5px; background:var(--line-subtle); }.morph-card b:last-child { width:52%; }
 .card-a { left:10%; top:25%; width:27%; height:47%; transform:rotate(-7deg); }.card-b { left:38%; top:15%; width:31%; height:58%; transform:rotate(3deg); }.card-c { left:68%; top:31%; width:24%; height:42%; transform:rotate(8deg); }
 .morph-node { position:absolute; display:grid; place-items:center; width:36px; height:36px; border:1px solid var(--line); border-radius:11px; background:var(--bg); box-shadow:var(--shadow-float); color:var(--accent); font:9px/1 var(--font-mono); opacity:0; }.node-a { left:13%; top:45%; }.node-b { left:46%; top:45%; }.node-c { left:80%; top:45%; }
 .morph-code-lines { position:absolute; left:8%; top:9%; display:grid; gap:7px; width:35%; opacity:0; }.morph-code-lines i { height:5px; border-radius:5px; background:var(--line-subtle); }.morph-code-lines i:nth-child(2) { width:80%; }.morph-code-lines i:nth-child(3) { width:58%; background:color-mix(in srgb,var(--accent) 28%,var(--line)); }.morph-code-lines i:nth-child(4) { width:90%; }.morph-code-lines i:nth-child(5) { width:65%; }
 .morph-core { position:absolute; left:50%; top:43%; z-index:5; display:grid; place-items:center; width:88px; height:88px; margin:-44px; border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line)); border-radius:24px; background:var(--bg); box-shadow:0 18px 45px color-mix(in srgb,var(--accent) 13%,transparent); color:var(--accent); }
 .morph-core svg { position:absolute; top:15px; width:25px; height:25px; }.core-window,.core-flow { opacity:0; }.core-label { position:absolute; bottom:16px; font:600 10px/1 var(--font-mono); letter-spacing:.08em; }.label-web,.label-flow { opacity:0; }
 .morph-orbits { position:absolute; left:50%; top:43%; z-index:2; width:340px; height:260px; transform:translate(-50%,-50%); }.morph-orbits i { position:absolute; inset:0; border:1px solid color-mix(in srgb,var(--accent) 18%,transparent); border-radius:50%; }.morph-orbits i:nth-child(2) { inset:38px; }.morph-orbits i:nth-child(3) { inset:76px; }
 .morph-connections { position:absolute; inset:0; z-index:3; width:100%; height:100%; pointer-events:none; }.morph-connections path { stroke:color-mix(in srgb,var(--accent) 45%,var(--line)); stroke-width:1.4; stroke-dasharray:7 8; opacity:0; }.morph-connections circle { fill:var(--bg); stroke:var(--accent); opacity:0; }
 .morph-cursor { position:absolute; z-index:8; left:70%; top:64%; width:28px; height:34px; color:var(--ink); }.morph-cursor svg { width:100%; height:100%; }
 .morph-caption { position:absolute; left:4%; bottom:4%; z-index:7; display:grid; gap:6px; width:110px; padding:12px; border:1px solid var(--line); border-radius:12px; background:var(--bg); box-shadow:var(--shadow-float); }.morph-caption>* { display:block; width:100%; height:4px; border-radius:5px; background:var(--line); }.morph-caption i:nth-child(2) { width:78%; }.morph-caption i:last-child { width:50%; background:color-mix(in srgb,var(--accent) 34%,var(--line)); }
 .morph-browser,.morph-card,.morph-core,.morph-orbits,.morph-cursor,.morph-caption,.morph-node,.morph-code-lines,.core-spark,.core-window,.core-flow,.core-label,.morph-connections path,.morph-connections circle { transition:all 700ms cubic-bezier(.22,1,.36,1); }

 /* Estado 1: los mismos paneles se ordenan como una interfaz web. */
 .service-morph[data-state="1"] .morph-browser { inset:7% 5% 6%; border-radius:16px; transform:rotateX(2deg); }
 .service-morph[data-state="1"] .browser-body { grid-template-columns:90px 1fr; }.service-morph[data-state="1"] .morph-nav { padding-inline:14px; }
 .service-morph[data-state="1"] .card-a { left:8%; top:34%; width:24%; height:50%; transform:none; }.service-morph[data-state="1"] .card-b { left:36%; top:24%; width:29%; height:60%; transform:none; }.service-morph[data-state="1"] .card-c { left:69%; top:34%; width:23%; height:50%; transform:none; }
 .service-morph[data-state="1"] .morph-code-lines { opacity:1; }.service-morph[data-state="1"] .morph-orbits { width:150px; height:150px; top:23%; opacity:.15; transform:translate(-50%,-50%) rotate(45deg); }

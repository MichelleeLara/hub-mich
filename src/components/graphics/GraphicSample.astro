---
import GraphicResource from './GraphicResource.astro';
import BentoArtwork from './BentoArtwork.astro';
import PanelResources from './PanelResources.astro';
import DifferenceArtwork from './DifferenceArtwork.astro';
import OnboardingResources from './OnboardingResources.astro';
import ObjectResources from './ObjectResources.astro';
import ReferenceResources from './ReferenceResources.astro';
import type {GraphicEntry} from '../../data/graphicLibrary';
interface Props {entry:GraphicEntry; tone:'light'|'dark';}
const {entry,tone}=Astro.props;
const id=`${entry.id}-${tone}`;
---
<div class:list={['graphic-sample',`sample-${tone}`]} data-sample-tone={tone}>
 <span class="sample-tone" aria-hidden="true">{tone==='light'?'Claro':'Oscuro'}</span>
 {entry.renderer==='ambient'&&<GraphicResource variant="ambient" profile={entry.profile}/>}
 {entry.renderer==='bento'&&<BentoArtwork variant={entry.variant as 'mark'|'radar'|'code'} id={id}/>}
 {entry.renderer==='panel'&&<PanelResources variant={entry.variant as 'perspective'|'consulting'|'workflow'|'sales'|'analysis'|'agents'|'collaboration'} id={id}/>}
 {entry.renderer==='difference'&&<DifferenceArtwork variant={entry.variant as 'context'|'build'} id={id}/>}
 {entry.renderer==='onboarding'&&<OnboardingResources variant={entry.variant as 'authentication'|'profile'|'intelligence'} id={id}/>}
 {entry.renderer==='object'&&<ObjectResources variant={entry.variant as 'stack'|'capsule'|'globe'|'toolbox'} id={id}/>}
 {entry.renderer==='reference'&&<ReferenceResources variant={entry.variant as 'integrations'|'tiles'|'analytics'|'document'|'mail'|'puzzle'|'stat'|'map'} id={id}/>}
</div>
<style>
 /* Fixed samples mirror the two repo palettes, independent of the page theme. */
 .sample-light { --bg:#fff; --surface:#f3f3f1; --ink:#202124; --muted:#62646b; --line:rgba(0,0,0,.12); --accent:#a74316; --accent-soft:#f5e9e1; --accent-deep:#6e2f15; }
 .sample-dark { --bg:#161616; --surface:#202020; --ink:#f6f6f6; --muted:#aaaab0; --line:rgba(255,255,255,.13); --accent:#efaa85; --accent-soft:#30251f; --accent-deep:#ffe0ca; }
 .graphic-sample { height:260px; padding:14px; position:relative; background:var(--bg); color:var(--ink); overflow:hidden; display:grid; place-items:center; }
 .sample-tone { position:absolute; top:10px; left:12px; z-index:1; font:9px/1 var(--font-mono); color:var(--muted); pointer-events:none; }
 .graphic-sample :global(.graphic-preview) { width:100%; max-width:320px; height:240px; margin:0; }
 .graphic-sample :global(.bento-artwork) { min-height:240px; }
</style>

---
interface Props {
 variant: 'perspective' | 'consulting' | 'workflow' | 'sales' | 'analysis' | 'agents' | 'collaboration';
 id: string;
 inverted?: boolean;
 decorative?: boolean;
}
const { variant, id, inverted = false, decorative = false } = Astro.props;
const Tag=decorative?'div':'button';
const labels = {
 perspective: 'Explorar las capas del panel de producto',
 consulting: 'Explorar los paneles de contexto y decisión de la consultoría IA',
 workflow: 'Explorar un flujo automático desde la entrada hasta la tarea completada',
 sales: 'Comparar los resultados del gráfico de ventas',
 analysis: 'Explorar el análisis de documentos',
 agents: 'Explorar el crecimiento del equipo de agentes',
 collaboration: 'Explorar el recorrido de una tarea compartida',
};
const bars = [38, 61, 82, 72, 88, 77];
const secondBars = [31, 43, 62, 53, 65, 55];
const documentLines = [58, 42, 64, 48, 26];
---

<Tag
 class:list={['panel-resource', `panel-${variant}`, { inverted }]}
 type={decorative?undefined:"button"}
 aria-hidden={decorative?"true":undefined}
 data-library-resource
 data-panel-resource={decorative?undefined:""}
 data-variant={variant}
 aria-label={decorative?undefined:labels[variant]}
 aria-pressed={decorative?undefined:"false"}
>
 <svg viewBox="0 0 400 260" fill="none" aria-hidden="true">
  <defs>
   <linearGradient id={`${id}-paper`} x1="0" y1="0" x2="1" y2="1">
    <stop stop-color="var(--panel-tint)" />
    <stop offset="1" stop-color="var(--panel-paper)" />
   </linearGradient>
   <linearGradient id={`${id}-highlight`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="var(--accent)" stop-opacity=".3" />
    <stop offset="1" stop-color="var(--accent)" stop-opacity=".04" />
   </linearGradient>
   <linearGradient id={`${id}-area`} x1="0" y1="0" x2="0" y2="1">
    <stop stop-color="var(--panel-ink)" stop-opacity=".07" />
    <stop offset="1" stop-color="var(--panel-ink)" stop-opacity="0" />
   </linearGradient>
   <pattern id={`${id}-hatch`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
    <rect width="4" height="4" fill="var(--panel-accent-fill)" />
    <path d="M0 0V4" stroke="var(--accent)" stroke-opacity=".5" stroke-width="1" />
   </pattern>
   <filter id={`${id}-shadow`} x="-35%" y="-35%" width="170%" height="180%">
    <feDropShadow dx="0" dy="7" stdDeviation="7" flood-color="var(--panel-ink)" flood-opacity=".045" />
   </filter>
  </defs>

  {variant === 'perspective' && <>
   <g class="perspective-base motion-layer" transform="translate(198 128) rotate(17) skewX(-8) translate(-198 -128)">
    <rect class="glass faint" x="112" y="25" width="180" height="207" rx="13" fill={`url(#${id}-paper)`} />
    <path class="edge faint" d="M114 218H289" />
    <text class="display-type" x="133" y="68">UI</text>
    <text class="display-type outline-type" x="227" y="196">UX</text>
    <rect class="pill" x="232" y="49" width="44" height="12" rx="5" fill={`url(#${id}-highlight)`} />
    <rect class="pill" x="190" y="151" width="44" height="12" rx="5" fill={`url(#${id}-highlight)`} />
    <rect class="pill" x="130" y="193" width="44" height="12" rx="5" fill={`url(#${id}-highlight)`} />
   </g>
   <g class="perspective-profile satellite motion-layer" transform="rotate(16 118 116)">
    <rect class="glass" x="78" y="83" width="84" height="91" rx="10" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    <circle class="icon-disc" cx="103" cy="97" r="12" />
    <circle class="accent-fill" cx="103" cy="93" r="3" />
    <path class="accent-fill" d="M97 102C97 97 109 97 109 102Z" />
    <text class="small-label" x="87" y="121">Perfil de usuario</text>
    {[0,1,2,3].map(i => <rect class="skeleton" x="88" y={130+i*8} width={i===3?35:61-i*5} height="3" rx="1.5" />)}
   </g>
   <g class="perspective-finance satellite motion-layer" transform="rotate(16 289 150)">
    <rect class="glass" x="255" y="120" width="63" height="54" rx="9" fill={`url(#${id}-paper)`} />
    {[0,1,2,3].map(i => <rect class="accent-fill" x={273+i*6} y={142-i*3} width="4" height={8+i*3} rx="1" />)}
    <path class="accent-stroke" d="m273 138 7-2 5-5 8 1" />
    <text class="micro-label" x="266" y="164">Finanzas</text>
   </g>
   <g class="perspective-commerce satellite motion-layer" transform="rotate(16 235 216)">
    <rect class="glass" x="203" y="192" width="65" height="52" rx="9" fill={`url(#${id}-paper)`} />
    <path class="accent-stroke" d="M227 205h18l2 15h-22l2-15Zm4 0v-3a5 5 0 0 1 10 0v3" />
    <text class="micro-label" x="213" y="233">Comercio</text>
   </g>
  </>}

  {variant === 'consulting' && <>
   <g class="consulting-back motion-layer">
    <rect class="glass faint" x="155" y="35" width="137" height="189" rx="13" fill={`url(#${id}-paper)`} />
    <rect class="pill" x="172" y="53" width="56" height="8" rx="4" fill={`url(#${id}-highlight)`} />
    <circle class="icon-disc" cx="268" cy="57" r="8" />
    <rect class="skeleton" x="173" y="82" width="78" height="3" rx="1.5" />
    <rect class="skeleton" x="173" y="91" width="59" height="3" rx="1.5" />
    <path class="edge faint" d="M157 209H290" />
   </g>
   <g class="consulting-angle satellite motion-layer" transform="rotate(-17 148 148)">
    <rect class="glass faint" x="102" y="100" width="103" height="113" rx="10" fill={`url(#${id}-paper)`} />
    <rect class="pill" x="117" y="116" width="61" height="6" rx="3" fill={`url(#${id}-highlight)`} />
    {[0,1,2].map(i => <rect class="skeleton" x="117" y={135+i*9} width={68-i*13} height="3" rx="1.5" />)}
   </g>
   <g class="consulting-toolbar satellite motion-layer">
    <rect class="glass" x="165" y="79" width="151" height="49" rx="10" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    <rect class="icon-disc" x="175" y="88" width="30" height="30" rx="8" />
    <path class="accent-stroke" d="m190 93 2.5 5.5 5.5 2.5-5.5 2.5-2.5 5.5-2.5-5.5-5.5-2.5 5.5-2.5 2.5-5.5Z" />
    <rect class="pill" x="216" y="93" width="57" height="5" rx="2.5" fill={`url(#${id}-highlight)`} />
    <rect class="skeleton" x="216" y="104" width="38" height="2" rx="1" />
    <rect class="skeleton" x="216" y="111" width="58" height="2" rx="1" />
    <rect class="skeleton" x="302" y="92" width="4" height="4" rx="1" />
   </g>
   <g class="consulting-key-one satellite motion-layer" transform="rotate(-21 90 65)">
    <rect class="glass" x="69" y="44" width="42" height="42" rx="9" fill={`url(#${id}-paper)`} />
    <text class="small-label key-label" x="90" y="69" text-anchor="middle">Alt</text>
   </g>
   <g class="consulting-key-two satellite motion-layer" transform="rotate(21 330 161)">
    <rect class="glass" x="309" y="140" width="42" height="42" rx="9" fill={`url(#${id}-paper)`} />
    <text class="small-label key-label" x="330" y="165" text-anchor="middle">F4</text>
   </g>
  </>}

  {variant === 'workflow' && <>
   <g class="workflow-base motion-layer" transform="translate(205 135) rotate(17) skewX(-8) translate(-205 -135)">
    <rect class="glass faint" x="110" y="32" width="183" height="196" rx="13" fill={`url(#${id}-paper)`} />
    <rect class="skeleton" x="132" y="53" width="67" height="3" rx="1.5" />
    <rect class="skeleton" x="132" y="62" width="41" height="3" rx="1.5" />
    <path class="edge faint" d="M113 214H290" />
   </g>
   <g class="workflow-routing">
    <path class="workflow-connector" d="M127 111C154 111 142 153 168 153M257 153C283 153 266 108 282 108" />
    <circle class="workflow-junction" cx="149" cy="133" r="2.5" />
    <circle class="workflow-junction" cx="271" cy="133" r="2.5" />
   </g>
   <g class="workflow-entry satellite motion-layer" transform="rotate(16 101 106)">
    <rect class="glass" x="61" y="69" width="80" height="74" rx="10" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    <circle class="icon-disc" cx="83" cy="88" r="12" />
    <path class="accent-stroke" d="M77 84h12v8H77zM77 85l6 4 6-4" />
    <text class="small-label" x="72" y="114">Entrada</text>
    <rect class="skeleton" x="72" y="123" width="51" height="3" rx="1.5" />
    <rect class="skeleton" x="72" y="131" width="35" height="3" rx="1.5" />
   </g>
   <g class="workflow-process satellite motion-layer" transform="rotate(16 210 153)">
    <rect class="glass" x="165" y="111" width="91" height="85" rx="10" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    <rect class="icon-disc" x="178" y="124" width="27" height="27" rx="8" />
    <path class="accent-stroke" d="m193 128-7 10h6l-1 9 7-12h-6l1-7Z" />
    <rect class="pill" x="216" y="130" width="23" height="6" rx="3" fill={`url(#${id}-highlight)`} />
    <text class="small-label" x="178" y="166">Acción automática</text>
    <rect class="skeleton" x="178" y="175" width="58" height="3" rx="1.5" />
    <rect class="skeleton" x="178" y="183" width="37" height="3" rx="1.5" />
   </g>
   <g class="workflow-complete satellite motion-layer" transform="rotate(16 310 108)">
    <rect class="glass" x="273" y="70" width="75" height="76" rx="10" fill={`url(#${id}-paper)`} />
    <circle class="icon-disc" cx="295" cy="90" r="12" />
    <path class="accent-stroke" d="m289 90 4 4 7-8" />
    <text class="small-label" x="285" y="117">Completada</text>
    <rect class="skeleton" x="285" y="126" width="48" height="3" rx="1.5" />
    <rect class="skeleton" x="285" y="134" width="28" height="3" rx="1.5" />
   </g>
  </>}

  {variant === 'sales' && <>
   <g class="sales-panel motion-layer" transform="rotate(-2 200 136)">
    <rect class="glass" x="35" y="39" width="331" height="184" rx="14" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    <text class="label" x="53" y="65">Ventas</text>
    <g class="menu-dots"><circle cx="347" cy="56" r="1.4"/><circle cx="347" cy="62" r="1.4"/><circle cx="347" cy="68" r="1.4"/></g>
    {[0,1,2,3,4].map(i => <g><path class="chart-rule" d={`M78 ${91+i*24}H346`} /><text class="axis-label" x="67" y={94+i*24} text-anchor="end">{i===4?'0':`$${800-i*200}`}</text></g>)}
    {bars.map((value,i) => <g>
     <rect class="bar bar-previous" x={90+i*42} y={187-value} width="10" height={value} rx="2" />
     <rect class="bar bar-current" x={103+i*42} y={187-secondBars[i]} width="10" height={secondBars[i]} rx="2" fill={`url(#${id}-hatch)`} />
     <text class="axis-label" x={101+i*42} y="206" text-anchor="middle">{['Dom','Lun','Mar','Mié','Jue','Vie'][i]}</text>
    </g>)}
   </g>
  </>}

  {variant === 'analysis' && <>
   <g class="document-left document-side motion-layer" transform="rotate(-17 96 113)">
    <rect class="glass faint" x="45" y="63" width="70" height="86" rx="11" fill={`url(#${id}-paper)`} />
    <rect class="glass" x="52" y="58" width="70" height="86" rx="11" fill={`url(#${id}-paper)`} />
    {documentLines.map((width,i) => <rect class="document-line" x="61" y={73+i*12} width={width*.72} height="4" rx="2" />)}
   </g>
   <g class="document-right document-side motion-layer" transform="rotate(-15 307 108)">
    <rect class="glass faint" x="277" y="60" width="72" height="85" rx="11" fill={`url(#${id}-paper)`} />
    <rect class="glass" x="269" y="56" width="72" height="85" rx="11" fill={`url(#${id}-paper)`} />
    {documentLines.map((width,i) => <rect class="document-line" x="278" y={71+i*12} width={width*.72} height="4" rx="2" />)}
   </g>
   <g class="magnifier motion-layer">
    <circle cx="208" cy="105" r="55" fill={`url(#${id}-highlight)`} class="magnifier-lens" />
    <path class="magnifier-handle" d="m249 146 30 31" />
    <circle class="magnifier-rim" cx="208" cy="105" r="55" />
   </g>
   <g class="document-main motion-layer">
    <rect class="glass" x="166" y="109" width="79" height="111" rx="11" fill={`url(#${id}-paper)`} filter={`url(#${id}-shadow)`} />
    {documentLines.map((width,i) => <rect class="document-line" x="176" y={124+i*17} width={width*.84} height="7" rx="3.5" />)}
    <circle class="confirmation" cx="243" cy="217" r="11" />
    <path class="check" d="m238 217 3 3 6-7" />
   </g>
  </>}

  {variant === 'agents' && <>
   <g class="agents-back motion-layer">
    <rect class="glass faint" x="44" y="25" width="320" height="205" rx="19" fill={`url(#${id}-paper)`} />
    <rect class="glass faint" x="58" y="53" width="306" height="177" rx="15" fill={`url(#${id}-paper)`} />
    <rect class="glass faint" x="72" y="66" width="179" height="29" rx="9" fill={`url(#${id}-paper)`} />
    <text class="small-label" x="89" y="85">Agentes IA · Equipo</text>
    <path class="edge" d="m232 76 5 5-5 5m-7-5h12" />
    <rect class="search-pill glass" x="257" y="34" width="96" height="17" rx="8.5" fill={`url(#${id}-paper)`} />
   </g>
   <g class="agents-front motion-layer">
    <rect class="glass" x="52" y="94" width="312" height="140" rx="13" fill={`url(#${id}-paper)`} />
    <path class="edge" d="M52 122H364M88 122V232" />
    <rect class="glass" x="61" y="102" width="20" height="13" rx="4" />
    <text class="micro-label" x="65" y="111">IA</text>
    <text class="small-label" x="90" y="112">Escalar equipo</text>
    <rect class="glass" x="159" y="102" width="162" height="12" rx="6" />
    <circle class="edge" cx="167" cy="108" r="3" /><path class="edge" d="m169 110 2 2" />
    <rect class="skeleton" x="178" y="106" width="38" height="3" rx="1.5" />
    <rect class="glass faint" x="62" y="134" width="15" height="20" rx="2" />
    <rect class="glass faint" x="62" y="173" width="15" height="36" rx="7.5" />
    <path class="chart-rule" d="M102 132H146M102 146H146M102 160H146M102 174H146M102 188H146M102 202H146M112 125V220M129 125V220" />
    {[0,1,2,3].map(i => <rect class="agent-pill glass" x={100-i*2} y={135+i*22} width={49+i*2} height="17" rx="8.5" fill={`url(#${id}-paper)`} />)}
    <rect class="glass" x="167" y="131" width="188" height="95" rx="10" fill={`url(#${id}-paper)`} />
    <text class="label accent-text" x="179" y="152">Crece con tu equipo</text>
    <text class="small-label" x="179" y="168">Un paso a la vez</text>
    <path class="progress-track" d="M184 198H338" />
    {[0,1,2,3,4].map(i => <g>
     <circle class:list={['progress-node', { reached:i<3, pending:i>2 }]} cx={184+i*38.5} cy="198" r="7" />
     <text class="micro-label" x={184+i*38.5} y="216" text-anchor="middle">{['1%','10%','20%','60%','100%'][i]}</text>
    </g>)}
   </g>
  </>}

  {variant === 'collaboration' && <>
   <path d="M27 223C92 223 107 221 145 169C166 139 183 88 204 88C226 88 241 144 264 179C291 220 319 223 376 223Z" fill={`url(#${id}-area)`} />
   <path class="collaboration-curve" d="M27 223C92 223 107 221 145 169C166 139 183 88 204 88C226 88 241 144 264 179C291 220 319 223 376 223" />
   <path class="collaboration-orbit" d="M123 158C99 67 152 24 216 34C280 41 298 104 264 153M152 132C147 68 202 39 240 72" />
   <path class="orbit-arrow" d="m174 29 7 6-9 4m12 28-8 3 1-9" />
   <g class="collaboration-complete motion-layer">
    <rect class="glass" x="89" y="122" width="94" height="40" rx="20" fill={`url(#${id}-paper)`} />
    <text class="small-label centered-label" x="136" y="138">Tarea</text>
    <text class="small-label centered-label" x="136" y="151">completada</text>
    <circle class="avatar" cx="136" cy="182" r="17" fill={`url(#${id}-paper)`} />
    <circle class="avatar-head" cx="136" cy="176" r="5" />
    <path class="avatar-body" d="M125 193C125 181 147 181 147 193" />
    <circle class="avatar-status" cx="148" cy="194" r="5" />
    <path class="check small-check" d="m146 194 1.5 1.5 3-3" />
   </g>
   <g class="collaboration-assigned motion-layer">
    <circle class="avatar" cx="270" cy="66" r="17" fill={`url(#${id}-paper)`} />
    <circle class="avatar-head" cx="270" cy="60" r="5" />
    <path class="avatar-body" d="M259 77C259 65 281 65 281 77" />
    <rect class="glass" x="224" y="89" width="92" height="40" rx="20" fill={`url(#${id}-paper)`} />
    <text class="small-label centered-label" x="270" y="105">Tarea</text>
    <text class="small-label centered-label" x="270" y="118">asignada</text>
   </g>
  </>}
 </svg>
</Tag>

<style>
 .panel-resource {
  --panel-paper:var(--bg); --panel-ink:var(--ink); --panel-stroke:color-mix(in srgb,var(--ink) 15%,transparent);
  --panel-tint:color-mix(in srgb,var(--accent) 9%,var(--bg)); --panel-accent-fill:color-mix(in srgb,var(--accent) 15%,var(--bg));
  position:relative; display:grid; place-items:center; width:100%; height:240px; padding:0; border:0; border-radius:20px;
  background:none; color:var(--panel-ink); cursor:pointer; overflow:hidden; isolation:isolate; -webkit-tap-highlight-color:transparent;
 }
 .panel-resource.inverted { --panel-paper:var(--ink); --panel-ink:var(--bg); --panel-stroke:color-mix(in srgb,var(--bg) 17%,transparent); --panel-tint:color-mix(in srgb,var(--accent) 11%,var(--ink)); --panel-accent-fill:color-mix(in srgb,var(--accent) 18%,var(--ink)); }
 .panel-resource::before { content:''; position:absolute; z-index:-1; inset:15%; background:radial-gradient(ellipse at 60% 40%,color-mix(in srgb,var(--accent) 5%,transparent),transparent 65%); }
 .panel-resource:focus-visible { outline:2px solid var(--accent); outline-offset:-3px; }
 .panel-resource svg { display:block; width:100%; height:100%; max-width:400px; overflow:visible; }
 .glass { stroke:var(--panel-stroke); stroke-width:1; vector-effect:non-scaling-stroke; }
 .edge { stroke:var(--panel-stroke); stroke-width:1; stroke-linejoin:round; stroke-linecap:round; }
 .faint { opacity:.55; }
 .skeleton { fill:color-mix(in srgb,var(--panel-ink) 13%,transparent); }
 .accent-fill { fill:color-mix(in srgb,var(--accent) 68%,var(--panel-ink)); }
 .accent-stroke { stroke:color-mix(in srgb,var(--accent) 65%,var(--panel-ink)); stroke-width:1.3; stroke-linecap:round; stroke-linejoin:round; }
 .icon-disc { fill:color-mix(in srgb,var(--accent) 13%,transparent); stroke:var(--panel-stroke); }
 text { fill:var(--panel-ink); font-family:var(--font-sans); font-weight:400; }
 .label { font-size:11px; opacity:.8; }
 .small-label { font-size:8px; opacity:.72; }
 .micro-label { font-size:6.2px; opacity:.6; }
 .display-type { font-size:30px; font-weight:500; fill:color-mix(in srgb,var(--accent) 30%,var(--panel-ink)); opacity:.35; }
 .outline-type { fill:none; stroke:var(--panel-stroke); stroke-width:1; }
 .pill { stroke:var(--panel-stroke); stroke-width:.6; }
 .menu-dots { fill:var(--panel-ink); opacity:.4; }
 .chart-rule { stroke:var(--panel-ink); stroke-opacity:.055; stroke-width:.8; }
 .axis-label { font:7.5px var(--font-sans); opacity:.5; }
 .bar-previous { fill:color-mix(in srgb,var(--panel-ink) 8%,transparent); }
 .bar { transform-box:fill-box; transform-origin:center bottom; transition:transform 500ms cubic-bezier(.22,1,.36,1),opacity 400ms; }
 .bar-current { opacity:.64; }
 .document-line { fill:color-mix(in srgb,var(--accent) 16%,var(--panel-paper)); stroke:color-mix(in srgb,var(--panel-ink) 9%,transparent); stroke-width:.7; }
 .magnifier-lens { opacity:.72; }
 .magnifier-handle { stroke:color-mix(in srgb,var(--accent) 25%,var(--panel-paper)); stroke-width:13; stroke-linecap:round; }
 .magnifier-rim { stroke:color-mix(in srgb,var(--accent) 19%,var(--panel-stroke)); stroke-width:1; }
 .confirmation,.avatar-status { fill:var(--accent); stroke:color-mix(in srgb,var(--accent) 55%,var(--panel-paper)); stroke-width:1; }
 .check { stroke:var(--panel-paper); stroke-width:1.3; stroke-linecap:round; stroke-linejoin:round; }
 .accent-text { fill:var(--accent); opacity:.85; }
 .progress-track { stroke:var(--panel-stroke); stroke-width:1.8; }
 .progress-node { fill:var(--panel-paper); stroke:var(--panel-stroke); stroke-width:1; transition:fill 350ms,stroke 350ms; }
 .progress-node.reached { fill:var(--panel-accent-fill); stroke:color-mix(in srgb,var(--accent) 50%,var(--panel-stroke)); }
 .collaboration-curve { stroke:color-mix(in srgb,var(--panel-ink) 30%,transparent); stroke-width:1.2; stroke-linecap:round; transition:stroke 400ms; }
 .collaboration-orbit { stroke:color-mix(in srgb,var(--panel-ink) 11%,transparent); stroke-width:1.2; stroke-dasharray:3 4; }
 .orbit-arrow { stroke:color-mix(in srgb,var(--panel-ink) 23%,transparent); stroke-width:1.3; stroke-linecap:round; stroke-linejoin:round; }
 .centered-label { text-anchor:middle; font-size:10px; }
 .avatar { stroke:color-mix(in srgb,var(--accent) 20%,var(--panel-stroke)); stroke-width:1; }
 .avatar-head { fill:color-mix(in srgb,var(--accent) 55%,var(--panel-ink)); opacity:.65; }
 .avatar-body { fill:color-mix(in srgb,var(--accent) 18%,var(--panel-paper)); }
 .small-check { stroke-width:.9; }

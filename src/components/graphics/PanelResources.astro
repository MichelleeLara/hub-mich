<script>
 document.querySelectorAll<HTMLButtonElement>('[data-panel-resource]').forEach(button => {
  if (button.dataset.panelResourceReady) return;
  button.dataset.panelResourceReady = 'true';
  button.addEventListener('click', () => {
   const active = button.classList.toggle('is-active');
   button.setAttribute('aria-pressed', String(active));
  });
 });
</script>

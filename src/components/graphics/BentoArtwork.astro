---
interface Props { variant:'mark' | 'radar' | 'code'; id:string; }
const {variant,id}=Astro.props;
const point=(radius:number,angle:number)=>({x:150+radius*Math.cos(angle*Math.PI/180),y:238-radius*Math.sin(angle*Math.PI/180)});
const rings=[34,61,88,115,142,169];
const spokes=[22.5,45,67.5,90,112.5,135,157.5];
const nodes=rings.slice(1).flatMap(radius=>spokes.map(angle=>({...point(radius,angle),radius,angle})));
const left=point(165,135),right=point(165,45);
---
<button class:list={['bento-artwork',`artwork-${variant}`]} type="button" data-bento-art aria-pressed="false" aria-label={variant==='radar'?'Explorar conexiones del radar':variant==='mark'?'Explorar las formas del gráfico':'Explorar la ventana de código'}>
 {variant==='mark'&&<svg class="mark-art" viewBox="0 0 220 150" fill="none" aria-hidden="true"><defs><linearGradient id={`${id}-body`} x1=".1" y1="0" x2=".7" y2="1"><stop stop-color="var(--accent-soft)"/><stop offset=".25" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent-deep)"/></linearGradient><radialGradient id={`${id}-shine`} cx=".52" cy=".24" r=".9"><stop stop-color="var(--accent-soft)" stop-opacity=".6"/><stop offset=".3" stop-color="var(--accent-soft)" stop-opacity=".35"/><stop offset=".7" stop-color="var(--accent)" stop-opacity=".03"/><stop offset="1" stop-color="var(--accent-deep)" stop-opacity="0"/></radialGradient></defs><g class="mark-part part-one"><path d="M43 121C65 83 79 9 134 31L104 97C90 123 71 134 43 121Z" fill={`url(#${id}-body)`}/><path d="M43 121C65 83 79 9 134 31L104 97C90 123 71 134 43 121Z" fill={`url(#${id}-shine)`}/><path class="mark-edge" d="M44 120C66 83 79 11 133 31"/></g><g class="mark-part part-two"><path d="M113 119C130 91 145 55 180 71L162 104C149 125 134 130 113 119Z" fill={`url(#${id}-body)`}/><path d="M113 119C130 91 145 55 180 71L162 104C149 125 134 130 113 119Z" fill={`url(#${id}-shine)`}/><path class="mark-edge" d="M114 118C131 90 145 57 179 71"/></g></svg>}
 {variant==='radar'&&<svg class="radar-art" viewBox="0 0 300 260" fill="none" aria-hidden="true"><defs><radialGradient id={`${id}-fan`} cx=".5" cy="1" r="1"><stop stop-color="var(--bg)" stop-opacity=".35"/><stop offset=".65" stop-color="color-mix(in srgb,var(--accent) 9%,var(--bg))" stop-opacity=".55"/><stop offset="1" stop-color="color-mix(in srgb,var(--ink) 4%,var(--bg))" stop-opacity=".7"/></radialGradient><linearGradient id={`${id}-hub`} x1="0" y1="0" x2="0" y2="1"><stop stop-color="color-mix(in srgb,var(--accent) 9%,var(--bg))"/><stop offset=".55" stop-color="var(--surface)"/><stop offset="1" stop-color="var(--bg)"/></linearGradient></defs><g class="radar-sweep"><path class="radar-fan" d={`M150 238L${left.x} ${left.y}A165 165 0 0 1 ${right.x} ${right.y}Z`} fill={`url(#${id}-fan)`}/><path class="radar-edge" d={`M${left.x} ${left.y}A165 165 0 0 1 ${right.x} ${right.y}`}/></g><g class="radar-grid">{rings.map(radius=><path d={`M${150-radius} 238a${radius} ${radius} 0 0 1 ${radius*2} 0`}/>)}{spokes.map(angle=>{const p=point(169,angle);return <path d={`M150 238L${p.x} ${p.y}`}/>})}{nodes.map(p=><circle class="radar-intersection" cx={p.x} cy={p.y} r="1.5"/>)}</g>{[{...point(115,112.5),detected:true},{...point(88,22.5),detected:true}].map(p=><g class="radar-signal"><circle class="signal-halo" cx={p.x} cy={p.y} r="8"/><circle class="signal-core" cx={p.x} cy={p.y} r="3.5"/></g>)}<circle class="radar-hub" cx="150" cy="238" r="24" fill={`url(#${id}-hub)`}/></svg>}
 {variant==='code'&&<div class="code-art"><div class="code-stack"><div class="code-layer layer-back"></div><div class="code-layer layer-mid"></div><div class="code-panel"><div class="code-panel-bar"><i></i><i></i><i></i></div><pre><span class="code-bracket">&lt;head&gt;</span><br/><br/><span class="code-line">  &lt;meta <em>charset</em>=<strong>"UTF-8"</strong>&gt;</span><br/><span class="code-line">  &lt;meta <em>name</em>=<strong>"viewport"</strong></span><br/><span class="code-line">    <em>content</em>=<strong>"width=device-width"</strong>&gt;</span><br/><span class="code-line">  &lt;title&gt;./mich&lt;/title&gt;</span><br/><span class="code-line">  &lt;link <em>rel</em>=<strong>"stylesheet"</strong></span><br/><span class="code-line">    <em>href</em>=<strong>"styles.css"</strong>&gt;</span><br/><br/><span class="code-bracket">&lt;/head&gt;</span></pre></div></div></div>}
</button>
<style>
 .bento-artwork { width:100%; height:100%; position:relative; display:grid; place-items:center; color:var(--ink); background:none; border:0; padding:0; border-radius:inherit; cursor:pointer; isolation:isolate; -webkit-tap-highlight-color:transparent; }
 .bento-artwork:focus-visible { outline:2px solid var(--accent); outline-offset:-5px; }
 .mark-art { width:200px; height:150px; max-width:100%; overflow:visible; }
 .mark-edge { stroke:color-mix(in srgb,var(--accent-soft) 75%,var(--accent)); stroke-width:.8; fill:none; opacity:.55; }
 .mark-part { transform-box:fill-box; transform-origin:center; transition:transform 500ms cubic-bezier(.22,1,.36,1); }
 .part-one { filter:drop-shadow(0 3px 12px color-mix(in srgb,var(--accent) 8%,transparent)); }.part-two { filter:drop-shadow(0 3px 10px color-mix(in srgb,var(--accent) 6%,transparent)); }
 .artwork-mark:is(:hover,:focus-visible,.is-active) .part-one { transform:translate(-4px,-3px) rotate(-3deg); }
 .artwork-mark:is(:hover,:focus-visible,.is-active) .part-two { transform:translate(4px,2px) rotate(3deg); }
 .radar-art { position:absolute; width:100%; height:230px; left:0; bottom:-24px; overflow:visible; }
 .radar-grid { stroke:color-mix(in srgb,var(--ink) 13%,transparent); stroke-width:.7; }
 .radar-intersection { fill:color-mix(in srgb,var(--ink) 28%,transparent); stroke:none; }
 .radar-fan { stroke:color-mix(in srgb,var(--ink) 15%,transparent); stroke-width:1; }
 .radar-edge { stroke:color-mix(in srgb,var(--accent) 30%,var(--line)); stroke-width:1; opacity:.55; }
 .radar-sweep { transform-origin:150px 238px; transition:transform 800ms cubic-bezier(.22,1,.36,1); }
 .radar-signal { opacity:.65; transition:opacity 450ms; }
 .signal-halo { fill:color-mix(in srgb,var(--accent) 9%,transparent); stroke:color-mix(in srgb,var(--accent) 30%,transparent); stroke-width:1; }
 .signal-core { fill:color-mix(in srgb,var(--accent) 15%,var(--bg)); stroke:color-mix(in srgb,var(--accent) 65%,var(--ink)); stroke-width:1; }
 .radar-hub { stroke:color-mix(in srgb,var(--accent) 25%,var(--line)); stroke-width:.8; }
 .artwork-radar:is(:hover,:focus-visible,.is-active) .radar-sweep { transform:rotate(9deg); }
 .artwork-radar:is(:hover,:focus-visible,.is-active) .radar-signal { opacity:1; }
 .code-art { position:absolute; inset:8px 0 auto; height:305px; opacity:.65; mask-image:linear-gradient(#000 0%,#000 48%,transparent 100%); text-align:left; pointer-events:none; }
 .code-stack { position:absolute; top:27px; left:30px; width:calc(100% + 8px); height:270px; }
 .code-panel,.code-layer { position:absolute; inset:0; border:1px solid var(--line); border-radius:20px; background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 10%,var(--bg)),var(--bg)); }
 .code-layer { background:none; }.layer-back { transform:translate(-20px,-20px); opacity:.25; }.layer-mid { transform:translate(-10px,-10px); opacity:.45; }
 .code-panel,.code-layer { transition:translate 500ms cubic-bezier(.22,1,.36,1); }
 .code-panel-bar { display:flex; gap:6px; padding:18px; }.code-panel-bar i { width:6px; height:6px; border:1px solid var(--line); border-radius:50%; background:color-mix(in srgb,var(--ink) 12%,transparent); }
 .code-panel pre { padding:8px 19px; font:11px/1.6 var(--font-mono); color:var(--muted); }.code-panel em { font-style:normal; color:var(--accent); }.code-panel strong { font-weight:400; color:var(--muted); }.code-bracket { opacity:.6; }
 .code-line { transition:opacity 450ms; opacity:.7; }
 .artwork-code:is(:hover,:focus-visible,.is-active) .code-panel { translate:-2px -3px; }
 .artwork-code:is(:hover,:focus-visible,.is-active) .layer-mid { translate:-1px -1px; }
 .artwork-code:is(:hover,:focus-visible,.is-active) .layer-back { translate:0 0; }
 .artwork-code:is(:hover,:focus-visible,.is-active) .code-line { opacity:1; }
 :global(html.dark) .radar-grid { stroke:color-mix(in srgb,var(--ink) 12%,transparent); }:global(html.dark) .radar-fan { opacity:.7; }
 @media(prefers-reduced-motion:reduce) { .mark-part,.radar-sweep,.radar-signal,.code-panel,.code-layer,.code-line { transition:none; } }
 :global(html.motion-paused) .mark-part,:global(html.motion-paused) .radar-sweep,:global(html.motion-paused) .radar-signal,:global(html.motion-paused) .code-panel,:global(html.motion-paused) .code-layer,:global(html.motion-paused) .code-line { transition:none; }
 @media(prefers-reduced-motion:reduce) { .artwork-mark:is(:hover,:focus-visible,.is-active) .mark-part,.artwork-radar:is(:hover,:focus-visible,.is-active) .radar-sweep,.artwork-code:is(:hover,:focus-visible,.is-active) .code-panel { transform:none; } }
 :global(html.motion-paused) .mark-part,:global(html.motion-paused) .radar-sweep { transform:none!important; }
 :global(html.motion-paused) .code-panel,:global(html.motion-paused) .code-layer { translate:none!important; }
 @media(prefers-reduced-motion:reduce) { .artwork-code .code-panel,.artwork-code .code-layer { translate:none!important; } }
</style>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-bento-art]').forEach(button=>{
  button.addEventListener('click',()=>{const active=button.classList.toggle('is-active');button.setAttribute('aria-pressed',String(active));});
 });
</script>

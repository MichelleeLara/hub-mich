---
interface Props { variant:'integrations'|'tiles'|'analytics'|'document'|'mail'|'puzzle'|'stat'|'map'; id:string; inverted?:boolean; }
const {variant,id,inverted=false}=Astro.props;
const grid=Array.from({length:6},(_,i)=>i);
---
<button class:list={['reference-resource',`ref-${variant}`,{inverted}]} data-reference-resource data-library-resource data-variant={variant} type="button" aria-pressed="false" aria-label={`Explorar ${ {integrations:'las conexiones',tiles:'las herramientas',analytics:'el gráfico',document:'el documento',mail:'el mensaje',puzzle:'la integración',stat:'la métrica',map:'el mapa de conexiones'}[variant] }`}>
 <svg viewBox="0 0 320 240" fill="none" aria-hidden="true"><defs><linearGradient id={`${id}-panel`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--art-top)"/><stop offset="1" stop-color="var(--art-paper)"/></linearGradient><linearGradient id={`${id}-accent`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--accent-soft)"/><stop offset=".6" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent-deep)"/></linearGradient><linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1"><stop stop-color="var(--accent)" stop-opacity=".15"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
 {variant==='integrations'&&<><g class="orbit-track">{[-35,35,90].map(angle=><ellipse cx="160" cy="120" rx="107" ry="45" transform={`rotate(${angle} 160 120)`}/>)}</g><rect class="surface" x="123" y="86" width="74" height="68" rx="18" fill={`url(#${id}-panel)`}/><text class="accent" x="160" y="127" text-anchor="middle">IA</text>{[[50,54,'Datos'],[235,83,'API'],[79,174,'Flujo']].map(([x,y,label])=><g class="orbit-label"><rect class="surface" x={x} y={y} width="55" height="21" rx="10" fill="var(--art-paper)"/><text x={Number(x)+27.5} y={Number(y)+14} text-anchor="middle">{label}</text></g>)}</>}
 {variant==='tiles'&&<g class="tech-cluster" transform="translate(72 41) rotate(-12 80 75)">{grid.map(i=><g class="tech-tile" style={`--delay:${i*40}ms`}><rect class:list={['surface',{'selected':i===3}]} x={(i%3)*60} y={Math.floor(i/3)*71} width="52" height="61" rx="13" fill={i===3?`url(#${id}-panel)`:'var(--art-paper)'}/><text x={(i%3)*60+26} y={Math.floor(i/3)*71+35} text-anchor="middle">{['UI','API','IA','Web','Datos','Flujo'][i]}</text></g>)}</g>}
 {variant==='analytics'&&<><g class="chart-grid">{[65,101,137,173].map(y=><path d={`M40 ${y}H284`}/>)}{[70,110,150,190,230,270].map(x=><path d={`M${x} 48V190`}/>)}</g><path d="M40 181C71 178 76 167 95 168S120 136 146 148 177 128 188 100 213 117 232 106 266 81 284 85V190H40Z" fill={`url(#${id}-fade)`}/><path class="chart-line" d="M40 181C71 178 76 167 95 168S120 136 146 148 177 128 188 100 213 117 232 106 266 81 284 85"/><circle class="chart-point" cx="188" cy="100" r="5"/><text x="42" y="37">Resultados</text><text class="metric" x="213" y="39">+24%</text></>}
 {variant==='document'&&<><circle class="doc-halo" cx="163" cy="141" r="85"/><g class="document-panel"><path class="surface" d="M96 44h94l37 37v118H96Z" fill={`url(#${id}-panel)`}/><path class="surface" d="M190 44v37h37"/>{[95,112,129,146,163,180].map((y,i)=><rect x="112" y={y} width={i%2?88:69} height="4" rx="2" fill="var(--art-line)"/>)}</g><g class="magnifier"><circle cx="114" cy="136" r="27" fill="var(--art-paper)" fill-opacity=".4"/><circle cx="114" cy="136" r="26"/><path d="m96 155-28 32"/></g></>}
 {variant==='mail'&&<><g class="letter"><rect class="surface" x="108" y="42" width="135" height="130" rx="12" transform="rotate(-8 108 42)" fill={`url(#${id}-panel)`}/>{[66,83,100,117].map((y,i)=><rect x="123" y={y} width={i%2?92:70} height="4" rx="2" fill="var(--art-line)"/>)}</g><path class="surface" d="M61 109 160 42 259 109v90H61Z" fill="var(--art-paper)"/><path class="surface" d="m61 109 99 63 99-63M61 199l99-74 99 74"/><circle class="mail-seal" cx="160" cy="166" r="19" fill={`url(#${id}-accent)`}/><path class="seal-check" d="m152 166 5 5 11-12"/></>}
 {variant==='puzzle'&&<><g class="puzzle-grid">{[0,1,2].map(row=>[0,1,2].map(col=><path d="M0 0h23c-5 10 19 10 14 0h23v23c-10-5-10 19 0 14v23H37c5-10-19-10-14 0H0V37c10 5 10-19 0-14Z" transform={`translate(${70+col*60} ${29+row*60})`}/>))}</g><path class="puzzle-piece" d="M0 0h23c-5 10 19 10 14 0h23v23c-10-5-10 19 0 14v23H37c5-10-19-10-14 0H0V37c10 5 10-19 0-14Z" transform="translate(162 76) rotate(17)" fill={`url(#${id}-accent)`}/></>}
 {variant==='stat'&&<><g class="stat-stack">{[0,1,2].map(i=><rect class="surface" x={104-i*15} y={73+i*7} width={112+i*30} height={96-i*14} rx="19" fill={`url(#${id}-panel)`}/>)}<rect class="surface" x="104" y="73" width="112" height="96" rx="19" fill={`url(#${id}-panel)`}/><text class="stat-value" x="160" y="134" text-anchor="middle">12</text></g><text x="160" y="201" text-anchor="middle">Avances conectados</text></>}
 {variant==='map'&&<><g class="map-dots">{Array.from({length:30},(_,c)=>Array.from({length:15},(_,r)=>{const x=23+c*9.5,y=50+r*9;const land=(c<12&&r<7&&Math.sin(c*.8+r*.4)>-.2)||(c>5&&c<12&&r>6&&r<14&&c+r<22)||(c>15&&c<29&&r<9&&Math.sin(c*.5+r*.8)>-.35)||(c>16&&c<21&&r>7&&r<13);return land&&<circle cx={x} cy={y} r="1.3"/>}))}</g><g class="map-arcs"><path d="M72 83Q132 3 186 88M186 88Q240 30 261 119M72 83Q120 175 141 149"/>{[[72,83],[186,88],[261,119],[141,149]].map(([x,y])=><circle cx={x} cy={y} r="3"/>)}</g></>}
 </svg>
</button>
<style>
 .reference-resource { --art-paper:var(--bg); --art-ink:var(--ink); --art-line:var(--line); --art-top:color-mix(in srgb,var(--accent) 8%,var(--bg)); display:grid; place-items:center; width:100%; height:240px; padding:0; border:0; background:none; border-radius:20px; color:var(--art-ink); cursor:pointer; }
 .reference-resource.inverted { --art-paper:var(--ink); --art-ink:var(--bg); --art-line:color-mix(in srgb,var(--bg) 15%,transparent); --art-top:color-mix(in srgb,var(--accent) 8%,var(--ink)); }
 svg { width:100%; height:100%; max-width:360px; overflow:visible; }text { fill:var(--art-ink); font:9px var(--font-mono); opacity:.65; }.surface { stroke:var(--art-line); stroke-width:1; }.accent { fill:var(--accent); font:24px var(--font-sans); opacity:.85; }
 .orbit-track,.chart-grid,.puzzle-grid { stroke:var(--art-line); stroke-width:.7; }.chart-line,.map-arcs { stroke:var(--accent); stroke-width:1.5; stroke-linecap:round; }.chart-point { fill:var(--art-paper); stroke:var(--accent); stroke-width:1.4; }.metric { fill:var(--accent); font-size:17px; }.selected { stroke:color-mix(in srgb,var(--accent) 35%,var(--art-line)); }
 .doc-halo { fill:color-mix(in srgb,var(--accent) 3%,transparent); stroke:color-mix(in srgb,var(--accent) 15%,transparent); }.magnifier { stroke:color-mix(in srgb,var(--art-ink) 48%,var(--accent)); stroke-width:3; }.magnifier path { stroke-width:7; stroke-linecap:round; }.seal-check { stroke:var(--art-paper); stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }.puzzle-piece { stroke:var(--accent); stroke-width:.8; }.stat-value { font:500 50px var(--font-sans); fill:var(--accent); opacity:.8; }.map-dots { fill:color-mix(in srgb,var(--art-ink) 20%,transparent); }.map-arcs circle { fill:var(--art-paper); }
 .reference-resource:focus-visible { outline:2px solid var(--accent); outline-offset:-5px; }
 @media(prefers-reduced-motion:no-preference) {
 .orbit-label,.tech-cluster,.document-panel,.magnifier,.letter,.puzzle-piece,.stat-stack,.map-arcs,.chart-point { transition:transform 600ms cubic-bezier(.22,1,.36,1),opacity 500ms; transform-box:fill-box; transform-origin:center; }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .orbit-label { transform:translateY(-3px); }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .tech-cluster { transform:translate(72px,37px) rotate(-12deg); transform-box:view-box; transform-origin:80px 75px; }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .magnifier { transform:translate(5px,-4px); }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .letter { transform:translateY(-7px); }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .puzzle-piece { transform:translate(161px,72px) rotate(10deg); transform-box:view-box; transform-origin:0 0; }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .stat-stack { transform:translateY(-4px); }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .map-arcs { opacity:.55; }
 :global(html:not(.motion-paused)) .reference-resource:is(:hover,:focus-visible,.is-active) .chart-point { transform:scale(1.35); }
 }
 :global(html.motion-paused) .reference-resource * { transition:none; }
</style>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-reference-resource]').forEach(button=>button.addEventListener('click',()=>{const active=button.classList.toggle('is-active');button.setAttribute('aria-pressed',String(active));}));
</script>

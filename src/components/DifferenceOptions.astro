---
import PanelResources from './graphics/PanelResources.astro';
import DifferenceArtwork from './graphics/DifferenceArtwork.astro';
interface Props { variant: 'editorial' | 'reasons' | 'evidence'; integrated?: boolean; id?: string; }
const { variant, integrated = false, id } = Astro.props;
const titleId = `why-${variant}-title`;
const reasons = [
 { title: 'Empiezo por entender tu negocio.', text: 'Busco qué necesitas resolver, qué está frenando el producto y qué conviene construir primero.', label: 'Criterio de producto' },
 { title: 'Diseño y construyo la solución.', text: 'Conecto la experiencia con su implementación: interfaz, datos y código con la misma intención.', label: 'Diseño + ingeniería' },
 { title: 'He trabajado con problemas reales.', text: 'Mapas en vivo, plataformas para distintas marcas, agentes de IA y dispositivos conectados.', label: 'Experiencia aplicada' },
 { title: 'Me involucro con tu equipo.', text: 'Explico las decisiones, comparto contexto y conecto negocio, diseño e ingeniería para avanzar.', label: 'Colaboración directa' },
];
const reasonGraphics = ['consulting', 'perspective', 'sales', 'collaboration'] as const;
const proofs = [
 { value: '+65%', title: 'Cuido cómo se siente usar el producto.', text: 'Mejoré el rendimiento de una plataforma logística y su actualización de datos.', project: 'Inteligencia Logística', slug: 'inteligencia-logistica', note: 'Rendimiento del mapa' },
 { value: '6', title: 'Puedo construir junto a tu equipo.', text: 'Lideré a seis ingenieros y definí una arquitectura común para una plataforma de múltiples marcas.', project: 'Monitoreo White-Label', slug: 'monitoreo-white-label', note: 'Ingenieros liderados' },
 { value: '< 2 min', title: 'Llevo la IA a una experiencia útil.', text: 'Construí el flujo de reportes automatizados de Luz.ia, mi producto en prevalidación.', project: 'Luz.ia · MVP', slug: 'luzia-agentes-ia', note: 'Reportes automatizados' },
];
---
<section id={id} class:list={['why-section',`why-${variant}`, { 'section-shell': integrated, integrated }]} aria-labelledby={titleId}>
 {variant === 'editorial' && <>
  <div class="editorial-layout">
   <header class="personal-intro">
    <p class="eyebrow">¿Por qué trabajar conmigo?</p>
    <h2 id={titleId}>Tu idea, con alguien<br/>que la <span>sabe construir.</span></h2>
    <p class="intro">Una mirada de producto y experiencia para conectar diseño, tecnología y negocio.</p>
    <div class="person"><img src="/media/hero-profile-240.webp" width="240" height="300" alt="Michelle Rodriguez" /><div><strong>Michelle Rodriguez</strong><span>Product Engineer · Diseño, ingeniería e IA</span></div></div>
   </header>
   <div class="editorial-reasons">
    {reasons.map((reason,index)=><article>
     <span class="number" aria-hidden="true">0{index+1}</span>
     <div class="editorial-art">{index < 2
      ? <DifferenceArtwork variant={index === 0 ? 'context' : 'build'} id={`why-personal-${index}`} />
      : <PanelResources variant={reasonGraphics[index]} id={`why-personal-${index}`} decorative />}</div>
     <h3>{reason.title}</h3><p>{reason.text}</p>
    </article>)}
   </div>
  </div>
 </>}
 {variant === 'reasons' && <>
  <header class="center-heading">
   <p class="eyebrow">¿Por qué trabajar conmigo?</p>
   <h2 id={titleId}>Tu idea, con alguien<br/>que la <span>sabe construir.</span></h2>
   <p class="intro">Una mirada de producto y experiencia para conectar diseño, tecnología y negocio.</p>
  </header>
  <div class="reason-cards">
   <article class="reason-card">
    <div class="art-stage"><PanelResources variant="consulting" id="why-context" decorative /></div>
    <div class="card-copy"><span class="mini-label">01 · CRITERIO</span><h3>Entender antes<br/>de construir.</h3><p>Te ayudo a ordenar la idea, definir prioridades y decidir dónde vale la pena empezar.</p></div>
   </article>
   <article class="reason-card">
    <div class="art-stage"><PanelResources variant="perspective" id="why-design" decorative /></div>
    <div class="card-copy"><span class="mini-label">02 · DISEÑO + CÓDIGO</span><h3>Del concepto<br/>al producto.</h3><p>Diseño la experiencia y la llevo a código, cuidando los detalles de cómo se ve y se usa.</p></div>
   </article>
   <article class="reason-card">
    <div class="art-stage"><PanelResources variant="collaboration" id="why-team" decorative /></div>
    <div class="card-copy"><span class="mini-label">03 · COLABORACIÓN</span><h3>Alguien dentro<br/>de tu equipo.</h3><p>Me involucro, explico las decisiones y comparto el contexto necesario para avanzar juntos.</p></div>
   </article>
  </div>
  <p class="experience-note">Experiencia en productos con datos en vivo, plataformas de múltiples marcas, IA y hardware.</p>
 </>}
 {variant === 'evidence' && <>
  <header class="evidence-heading">
   <div><p class="eyebrow">¿Por qué trabajar conmigo?</p><h2 id={titleId}>Lo que puedo aportar.<br/><span>Lo que ya he construido.</span></h2></div>
   <p class="intro">Mi experiencia se traduce en decisiones que cuidan el producto, el equipo y a quien lo usa.</p>
  </header>
  <div class="proof-cards">
   {proofs.map((proof,index)=><article class="proof-card">
    <p class="mini-label">0{index+1} · EXPERIENCIA APLICADA</p>
    <h3>{proof.title}</h3><p class="proof-description">{proof.text}</p>
    <div class="proof-result"><strong>{proof.value}</strong><span>{proof.note}</span></div>
    <a href={`/proyectos/${proof.slug}`}>Ver {proof.project}<span aria-hidden="true">↗</span></a>
   </article>)}
  </div>
 </>}
 <footer class="why-footer"><p>Cuéntame qué quieres construir. Veamos cómo puedo ayudarte.</p><a href="mailto:mich.ia@hotmail.com?subject=Trabajemos%20juntos">Trabajemos juntos <span aria-hidden="true">↗</span></a></footer>
</section>
<style>
 .why-section { color:var(--ink); padding:48px 0 32px; }
 .why-section.integrated { padding:var(--section-y) var(--gutter); }
 .eyebrow { width:fit-content; color:var(--muted); font:400 clamp(13px,1.25vw,16px)/1.55 var(--font-note); letter-spacing:0; margin-bottom:var(--space-5); }
 h2 { font:700 clamp(40px,4.7vw,60px)/1.04 var(--font-sans); letter-spacing:-.045em; text-wrap:balance; }
 h2 span { color:inherit; }
 h3 { font:600 24px/1.15 var(--font-sans); letter-spacing:-.025em; text-wrap:balance; }
 .intro { font-size:18px; line-height:1.6; color:var(--muted); }
 .editorial-layout { display:grid; grid-template-columns:.95fr 1.1fr; gap:72px; align-items:start; }
 .personal-intro .intro { margin-top:24px; max-width:385px; }
 .person { display:flex; align-items:center; gap:16px; margin-top:36px; }
 .person img { width:64px; height:64px; border-radius:50%; object-fit:cover; object-position:50% 25%; border:1px solid var(--line); }
 .person strong { font-size:15px; font-weight:600; }
 .person span { display:block; margin-top:4px; color:var(--muted); font-size:12px; line-height:1.5; }
 .editorial-reasons { display:grid; grid-template-columns:1fr 1fr; gap:36px 32px; padding-top:4px; }
 .editorial-reasons article { padding-top:20px; border-top:1px solid var(--line); }
 .editorial-art { position:relative; height:138px; margin:8px 0 12px; }
 .editorial-art :global(.panel-resource) { width:100%; height:138px; opacity:.85; mask-image:linear-gradient(to bottom,black 78%,transparent 100%); }
 .number { color:var(--accent); font:12px/1.4 var(--font-mono); }
 .editorial-reasons h3 { margin-top:16px; }
 .editorial-reasons p { margin-top:12px; font-size:16px; line-height:1.55; color:var(--muted); }
 .center-heading { text-align:center; max-width:800px; margin:0 auto 36px; }
 .center-heading .eyebrow { margin-left:auto; margin-right:auto; }
 .center-heading .intro { max-width:560px; margin:20px auto 0; }
 .reason-cards,.proof-cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
 .reason-card { border:1px solid var(--line); border-radius:var(--radius-lg); overflow:hidden; background:linear-gradient(135deg,var(--surface),var(--surface-glass)); }
 .art-stage { height:168px; position:relative; overflow:hidden; }
 .art-stage :global(.panel-resource) { position:absolute; width:100%; height:205px; inset:-12px 0 auto; opacity:.85; }
 .card-copy { padding:0 28px 28px; }
 .mini-label { color:var(--muted); font:500 11px/1.5 var(--font-mono); letter-spacing:.045em; }
 .card-copy h3 { margin-top:14px; font-size:28px; }
 .card-copy p { margin-top:14px; font-size:16px; line-height:1.55; color:var(--muted); }
 .experience-note { color:var(--muted); font-size:13px; line-height:1.5; margin-top:20px; text-align:center; }
 .evidence-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; margin-bottom:40px; }
 .evidence-heading .intro { max-width:290px; flex-shrink:0; font-size:16px; }
 .proof-card { display:flex; flex-direction:column; border:1px solid var(--line); border-radius:var(--radius-lg); padding:28px; background:var(--surface-glass); }
 .proof-card h3 { margin-top:20px; font-size:26px; }
 .proof-description { color:var(--muted); font-size:16px; line-height:1.55; margin-top:16px; }
 .proof-result { margin-top:auto; padding-top:36px; }
 .proof-result strong { display:block; font:600 clamp(40px,4.2vw,56px)/1.1 var(--font-display); letter-spacing:-.035em; }
 .proof-result>span { display:block; margin-top:8px; font-size:13px; color:var(--muted); }
 .proof-card a { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; padding-top:20px; border-top:1px solid var(--line); margin-top:24px; color:var(--accent); font-size:14px; }
 .why-footer { display:flex; align-items:center; justify-content:space-between; gap:32px; border-top:1px solid var(--line); padding-top:24px; margin-top:40px; }
 .why-footer p { color:var(--muted); font-size:14px; line-height:1.5; }
 .why-footer>a { display:inline-flex; align-items:center; justify-content:center; gap:28px; min-height:48px; padding:12px 24px; border-radius:var(--radius-full); background:var(--ink); color:var(--bg); font-size:14px; font-weight:600; white-space:nowrap; }
 @media(max-width:900px) { .editorial-layout { gap:36px; } .editorial-reasons { gap:28px 20px; } .evidence-heading { display:block; } .evidence-heading .intro { max-width:500px; margin-top:20px; } .card-copy,.proof-card { padding:24px; } }
 @media(max-width:767px) {
  .why-section { padding-top:32px; }
  h2 { font-size:clamp(36px,10.5vw,46px); }
  .intro { font-size:16px; }
  .editorial-layout { grid-template-columns:1fr; gap:32px; }
  .personal-intro .intro { max-width:450px; }
  .person { margin-top:24px; }
  .editorial-reasons { grid-template-columns:1fr; gap:24px; }
  .editorial-reasons article { display:grid; grid-template-columns:28px 1fr; gap:8px 12px; }
  .editorial-art { grid-column:2; grid-row:1; width:min(100%,280px); height:160px; margin:0 0 12px; }
  .editorial-art :global(.panel-resource) { height:160px; }
  .editorial-reasons h3 { grid-column:2; }
  .editorial-reasons h3 { margin:0; font-size:24px; }
  .editorial-reasons .number { padding-top:4px; }
  .editorial-reasons p { grid-column:2; margin-top:4px; }
  .center-heading { text-align:left; margin-bottom:28px; }
  .center-heading .intro { margin-top:16px; }
  .reason-cards,.proof-cards { grid-template-columns:1fr; gap:20px; }
  .art-stage { height:160px; }
  .art-stage :global(.panel-resource) { max-width:340px; left:50%; transform:translateX(-50%); }
  .card-copy { padding:0 24px 24px; }
  .card-copy h3 br { display:none; }
  .card-copy h3 { font-size:26px; }
  .experience-note { text-align:left; }
  .proof-result { padding-top:28px; }
  .why-footer { align-items:flex-start; flex-direction:column; gap:16px; margin-top:32px; }
 }
</style>

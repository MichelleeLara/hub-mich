---
// Sección "Trayectoria" (experiencia laboral) del Home. Lista editorial de
// filas rol/empresa/fechas. Va sobre fondo claro para contrastar con el grid
// oscuro de proyectos. Theme-aware para respetar el toggle del header.
const jobs = [
	{
		role: 'Frontend UI Engineer',
		company: 'Row Quintero Studio',
		dates: '2026 — Presente',
	},
	{
		role: 'Firmware & Frontend Lead',
		company: 'Bego AI',
		dates: '2025 — 2026',
	},
	{
		role: 'Frontend Developer',
		company: 'Bego',
		dates: '2024 — 2025',
	},
];
---

<section class="mx-auto max-w-5xl px-8 py-32 text-zinc-900 dark:text-secondary">
	<!-- Encabezado sutil -->
	<h2 class="mb-16 font-mono text-sm uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
		Trayectoria
	</h2>

	<!-- Tabla de experiencia -->
	<div class="flex flex-col">
		{
			jobs.map((job, i) => (
				<div
					class={`group flex flex-col justify-between border-t border-zinc-200 py-8 transition-colors hover:bg-zinc-50/50 dark:border-white/10 dark:hover:bg-white/[0.03] md:flex-row md:items-baseline ${i === jobs.length - 1 ? 'border-b' : ''}`}
				>
					<!-- Izquierda · rol y empresa -->
					<div class="flex flex-col gap-1">
						<h3 class="text-2xl font-bold tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600 dark:text-secondary dark:group-hover:text-zinc-400 md:text-3xl">
							{job.role}
						</h3>
						<p class="inline-flex items-center gap-1.5 text-lg font-medium text-zinc-500 dark:text-zinc-400">
							{job.company}
							<svg
								class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M7 7h10v10" />
								<path d="M7 17 17 7" />
							</svg>
						</p>
					</div>

					<!-- Derecha · fechas -->
					<span class="mt-4 font-mono text-sm text-zinc-400 dark:text-zinc-500 md:mt-0 md:text-right">
						{job.dates}
					</span>
				</div>
			))
		}
	</div>
</section>

<script>
 const section=document.querySelector<HTMLElement>('.services');
 if(section){
  section.querySelectorAll<HTMLButtonElement>('[data-service-open]').forEach(button=>{
   const dialog=section.querySelector<HTMLDialogElement>(`#service-detail-${button.dataset.serviceOpen}`)!;
   let closing=false;
   const reduced=()=>matchMedia('(prefers-reduced-motion:reduce)').matches||document.documentElement.classList.contains('motion-paused');
   const close=()=>{if(closing)return;closing=true;const finish=()=>{dialog.close();closing=false;button.focus({preventScroll:true});};if(reduced()){finish();return;}dialog.animate([{opacity:1,transform:'translateY(0)'},{opacity:0,transform:'translateY(8px)'}],{duration:150,easing:'ease-in'}).finished.then(finish);};
   button.addEventListener('click',()=>{dialog.showModal();if(!reduced())dialog.animate([{opacity:0,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:220,easing:'cubic-bezier(.2,.8,.2,1)'});});
   dialog.querySelector('.detail-close')!.addEventListener('click',close);
   dialog.addEventListener('cancel',event=>{event.preventDefault();close();});
   dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)close();});
  });
  const track=section.querySelector<HTMLElement>('.service-track')!,cards=Array.from(track.querySelectorAll<HTMLElement>('.service-card'));
  const buttons=Array.from(section.querySelectorAll<HTMLButtonElement>('[data-service-direction]'));
  const selectors=Array.from(section.querySelectorAll<HTMLButtonElement>('[data-service-select]'));
  selectors.forEach((button,index)=>button.addEventListener('click',()=>{selectors.forEach((choice,i)=>choice.setAttribute('aria-pressed',String(i===index)));cards.forEach((card,i)=>card.classList.toggle('selected-service',i===index));}));
  const position=section.querySelector('.service-position');
  const measureWave=()=>{
   const box=track.getBoundingClientRect(),width=track.scrollWidth,scroll=track.scrollLeft;
   const positions=cards.map(card=>{const art=card.querySelector<HTMLElement>('.service-art')!;return {art,x:art.getBoundingClientRect().left-box.left+scroll};});
   // Measure together, then write together; scrolling doesn't change this geometry.
   positions.forEach(({art,x})=>{art.style.setProperty('--shared-width',`${width}px`);art.style.setProperty('--shared-x',`${x}px`);});
  };
  const update=()=>{
   const index=Math.round(track.scrollLeft/(cards[0].offsetWidth+parseFloat(getComputedStyle(track).columnGap)));
   const label=`0${index+1} / 0${cards.length}`;if(position&&position.textContent!==label)position.textContent=label;
   buttons[0].disabled=track.scrollLeft<2;buttons[1].disabled=track.scrollLeft>=track.scrollWidth-track.clientWidth-2;
  };
  buttons.forEach(button=>button.addEventListener('click',()=>{const distance=(cards[0].offsetWidth+parseFloat(getComputedStyle(track).columnGap))*Number(button.dataset.serviceDirection);track.scrollBy({left:distance,behavior:matchMedia('(prefers-reduced-motion:reduce)').matches||document.documentElement.classList.contains('motion-paused')?'auto':'smooth'});}));
  track.addEventListener('scroll',update,{passive:true});const resize=()=>{measureWave();update();};addEventListener('resize',resize,{passive:true});new ResizeObserver(resize).observe(track);resize();
 }
</script>

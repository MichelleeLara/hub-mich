---
import PanelResources from './graphics/PanelResources.astro';
import BentoArtwork from './graphics/BentoArtwork.astro';
const {bento=true}=Astro.props;
const samplePrices=['12,000','24,000','18,000'];
// Placeholder copy for comparing the service layouts; final scope is still to be defined.
const services=[
 {title:'Consultor IA',short:'Encuentra dónde la IA puede aportar valor.',headline:'Una dirección clara para empezar.',deliverables:['Diagnóstico de oportunidades','Ruta de implementación','Acompañamiento y validación'],project:'Luz.ia',slug:'luzia-agentes-ia',symbol:'ai'},
 {title:'Desarrollo web',short:'De una idea a una experiencia funcional.',headline:'Llevar tu producto a la web.',deliverables:['Diseño e implementación web','Conexión con datos y APIs','Entrega y puesta en marcha'],project:'Monitoreo White-Label',slug:'monitoreo-white-label',symbol:'system'},
 {title:'Automatizaciones',short:'Menos tareas repetitivas. Más tiempo para avanzar.',headline:'Simplificar tu operación.',deliverables:['Conexión de herramientas','Automatización de procesos','Seguimiento de resultados'],project:'Luz.ia',slug:'luzia-agentes-ia',symbol:'interface'},
];
---
<section class:list={["section-shell services handwritten format-exterior format-split",{"format-bento":bento}]} data-graphic="ambient" id="servicios" aria-labelledby="services-title">
 <header class="services-heading">
  <div class="heading-note"><p>¿Qué construimos?</p><svg viewBox="0 0 90 65" fill="none" aria-hidden="true"><path d="M12 3c-4 29 17 43 59 48m-8-9 10 9-13 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
  <h2 id="services-title">Diseño, ingeniería e IA.<br/><span>Para tu siguiente paso.</span></h2>
 </header>
 <svg class="section-ribbon" viewBox="0 0 1400 620" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true"><path d="M180 130C-40 440 290 640 495 475C700 310 420 190 430 390C445 650 920 575 1010 290C1105 -15 785 65 860 260C940 465 1195 385 1270 90"/></svg>
 <div class="service-selector" aria-label="Elegir un servicio">{services.map((service,i)=><button type="button" data-service-select={i} aria-pressed={i===0}><span class="select-number">0{i+1}</span><span><strong>{service.title}</strong><small>{service.short}</small></span><span class="select-check" aria-hidden="true">↗</span></button>)}</div>
 <div class="service-track" aria-label="Servicios disponibles" tabindex="0">
  {services.map((service,i)=><article class:list={["service-card",{"selected-service":i===0}]} aria-labelledby={`service-title-${i}`}>
   <svg class="service-ribbon" viewBox="0 0 1400 620" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true"><path d="M180 130C-40 440 290 640 495 475C700 310 420 190 430 390C445 650 920 575 1010 290C1105 -15 785 65 860 260C940 465 1195 385 1270 90"/></svg>
   <div class="card-top"><span>0{i+1}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><rect x="4" y="4" width="10" height="10" rx="3"/><rect x="10" y="10" width="10" height="10" rx="3"/></svg></div>
   <div class={`service-art art-${service.symbol}`} aria-hidden="true">
    <svg class="shared-light" viewBox="0 0 1200 220" preserveAspectRatio="none"><defs><linearGradient id={`shared-light-${i}`} x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#eaded8"/><stop offset=".5" stop-color="#cfaa95"/><stop offset="1" stop-color="#a85d35"/></linearGradient><filter id={`shared-blur-${i}`} x="-30%" y="-100%" width="160%" height="300%"><feGaussianBlur stdDeviation="15"/></filter></defs><path d="M-140 -80C50 220 230 40 480 65S910 280 1350 -90" stroke={`url(#shared-light-${i})`} stroke-width="100" fill="none" filter={`url(#shared-blur-${i})`}/><path d="M-140 -80C50 220 230 40 480 65S910 280 1350 -90" stroke="#fff" stroke-width="30" opacity=".65" fill="none" filter={`url(#shared-blur-${i})`}/></svg>
    {service.symbol==='interface'&&<div class="mini-window"><div class="window-bar"><i></i><i></i><i></i></div><div class="window-body"><div class="mini-sidebar"><b></b><b></b><b></b></div><div class="mini-content"><span class="skeleton wide"></span><span class="skeleton"></span><div class="mini-grid"><span></span><span></span></div></div></div><div class="floating-note"><span class="note-icon">↗</span><div><strong>Una experiencia clara</strong><small>Diseñar · Probar · Afinar</small></div></div></div>}
    {service.symbol==='system'&&<div class="tech-grid">{['UI','API','Datos','Web','Tiempo real','Producto'].map((label,n)=><span class:list={['tech-tile',{'tile-accent':n===3}]}>{label}</span>)}</div>}
    {service.symbol==='ai'&&<><div class="ai-orbits"><i></i><i></i><i></i><span>IA</span></div><div class="ai-note"><span class="status-dot"></span>Del dato a la acción</div></>}
    {service.symbol==='chip'&&<div class="device-diagram"><svg viewBox="0 0 300 160" fill="none"><path d="M150 30v100M90 80H35m175 0h55M90 55H65V25m145 80h25v30" stroke="currentColor" stroke-width="1"/><circle cx="35" cy="80" r="4"/><circle cx="265" cy="80" r="4"/><circle cx="65" cy="25" r="4"/><circle cx="235" cy="135" r="4"/></svg><div class="device-chip"><span></span><strong>IoT</strong><small>Conectado</small></div></div>}
   </div>
   <div class:list={["service-resource",{"resource-perspective":i===1,"resource-consulting":i===0,"resource-workflow":i===2}]}><PanelResources variant={i===1?"perspective":i===0?"consulting":"workflow"} id={`services-graphic-${i}`} decorative/></div>
   <div class="service-copy"><h3 id={`service-title-${i}`}>{service.title}</h3><p>{service.short}</p></div>
   <div class="service-price"><small>Desde · precio de muestra</small><p>${samplePrices[i]} <span>MXN / proyecto</span></p></div>
   <p class="service-promise">{service.headline}</p>
   <div class="service-scope"><p class="scope-label">Podemos construir</p><ul>{service.deliverables.map(item=><li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg><span>{item}</span></li>)}</ul><a class="service-cta" href={`mailto:mich.ia@hotmail.com?subject=${encodeURIComponent('Hablemos de '+service.title)}`}>Hablemos de tu idea <span aria-hidden="true">↗</span></a></div>
   <button class="service-open" type="button" data-service-open={i} aria-haspopup="dialog" aria-controls={`service-detail-${i}`} aria-label={`Ver servicio: ${service.title}`}><span>Explorar servicio</span><span aria-hidden="true">↗</span></button>
   <a class="service-case" href={`/proyectos/${service.slug}`}>Ver en práctica · {service.project} <span aria-hidden="true">↗</span></a>
  </article>)}
  {bento&&<>
   <div class="bento-brand bento-decoration"><BentoArtwork variant="mark" id="services-mark" /></div>
   <div class="bento-radar bento-decoration"><p>Diseño, código y criterio.</p><BentoArtwork variant="radar" id="services-radar" /></div>
   <div class="bento-code bento-decoration"><BentoArtwork variant="code" id="services-code" /><p>Ideas que toman forma.</p></div>
  </>}
 </div>
 {services.map((service,i)=><dialog class="service-detail" id={`service-detail-${i}`} aria-labelledby={`detail-title-${i}`}>
  <button class="detail-close" type="button" aria-label="Cerrar detalle">×</button>
  <p class="detail-eyebrow">Servicio · 0{i+1}</p><h2 id={`detail-title-${i}`}>{service.title}</h2><p class="detail-intro">{service.short}</p>
  <div class="detail-price"><small>Precio de muestra · alcance por definir</small><p>${samplePrices[i]} <span>MXN / proyecto</span></p></div>
  <h3>De inicio a entrega</h3><ol class="detail-steps"><li><span>01</span><div><strong>Entender tu objetivo</strong><p>Conversamos sobre tu idea, el problema y el resultado que buscas.</p></div></li><li><span>02</span><div><strong>Definir el alcance</strong><p>Acordamos una propuesta, entregables y tiempos antes de comenzar.</p></div></li><li><span>03</span><div><strong>Construir y revisar</strong><p>Avanzamos con entregas y revisiones para validar la dirección.</p></div></li><li><span>04</span><div><strong>Entregar y acompañar</strong><p>Revisamos el resultado y los pasos para ponerlo en uso.</p></div></li></ol>
  <div class="detail-start"><h3>¿Cómo comenzamos?</h3><p>Cuéntame qué necesitas resolver y en qué etapa estás.</p><a class="service-cta" href={`mailto:mich.ia@hotmail.com?subject=${encodeURIComponent('Hablemos de '+service.title)}`}>Hablemos de tu idea <span aria-hidden="true">↗</span></a></div>
 </dialog>)}
 <div class="services-navigation"><p>Una parte del producto o el recorrido completo.</p><div><span class="service-position" aria-live="polite">01 / 03</span><button type="button" data-service-direction="-1" aria-label="Servicio anterior">←</button><button type="button" data-service-direction="1" aria-label="Siguiente servicio">→</button></div></div>
</section>
<style>
 .services-heading { display:flex; align-items:flex-start; gap:40px; margin-bottom:48px; }
 .heading-note { width:190px; flex-shrink:0; color:var(--accent); padding-top:8px; }
 .heading-note p { font:400 20px/1.3 var(--font-accent); }
 .heading-note svg { display:none; width:76px; height:60px; margin:8px 0 0 40px; }
 .handwritten .heading-note p { font:400 30px/1.2 var(--font-accent); white-space:nowrap; transform:rotate(-5deg); }
 .handwritten .heading-note svg { display:block; }
 .services-heading h2 { font:550 clamp(34px,4.2vw,56px)/1.1 var(--font-sans); letter-spacing:-.045em; text-wrap:balance; }
 .services-heading h2 span { color:var(--muted); }
 .service-track { display:grid; grid-auto-flow:column; grid-auto-columns:calc((100% - 40px)/3); gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:10px 2px 28px; margin:0 -2px; }
 .service-track::-webkit-scrollbar { display:none; }
 .service-card { scroll-snap-align:start; display:flex; flex-direction:column; padding:24px 20px 18px; min-width:0; border:1px solid var(--line); border-radius:32px; background:color-mix(in srgb,var(--surface) 92%,var(--bg)); box-shadow:0 10px 24px rgb(0 0 0 / .025); overflow:hidden; }
 .card-top { display:flex; justify-content:space-between; align-items:center; color:var(--muted); }
 .card-top>span { font:450 30px/1 var(--font-sans); letter-spacing:-.04em; }
 .card-top svg { width:28px; height:28px; opacity:.5; }
 .service-art { height:182px; position:relative; margin:18px -4px 22px; display:flex; align-items:center; justify-content:center; color:var(--accent); background:radial-gradient(ellipse at center,color-mix(in srgb,var(--accent) 8%,transparent),transparent 72%); }
 .service-selector { display:none; }
 .shared-light { display:none; }
 .shared-wave .service-art { overflow:hidden; background:none; margin-left:-20px; margin-right:-20px; }
 .shared-wave .service-art>:not(.shared-light) { display:none; }
 .shared-wave .shared-light { display:block; position:absolute; top:0; left:calc(-1 * var(--shared-x,0px)); width:var(--shared-width,1200px); height:220px; max-width:none; opacity:.8; }
 .service-copy h3 { font:550 25px/1.15 var(--font-sans); letter-spacing:-.025em; }
 .service-copy p { font-size:14px; color:var(--muted); line-height:1.6; margin-top:12px; min-height:45px; }
 .service-scope { margin:22px -8px 0; padding:20px 16px 12px; flex:1; display:flex; flex-direction:column; border:1px solid var(--line); border-radius:24px; background:var(--bg); box-shadow:0 3px 8px rgb(0 0 0 / .025); }
 .scope-label { font:11px/1.4 var(--font-mono); color:var(--muted); margin-bottom:16px; }
 .service-scope ul { list-style:none; display:grid; gap:14px; margin-bottom:24px; }
 .service-scope li { display:flex; gap:10px; font-size:13px; line-height:1.5; color:var(--muted); }
 .service-scope li svg { width:16px; height:20px; flex-shrink:0; color:var(--accent); }
 .service-cta { display:flex; align-items:center; justify-content:center; gap:20px; min-height:44px; padding:10px 12px; border-radius:999px; font-size:13px; font-weight:550; color:var(--bg); background:var(--accent); margin-top:auto; box-shadow:inset 0 1px 2px rgb(255 255 255 / .2); }
 .service-case { font-size:11px; color:var(--muted); display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:44px; padding:14px 2px 0; }
 .services-navigation { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:6px; color:var(--muted); font-size:13px; }
 .services-navigation>div { display:flex; align-items:center; gap:10px; }
 .service-position { font:11px/1.3 var(--font-mono); margin-right:12px; }
 .services-navigation button { border:1px solid var(--line); border-radius:50%; background:var(--bg); color:var(--ink); width:44px; height:44px; font-size:20px; }
 .services-navigation button:disabled { opacity:.3; cursor:default; }
 .mini-window { position:relative; width:218px; height:136px; border:1px solid var(--line); border-radius:14px; background:var(--bg); box-shadow:0 14px 30px rgb(0 0 0 / .08); transform:rotate(-6deg); }
 .window-bar { display:flex; gap:4px; padding:10px; border-bottom:1px solid var(--line); }
 .window-bar i { width:4px; height:4px; border-radius:50%; background:var(--muted); opacity:.4; }
 .window-body { display:flex; height:100px; }
 .mini-sidebar { width:42px; padding:14px 9px; border-right:1px solid var(--line); display:grid; align-content:start; gap:9px; }
 .mini-sidebar b { height:3px; background:var(--line); border-radius:4px; }
 .mini-content { flex:1; padding:15px; }
 .skeleton { display:block; width:46%; height:4px; background:var(--line); border-radius:3px; margin-bottom:7px; }
 .skeleton.wide { width:74%; background:color-mix(in srgb,var(--accent) 30%,var(--line)); }
 .mini-grid { display:flex; gap:7px; margin-top:14px; }
 .mini-grid span { width:50%; height:35px; background:var(--surface); border:1px solid var(--line); border-radius:5px; }
 .floating-note { display:flex; align-items:center; gap:9px; position:absolute; right:-15px; bottom:-10px; background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:11px; transform:rotate(6deg); box-shadow:0 10px 20px rgb(0 0 0 / .06); }
 .note-icon { display:grid; place-items:center; width:30px; height:30px; color:var(--accent); border-radius:9px; background:var(--surface); }
 .floating-note strong { display:block; color:var(--ink); font-size:10px; font-weight:500; }
 .floating-note small { font-size:8px; color:var(--muted); }
 .tech-grid { display:grid; grid-template-columns:repeat(3,65px); gap:9px; transform:rotate(-13deg); }
 .tech-tile { width:65px; height:64px; border:1px solid var(--line); border-radius:16px; background:var(--bg); color:var(--muted); display:grid; place-items:center; font:10px/1.2 var(--font-mono); box-shadow:0 6px 12px rgb(0 0 0 / .035); }
 .tech-tile.tile-accent { color:var(--accent); background:color-mix(in srgb,var(--accent) 8%,var(--bg)); border-color:color-mix(in srgb,var(--accent) 30%,var(--line)); }
 .ai-orbits { position:relative; width:152px; height:152px; display:grid; place-items:center; }
 .ai-orbits i { position:absolute; border:1px solid color-mix(in srgb,var(--accent) 20%,var(--line)); border-radius:28px; }
 .ai-orbits i:nth-child(1) { inset:0; }.ai-orbits i:nth-child(2) { inset:14px; }.ai-orbits i:nth-child(3) { inset:28px; }
 .ai-orbits>span { display:grid; place-items:center; width:70px; height:70px; font:500 30px/1 var(--font-sans); border:1px solid var(--line); border-radius:20px; background:var(--bg); box-shadow:0 10px 24px rgb(0 0 0 / .055); }
 .ai-note { position:absolute; bottom:0; right:0; display:flex; gap:7px; align-items:center; padding:9px 12px; border:1px solid var(--line); border-radius:10px; background:var(--bg); color:var(--muted); font-size:9px; }
 .status-dot { width:5px; height:5px; border-radius:50%; background:var(--accent); }
 .device-diagram { position:relative; width:100%; height:160px; display:grid; place-items:center; }
 .device-diagram svg { position:absolute; inset:0; width:100%; height:100%; opacity:.4; }
 .device-diagram svg circle { fill:var(--accent); stroke:none; }
 .device-chip { z-index:1; display:flex; flex-direction:column; align-items:center; justify-content:center; width:94px; height:94px; border:1px solid var(--line); border-radius:20px; background:var(--bg); box-shadow:0 12px 25px rgb(0 0 0 / .06); }
 .device-chip strong { font:500 26px/1 var(--font-sans); }.device-chip small { color:var(--muted); font-size:8px; margin-top:8px; }
 /* Three distinct compositions based on the selected references. */
 .section-ribbon,.service-ribbon,.service-price { display:none; }
 .service-promise { display:none; }
 .format-lightline .service-price,.format-split .service-price { display:block; position:relative; margin-top:20px; }
 .service-price small { display:block; font-size:10px; color:var(--muted); margin-bottom:6px; }
 .service-price p { font:450 clamp(28px,3vw,40px)/1.1 var(--font-sans); letter-spacing:-.04em; }
 .service-price p span { display:inline-block; font:12px/1.4 var(--font-sans); letter-spacing:0; color:var(--muted); }

 .format-lightline .services-heading,.format-columns .services-heading,.format-split .services-heading { flex-direction:column; gap:22px; }
 .format-lightline .heading-note,.format-columns .heading-note,.format-split .heading-note { width:auto; }
 .format-lightline .heading-note svg,.format-columns .heading-note svg,.format-split .heading-note svg { display:none; }
 .format-lightline .service-card,.format-columns .service-card,.format-split .service-card { position:relative; border-radius:16px; padding:34px 26px 24px; box-shadow:none; }
 .format-lightline .card-top { z-index:1; font-size:12px; margin-bottom:68px; }
 .format-lightline .card-top>span { font:12px/1 var(--font-mono); }
 .format-lightline .service-art { position:absolute; top:0; left:0; right:0; height:200px; margin:0; pointer-events:none; mask-image:linear-gradient(#000 0%,#000 45%,transparent 100%); }
 .format-lightline .shared-light { top:-32px; opacity:.85; }
 .format-lightline .service-copy { position:relative; z-index:1; }
 .format-lightline .service-copy h3 { font-size:28px; font-weight:500; }
 .format-lightline .service-scope,.format-columns .service-scope,.format-split .service-scope { margin:26px 0 0; padding:0; border:0; border-radius:0; background:transparent; box-shadow:none; }
 .format-lightline .scope-label { display:flex; align-items:center; gap:12px; font:12px/1 var(--font-sans); margin-bottom:22px; }
 .format-lightline .scope-label::before,.format-lightline .scope-label::after { content:''; flex:1; height:1px; background:var(--line); }
 .format-lightline .service-scope li { min-height:36px; }
 .format-lightline .service-cta { margin-top:28px; background:transparent; color:var(--ink); border:1px solid var(--line); box-shadow:none; }
 .format-lightline .service-card:nth-child(2) .service-cta { background:var(--ink); color:var(--bg); }
 .format-columns .services-heading { align-items:center; text-align:center; margin-bottom:64px; }
 .format-columns .service-track { gap:0; grid-auto-columns:33.333%; border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:0; }
 .format-columns .service-card { border:0; border-right:1px solid var(--line); border-radius:0; background:transparent; padding:32px 28px; }
 .format-columns .service-card:nth-child(2) { background:radial-gradient(ellipse at 15% 0%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 45%); }
 .format-columns .card-top>span { font:11px/1 var(--font-mono); }
 .format-columns .service-art { display:none; }
 .format-columns .service-copy { margin-top:34px; }
 .format-columns .service-promise { display:block; font:500 25px/1.2 var(--font-sans); letter-spacing:-.025em; margin:24px 0 0; min-height:90px; }
 .format-columns .service-scope { display:flex; flex-direction:column; margin-top:20px; }
 .format-columns .scope-label { display:none; }
 .format-columns .service-cta { order:-1; margin:0 0 28px; background:var(--surface); color:var(--ink); border:1px solid var(--line); box-shadow:none; }
 .format-columns .service-card:nth-child(2) .service-cta { background:var(--accent); color:var(--bg); border-color:var(--accent); }
 .format-columns .service-scope ul { gap:18px; }
 .format-split .service-track { display:grid; grid-auto-flow:row; grid-auto-columns:auto; grid-template-columns:.85fr 1.35fr; overflow:visible; gap:24px; }
 .format-split .service-card { border:0; border-radius:26px; background:var(--surface); padding:28px; isolation:isolate; }
 .format-split .service-card:nth-child(even) { background:var(--ink); color:var(--bg); }
 .format-split .card-top { display:none; }
 .format-split .service-art { display:none; }
 .format-split .service-copy h3 { font-size:30px; }
 .format-split .service-promise { display:none; }
 .format-split .service-copy p { min-height:0; margin-top:8px; }
 .format-split .service-ribbon { display:block; position:absolute; inset:0; width:100%; height:100%; z-index:-1; stroke:var(--accent); stroke-width:60; stroke-linecap:round; opacity:.12; pointer-events:none; }
 .format-split .service-card:nth-child(even) .service-ribbon { opacity:.24; }
 .format-split .service-price { margin-top:18px; }
 .format-split .service-card:nth-child(even) .service-price small,.format-split .service-card:nth-child(even) .service-price p span { color:inherit; opacity:.65; }

 .format-split .service-scope { margin-top:20px; padding-top:20px; border-top:1px solid var(--line); }
 .format-split .service-scope ul { gap:12px; margin-bottom:20px; }
 .format-split .service-card:nth-child(even) .service-scope ul { grid-template-columns:1fr 1fr; }
 .format-split .scope-label { display:none; }
 .format-split .service-cta { width:max-content; min-width:190px; align-self:flex-end; margin-top:auto; }
 .format-split .service-case { margin-top:12px; border-top:1px solid var(--line); }
 .format-split .service-card:nth-child(even) .service-copy p,.format-split .service-card:nth-child(even) .service-scope li,.format-split .service-card:nth-child(even) .service-promise,.format-split .service-card:nth-child(even) .service-case { color:inherit; opacity:.75; }
 .format-split .service-card:nth-child(even) .service-scope,.format-split .service-card:nth-child(even) .service-case { border-color:color-mix(in srgb,var(--bg) 20%,transparent); }
 .format-split .services-navigation>div { display:none; }
 @media(max-width:1000px) { .format-columns .service-track { grid-auto-columns:48%; } .format-split .service-track { grid-template-columns:1fr 1fr; } .format-split .service-card { padding:26px; } .format-split .service-card:nth-child(even) .service-scope ul { grid-template-columns:1fr; } }

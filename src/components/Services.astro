---
import SectionHeading from './SectionHeading.astro';
import ServiceMorph from './graphics/ServiceMorph.astro';

const services = [
  { title:'Diseño UX/UI', step:'Diseño', short:'Experiencias claras para web y móvil.', description:'Diseñamos recorridos, interfaces y sistemas visuales que convierten una idea en una experiencia coherente, accesible y lista para construir.', deliverables:['Diseño web','Diseño móvil','UX/UI'], outcome:'Una experiencia clara antes de escribir código.', project:'Tracking Aduanal', slug:'tracking-aduanal', icon:'spark' },
  { title:'Desarrollo de producto', step:'Desarrollo', short:'Productos web y móviles hechos a la medida.', description:'Construimos soluciones listas para operar: desde una microapp enfocada hasta una plataforma web o una aplicación móvil para iOS.', deliverables:['Desarrollo web','Microapps y apps web a medida','Desarrollo móvil · iOS'], outcome:'Un producto funcional, escalable y listo para crecer.', project:'Monitoreo White-Label', slug:'monitoreo-white-label', icon:'browser' },
  { title:'Automatización', step:'Automatización', short:'Procesos a medida que eliminan trabajo repetitivo.', description:'Conectamos herramientas, datos y reglas de negocio para crear automatizaciones confiables, medibles y adaptadas a tu operación.', deliverables:['Automatizaciones a medida','Integración de herramientas y APIs','Seguimiento y mejora del flujo'], outcome:'Una operación más simple, rápida y consistente.', project:'Luz.ia', slug:'luzia-agentes-ia', icon:'flow' },
];
---

<section class="section-shell services" id="servicios" aria-labelledby="services-title" data-services data-context-stepper data-context-title="Servicios" data-context-steps={JSON.stringify(services.map(service=>service.step))} data-context-icons={JSON.stringify(services.map(service=>service.icon))} data-context-index="0">
  <header class="services-heading">
    <SectionHeading label="Servicios" title="Diseñamos y construimos productos a tu medida." id="services-title" />
    <p>Podemos resolver una etapa específica o acompañar el recorrido completo, desde la experiencia hasta la implementación.</p>
  </header>

  <div class="service-stage">
    <div class="stage-bar" aria-hidden="true"><span class="stage-dots"><i></i><i></i><i></i></span><span class="stage-address">itsmich / servicios</span><span class="stage-status">Disponible</span></div>
    <div class="service-stage-body">
     <div class="service-sidebar-stack">
      {services.map((service, i) => <article class="service-panel" id={`service-panel-${i}`} role="region" aria-label={service.title} hidden={i!==0} data-service-panel={i}>
       <div class="service-sidebar">
        <div class="service-index">0{i+1} / 03</div>
        <div class="service-copy"><p class="service-label">Servicio</p><h3>{service.title}</h3><p class="service-short">{service.short}</p><p class="service-description">{service.description}</p></div>
        <div class="service-scope"><p>Incluye</p><ul>{service.deliverables.map(item=><li><span aria-hidden="true">↗</span>{item}</li>)}</ul></div>
        <div class="service-links"><a class="service-cta" href={`mailto:mich.ia@hotmail.com?subject=${encodeURIComponent('Hablemos de '+service.title)}`}>Hablemos de tu idea <span aria-hidden="true">↗</span></a><a class="service-case" href={`/proyectos/${service.slug}`}>Ver en práctica · {service.project}</a></div>
       </div>
      </article>)}
     </div>
      <div class="service-canvas">
        <div class="canvas-heading"><div><span>Resultado</span>{services.map((service,i)=><strong data-service-outcome={i} hidden={i!==0}>{service.outcome}</strong>)}</div><span class="canvas-number" data-canvas-number>01</span></div>
        <ServiceMorph />
      </div>
    </div>
  </div>

  <footer class="services-footer"><p>Una parte del producto o el recorrido completo.</p><a href="mailto:mich.ia@hotmail.com?subject=Quiero%20construir%20un%20producto">Cuéntame qué necesitas <span aria-hidden="true">↗</span></a></footer>
</section>

<style>
 .services { overflow:hidden; }
 .services-heading { display:flex; justify-content:space-between; align-items:end; gap:var(--space-8); margin-bottom:var(--space-8); }
 .services-heading>p { max-width:360px; margin:0 0 4px; color:var(--muted); font-size:var(--fs-body); line-height:1.65; }
 .service-stage { overflow:hidden; border:1px solid var(--line); border-radius:28px; background:color-mix(in srgb,var(--surface) 54%,var(--bg)); box-shadow:0 20px 60px rgb(0 0 0 / .045); }
 .stage-bar { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; min-height:54px; padding:0 20px; border-bottom:1px solid var(--line); color:var(--muted); font:10px/1 var(--font-mono); letter-spacing:.08em; text-transform:uppercase; }
 .stage-dots { display:flex; gap:6px; }.stage-dots i { width:7px; height:7px; border:1px solid var(--line); border-radius:50%; background:var(--bg); }
 .stage-address { padding:8px 18px; border-radius:var(--radius-full); background:var(--bg); }
 .stage-status { justify-self:end; display:flex; align-items:center; gap:7px; }.stage-status::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--success); }
 .service-stage-body { display:grid; grid-template-columns:minmax(280px,.78fr) minmax(0,2.22fr); min-height:620px; }
 .service-sidebar-stack { min-width:0; border-right:1px solid var(--line); background:color-mix(in srgb,var(--bg) 78%,transparent); }
 .service-panel { height:100%; }.service-panel[hidden] { display:none; }
 .service-sidebar { display:flex; flex-direction:column; min-width:0; min-height:620px; height:100%; padding:30px; }
 .service-index { color:var(--muted); font:10px/1 var(--font-mono); letter-spacing:.12em; }.service-copy { margin-top:60px; }
 .service-label,.service-scope>p { margin:0 0 12px; color:var(--muted); font:10px/1 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; }
 .service-copy h3 { margin:0; font-family:var(--font-display); font-size:clamp(32px,3.3vw,48px); font-weight:600; line-height:.98; letter-spacing:-.045em; }
 .service-short { margin:var(--space-4) 0 0; color:var(--accent); font-size:15px; font-weight:600; line-height:1.45; }
 .service-description { margin:var(--space-4) 0 0; color:var(--muted); font-size:14px; line-height:1.6; }
 .service-scope { margin-top:var(--space-7); padding-top:var(--space-5); border-top:1px solid var(--line); }
 .service-scope ul { display:grid; gap:12px; margin:0; padding:0; list-style:none; }.service-scope li { display:flex; align-items:flex-start; gap:9px; color:var(--muted); font-size:13px; line-height:1.4; }.service-scope li span { color:var(--accent); }
 .service-links { display:grid; gap:8px; margin-top:auto; padding-top:var(--space-6); }
 .service-cta { display:flex; align-items:center; justify-content:space-between; min-height:48px; padding:0 16px; border-radius:12px; background:var(--ink); color:var(--bg); font-size:13px; font-weight:600; }
 .service-case { min-height:38px; padding:12px 4px 0; color:var(--muted); font-size:11px; line-height:1.35; text-decoration:underline; text-decoration-color:var(--line); text-underline-offset:4px; }
 .service-canvas { position:relative; min-width:0; overflow:hidden; isolation:isolate; background:linear-gradient(150deg,color-mix(in srgb,var(--accent) 4%,var(--bg)),var(--bg) 58%); }
 .service-canvas::before { content:''; position:absolute; inset:0; z-index:-1; background-image:radial-gradient(circle,var(--line) 1px,transparent 1px); background-size:28px 28px; opacity:.6; mask-image:linear-gradient(to bottom,transparent 0%,#000 18%,#000 78%,transparent 100%); }
 .canvas-heading { position:relative; z-index:3; display:flex; justify-content:space-between; align-items:flex-start; gap:20px; padding:30px 34px 0; }.canvas-heading div { display:flex; flex-direction:column; gap:6px; }
 .canvas-heading span { color:var(--muted); font:9px/1 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; }.canvas-heading strong { max-width:420px; font-size:18px; font-weight:600; line-height:1.3; }.canvas-number { font-size:11px!important; }
 .services-footer { display:flex; justify-content:space-between; align-items:center; gap:var(--space-5); margin-top:var(--space-5); color:var(--muted); font-size:13px; }.services-footer p { margin:0; }.services-footer a { display:flex; align-items:center; gap:12px; min-height:44px; color:var(--ink); font-weight:600; }
 @media(hover:hover) and (prefers-reduced-motion:no-preference) { .service-cta,.services-footer a { transition:color var(--dur-fast),background-color var(--dur-fast),transform var(--dur-fast); }.service-cta:hover { transform:translateY(-2px); }.services-footer a:hover { color:var(--accent); } }
 @media(max-width:960px) { .services-heading { align-items:flex-start; flex-direction:column; gap:var(--space-5); }.service-stage-body { grid-template-columns:270px minmax(0,1fr); } }
 @media(max-width:767px) { .services-heading { margin-bottom:var(--space-6); }.stage-bar { grid-template-columns:1fr auto; min-height:46px; padding:0 14px; }.stage-address { display:none; }.service-stage-body { grid-template-columns:1fr; }.service-sidebar-stack { border-right:0; border-bottom:1px solid var(--line); }.service-sidebar { min-height:500px; padding:24px; }.service-copy { margin-top:38px; }.service-copy h3 { font-size:40px; }.service-canvas { min-height:430px; }.canvas-heading { padding:24px 22px 0; }.canvas-heading strong { font-size:16px; }.services-footer { align-items:flex-start; flex-direction:column; gap:8px; } }
 @media(prefers-reduced-motion:no-preference) { .service-panel:not([hidden]) { animation:service-panel-in 420ms var(--ease-out) both; } @keyframes service-panel-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } } }
 @media(prefers-reduced-motion:reduce) { .service-panel { animation:none; } }
</style>

<script>
 document.querySelectorAll<HTMLElement>('[data-services]').forEach(section=>{
  const panels=[...section.querySelectorAll<HTMLElement>('[data-service-panel]')];
  const outcomes=[...section.querySelectorAll<HTMLElement>('[data-service-outcome]')];
  const morph=section.querySelector<HTMLElement>('[data-service-morph]');
  const number=section.querySelector<HTMLElement>('[data-canvas-number]');
  const select=(next:number)=>{const safe=(next+panels.length)%panels.length;panels.forEach((panel,index)=>{const active=index===safe;panel.hidden=!active;outcomes[index].hidden=!active;});section.dataset.contextIndex=String(safe);if(morph)morph.dataset.state=String(safe);if(number)number.textContent=`0${safe+1}`;window.dispatchEvent(new CustomEvent('context-stepper:update',{detail:{sectionId:section.id,index:safe}}));};
  section.addEventListener('context-stepper:select',event=>select((event as CustomEvent<{index:number}>).detail.index));
 });
</script>

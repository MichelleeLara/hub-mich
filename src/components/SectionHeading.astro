---
interface Props {
  title: string;
  label: string;
  id?: string;
  compact?: boolean;
}
const { title, label, id, compact = false } = Astro.props;
---
<div class:list={['section-heading', { 'section-heading-compact': compact }]}>
  <p class="section-label">{label}</p>
  <h2 class="section-title" id={id}>{title}</h2>
</div>
<style>
  .section-heading { display: grid; gap: var(--space-5); max-width: 980px; }
  .section-title { margin: 0; font-family: var(--font-sans); font-size: clamp(40px, 4.7vw, 60px); font-weight: 700; line-height: 1.04; letter-spacing: -.045em; color: var(--ink); text-wrap: balance; }
  .section-label { justify-self: start; width: fit-content; margin: 0; color: var(--muted); font-family: var(--font-note); font-size: clamp(13px, 1.25vw, 16px); font-weight: 400; line-height: 1.55; letter-spacing: 0; text-wrap: balance; }
  .section-heading-compact .section-title { font-size: var(--fs-h2-compact); line-height: 1.2; }
  .section-heading-compact .section-label { font-size: 12px; }
  @media (max-width: 767px) {
    .section-heading { gap: var(--space-4); }
    .section-title { font-size: clamp(36px, 10.5vw, 46px); }
    .section-label { font-size: 12px; }
  }
</style>

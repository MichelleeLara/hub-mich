---
interface Props {
  title: string;
  label: string;
  id?: string;
  compact?: boolean;
}
const { title, label, id, compact = false } = Astro.props;
---
<div class:list={['section-heading', { 'section-heading-compact': compact }]}>
  <p class="section-label note-label">{label}</p>
  <h2 class="section-title" id={id}>{title}</h2>
</div>
<style>
  .section-heading { display: grid; gap: 14px; max-width: 980px; }
  .section-title { margin: 0; font-family: var(--font-display); font-size: var(--fs-h2); font-weight: 600; line-height: 1.06; letter-spacing: -.012em; color: var(--ink); text-wrap: balance; }
  .section-label { justify-self: start; width: fit-content; margin: 0; color: var(--muted); font-family: var(--font-note); font-size: clamp(11px, .9vw, 13px); font-weight: 400; line-height: 1.55; letter-spacing: 0; text-wrap: balance; }
  .section-heading-compact .section-title { font-size: var(--fs-h2-compact); line-height: 1.2; }
  .section-heading-compact .section-label { font-size: 11px; }
  @media (max-width: 767px) {
    .section-heading { gap: var(--space-3); }
    .section-title { font-size: clamp(26px, 7vw, 30px); }
    .section-label { font-size: 11px; }
  }
</style>

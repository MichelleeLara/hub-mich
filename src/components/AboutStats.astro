---
import { ideaPoints } from '../data/ideasGeometry';
import SectionHeading from './SectionHeading.astro';
const proof = [
  { value: '< 2 min', label: 'Reportes con IA en Luz.ia', slug: 'luzia-agentes-ia' },
  { value: '+65%', label: 'Rendimiento en logística', slug: 'inteligencia-logistica' },
  { value: '6', label: 'Ingenieros liderados', slug: 'monitoreo-white-label' },
];
---
<section id="yo" class="section-shell about-section">
  <div id="about-build-scroll" class="about-build-scroll">
  <div class="about-grid">
    <div class="about-copy">
      <SectionHeading label="Mi enfoque" title="Productos simples para problemas complejos." />
      <p class="about-description">Soy Mich. Uno diseño, ingeniería e IA para convertir un problema de negocio en algo que las personas puedan usar de verdad.</p>
      <p class="about-detail">Uso la IA para explorar, construir y automatizar. Mi trabajo es darle dirección: elegir qué resolver, cuidar la experiencia y llevarlo hasta la entrega.</p>
      <a href="#proyectos" class="text-link">Mira cómo se traduce en producto <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
    </div>
    <figure class="portrait-study">
      <div class="portrait-top"><span>Diseño + ingeniería + IA</span><span aria-hidden="true">↗</span></div>
      <div id="face-anchor">
        <svg class="face-fallback" viewBox="0 0 600 660" role="img" aria-label="Estructura isométrica construida por capas: una base, conexiones y un producto ensamblado">
          {ideaPoints.map((point, i) => <circle cx={point.x * 600} cy={point.y * 660} r={i % 11 === 0 ? 2.6 : 1.8} fill="currentColor" opacity={point.outer ? .76 : .44} />)}
        </svg>
        <span class="portrait-cross cross-one" aria-hidden="true">+</span><span class="portrait-cross cross-two" aria-hidden="true">+</span>
      </div>
      <div class="build-stages" aria-label="Etapas de construcción"><span data-build-stage="0">01 / Entender</span><span data-build-stage="1">02 / Diseñar</span><span data-build-stage="2" aria-current="step">03 / Construir</span></div>
      <div class="build-progress" aria-hidden="true"><span class="build-progress-track"><span data-build-progress></span></span><span data-build-percent>0%</span></div>
      <figcaption><span>Las piezas encuentran su lugar.</span><span class="portrait-note">De las piezas al producto</span></figcaption>
    </figure>
  </div>
  </div>
  <div class="proof-strip">
    {proof.map(item => <a href={`/proyectos/${item.slug}`} class="proof-item"><strong>{item.value}</strong><span>{item.label}</span><span class="proof-arrow" aria-hidden="true">↗</span></a>)}
  </div>
</section>
<style>
  .about-section { padding-top: 96px; }
  .about-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 80px; align-items: center; }
  h2 { margin-top: 28px; }
  .about-description { margin-top: 28px; max-width: 470px; font-size: var(--fs-lead); line-height: 1.5; }
  .about-detail { margin: 16px 0 20px; max-width: 455px; color: var(--muted); font-size: var(--fs-body); line-height: 1.7; }
  .portrait-study { position: relative; min-width: 0; }
  .portrait-top { display: flex; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: var(--fs-caption); }
  #face-anchor { position: relative; width: min(100%, 440px); aspect-ratio: 10/11; margin: 48px auto; }
  .face-fallback { overflow: visible; width: 100%; height: 100%; color: var(--accent); }
  .portrait-cross { position: absolute; font-family: var(--font-mono); color: var(--muted); }
  .cross-one { left: 0; top: 20px; } .cross-two { right: 0; bottom: 20px; }
  .build-stages { display: flex; justify-content: space-between; gap: 10px; margin: 0 0 24px; font-family: var(--font-mono); font-size: var(--fs-micro); color: var(--muted); }
  .build-progress { display: none; align-items: center; gap: 12px; margin-bottom: 18px; color: var(--muted); font: var(--fs-micro) var(--font-mono); }
  .build-progress-track { height: 1px; flex: 1; background: var(--line); overflow: hidden; }
  [data-build-progress] { display: block; height: 100%; background: var(--accent); transform: scaleX(var(--build-progress, 0)); transform-origin: left; }
  [data-build-percent] { min-width: 4ch; text-align: right; }
  .build-stages [aria-current="step"] { color: var(--accent); }
  figcaption { display: flex; flex-direction: column; gap: 7px; text-align: center; font-size: var(--fs-small); }
  .portrait-note { color: var(--muted); font-size: var(--fs-caption); }
  .proof-strip { margin-top: 64px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .proof-item { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 28px 28px 28px 0; }
  .proof-item + .proof-item { padding-left: 28px; border-left: 1px solid var(--line); }
  .proof-item strong { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; line-height: 1.1; letter-spacing: -.02em; }
  .proof-item > span:not(.proof-arrow) { font-size: var(--fs-small); color: var(--muted); }
  .proof-arrow { position: absolute; top: 32px; right: 24px; color: var(--muted); }
  @media (max-width: 767px) { .about-grid { grid-template-columns: 1fr; gap: 48px; } .portrait-study { max-width: 380px; width: 100%; margin: auto; } #face-anchor { width: 100%; } .proof-strip { grid-template-columns: 1fr; margin-top: 48px; } .proof-item + .proof-item { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); } .proof-item { padding: 22px 0; } }
</style>
<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html.particles-build-ready:not(.motion-paused) .about-build-scroll { height: 280svh; }
    html.particles-build-ready:not(.motion-paused) .about-grid { position: sticky; top: 120px; min-height: calc(100svh - 144px); }
    html.particles-build-ready:not(.motion-paused) #face-anchor { width: min(100%, 440px, 43svh); }
    html.particles-build-ready:not(.motion-paused) .build-progress { display: flex; }
    @media (min-width: 768px) and (max-height: 760px) {
      html.particles-build-ready:not(.motion-paused) .about-copy h2 { font-size: clamp(30px, 3.4vw, 48px); margin-top: 0; }
      html.particles-build-ready:not(.motion-paused) .about-description { margin-top: 20px; font-size: 16px; }
      html.particles-build-ready:not(.motion-paused) .about-detail { font-size: 14px; line-height: 1.6; }
    }
    @media (max-width: 767px) {
      html.particles-build-ready:not(.motion-paused) .about-build-scroll { height: calc(280svh + 420px); }
      html.particles-build-ready:not(.motion-paused) .about-grid { display: block; position: static; height: 100%; min-height: 0; }
      html.particles-build-ready:not(.motion-paused) .portrait-study { position: sticky; top: 92px; margin: 48px auto 0; }
      html.particles-build-ready:not(.motion-paused) #face-anchor { width: min(100%, 42svh); margin: 40px auto; }
      html.particles-build-ready:not(.motion-paused) .build-stages { margin-bottom: 16px; }
    }
  }
  html.particles-portrait .face-fallback { opacity: 0; }
  html.motion-paused .portrait-note::after { content: ' · en pausa'; }
  @media (prefers-reduced-motion: reduce) { html.particles-portrait .face-fallback { opacity: 1; } }
</style>

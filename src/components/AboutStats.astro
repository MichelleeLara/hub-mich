---
import SectionHeading from './SectionHeading.astro';
const stages = [
  { number: '01', title: 'Entender el problema.', text: 'Antes de pensar en una solución, busco la fricción: qué necesita la persona, qué está fallando y qué cambiaría si lo resolvemos.', detail: 'La IA me ayuda a explorar alternativas. El problema marca la dirección.' },
  { number: '02', title: 'Diseñar el recorrido.', text: 'Conecto las piezas en una experiencia: qué se ve, qué se hace y qué pasa después. Prototipo, pruebo estados y cuido los detalles.', detail: 'Diseño e ingeniería trabajan juntas para que la solución se entienda antes de construirla.' },
  { number: '03', title: 'Construir el producto.', text: 'Uno interfaz, datos e IA para construir un producto funcional. Reviso el resultado con pruebas y uso real, y lo llevo hasta la entrega.', detail: 'La tecnología acelera el trabajo. El criterio mantiene la dirección.' },
];
const proof = [
  { value: '< 2 min', label: 'Reportes con IA en Luz.ia', slug: 'luzia-agentes-ia' },
  { value: '+65%', label: 'Rendimiento en logística', slug: 'inteligencia-logistica' },
  { value: '6', label: 'Ingenieros liderados', slug: 'monitoreo-white-label' },
];
---
 <section id="yo" class="editorial-preview" aria-label="Mi enfoque">
  <section id="enfoque-scroll" class="editorial-runway" aria-label="Mi enfoque: recorrido por tres niveles">
   <div class="editorial-sticky">
    <header class="editorial-heading"><SectionHeading label="Mi enfoque" title="Productos simples para problemas complejos." /></header>
    <div class="editorial-grid">

     <div class="editorial-content">
      {stages.map((stage, i) => <article data-editorial-stage={i}>
       <div class="editorial-title">
        <span class="editorial-number" aria-hidden="true">{stage.number}</span>
        <h3 aria-label={`Etapa ${stage.number}: ${stage.title}`}>
         {stage.title.split(' ').map(word => <span data-reveal-word aria-hidden="true">{word}{' '}</span>)}
        </h3>
       </div>
       <div class="editorial-copy">
        {[stage.text, stage.detail].map(text => <p aria-label={text}>
         {text.split(' ').map(word => <span data-reveal-word aria-hidden="true">{word}{' '}</span>)}
        </p>)}
       </div>
      </article>)}
      <span id="editorial-announcement" class="editorial-sr-only" role="status" aria-live="polite"></span>
     </div>
     <figure class="editorial-figure" aria-label="La dispersión se aclara en un plano, se divide en cuatro bases y se convierte en una estructura por niveles">
      <canvas id="editorial-canvas" aria-hidden="true"></canvas>
      <svg class="editorial-fallback" viewBox="0 0 600 660" aria-hidden="true"><use href="/media/enfoque-static.svg#points" width="600" height="660" /></svg>
      <span class="editorial-cross first" aria-hidden="true">+</span><span class="editorial-cross last" aria-hidden="true">+</span>
     </figure>
    </div>
    <div class="editorial-scroll"><span>Sigue el scroll</span><div class="editorial-track" aria-hidden="true"><span data-editorial-progress></span></div><span data-editorial-position>01 / 03</span></div>
   </div>
  </section>
  <section class="editorial-proof" aria-label="Resultados de este enfoque">{proof.map(item=><a href={`/proyectos/${item.slug}`}><strong>{item.value}</strong><span>{item.label}</span></a>)}</section>
 </section>
<style>
 .editorial-preview { color: var(--ink); padding: 104px var(--gutter) var(--space-9); }
 .editorial-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
 .editorial-runway { width: min(100%, var(--container)); margin: auto; }
 .editorial-sticky { padding: var(--space-4) 0; }
 .editorial-heading { display: flex; justify-content: center; text-align: center; margin-bottom: var(--space-4); }
 .editorial-heading :global(.section-heading) { max-width: 680px; }
 .editorial-heading :global(.section-label) { justify-self: center; }
 .editorial-grid { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); align-items: start; gap: var(--space-8); width: min(100%, 1000px); margin: auto; }
 .editorial-figure { position: relative; width: min(100%, 460px); aspect-ratio: 10/11; margin: auto; color: var(--accent); }
 #editorial-canvas, .editorial-fallback { width: 100%; height: 100%; display: block; }
 #editorial-canvas { display: none; }
 .editorial-cross { position: absolute; color: var(--muted); font: var(--fs-small) var(--font-mono); }
 .first { left: 0; top: 20px; } .last { right: 0; bottom: 20px; }
 .editorial-content { min-width: 0; position: relative; padding-top: var(--space-5); }
 .editorial-title { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-5); }
 .editorial-number { color: var(--accent); font: 500 64px/1 var(--font-display); letter-spacing: -.04em; flex-shrink: 0; }
 .editorial-title h3 { font-family: var(--font-sans); font-weight: 650; font-size: clamp(28px, 3vw, 36px); letter-spacing: -.03em; line-height: 1.12; max-width: 400px; text-wrap: balance; }
 .editorial-copy { max-width: 470px; font-size: var(--fs-body); line-height: 1.7; }
 .editorial-copy p+p { margin-top: var(--space-4); color: var(--muted); }
 .editorial-scroll { display: flex; gap: var(--space-4); align-items: center; max-width: 1000px; margin: var(--space-6) auto 0; color: var(--muted); font: var(--fs-micro) var(--font-mono); }
 .editorial-scroll>span { white-space: nowrap; }
 .editorial-track { flex: 1; height: 1px; background: var(--line); }
 .editorial-track span { display: block; height: 100%; background: var(--accent); transform: scaleX(var(--editorial-progress, 0)); transform-origin: left; }
 .editorial-proof { width: min(100%,1000px); margin: var(--space-8) auto 0; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-block: 1px solid var(--line); }
 .editorial-proof a { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6) var(--space-5); }
 .editorial-proof a+a { border-left: 1px solid var(--line); }
 .editorial-proof strong { font: 600 var(--fs-h3)/1.1 var(--font-display); letter-spacing: -.02em; }
 .editorial-proof a>span { font-size: var(--fs-small); color: var(--muted); }
 .editorial-end { text-align: center; padding: var(--space-9) 0; color: var(--muted); }
 .editorial-end p { margin-bottom: var(--space-4); }
 @media (max-width:767px) {
  .editorial-preview { padding-top: var(--space-9); }
  .editorial-heading { margin-bottom: var(--space-5); }
  .editorial-grid { grid-template-columns: minmax(0,1fr); gap: var(--space-5); }
  .editorial-content { padding-top: 0; }
  .editorial-figure { width: min(100%,260px); }
  .editorial-number { font-size: 48px; }
  .editorial-title { gap: var(--space-4); margin-bottom: var(--space-4); }
  .editorial-title h3 { font-size: 28px; }
  .editorial-proof { grid-template-columns: 1fr; }
  .editorial-proof a { padding: var(--space-5) 0; }
  .editorial-proof a+a { border-left: 0; border-top: 1px solid var(--line); }
 }
</style>
<style is:global>
 html.editorial-ready [data-reveal-word] { opacity: var(--word-light, .24); }
 html.motion-paused [data-reveal-word], html.editorial-tall [data-reveal-word] { opacity: 1 !important; }
 html.editorial-ready:not(.motion-paused) .editorial-runway { height: 310svh; }
 html.editorial-ready:not(.motion-paused) .editorial-sticky { position: sticky; top: 92px; }
 html.editorial-ready:not(.motion-paused) .editorial-figure { width: min(100%,460px,var(--editorial-figure-width,52svh)); }
 html.editorial-ready:not(.motion-paused):not(.editorial-tall) .editorial-content { min-height: var(--editorial-copy-height,0px); }
 html.editorial-ready:not(.motion-paused) #editorial-canvas { display: block; }
 html.editorial-ready:not(.motion-paused) .editorial-fallback { display: none; }
 @media (max-width:767px) {
  html.editorial-ready:not(.motion-paused) .editorial-sticky { top: 80px; }
  html.editorial-ready:not(.motion-paused) .editorial-figure { width: min(100%,220px,var(--editorial-figure-width,26svh)); }
 }
 html.editorial-ready.editorial-tall:not(.motion-paused) .editorial-sticky { position: static; }
 html.editorial-ready.editorial-tall:not(.motion-paused) .editorial-runway { height: auto; }
 html.editorial-ready.editorial-tall:not(.motion-paused) #editorial-canvas { display: none; }
 html.editorial-ready.editorial-tall:not(.motion-paused) .editorial-fallback { display: block; }
 html.editorial-tall [data-editorial-stage], html.motion-paused [data-editorial-stage] { display: block; }
 html.editorial-tall [data-editorial-stage]+[data-editorial-stage], html.motion-paused [data-editorial-stage]+[data-editorial-stage] { margin-top: var(--space-7); }
 @media (prefers-reduced-motion: reduce) {
  [data-reveal-word] { opacity: 1 !important; }
  html.editorial-ready .editorial-runway { height: auto !important; }
  html.editorial-ready .editorial-sticky { position: static !important; }
  html.editorial-ready #editorial-canvas { display: none !important; }
  html.editorial-ready .editorial-fallback { display: block !important; }
  [data-editorial-stage] { display: block; }
  [data-editorial-stage]+[data-editorial-stage] { margin-top: var(--space-7); }
 }
</style>
<script>
 import { ideaPoints, ideaFlowPoint, ideaFlowRoute } from '../data/ideasGeometry';
 import { ENFOQUE_PARTICLE_EVENT, type EnfoqueGrain, type EnfoqueParticleFrame } from '../lib/enfoqueParticles';
 const runway=document.getElementById('enfoque-scroll');
 const sticky=runway?.querySelector<HTMLElement>('.editorial-sticky');
 const figure=runway?.querySelector<HTMLElement>('.editorial-figure');
 const canvas=document.getElementById('editorial-canvas') as HTMLCanvasElement|null;
 const ctx=canvas?.getContext('2d');
 if(runway&&sticky&&figure&&canvas&&ctx){
  const articles=Array.from(runway.querySelectorAll<HTMLElement>('[data-editorial-stage]'));
  const words=articles.map(article=>Array.from(article.querySelectorAll<HTMLElement>('[data-reveal-word]')));
  const counter=runway.querySelector('[data-editorial-position]');
  const announcement=document.getElementById('editorial-announcement');
  const progressLine=runway.querySelector<HTMLElement>('[data-editorial-progress]');
  const reduced=matchMedia('(prefers-reduced-motion: reduce)');
  const unified=Boolean(document.getElementById('particles-bg'));
  const releaseField=()=>document.dispatchEvent(new CustomEvent<EnfoqueParticleFrame>(ENFOQUE_PARTICLE_EVENT,{detail:{points:[],strength:0}}));
  let width=0,height=0,raf=0,visible=false,progress=0,target=0,active=-1,last=0,ambientTime=0,scrollRaf=0;
  const mobile=matchMedia('(max-width:767px)');
  // Mobile toolbars change innerHeight while scrolling; only width or large changes resize the layout.
  let viewportWidth=0,viewportHeight=0;
  const stableHeight=()=>{
   if(!mobile.matches||innerWidth!==viewportWidth||Math.abs(innerHeight-viewportHeight)>viewportHeight*.25){viewportWidth=innerWidth;viewportHeight=innerHeight;}
   return viewportHeight;
  };
  let scrollProgress=0,lastInput=performance.now();
  // Each step forms over its first 64%; the remaining scroll keeps it complete.
  const formationEnd=.64;
  const formationRanges=[[0,.30],[1/3,.625],[2/3,1]];
  const offsets=ideaPoints.map(()=>({x:0,y:0,vx:0,vy:0}));
  const pointGeometry=ideaPoints.map((p,i)=>{
   const z=(p.baseY-p.y)/(.183*1.3225),floor=Math.min(3,Math.max(0,Math.round(z)));
   return {z,floor,final:{x:.5+(p.x-.5)*.78,y:.5+(p.y-.5)*.78},
    blueprint:{x:.28+(floor%2)*.44+(p.x-.5)*.34,y:.32+Math.floor(floor/2)*.36+(p.baseY-.69)*.60},
    clearPlane:{x:.5+(p.x-.5)*.65,y:.5+(p.baseY-.87)*.75},
    delay:Math.abs((Math.sin(i*12.9898)*43758.5453)%1)*.045,
    bend:Math.sin(i*.7),assemblyBend:.3+Math.sin(i*1.3)*.2,brightness:.88+.12*Math.sin(i*.27)};
  });
  const grains:EnfoqueGrain[]=ideaPoints.map(()=>({x:0,y:0,alpha:0,radius:0,tint:0}));
  const wordLights=words.map(list=>list.map(()=>''));
  let stickyTop=92,runwayHeight=1,stickyHeight=1;
  const pointer={x:0,y:0,inside:false};
  figure.addEventListener('pointermove',event=>{
   if(event.pointerType!=='mouse'||disabled())return;
   const box=figure.getBoundingClientRect();pointer.x=event.clientX-box.left;pointer.y=event.clientY-box.top;pointer.inside=true;lastInput=performance.now();schedule();
  },{passive:true});
  figure.addEventListener('pointerleave',()=>{pointer.inside=false;lastInput=performance.now();schedule();},{passive:true});
  const clamp=(x:number)=>Math.max(0,Math.min(1,x));
  const ease=(x:number)=>{const t=clamp(x);return t*t*(3-2*t);};
  let color=getComputedStyle(runway).getPropertyValue('--accent').trim();
  const paused=()=>document.documentElement.classList.contains('motion-paused');
  const disabled=()=>reduced.matches||paused()||document.documentElement.classList.contains('editorial-tall')||document.documentElement.classList.contains('project-preview-open');
  function measure(){
   document.documentElement.classList.remove('editorial-tall');
   if(!reduced.matches&&!paused())articles.forEach((a,i)=>a.hidden=i!==(active<0?0:active));
   if(!reduced.matches&&!paused()){
    const content=articles[0].parentElement!;
    let copyHeight=0;
    // Reserve the longest stage so changing copy never moves the graphic or heading.
    articles.forEach(article=>{
     const wasHidden=article.hidden,style=article.style.cssText;
     article.hidden=false;
     Object.assign(article.style,{position:'absolute',left:'0',right:'0',visibility:'hidden'});
     copyHeight=Math.max(copyHeight,article.getBoundingClientRect().height);
     article.hidden=wasHidden;article.style.cssText=style;
    });
    copyHeight+=parseFloat(getComputedStyle(content).paddingTop)||0;
    content.style.setProperty('--editorial-copy-height',`${Math.ceil(copyHeight)}px`);
    const heading=sticky!.querySelector<HTMLElement>('.editorial-heading')!;
    const scroll=sticky!.querySelector<HTMLElement>('.editorial-scroll')!;
    const grid=sticky!.querySelector<HTMLElement>('.editorial-grid')!;
    const stickyStyle=getComputedStyle(sticky!);
    const top=parseFloat(stickyStyle.top)||92;
    const overhead=heading.getBoundingClientRect().height+(parseFloat(getComputedStyle(heading).marginBottom)||0)
     +scroll.getBoundingClientRect().height+(parseFloat(getComputedStyle(scroll).marginTop)||0)
     +(parseFloat(stickyStyle.paddingTop)||0)+(parseFloat(stickyStyle.paddingBottom)||0);
    const mobile=matchMedia('(max-width:767px)').matches;
    const available=stableHeight()-top-(mobile?84:24)-overhead-(mobile?copyHeight+(parseFloat(getComputedStyle(grid).rowGap)||0):0);
    figure!.style.setProperty('--editorial-figure-width',`${Math.max(100,Math.floor(available/1.1))}px`);
   }
   const box=figure!.getBoundingClientRect();width=box.width;height=box.height;
   if(!unified){const dpr=Math.min(devicePixelRatio||1,mobile.matches?1.5:2);canvas!.width=Math.round(width*dpr);canvas!.height=Math.round(height*dpr);ctx!.setTransform(dpr,0,0,dpr,0,0);}
   const top=parseFloat(getComputedStyle(sticky!).top)||92;
   document.documentElement.classList.toggle('editorial-tall',!reduced.matches&&!paused()&&sticky!.getBoundingClientRect().height>stableHeight()-top-20);
   stickyTop=top;runwayHeight=runway!.getBoundingClientRect().height;stickyHeight=sticky!.getBoundingClientRect().height;
   color=getComputedStyle(runway!).getPropertyValue('--accent').trim();
   if(disabled())releaseField();
   updateTarget();schedule();
  }
  function updateTarget(){
   const box=runway!.getBoundingClientRect();
   const next=clamp((stickyTop-box.top)/Math.max(1,runwayHeight-stickyHeight));
   if(Math.abs(next-target)>.0001)lastInput=performance.now();
   target=next;
   schedule();
  }
  function schedule(){if(!raf&&visible&&!document.hidden&&!disabled())raf=requestAnimationFrame(frame);}
  function setStage(stage:number){
   if(stage===active)return;
   const previous=active;
   articles.forEach(article=>article.getAnimations().forEach(animation=>animation.cancel()));
   const container=articles[0].parentElement!;
   container.querySelectorAll('[data-transition-ghost]').forEach(e=>e.remove());
   if(previous>=0&&!disabled()){
    const ghost=articles[previous].cloneNode(true) as HTMLElement;
    ghost.hidden=false;ghost.setAttribute('aria-hidden','true');ghost.setAttribute('data-transition-ghost','');ghost.removeAttribute('data-editorial-stage');
    Object.assign(ghost.style,{position:'absolute',top:getComputedStyle(container).paddingTop,left:'0',right:'0',pointerEvents:'none'});container.append(ghost);
    ghost.animate([{opacity:1},{opacity:0}],{duration:180,easing:'ease-out'}).finished.then(()=>ghost.remove()).catch(()=>ghost.remove());

   }
   active=stage;articles.forEach((a,i)=>a.hidden=i!==stage);
   if(counter)counter.textContent=`0${stage+1} / 03`;
   if(announcement)announcement.textContent=['01: Entender el problema','02: Diseñar el recorrido','03: Construir el producto'][stage];
   if(!disabled())articles[stage].animate([{opacity:0},{opacity:1}],{duration:260,delay:previous>=0?100:0,fill:'backwards',easing:'ease-out'});
  }
  function frame(time:number){
   raf=0;if(disabled()||!visible||document.hidden)return;
   // Cap at 60fps on 120Hz while letting 90Hz panels use every frame.
   if(last&&time-last<1000/90-1){raf=requestAnimationFrame(frame);return;}
   const dt=Math.min(50,time-last||16);last=time;ambientTime+=dt/1000;
   const figureBox=figure!.getBoundingClientRect();
   scrollProgress+=(target-scrollProgress)*(1-Math.exp(-dt/90));
   const stage=Math.min(2,Math.floor(scrollProgress*3));
   const local=clamp(scrollProgress*3-stage),formation=clamp(local/formationEnd);
   const [from,to]=formationRanges[stage];
   progress=from+(to-from)*formation;
   setStage(stage);
   // Each stage shares its scroll range with the particle formation.
   // Words progressively brighten in reading order and dim again on reverse scroll.
   const readingProgress=clamp((progress*3-stage)/.85);
   words[stage].forEach((word,i,list)=>{
    const start=list.length<=1?0:i/(list.length-1)*.8;
    const light=(.24+.76*ease((readingProgress-start)/.2)).toFixed(3);
    if(wordLights[stage][i]!==light){word.style.setProperty('--word-light',light);wordLights[stage][i]=light;}
   });
   progressLine?.style.setProperty('--editorial-progress',String(scrollProgress));
   if(!unified){ctx!.clearRect(0,0,width,height);ctx!.fillStyle=color;}
   const design=ease((progress-1/3)/.29),assemble=ease((progress-2/3)/.24),connect=ease((progress-.88)/.12);
   const fit=(p:{x:number;y:number})=>({x:.5+(p.x-.5)*.78,y:.5+(p.y-.5)*.78});
   const drift=ambientTime;
   const curve=(a:{x:number;y:number},b:{x:number;y:number},t:number,bend:number)=>{
    const arc=Math.sin(Math.PI*t)*bend;
    return {x:a.x+(b.x-a.x)*t-(b.y-a.y)*arc,y:a.y+(b.y-a.y)*t+(b.x-a.x)*arc};
   };
   for(let i=0;i<ideaPoints.length;i++){
    const p=ideaPoints[i],geometry=pointGeometry[i],{z,floor,final,blueprint,clearPlane,delay}=geometry;
    // A living field: grains follow different, continuous currents even when
    // scrolling stops. The same trajectories gradually settle into the plane.
    const current=drift*(.065+(i%17)*.004);
    const cloudX=Math.sin(i*2.399+current)*(.12+(i%23)/75);
    const cloudY=Math.cos(i*1.731+current*.82)*(.10+(i%19)/65);
    const swirl=Math.sin(drift*.13)*.16;
    const scattered={
     x:.5+cloudX*Math.cos(swirl)-cloudY*Math.sin(swirl)+Math.sin(drift*.32+i*.73)*.018,
     y:.5+cloudX*Math.sin(swirl)+cloudY*Math.cos(swirl)+Math.cos(drift*.27+i*.91)*.018,
    };
    // Individual arrival times and curved advection prevent the floors moving as rigid objects.
    const localDesign=ease((progress-1/3-delay)/.23),localAssembly=ease((progress-2/3-delay)/.23);
    // Understanding resolves the cloud into one shared plane. Those same
    // particles separate into the four design bases, retaining their identity.
    const clarity=ease((progress-.06)/.23);
    const understood=curve(scattered,clearPlane,clarity,geometry.bend*.22);
    const planned=curve(understood,blueprint,localDesign,geometry.bend*.35);
    const position=curve(planned,final,localAssembly,geometry.assemblyBend);
    const settled=clarity*(1-localDesign)+localDesign*(1-localAssembly)+localAssembly;
    const movement=(p.outer?0:.001)*settled+.008*(1-settled);
    const baseX=(position.x+Math.sin(drift*.55+i*.73)*movement)*width;
    const baseY=(position.y+Math.cos(drift*.48+i*.91)*movement)*height;
    const offset=offsets[i],step=dt/16.667;
    let forceX=0,forceY=0;
    if(pointer.inside){
     const dx=baseX+offset.x-pointer.x,dy=baseY+offset.y-pointer.y,distance=Math.hypot(dx,dy),radius=Math.min(width*.23,72);
     if(distance<radius){const force=(1-distance/radius)**2*1.6;forceX=dx/Math.max(1,distance)*force;forceY=dy/Math.max(1,distance)*force;}
    }
    offset.vx=(offset.vx+(forceX-offset.x*.035)*step)*Math.pow(.83,step);
    offset.vy=(offset.vy+(forceY-offset.y*.035)*step)*Math.pow(.83,step);
    offset.x+=offset.vx*step;offset.y+=offset.vy*step;
    const x=baseX+offset.x,y=baseY+offset.y;
    const posts=Math.abs(z-Math.round(z))>.025;
    // Scroll reveals light through the same planes: design establishes clarity,
    // then the completed structure gains illumination from its base upward.
    const designLight=ease(((progress-1/3)*3-floor*.12)/.42);
    const buildLight=ease(((progress-2/3)*3-clamp(z/3)*.55)/.3);
    const light=.38+.62*(clarity*(1-localDesign)+designLight*localDesign*(1-localAssembly)+buildLight*localAssembly);
    // A narrow light wave travels through the existing contour grains.
    // Geometry stays anchored while brightness and grain size provide emphasis.
    const pathPhase=((p.x+p.baseY)*1.7+floor*.19-drift*.22)%1;
    const waveDistance=Math.min(Math.abs(pathPhase),1-Math.abs(pathPhase));
    const pulse=Math.exp(-waveDistance*waveDistance/.003)*settled;
    const alpha=Math.min(1,(p.outer?.72+.28*pulse:.3+.035*pulse)*(posts?(1-localDesign+localAssembly)*.65:1)*light*geometry.brightness);
    const radius=p.outer?(i%11===0?1.6:1.1)+pulse*.9:.75;
    const tint=clamp(settled-.55*Math.sin(Math.PI*localDesign)-.55*Math.sin(Math.PI*localAssembly));
    if(unified){const grain=grains[i];grain.x=figureBox.left+x;grain.y=figureBox.top+y;grain.alpha=alpha;grain.radius=radius;grain.tint=tint;}
    else {ctx!.globalAlpha=alpha;ctx!.beginPath();ctx!.arc(x,y,radius,0,Math.PI*2);ctx!.fill();}
   }
   if(unified){
    // One renderer owns the actual grains. This component provides destinations,
    // rather than painting a second cloud over the background.
    const entry=clamp((stableHeight()-figureBox.top)/Math.max(1,figureBox.height*.75));
    const exit=clamp(figureBox.bottom/Math.max(1,figureBox.height*.75));
    document.dispatchEvent(new CustomEvent<EnfoqueParticleFrame>(ENFOQUE_PARTICLE_EVENT,{detail:{points:grains,strength:ease(entry)*ease(exit)}}));
    if(!mobile.matches||pointer.inside||Math.abs(scrollProgress-target)>.0001||time-lastInput<1200)raf=requestAnimationFrame(frame);
    return;
   }
   ctx!.strokeStyle=color;
   // Stable drafting molds keep the design legible while their particles remain free.
   for(let floor=0;floor<4;floor++){
    const cx=.28+(floor%2)*.44,cy=.32+Math.floor(floor/2)*.36+.108;
    ctx!.globalAlpha=design*(1-assemble)*.025;ctx!.beginPath();ctx!.moveTo((cx-.144)*width,cy*height);ctx!.lineTo(cx*width,(cy-.135)*height);ctx!.lineTo((cx+.144)*width,cy*height);ctx!.lineTo(cx*width,(cy+.135)*height);ctx!.closePath();ctx!.fill();
    ctx!.globalAlpha=design*(1-assemble)*.22;ctx!.lineWidth=.65;ctx!.stroke();
    // Registration marks make the four planes read as considered design modules.
    ctx!.globalAlpha=design*(1-assemble)*.35;ctx!.beginPath();ctx!.moveTo(cx*width-3,cy*height);ctx!.lineTo(cx*width+3,cy*height);ctx!.moveTo(cx*width,cy*height-3);ctx!.lineTo(cx*width,cy*height+3);ctx!.stroke();
   }
   // Subtle signals pass between bases, instead of a dashed assembly diagram.
   const centers=[{x:.28,y:.428},{x:.72,y:.428},{x:.72,y:.788},{x:.28,y:.788}];
   for(let packet=0;packet<3;packet++){
    const travel=(drift*.06+packet/3)%1,index=Math.floor(travel*4),t=(travel*4)%1;
    const p=curve(centers[index],centers[(index+1)%4],t,.35);
    ctx!.globalAlpha=design*(1-assemble)*.35;ctx!.beginPath();ctx!.arc(p.x*width,p.y*height,1.5,0,Math.PI*2);ctx!.fill();
   }
   if(connect>0){
    const flow=(drift*.035+clamp((progress-.88)/.12)*.16)%1;
    for(let packet=0;packet<3;packet++){
     for(let grain=0;grain<14;grain++){
      const p=fit(ideaFlowPoint(flow+packet/3-grain*.002));
      ctx!.globalAlpha=connect*(1-grain/14)*.8;ctx!.beginPath();ctx!.arc(p.x*width,p.y*height,grain===0?2:1,0,Math.PI*2);ctx!.fill();
     }
    }
    for(let floor=0;floor<4;floor++){const p=fit(ideaFlowRoute[floor*5]);ctx!.globalAlpha=connect*.35;ctx!.beginPath();ctx!.arc(p.x*width,p.y*height,2.4,0,Math.PI*2);ctx!.fill();}
   }
   ctx!.globalAlpha=1;
   if(!mobile.matches||pointer.inside||Math.abs(scrollProgress-target)>.0001||time-lastInput<1200)raf=requestAnimationFrame(frame);
  }
  document.documentElement.classList.add('editorial-ready');
  new ResizeObserver(measure).observe(figure);
  new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible){last=0;updateTarget();}else{releaseField();cancelAnimationFrame(raf);raf=0;}},{rootMargin:'100px'}).observe(sticky);
  addEventListener('scroll',()=>{if(visible&&!scrollRaf)scrollRaf=requestAnimationFrame(()=>{scrollRaf=0;updateTarget();});},{passive:true});addEventListener('resize',measure,{passive:true});
  const sync=()=>{last=0;releaseField();cancelAnimationFrame(raf);raf=0;measure();if(disabled())articles.forEach(a=>a.hidden=false);else {active=-1;setStage(progress<1/3?0:progress<2/3?1:2);}};
  document.addEventListener('motionchange',sync);reduced.addEventListener('change',sync);
  document.addEventListener('visibilitychange',schedule);
  let dark=document.documentElement.classList.contains('dark');
  new MutationObserver(()=>{
   const nextDark=document.documentElement.classList.contains('dark');
   if(nextDark!==dark){dark=nextDark;color=getComputedStyle(runway).getPropertyValue('--accent').trim();}
   if(document.documentElement.classList.contains('project-preview-open')){cancelAnimationFrame(raf);raf=0;releaseField();}
   else schedule();
  }).observe(document.documentElement,{attributes:true,attributeFilter:['class']});
  measure();
 }
</script>
